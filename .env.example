# Copier en .env pour le dev local (cp .env.example .env).
# Production : Cloudflare Pages → Settings → Environment variables.

UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_URL=https://analytics.nicodev.fr

# Clé fournie par Ahrefs Web Analytics (attribut data-key du script).
PUBLIC_AHREFS_ANALYTICS_KEY=

PUBLIC_FORMSPREE_CONTACT=https://formspree.io/f/xxxx
PUBLIC_FORMSPREE_DEVIS=https://formspree.io/f/xxxx
PUBLIC_FORMSPREE_DIAGNOSTIC=https://formspree.io/f/xxxx

# Affiche les boutons « S'abonner » sur /tarifs/ et l'accueil (#offres).
# Les deux liens doivent être définis (test ou live).
PUBLIC_STRIPE_PAYMENT_LINK_SERENITE=https://buy.stripe.com/xxxx
PUBLIC_STRIPE_PAYMENT_LINK_VISIBILITE=https://buy.stripe.com/xxxx
