---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	image: ImageMetadata;
	alt: string;
	caption?: string;
}

const { image, alt, caption } = Astro.props;
---

<figure class="not-prose my-10">
	<Image
		src={image}
		alt={alt}
		class="w-full h-auto rounded-lg shadow-sm"
		loading="lazy"
		decoding="async"
		widths={[640, 768, 896, 1280]}
		sizes="(min-width: 896px) 896px, 100vw"
		quality={80}
	/>
	{caption && <figcaption class="mt-3 text-center text-sm leading-relaxed text-muted">{caption}</figcaption>}
</figure>
