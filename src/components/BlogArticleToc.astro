---
import type { BlogTocItem } from '../utils/blog';

interface Props {
	items: BlogTocItem[];
}

const { items } = Astro.props;
---

{
	items.length > 0 && (
		<nav
			class="not-prose mb-10 rounded-xl border border-border bg-surface/80 p-5 shadow-sm"
			aria-label="Sommaire de l'article"
		>
			<p class="text-sm font-semibold uppercase tracking-wide text-muted">Sommaire</p>
			<ol class="mt-3 list-decimal space-y-2 pl-5 text-base text-foreground marker:text-muted">
				{items.map((item) => (
					<li class="pl-1">
						<a
							href={`#${item.slug}`}
							class="text-pretty font-medium text-foreground underline-offset-2 hover:text-primary hover:underline"
						>
							{item.text}
						</a>
						{item.children && item.children.length > 0 && (
							<ul class="mt-2 list-none space-y-1.5 border-l border-border pl-4 text-sm text-muted">
								{item.children.map((child) => (
									<li>
										<a
											href={`#${child.slug}`}
											class="text-pretty text-muted underline-offset-2 hover:text-primary hover:underline"
										>
											{child.text}
										</a>
									</li>
								))}
							</ul>
						)}
					</li>
				))}
			</ol>
		</nav>
	)
}
