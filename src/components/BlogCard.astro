---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { toTagHref } from '../utils/blog';

export interface Props {
	title: string;
	description: string;
	href: string;
	image: ImageMetadata;
	imageAlt: string;
	pubDate: string;
	author: string;
	tags?: string[];
	updatedDate?: string;
}

const { title, description, href, image, imageAlt, pubDate, author, tags, updatedDate } = Astro.props;
const displayTitle = title.replace(/\s(?=[?!:;])/g, '\u202F');
---

<article class="grid h-full min-h-0 grid-rows-[auto_minmax(0,1fr)] self-stretch overflow-hidden rounded-lg border border-border bg-background shadow-sm transition-shadow duration-300 hover:shadow-md">
	<div class="min-h-0">
		<Image
			src={image}
			alt={imageAlt}
			class="w-full h-48 object-cover"
			width={800}
			height={450}
		/>
	</div>
	<div class="p-6 flex flex-col min-h-0 h-full">
		<div class="flex flex-col gap-1 text-sm text-muted mb-2">
			<div class="flex items-center">
				<time datetime={pubDate}>
					{new Date(pubDate).toLocaleDateString('fr-FR', {
						year: 'numeric',
						month: 'long',
						day: 'numeric'
					})}
				</time>
				<span class="mx-2">•</span>
				<span>{author}</span>
			</div>
			{updatedDate && (
				<div class="text-xs text-muted">
					Mis à jour le{' '}
					<time datetime={updatedDate}>
						{new Date(updatedDate).toLocaleDateString('fr-FR', {
							year: 'numeric',
							month: 'long',
							day: 'numeric'
						})}
					</time>
				</div>
			)}
		</div>
		<h2 class="text-xl font-semibold text-foreground mb-3">
			<a href={href} class="hover:text-primary transition-colors">
				{displayTitle}
			</a>
		</h2>
		<p class="text-muted mb-4 line-clamp-3">
			{description}
		</p>
		{tags && tags.length > 0 && (
			<div class="flex flex-wrap gap-2 mb-4" role="list" aria-label="Thématiques de l’article">
				{tags.slice(0, 3).map((t: string) => (
					<a
						href={toTagHref(t)}
						role="listitem"
						title={t}
						class="inline-flex max-w-[min(100%,12rem)] shrink-0 items-center rounded-full border border-border bg-background px-3 py-1 text-xs font-medium text-muted shadow-sm transition-colors hover:border-primary hover:bg-surface hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
					>
						<span class="truncate">{t}</span>
					</a>
				))}
			</div>
		)}
		<a
			href={href}
			class="mt-auto inline-flex w-fit shrink-0 items-center gap-1.5 font-semibold text-primary-foreground underline decoration-primary/40 underline-offset-[0.22em] transition-colors hover:text-primary-900 hover:decoration-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
		>
			Lire l'article
			<span aria-hidden="true">→</span>
		</a>
	</div>
</article>
