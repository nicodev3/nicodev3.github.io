---
import { Image } from 'astro:assets';
import { toTagHref } from '../utils/blog';

export interface Props {
	title: string;
	description: string;
	href: string;
	image: string;
	imageAlt: string;
	tag?: string;
	pubDate: string;
	author: string;
	tags?: string[];
	updatedDate?: string;
}

const { title, description, href, image, imageAlt, tag, pubDate, author, tags, updatedDate } = Astro.props;
---

<article class="bg-background rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-border">
	<div class="relative">
		<Image
			src={image}
			alt={imageAlt}
			class="w-full h-48 object-cover"
			width={800}
			height={450}
		/>
		{tag && (
			<div class="absolute top-4 left-4">
				<a href={toTagHref(tag)} class="bg-surface text-foreground hover:bg-surface-alt px-3 py-1 rounded-full text-sm font-medium transition-colors">
					{tag}
				</a>
			</div>
		)}
	</div>
	<div class="p-6">
		<div class="flex flex-col gap-1 text-sm text-muted mb-2">
			<div class="flex items-center">
				<time datetime={pubDate}>
					{new Date(pubDate).toLocaleDateString('fr-FR', {
						year: 'numeric',
						month: 'long',
						day: 'numeric'
					})}
				</time>
				<span class="mx-2">•</span>
				<span>{author}</span>
			</div>
			{updatedDate && (
				<div class="text-xs text-muted">
					Mis à jour le{' '}
					<time datetime={updatedDate}>
						{new Date(updatedDate).toLocaleDateString('fr-FR', {
							year: 'numeric',
							month: 'long',
							day: 'numeric'
						})}
					</time>
				</div>
			)}
		</div>
		<h2 class="text-xl font-semibold text-foreground mb-3">
			<a href={href} class="hover:text-primary transition-colors">
				{title}
			</a>
		</h2>
		<p class="text-muted mb-4 line-clamp-3">
			{description}
		</p>
		{tags && tags.length > 0 && (
			<div class="flex flex-wrap gap-2 mb-4">
				{tags.slice(0, 3).map((t: string) => (
					<a href={toTagHref(t)} class="bg-surface text-foreground hover:bg-surface-alt px-2 py-1 rounded text-sm transition-colors">
						{t}
					</a>
				))}
			</div>
		)}
		<a
			href={href}
			class="inline-block bg-primary text-on-primary px-4 py-2 rounded-lg hover:opacity-90 transition-colors"
		>
			Lire l'article
		</a>
	</div>
</article>
