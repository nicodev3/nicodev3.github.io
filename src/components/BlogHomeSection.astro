---
import type { CollectionEntry } from 'astro:content';
import BlogCard from './BlogCard.astro';
import defaultBlogCover from '../assets/images/blog/development.webp';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<section id="blog" class="py-16 bg-white border-y border-border/60" aria-labelledby="blog-home-heading">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="max-w-3xl mb-10">
			<p class="text-sm font-semibold uppercase tracking-wider text-muted mb-2">Blog</p>
			<h2 id="blog-home-heading" class="text-3xl font-bold text-foreground">
				Des réponses aux questions que vous posez peut-être concernant votre présence sur Internet en tant que psychologue libéral
			</h2>
			<p class="mt-4 text-lg text-muted">
				Installation, premiers patients, visibilité Google, site vs Doctolib… Des articles rédigés pour les psychologues en libéral, pour clarifier les sujets que vous cherchez sur le web — souvent longtemps avant de demander un devis.
			</p>
		</div>
		<div class="relative lg:px-10 xl:px-14" data-carousel-root>
			<div
				class="flex gap-6 overflow-x-auto pb-4 scroll-smooth snap-x snap-mandatory [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
				data-carousel-track
				aria-label="Articles du blog"
			>
				{posts.map((post) => (
					<div class="snap-start shrink-0 w-full md:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
						<BlogCard
							title={post.data.title}
							description={post.data.description}
							href={`/blog/${post.id}/`}
							image={post.data.image ?? defaultBlogCover}
							imageAlt={post.data.title}
							pubDate={post.data.pubDate}
							updatedDate={post.data.updatedDate}
							author={post.data.author}
							tags={post.data.tags}
						/>
					</div>
				))}
			</div>
			<button
				type="button"
				class="absolute left-1 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-primary/60 text-white shadow-md ring-2 ring-white/70 transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40 sm:left-2 sm:bg-primary/70 lg:-left-5 lg:bg-primary xl:-left-6"
				aria-label="Voir les articles précédents"
				data-carousel-prev
			>
				<span aria-hidden="true">←</span>
			</button>
			<button
				type="button"
				class="absolute right-1 top-1/2 z-10 inline-flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-primary/60 text-white shadow-md ring-2 ring-white/70 transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-40 sm:right-2 sm:bg-primary/70 lg:-right-5 lg:bg-primary xl:-right-6"
				aria-label="Voir les articles suivants"
				data-carousel-next
			>
				<span aria-hidden="true">→</span>
			</button>
			<div class="mt-4 flex items-center justify-center" data-carousel-controls>
				<p class="text-sm text-muted tabular-nums" aria-live="polite">
					<span data-carousel-current>1</span>
					<span aria-hidden="true"> / </span>
					<span data-carousel-total>{posts.length}</span>
				</p>
			</div>
		</div>
		<div class="mt-12 text-center">
			<a
				href="/blog/"
				class="inline-flex items-center justify-center font-semibold text-foreground underline decoration-primary/50 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
			>
				Voir tous les articles
			</a>
		</div>
	</div>
</section>

<script>
	const carouselRoot = document.querySelector('[data-carousel-root]');
	const carouselTrack = carouselRoot?.querySelector('[data-carousel-track]');
	const prevButton = carouselRoot?.querySelector('[data-carousel-prev]');
	const nextButton = carouselRoot?.querySelector('[data-carousel-next]');
	const currentLabel = carouselRoot?.querySelector('[data-carousel-current]');
	const totalLabel = carouselRoot?.querySelector('[data-carousel-total]');

	if (
		carouselTrack instanceof HTMLElement &&
		prevButton instanceof HTMLButtonElement &&
		nextButton instanceof HTMLButtonElement &&
		currentLabel instanceof HTMLElement &&
		totalLabel instanceof HTMLElement
	) {
		const getScrollStep = () => carouselTrack.clientWidth;

		const updateButtons = () => {
			const maxScroll = carouselTrack.scrollWidth - carouselTrack.clientWidth;
			const rawIndex = Math.round(carouselTrack.scrollLeft / Math.max(getScrollStep(), 1)) + 1;
			const maxIndex = Math.max(Math.ceil(carouselTrack.scrollWidth / Math.max(getScrollStep(), 1)), 1);
			const clampedIndex = Math.min(Math.max(rawIndex, 1), maxIndex);
			prevButton.disabled = carouselTrack.scrollLeft <= 8;
			nextButton.disabled = carouselTrack.scrollLeft >= maxScroll - 8;
			currentLabel.textContent = String(clampedIndex);
			totalLabel.textContent = String(maxIndex);
		};

		prevButton.addEventListener('click', () => {
			carouselTrack.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
		});

		nextButton.addEventListener('click', () => {
			carouselTrack.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
		});

		carouselTrack.addEventListener('scroll', updateButtons, { passive: true });
		window.addEventListener('resize', updateButtons);
		updateButtons();
	}
</script>
