---
import type { BlogInlineCtaVariant } from '../data/blog-inline-ctas';

interface Props {
  variant: BlogInlineCtaVariant;
  beforeHeading: string;
  articleId: string;
  /** Style discret pour les articles Read (lien texte, pas d’encart primary). */
  quiet?: boolean;
}

const { variant, beforeHeading, articleId, quiet = false } = Astro.props;

const copies: Record<
  BlogInlineCtaVariant,
  {
    eyebrow: string;
    title: string;
    description: string;
    primary: string;
    primaryHref: string;
    trackDiagnostic?: boolean;
  }
> = {
  site: {
    eyebrow: 'Besoin d’un regard extérieur ?',
    title: 'Votre site doit être clair pour vos patients avant d’être sophistiqué.',
    description:
      'Quatre questions suffisent : je vous indique les priorités utiles, structure, contenu et visibilité locale.',
    primary: 'Demander un diagnostic gratuit',
    primaryHref: '/diagnostic-gratuit/',
    trackDiagnostic: true,
  },
  visibility: {
    eyebrow: 'Passez de la méthode à votre situation',
    title: 'Quelles actions auraient réellement un effet pour votre cabinet ?',
    description:
      'Un diagnostic court à partir de votre site, de votre fiche Google et de votre contexte local.',
    primary: 'Demander un diagnostic gratuit',
    primaryHref: '/diagnostic-gratuit/',
    trackDiagnostic: true,
  },
  refonte: {
    eyebrow: 'Avant de lancer la refonte',
    title: 'Identifiez ce qui mérite vraiment d’être changé.',
    description:
      'Je distingue les problèmes de contenu, de structure, de référencement ou de technique avant que vous engagiez un budget.',
    primary: 'Demander un diagnostic gratuit',
    primaryHref: '/diagnostic-gratuit/',
    trackDiagnostic: true,
  },
  budget: {
    eyebrow: 'Vous préparez votre budget ?',
    title: 'Faites le point avant de comparer les prix.',
    description:
      'Je vous indique les éléments réellement nécessaires et ceux qui peuvent attendre.',
    primary: 'Demander un diagnostic gratuit',
    primaryHref: '/diagnostic-gratuit/',
    trackDiagnostic: true,
  },
  independence: {
    eyebrow: 'Construire une présence durable',
    title: 'Votre site peut devenir le point central de votre visibilité.',
    description:
      'Je vérifie comment articuler site, Google et rendez-vous, sans tout faire dépendre d’une plateforme.',
    primary: 'Demander un diagnostic gratuit',
    primaryHref: '/diagnostic-gratuit/',
    trackDiagnostic: true,
  },
  creation: {
    eyebrow: 'La suite, si vous préparez votre visibilité',
    title: 'Un site pour présenter votre cabinet.',
    description:
      'Création offerte, puis 29 ou 49 € par mois. La page détaille ce qui est inclus pour un psychologue en libéral.',
    primary: 'Voir la création de site pour psychologue',
    primaryHref: '/creation-site-internet-psychologue/',
    trackDiagnostic: false,
  },
  viabilite: {
    eyebrow: 'Passer des fourchettes à votre cas',
    title: 'Combien de séances pour que le cabinet tienne ?',
    description:
      'L’outil calcule un seuil à partir de votre tarif, de vos charges et du rythme que vous visez.',
    primary: 'Calculer le seuil de viabilité',
    primaryHref: '/outils/seuil-viabilite-seances/',
    trackDiagnostic: false,
  },
  psychomotricien: {
    eyebrow: 'Pour votre cabinet de psychomotricité',
    title: 'Vérifiez les priorités de votre visibilité locale.',
    description:
      'Quatre questions : site, fiche Google, cohérence des infos, et trois actions adaptées.',
    primary: 'Demander un diagnostic gratuit',
    primaryHref: '/diagnostic-gratuit/',
    trackDiagnostic: true,
  },
};

const baseCopy = copies[variant];
const copy =
  quiet && baseCopy.trackDiagnostic !== false
    ? {
        ...baseCopy,
        eyebrow: 'Suite possible',
        title: 'Un doute sur votre site ou votre visibilité ?',
        description:
          'Diagnostic court : structure, contenu, visibilité locale. Retour sous 48 h.',
        primary: 'Demander un diagnostic gratuit →',
      }
    : baseCopy;
const source = `article-${articleId}-inline`;
const eventSource = articleId.replaceAll('-', '_');
---

<aside
  class:list={[
    'blog-inline-cta not-prose my-10 border p-5',
    quiet
      ? 'rounded-xl border-border bg-surface/60 sm:p-6'
      : 'rounded-2xl border-primary/25 bg-primary-50 shadow-sm sm:p-7',
  ]}
  data-blog-inline-cta
  data-before-heading={beforeHeading}
  aria-label={quiet ? copy.title : copy.eyebrow}
>
  {!quiet && <p class="type-eyebrow text-primary-700">{copy.eyebrow}</p>}
  {
    quiet ? (
      <p class="text-balance text-lg font-medium leading-snug text-foreground">{copy.title}</p>
    ) : (
      <h2 class="mt-2 text-balance font-heading text-2xl font-semibold leading-tight text-foreground sm:text-3xl">
        {copy.title}
      </h2>
    )
  }
  <p
    class:list={[
      'max-w-3xl text-pretty leading-relaxed text-muted',
      quiet ? 'mt-2 text-sm' : 'mt-3 text-base',
    ]}
  >
    {copy.description}
  </p>
  <div class={quiet ? 'mt-3' : 'mt-5'}>
    <a
      href={copy.primaryHref}
      class:list={[
        quiet
          ? 'text-sm font-medium text-primary underline-offset-2 hover:underline'
          : 'btn-primary-solid inline-flex items-center justify-center rounded-lg px-5 py-3 font-semibold',
      ]}
      data-lead-source={source}
      data-analytics-event={copy.trackDiagnostic === false ? undefined : 'lead_click_diagnostic'}
      data-analytics-cta={copy.trackDiagnostic === false ? undefined : 'diagnostic'}
      data-analytics-location={`article_${eventSource}_inline`}
    >
      {copy.primary}
    </a>
    {copy.trackDiagnostic !== false && !quiet && (
      <p class="mt-2 text-xs text-muted">Moins de 2 minutes. Sans engagement.</p>
    )}
  </div>
</aside>

<script>
  const normalizeHeading = (value: string | null | undefined) =>
    (value ?? '')
      .replace(/[’‘]/g, "'")
      .replace(/\s+/g, ' ')
      .trim();

  document.querySelectorAll<HTMLElement>('[data-blog-inline-cta]').forEach((cta) => {
    const articleBody = cta.closest('.prose');
    const target = normalizeHeading(cta.dataset.beforeHeading);
    const heading = Array.from(articleBody?.querySelectorAll('h2') ?? []).find(
      (item) => normalizeHeading(item.textContent) === target,
    );

    if (heading) heading.before(cta);
  });
</script>
