---
export interface Props {
	/** URL absolue de la page à partager */
	url: string;
	title: string;
}

const { url, title } = Astro.props;

const encUrl = encodeURIComponent(url);
const encTitle = encodeURIComponent(title);
const textWithUrl = encodeURIComponent(`${title}\n${url}`);

const links = [
	{
		name: 'LinkedIn',
		href: `https://www.linkedin.com/sharing/share-offsite/?url=${encUrl}`,
		icon: 'linkedin',
		brandClass:
			'border-[#0A66C2] bg-[#0A66C2] text-white hover:bg-[#004182] hover:border-[#004182] focus-visible:ring-[#0A66C2]',
	},
	{
		name: 'Facebook',
		href: `https://www.facebook.com/sharer/sharer.php?u=${encUrl}`,
		icon: 'facebook',
		brandClass:
			'border-[#1877F2] bg-[#1877F2] text-white hover:bg-[#166FE5] hover:border-[#166FE5] focus-visible:ring-[#1877F2]',
	},
	{
		name: 'X',
		href: `https://twitter.com/intent/tweet?url=${encUrl}&text=${encTitle}`,
		icon: 'x',
		brandClass:
			'border-black bg-black text-white hover:bg-neutral-800 hover:border-neutral-800 focus-visible:ring-black',
	},
	{
		name: 'WhatsApp',
		href: `https://wa.me/?text=${textWithUrl}`,
		icon: 'whatsapp',
		brandClass:
			'border-[#25D366] bg-[#25D366] text-white hover:bg-[#20BD5A] hover:border-[#20BD5A] focus-visible:ring-[#128C7E]',
	},
] as const;
---

<nav class="blog-share not-prose w-full" aria-label="Partager cet article sur les réseaux sociaux">
	<div
		class="mx-auto flex max-w-xl flex-wrap items-center justify-center gap-2 border-t border-border/60 pt-3 sm:gap-1.5"
	>
		<div class="flex flex-wrap items-center justify-center gap-2 sm:gap-1.5">
			{
				links.map(({ name, href, icon, brandClass }) => (
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`Partager sur ${name} (nouvel onglet)`}
						class:list={[
							'inline-flex size-12 shrink-0 touch-manipulation items-center justify-center rounded-lg border shadow-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 sm:size-8',
							brandClass,
						]}
					>
						{icon === 'linkedin' && (
							<svg class="size-6 sm:size-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path
									d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
								/>
							</svg>
						)}
						{icon === 'facebook' && (
							<svg class="size-6 sm:size-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path
									d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
								/>
							</svg>
						)}
						{icon === 'x' && (
							<svg class="size-6 sm:size-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path
									d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
								/>
							</svg>
						)}
						{icon === 'whatsapp' && (
							<svg class="size-6 sm:size-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path
									d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
								/>
							</svg>
						)}
					</a>
				))
			}
			<button
				type="button"
				aria-label="Copier le lien de l’article"
				title="Copier le lien"
				class="inline-flex size-12 shrink-0 touch-manipulation items-center justify-center rounded-lg border border-border bg-background/90 text-muted shadow-sm transition-colors hover:border-primary/45 hover:bg-primary/8 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 sm:size-8"
				data-share-copy
				data-url={url}
			>
				<svg class="size-6 sm:size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
					/>
				</svg>
				<span class="copy-label sr-only">Copier le lien</span>
			</button>
		</div>
	</div>
</nav>

<script>
	function initCopyButtons(root: ParentNode) {
		root.querySelectorAll<HTMLButtonElement>('[data-share-copy]').forEach((btn) => {
			if (btn.dataset.shareBound === '1') return;
			btn.dataset.shareBound = '1';
			const label = btn.querySelector('.copy-label');
			const urlToCopy = btn.getAttribute('data-url');
			btn.addEventListener('click', async () => {
				if (!urlToCopy) return;
				try {
					await navigator.clipboard.writeText(urlToCopy);
					btn.setAttribute('title', 'Lien copié !');
					btn.setAttribute('aria-label', 'Lien copié dans le presse-papiers');
					if (label) label.textContent = 'Lien copié !';
					setTimeout(() => {
						btn.setAttribute('title', 'Copier le lien');
						btn.setAttribute('aria-label', 'Copier le lien de l’article');
						if (label) label.textContent = 'Copier le lien';
					}, 2000);
				} catch {
					btn.setAttribute('title', 'Impossible de copier');
					setTimeout(() => {
						btn.setAttribute('title', 'Copier le lien');
					}, 2000);
				}
			});
		});
	}
	initCopyButtons(document);
</script>
