---
import ContactWhatsAppOption from './ContactWhatsAppOption.astro';
import FormField from './FormField.astro';

export interface Props {
	mode?: 'contact' | 'devis';
}

const { mode = 'devis' } = Astro.props;

const isDevisMode = mode === 'devis';
const formspreeUrl = (
	isDevisMode
		? import.meta.env.PUBLIC_FORMSPREE_DEVIS
		: import.meta.env.PUBLIC_FORMSPREE_CONTACT
)?.trim();
// Preview CF (branches / PR) n’a souvent pas les secrets Production.
const isCloudflareProduction =
	process.env.CF_PAGES === '1' &&
	(process.env.CF_PAGES_BRANCH === 'main' || process.env.CF_PAGES_BRANCH === 'master');
if (import.meta.env.PROD && isCloudflareProduction && !formspreeUrl) {
	const missing = isDevisMode ? 'PUBLIC_FORMSPREE_DEVIS' : 'PUBLIC_FORMSPREE_CONTACT';
	throw new Error(
		`Build Cloudflare Pages interrompu : ${missing} manquant. ` +
			`Ajoutez l’URL Formspree (ex. https://formspree.io/f/…) dans Cloudflare Pages → Settings → Environment variables (Production).`,
	);
}

const redirectUrl = import.meta.env.SITE
	? new URL(isDevisMode ? '/merci/devis/' : '/merci/contact/', import.meta.env.SITE).href
	: undefined;

const formName = isDevisMode ? 'devis' : 'contact';
const submitEvent = isDevisMode ? 'lead_submit_devis' : 'lead_submit_contact_simple';
const startEvent = isDevisMode ? 'lead_start_devis' : 'lead_start_contact_simple';
const subject = isDevisMode ? '[nicodev.fr] Demande de devis' : '[nicodev.fr] Message de contact';
const messageLabel = isDevisMode ? 'Votre projet *' : 'Votre message *';
const messagePlaceholder = isDevisMode
	? 'Décrivez votre activité, vos besoins, vos objectifs...'
	: 'Précisez votre demande (question, disponibilité, besoin particulier...)';
const submitLabel = isDevisMode ? 'Recevoir mon devis sous 48h' : 'Envoyer mon message (réponse sous 48h)';
const reassuranceText = isDevisMode
	? "Sans engagement. Vous recevez une recommandation claire adaptée à votre situation."
	: 'Aucune inscription à une newsletter. Votre message reste strictement confidentiel.';
---

<div id="contact-form-wrapper" class="bg-background rounded-lg border border-border p-6 md:p-8 shadow-sm">
	<div class="mb-6">
		<ContactWhatsAppOption
			variant="button"
			umamiEvent={isDevisMode ? 'lead_click_whatsapp_from_devis' : 'lead_click_whatsapp_from_contact'}
		/>
	</div>
	<form
		id="contact-form"
		name={formName}
		method="POST"
		action={formspreeUrl}
		data-umami-event={submitEvent}
		data-umami-start-event={startEvent}
		data-success-url={redirectUrl}
		class="space-y-6"
	>
		<input type="hidden" name="form-name" value={formName} />
		{redirectUrl && <input type="hidden" name="_next" value={redirectUrl} />}
		<input type="hidden" name="_subject" value={subject} />
		<p class="hidden" aria-hidden="true">
			<label for="contact-gotcha">Ne pas remplir</label>
			<input id="contact-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
		</p>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<FormField id="contact-firstName" name="firstName" label="Prénom *" type="text" required />
			<FormField id="contact-lastName" name="lastName" label="Nom *" type="text" required />
		</div>

		<FormField id="contact-email" name="email" label="Email *" type="email" required />
		<FormField id="contact-phone" name="phone" label="Téléphone" type="tel" />

		{
			isDevisMode && (
				<FormField id="contact-profession" name="profession" label="Profession *" required variant="select">
					<option value="">Sélectionnez votre profession</option>
					<option value="psychologue">Psychologue</option>
					<option value="psychotherapeute">Psychothérapeute (titre + RPPS)</option>
					<option value="psychomotricien">Psychomotricien</option>
				</FormField>
			)
		}

		{
			isDevisMode && (
				<FormField id="contact-formule" name="formule" label="Offre souhaitée *" required variant="select">
					<option value="">Sélectionnez une offre</option>
					<option value="serenite">Offre Sérénité — 29€/mois</option>
					<option value="visibilite-confiance">Offre Visibilité &amp; Confiance — 49€/mois</option>
					<option value="indecis">Je ne sais pas encore</option>
				</FormField>
			)
		}

		<FormField
			id="contact-message"
			name="message"
			label={messageLabel}
			required
			variant="textarea"
			placeholder={messagePlaceholder}
			rows={6}
		/>

		<button
			type="submit"
			class="btn-primary-solid relative inline-flex w-full min-h-12 items-center justify-center gap-2 rounded-lg px-5 py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-85"
		>
			<svg
				class="contact-submit-spinner hidden h-5 w-5 shrink-0 animate-spin"
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 24 24"
				aria-hidden="true"
			>
				<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
				<path
					class="opacity-75"
					fill="currentColor"
					d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
				></path>
			</svg>
			<span data-contact-submit-text>{submitLabel}</span>
		</button>
		<p id="contact-form-feedback" class="hidden text-sm font-medium text-red-700 dark:text-red-400" role="alert" aria-live="polite"></p>
		<p class="text-center text-xs text-muted">{reassuranceText}</p>
	</form>
</div>

<script is:inline>
	(() => {
		const form = document.getElementById('contact-form');
		if (!form) return;
		const startEvent = form.getAttribute('data-umami-start-event');
		const submitEvent = form.getAttribute('data-umami-event');
		const successUrl = form.getAttribute('data-success-url');
		const feedback = document.getElementById('contact-form-feedback');
		const submitButton = form.querySelector('button[type="submit"]');
		const submitLabelEl = submitButton?.querySelector('[data-contact-submit-text]');
		const submitSpinner = submitButton?.querySelector('.contact-submit-spinner');
		const defaultSubmitLabel = submitLabelEl?.textContent?.trim() ?? '';

		let started = false;
		const trackStart = () => {
			if (started) return;
			started = true;
			if (startEvent && window.umami && typeof window.umami.track === 'function') {
				window.umami.track(startEvent);
			}
		};

		form.addEventListener('focusin', trackStart, { once: true });
		form.addEventListener('change', trackStart, { once: true });

		const messageField = form.querySelector('#contact-message');
		const params = new URLSearchParams(window.location.search);
		if (
			params.get('sujet') === 'guide-installation' &&
			messageField instanceof HTMLTextAreaElement &&
			!messageField.value.trim()
		) {
			messageField.value =
				'Guide installation libéral psy\n\nContexte (2 lignes) : ';
			messageField.focus();
			const cursor = messageField.value.length;
			messageField.setSelectionRange(cursor, cursor);
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			let redirecting = false;
			if (feedback) {
				feedback.textContent = '';
				feedback.classList.add('hidden');
			}
			if (submitButton) {
				submitButton.setAttribute('disabled', 'disabled');
				submitButton.setAttribute('aria-busy', 'true');
			}
			if (submitSpinner) submitSpinner.classList.remove('hidden');
			if (submitLabelEl) submitLabelEl.textContent = 'Envoi en cours…';
			if (submitEvent && window.umami && typeof window.umami.track === 'function') {
				window.umami.track(submitEvent);
			}

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: {
						Accept: 'application/json'
					}
				});

				if (!response.ok) {
					throw new Error('Submission failed');
				}

				if (successUrl) {
					redirecting = true;
					window.location.href = successUrl;
					return;
				}

				form.reset();
			} catch (_) {
				if (feedback) {
					feedback.textContent = 'Une erreur est survenue. Merci de réessayer dans un instant.';
					feedback.classList.remove('hidden');
				}
			} finally {
				if (!redirecting && submitButton) {
					submitButton.removeAttribute('disabled');
					submitButton.removeAttribute('aria-busy');
				}
				if (!redirecting && submitSpinner) submitSpinner.classList.add('hidden');
				if (!redirecting && submitLabelEl && defaultSubmitLabel) submitLabelEl.textContent = defaultSubmitLabel;
			}
		});
	})();
</script>
