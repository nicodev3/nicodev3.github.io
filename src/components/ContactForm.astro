---
import FormField from './FormField.astro';
---

<div id="contact-form-wrapper">
	<form id="contact-form" name="contact" method="POST" action="/merci" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
		<input type="hidden" name="form-name" value="contact" />
		<p class="hidden" aria-hidden="true">
			<label for="contact-bot-field">Ne pas remplir</label>
			<input id="contact-bot-field" name="bot-field" type="text" tabindex="-1" autocomplete="off" />
		</p>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<FormField id="firstName" name="firstName" label="Prénom *" type="text" required />
			<FormField id="lastName" name="lastName" label="Nom *" type="text" required />
		</div>

		<FormField id="email" name="email" label="Email *" type="email" required />
		<FormField id="phone" name="phone" label="Téléphone" type="tel" />

		<FormField id="profession" name="profession" label="Votre profession *" required variant="select">
			<option value="">Sélectionnez votre profession</option>
			<option value="psychologue">Psychologue</option>
		</FormField>

		<FormField id="formule" name="formule" label="Offre souhaitée *" required variant="select">
			<option value="">Sélectionnez une offre</option>
			<option value="serenite">Offre Sérénité — 29€/mois</option>
			<option value="visibilite-confiance">Offre Visibilité &amp; Confiance — 49€/mois</option>
			<option value="indecis">Je ne sais pas encore</option>
		</FormField>

		<FormField id="message" name="message" label="Votre projet *" required variant="textarea" placeholder="Décrivez votre activité, vos besoins, vos objectifs..." rows={6} />

		<button
			type="submit"
			class="w-full bg-primary text-on-primary py-3 px-6 rounded-lg font-semibold hover:opacity-90 transition-colors"
		>
			Envoyer le message
		</button>
	</form>
</div>
