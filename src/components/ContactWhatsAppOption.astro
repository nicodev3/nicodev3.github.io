---
import { MessageCircle } from '@lucide/astro';
import { SOCIAL_HANDLE_DISPLAY, WHATSAPP_DISPLAY, WHATSAPP_HREF } from '../data/contact';

export interface Props {
	/** Variante compacte (lien inline) ou bouton pleine largeur. */
	variant?: 'inline' | 'button';
	/** Événement Umami au clic (optionnel). */
	umamiEvent?: string;
	/** Emplacement stable envoyé sans donnée personnelle. */
	analyticsLocation?: string;
}

const { variant = 'button', umamiEvent, analyticsLocation } = Astro.props;
const legacyLocation = umamiEvent?.match(/_from_(.+)$/)?.[1];
const location = analyticsLocation ?? legacyLocation ?? 'form';

const linkClass =
	variant === 'button'
		? 'inline-flex w-full items-center justify-center gap-2 rounded-lg bg-whatsapp px-5 py-3 text-sm font-semibold text-white shadow-sm transition-colors duration-150 hover:bg-whatsapp-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-whatsapp focus-visible:ring-offset-2 focus-visible:ring-offset-background'
		: 'inline-flex items-center gap-1.5 font-semibold text-whatsapp underline underline-offset-4 hover:text-whatsapp-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-whatsapp focus-visible:ring-offset-2 rounded-sm';
---

<div
	class:list={[
		variant === 'button' && 'rounded-lg border border-border bg-surface-alt p-4',
	]}
	role="region"
	aria-label="Contact WhatsApp"
>
	{variant === 'button' ? (
		<p class="mb-3 text-sm text-muted">
			Vous préférez un échange direct&nbsp;? Contactez-moi sur WhatsApp ({SOCIAL_HANDLE_DISPLAY}), réponse en général le jour même.
		</p>
	) : (
		<p class="text-sm text-muted">
			<strong class="text-foreground">WhatsApp</strong>
			{' '}
			({SOCIAL_HANDLE_DISPLAY})
			{', '}
			contact direct&nbsp;:
		</p>
	)}
	<a
		href={WHATSAPP_HREF}
		target="_blank"
		rel="noopener noreferrer"
		class={linkClass}
		data-analytics-event="lead_click_whatsapp"
		data-analytics-cta="whatsapp"
		data-analytics-location={location}
	>
		<MessageCircle size={18} stroke-width={2} nonScalingStroke class="shrink-0" aria-hidden="true" />
		<span>{variant === 'button' ? 'Écrire sur WhatsApp' : WHATSAPP_DISPLAY}</span>
	</a>
</div>
