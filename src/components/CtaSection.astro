---
import contactBackground from '../assets/images/contact-accueil-background.png';

export interface CtaButton {
	text: string;
	href: string;
	/** Événement Umami émis au clic (convention : lead_click_<cible>_from_<source>). */
	umamiEvent?: string;
	/** Origine mémorisée en session puis transmise au formulaire de destination. */
	leadSource?: string;
}

export interface Props {
	title: string;
	description: string;
	primaryButton: CtaButton;
	secondaryButton: CtaButton;
	background?: 'surface' | 'white' | 'background';
	/** Bandeau terracotta plein (CTA final accueil, design Stitch). */
	variant?: 'default' | 'accent-band';
	/** Ancre pour navigation sur la page (ex. accueil). */
	anchorId?: string;
}

const {
	title,
	description,
	primaryButton,
	secondaryButton,
	background = 'surface',
	variant = 'default',
	anchorId,
} = Astro.props;

const bgClass = { surface: 'bg-surface', white: 'bg-white', background: 'bg-background' }[background];
const isAccentBand = variant === 'accent-band';

const isDiagnosticHref = (href: string) =>
	new URL(href, Astro.site ?? Astro.url).pathname.replace(/\/+$/, '') === '/diagnostic-gratuit';
const primarySuppressHeaderDiag = isDiagnosticHref(primaryButton.href);
const secondaryIsDiagnostic = isDiagnosticHref(secondaryButton.href);
---

<section
	id={anchorId}
	class:list={[
		'section-y',
		isAccentBand ? 'cta-accent-band border-t border-primary-900/20' : ['border-t border-border', bgClass],
		anchorId && 'scroll-mt-28',
	]}
	style={isAccentBand ? `background-image: url("${contactBackground.src}")` : undefined}
>
	<div class="shell-layout text-center">
		<h2
			class:list={[
				'mb-4 font-heading font-semibold tracking-tight',
				isAccentBand ? 'text-3xl leading-tight text-on-primary sm:text-4xl md:text-5xl' : 'text-3xl sm:text-4xl text-foreground',
			]}
		>
			{title}
		</h2>
		<p
			class:list={[
				'shell-prose mx-auto mb-8 text-lg sm:text-xl',
				isAccentBand ? 'text-on-primary/90' : 'text-muted',
			]}
		>
			{description}
		</p>
		<div class="flex flex-col justify-center gap-4 sm:flex-row">
			<a
				href={primaryButton.href}
				class:list={[
					'inline-flex items-center justify-center rounded-lg px-6 py-3.5 font-semibold transition-[background-color,box-shadow,transform] duration-200',
					isAccentBand
						? 'rounded-xl bg-white px-8 py-4 text-primary-foreground shadow-lg hover:bg-neutral-50'
						: 'btn-primary-solid',
				]}
				{...(primarySuppressHeaderDiag ? { 'data-suppress-header-diagnostic-when-visible': true } : {})}
				{...(primarySuppressHeaderDiag
					? {
							'data-analytics-event': 'lead_click_diagnostic',
							'data-analytics-cta': 'diagnostic',
							'data-analytics-location': primaryButton.leadSource ?? 'cta_section',
						}
					: primaryButton.umamiEvent
						? { 'data-umami-event': primaryButton.umamiEvent }
						: {})}
				{...(primaryButton.leadSource ? { 'data-lead-source': primaryButton.leadSource } : {})}
			>
				{primaryButton.text}
			</a>
			<a
				href={secondaryButton.href}
				class:list={[
					'inline-flex items-center justify-center rounded-lg px-6 py-3.5 font-semibold transition-colors duration-200',
					isAccentBand
						? 'rounded-xl border border-on-primary px-8 py-4 text-on-primary hover:bg-white/10'
						: 'btn-outline-accent border-2 border-primary text-foreground hover:bg-background',
				]}
				{...(secondaryIsDiagnostic
					? {
							'data-analytics-event': 'lead_click_diagnostic',
							'data-analytics-cta': 'diagnostic',
							'data-analytics-location': secondaryButton.leadSource ?? 'cta_section',
						}
					: secondaryButton.umamiEvent
						? { 'data-umami-event': secondaryButton.umamiEvent }
						: {})}
				{...(secondaryButton.leadSource ? { 'data-lead-source': secondaryButton.leadSource } : {})}
			>
				{secondaryButton.text}
			</a>
		</div>
	</div>
</section>

{isAccentBand && (
	<style>
		.cta-accent-band {
			background-color: var(--color-primary-foreground);
			background-position: center;
			background-repeat: no-repeat;
			background-size: 100% 100%;
			color: var(--color-on-primary);
		}
	</style>
)}
