---
import FormField from './FormField.astro';

const formspreeUrl = import.meta.env.PUBLIC_FORMSPREE_DIAGNOSTIC?.trim();
if (import.meta.env.PROD && !formspreeUrl) {
	throw new Error('PUBLIC_FORMSPREE_DIAGNOSTIC doit être défini (URL Formspree, ex. https://formspree.io/f/…)');
}

const redirectUrl = import.meta.env.SITE
	? new URL('/merci/diagnostic/', import.meta.env.SITE).href
	: undefined;

const startEvent = 'lead_start_diagnostic';
---

<div
	id="diagnostic-form-wrapper"
	class="bg-background rounded-lg shadow-lg border border-border p-6 md:p-8"
>
	<form
		id="diagnostic-form"
		name="diagnostic"
		method="POST"
		action={formspreeUrl}
		data-umami-event="lead_submit_diagnostic"
		data-umami-start-event={startEvent}
		data-success-url={redirectUrl}
		class="space-y-6"
	>
		<input type="hidden" name="form-name" value="diagnostic" />
		{redirectUrl && <input type="hidden" name="_next" value={redirectUrl} />}
		<input type="hidden" name="_subject" value="[nicodev.fr] Demande diagnostic gratuit" />
		<p class="hidden" aria-hidden="true">
			<label for="diagnostic-gotcha">Ne pas remplir</label>
			<input id="diagnostic-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
		</p>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<FormField id="diagnostic-firstName" name="firstName" label="Prénom *" type="text" required />
			<FormField id="diagnostic-lastName" name="lastName" label="Nom *" type="text" required />
		</div>

		<FormField id="diagnostic-email" name="email" label="Email *" type="email" required />

		<div class="space-y-2">
			<div class="flex items-start gap-3">
				<input
					id="diagnostic-certifiedPsychologist"
					name="certifiedPsychologist"
					type="checkbox"
					value="yes"
					required
					class="mt-1 h-4 w-4 rounded border-border text-primary-foreground focus:ring-primary"
				/>
				<label for="diagnostic-certifiedPsychologist" class="text-sm font-medium leading-6 text-foreground">
					Je certifie être psychologue *
				</label>
			</div>
		</div>
		<FormField id="diagnostic-city" name="city" label="Ville (ou zone) *" required placeholder="Paris 15, Sceaux, ... " />

		<FormField id="diagnostic-website" name="website" label="Site internet (si vous en avez un)" type="text" placeholder="https://votre-site.fr" />

		<FormField
			id="diagnostic-visibilityStatus"
			name="visibilityStatus"
			label="Votre situation actuelle (visibilité) *"
			required
			variant="select"
		>
			<option value="">Sélectionnez votre situation</option>
			<option value="site-peu-visibilite">J'ai un site mais il ne génère pas assez de demandes</option>
			<option value="pas-de-site">Je n'ai pas de site (ou il est très ancien)</option>
			<option value="plateformes-seules">Je dépends surtout des plateformes/annuaires (Doctolib, ...)</option>
			<option value="je-ne-sais-pas">Je ne sais pas encore</option>
		</FormField>

		<FormField id="diagnostic-mainObjective" name="mainObjective" label="Votre objectif principal *" required variant="select">
			<option value="">Sélectionnez votre objectif</option>
			<option value="google-local">Être plus visible sur Google local</option>
			<option value="confiance-contenu">Rassurer davantage (contenu + pages claires)</option>
			<option value="mobile-vitesse">Avoir un site mobile rapide et agréable</option>
			<option value="je-ne-sais-pas">Je ne sais pas encore</option>
		</FormField>

		<FormField
			id="diagnostic-message"
			name="message"
			label="Votre contexte (quelques mots)"
			variant="textarea"
			placeholder="Votre message si vous souhaitez me préciser quelque chose"
			rows={6}
		/>

		<button
			type="submit"
			class="btn-primary-solid w-full rounded-lg px-5 py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
		>
			Demander un diagnostic gratuit
		</button>
		<p id="diagnostic-form-feedback" class="hidden text-sm text-red-700" role="alert" aria-live="polite"></p>
		<p class="text-center text-xs text-muted">
			Sans engagement. Vous recevez un retour concret avec priorités d'action.
		</p>
	</form>
</div>

<script is:inline>
	(() => {
		const form = document.getElementById('diagnostic-form');
		if (!form) return;
		const startEvent = form.getAttribute('data-umami-start-event');
		const submitEvent = form.getAttribute('data-umami-event');
		const successUrl = form.getAttribute('data-success-url');
		const feedback = document.getElementById('diagnostic-form-feedback');
		const submitButton = form.querySelector('button[type="submit"]');

		let started = false;
		const trackStart = () => {
			if (started) return;
			started = true;
			if (startEvent && window.umami && typeof window.umami.track === 'function') {
				window.umami.track(startEvent);
			}
		};

		form.addEventListener('focusin', trackStart, { once: true });
		form.addEventListener('change', trackStart, { once: true });
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (feedback) {
				feedback.textContent = '';
				feedback.classList.add('hidden');
			}
			if (submitButton) submitButton.setAttribute('disabled', 'disabled');
			if (submitEvent && window.umami && typeof window.umami.track === 'function') {
				window.umami.track(submitEvent);
			}

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: {
						Accept: 'application/json'
					}
				});

				if (!response.ok) {
					throw new Error('Submission failed');
				}

				if (successUrl) {
					window.location.href = successUrl;
					return;
				}

				form.reset();
			} catch (_) {
				if (feedback) {
					feedback.textContent = "Une erreur est survenue. Merci de reessayer dans un instant.";
					feedback.classList.remove('hidden');
				}
			} finally {
				if (submitButton) submitButton.removeAttribute('disabled');
			}
		});
	})();
</script>

