---
import ContactWhatsAppOption from './ContactWhatsAppOption.astro';
import FormField from './FormField.astro';

const formspreeUrl = import.meta.env.PUBLIC_FORMSPREE_DIAGNOSTIC?.trim();
// Preview CF (branches / PR) n’a souvent pas les secrets Production.
const isCloudflareProduction =
	process.env.CF_PAGES === '1' &&
	(process.env.CF_PAGES_BRANCH === 'main' || process.env.CF_PAGES_BRANCH === 'master');
if (import.meta.env.PROD && isCloudflareProduction && !formspreeUrl) {
	throw new Error(
		'Build Cloudflare Pages interrompu : PUBLIC_FORMSPREE_DIAGNOSTIC manquant. ' +
			'Ajoutez l’URL Formspree (ex. https://formspree.io/f/…) dans Cloudflare Pages → Settings → Environment variables (Production).',
	);
}

const redirectUrl = new URL('/merci/diagnostic/', Astro.url.origin).href;

const startEvent = 'lead_start_diagnostic';
---

<div
	id="diagnostic-form-wrapper"
	class="bg-background rounded-lg shadow-lg border border-border p-6 md:p-8"
>
	<div class="mb-6">
		<ContactWhatsAppOption variant="button" umamiEvent="lead_click_whatsapp_from_diagnostic" />
	</div>
	<form
		id="diagnostic-form"
		name="diagnostic"
		method="POST"
		action={formspreeUrl}
		data-submit-event="lead_submit_diagnostic"
		data-umami-start-event={startEvent}
		data-success-url={redirectUrl}
		data-form-configured={Boolean(formspreeUrl).toString()}
		class="space-y-6"
	>
		<input type="hidden" name="form-name" value="diagnostic" />
		{redirectUrl && <input type="hidden" name="_next" value={redirectUrl} />}
		<input type="hidden" name="_subject" value="[nicodev.fr] Demande diagnostic gratuit" />
		<input type="hidden" name="sourcePage" value="" data-source-page-input />
		<input type="hidden" name="sourceParam" value="" data-source-param-input />
		<p class="hidden" aria-hidden="true">
			<label for="diagnostic-gotcha">Ne pas remplir</label>
			<input id="diagnostic-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
		</p>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<FormField id="diagnostic-firstName" name="firstName" label="Prénom *" type="text" autocomplete="given-name" required />
			<FormField id="diagnostic-lastName" name="lastName" label="Nom *" type="text" autocomplete="family-name" required />
		</div>

		<FormField id="diagnostic-email" name="email" label="Email *" type="email" autocomplete="email" required />

		<FormField id="diagnostic-profession" name="profession" label="Votre profession *" required variant="select">
			<option value="">Sélectionnez votre profession</option>
			<option value="psychologue">Psychologue</option>
			<option value="psychotherapeute">Psychothérapeute (titre + RPPS)</option>
			<option value="psychomotricien">Psychomotricien</option>
		</FormField>
		<FormField id="diagnostic-city" name="city" label="Ville (ou zone) *" autocomplete="address-level2" required placeholder="Paris 15, Sceaux, ... " />

		<FormField id="diagnostic-website" name="website" label="Site internet (si vous en avez un, ou une URL en projet)" type="text" placeholder="https://votre-site.fr — laissez vide si pas encore de site" />

		<FormField
			id="diagnostic-visibilityStatus"
			name="visibilityStatus"
			label="Votre situation actuelle (visibilité) *"
			required
			variant="select"
		>
			<option value="">Sélectionnez votre situation</option>
			<option value="pas-de-site">Je n'ai pas encore de site (installation ou réflexion)</option>
			<option value="plateformes-seules">J'ai surtout une fiche Google et/ou Doctolib, sans site dédié</option>
			<option value="site-peu-visibilite">J'ai un site mais il ne génère pas assez de demandes</option>
			<option value="je-ne-sais-pas">Je ne sais pas encore</option>
		</FormField>

		<FormField id="diagnostic-mainObjective" name="mainObjective" label="Votre objectif principal *" required variant="select">
			<option value="">Sélectionnez votre objectif</option>
			<option value="preparer-installation">Préparer mon installation / ouverture de cabinet</option>
			<option value="google-local">Être plus visible sur Google local</option>
			<option value="confiance-contenu">Rassurer davantage (contenu + pages claires)</option>
			<option value="mobile-vitesse">Avoir un site mobile rapide et agréable</option>
			<option value="je-ne-sais-pas">Je ne sais pas encore</option>
		</FormField>

		<FormField
			id="diagnostic-message"
			name="message"
			label="Votre contexte (quelques mots)"
			variant="textarea"
			placeholder="Votre message si vous souhaitez me préciser quelque chose"
			rows={6}
		/>

		<button
			type="submit"
			class="btn-primary-solid relative inline-flex w-full min-h-12 items-center justify-center gap-2 rounded-lg px-5 py-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:pointer-events-none disabled:opacity-85"
		>
			<svg class="diagnostic-submit-spinner hidden h-5 w-5 shrink-0 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
				<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.4 0 0 5.4 0 12h4zm2 5.3A8 8 0 014 12H0c0 3 1.1 5.8 3 7.9l3-2.6z"></path>
			</svg>
			<span data-diagnostic-submit-text>Demander un diagnostic gratuit</span>
		</button>
		<p id="diagnostic-form-feedback" class="hidden text-sm font-medium text-red-700" role="alert" aria-live="polite" tabindex="-1"></p>
		<p class="text-center text-xs text-muted">
			Sans engagement. Vous recevez un retour concret avec priorités d'action.
		</p>
	</form>
</div>

<script is:inline>
	(() => {
		const form = document.getElementById('diagnostic-form');
		if (!form) return;
		const startEvent = form.getAttribute('data-umami-start-event');
		const submitEvent = form.getAttribute('data-submit-event');
		const successUrl = form.getAttribute('data-success-url');
		const formConfigured = form.getAttribute('data-form-configured') === 'true';
		const feedback = document.getElementById('diagnostic-form-feedback');
		const submitButton = form.querySelector('button[type="submit"]');
		const submitLabel = submitButton?.querySelector('[data-diagnostic-submit-text]');
		const submitSpinner = submitButton?.querySelector('.diagnostic-submit-spinner');
		const defaultSubmitLabel = submitLabel?.textContent?.trim() || '';
		const sourcePageInput = form.querySelector('[data-source-page-input]');
		const sourceParamInput = form.querySelector('[data-source-param-input]');

		if (sourcePageInput instanceof HTMLInputElement) sourcePageInput.value = window.location.pathname;
		if (sourceParamInput instanceof HTMLInputElement) {
			const urlSource = new URLSearchParams(window.location.search).get('source');
			let storedSource = '';
			try {
				storedSource = window.sessionStorage.getItem('nicodevLeadSource') || '';
			} catch (_) {
				storedSource = '';
			}
			const source = urlSource || storedSource;
			sourceParamInput.value = /^[a-z0-9_-]{1,80}$/i.test(source) ? source : '';
		}

		let started = false;
		const trackStart = () => {
			if (started) return;
			started = true;
			if (startEvent === 'lead_start_diagnostic') {
				window.nicodevAnalytics?.track(startEvent, { form: 'diagnostic' }, 'form-start:diagnostic');
			}
		};

		form.addEventListener('input', trackStart, { once: true });
		form.addEventListener('change', trackStart, { once: true });
		let inFlight = false;
		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (inFlight) return;
			if (feedback) {
				feedback.textContent = '';
				feedback.classList.add('hidden');
			}
			if (!formConfigured) {
				if (feedback) {
					feedback.textContent = "Le formulaire est temporairement indisponible. Vous pouvez me contacter par WhatsApp.";
					feedback.classList.remove('hidden');
					feedback.focus();
				}
				return;
			}
			inFlight = true;
			if (submitButton) {
				submitButton.setAttribute('disabled', 'disabled');
				submitButton.setAttribute('aria-busy', 'true');
			}
			if (submitSpinner) submitSpinner.classList.remove('hidden');
			if (submitLabel) submitLabel.textContent = 'Envoi en cours…';

			let redirecting = false;
			try {
				const response = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: {
						Accept: 'application/json'
					}
				});

				if (!response.ok) {
					throw new Error('Submission failed');
				}
				if (submitEvent === 'lead_submit_diagnostic') {
					window.nicodevAnalytics?.track(submitEvent, { form: 'diagnostic' }, 'form-submit:diagnostic');
				}

				if (successUrl) {
					redirecting = true;
					window.location.href = successUrl;
					return;
				}

				form.reset();
			} catch (_) {
				if (feedback) {
					feedback.textContent = "L’envoi n’a pas abouti. Vos informations sont conservées : vérifiez votre connexion puis réessayez.";
					feedback.classList.remove('hidden');
					feedback.focus();
				}
			} finally {
				if (!redirecting) {
					inFlight = false;
					if (submitButton) {
						submitButton.removeAttribute('disabled');
						submitButton.removeAttribute('aria-busy');
					}
					if (submitSpinner) submitSpinner.classList.add('hidden');
					if (submitLabel && defaultSubmitLabel) submitLabel.textContent = defaultSubmitLabel;
				}
			}
		});
	})();
</script>
