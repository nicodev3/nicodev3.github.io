---
import FormField from './FormField.astro';
---

<div
	id="diagnostic-form-wrapper"
	class="bg-background rounded-2xl shadow-lg border border-border p-6 md:p-8"
>
	<form
		id="diagnostic-form"
		name="diagnostic"
		method="POST"
		action="/merci"
		data-netlify="true"
		netlify-honeypot="bot-field"
		data-umami-event="diagnostic_form_submit"
		class="space-y-6"
	>
		<input type="hidden" name="form-name" value="diagnostic" />
		<p class="hidden" aria-hidden="true">
			<label for="diagnostic-bot-field">Ne pas remplir</label>
			<input id="diagnostic-bot-field" name="bot-field" type="text" tabindex="-1" autocomplete="off" />
		</p>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			<FormField id="firstName" name="firstName" label="Prénom *" type="text" required />
			<FormField id="lastName" name="lastName" label="Nom *" type="text" required />
		</div>

		<FormField id="email" name="email" label="Email *" type="email" required />

		<FormField id="profession" name="profession" label="Votre profession *" required variant="select">
			<option value="">Sélectionnez votre profession</option>
			<option value="psychologue">Psychologue</option>
		</FormField>

		<FormField id="city" name="city" label="Ville (ou zone) *" required placeholder="Paris 15, Sceaux, ... " />

		<FormField id="website" name="website" label="Site internet (si vous en avez un)" type="text" placeholder="https://votre-site.fr" />

		<FormField
			id="visibilityStatus"
			name="visibilityStatus"
			label="Votre situation actuelle (visibilité) *"
			required
			variant="select"
		>
			<option value="">Sélectionnez votre situation</option>
			<option value="site-peu-visibilite">J'ai un site mais il ne génère pas assez de demandes</option>
			<option value="pas-de-site">Je n'ai pas de site (ou il est très ancien)</option>
			<option value="plateformes-seules">Je dépends surtout des plateformes/annuaires (Doctolib, ...)</option>
			<option value="je-ne-sais-pas">Je ne sais pas encore</option>
		</FormField>

		<FormField id="mainObjective" name="mainObjective" label="Votre objectif principal *" required variant="select">
			<option value="">Sélectionnez votre objectif</option>
			<option value="google-local">Être plus visible sur Google local</option>
			<option value="confiance-contenu">Rassurer davantage (contenu + pages claires)</option>
			<option value="mobile-vitesse">Avoir un site mobile rapide et agréable</option>
			<option value="je-ne-sais-pas">Je ne sais pas encore</option>
		</FormField>

		<FormField
			id="message"
			name="message"
			label="Votre contexte (quelques mots) *"
			required
			variant="textarea"
			placeholder="Type de pratique, délai souhaité, éléments déjà disponibles (si vous en avez), et ce que vous attendez des demandes de contact."
			rows={6}
		/>

		<button
			type="submit"
			class="w-full bg-primary-foreground text-on-primary py-3 px-6 rounded-lg font-semibold hover:opacity-90 transition-colors"
		>
			Demander mon diagnostic gratuit
		</button>
	</form>
</div>

