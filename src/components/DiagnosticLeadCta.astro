---
type DiagnosticLeadCtaVariant =
	| 'guide-visibilite-intro'
	| 'guide-visibilite-final'
	| 'installation-intro'
	| 'installation-mid'
	| 'installation-final'
	| 'salaire-intro'
	| 'salaire-final'
	| 'mentions-legales'
	| 'visibilite-tool';

interface Props {
	variant: DiagnosticLeadCtaVariant;
	class?: string;
	hidden?: boolean;
	id?: string;
}

const { variant, class: className, hidden = false, id } = Astro.props;

const copies: Record<
	DiagnosticLeadCtaVariant,
	{
		eyebrow: string;
		title: string;
		description: string;
		primary: string;
		source: string;
		href: string;
	}
> = {
	'guide-visibilite-intro': {
		eyebrow: 'Vous voulez un plan pour votre cabinet ?',
		title: 'Je peux regarder votre situation et vous dire quoi prioriser.',
		description:
			'Quatre questions, retour sous 48 h : site ou projet, fiche Google, et les prochaines actions utiles.',
		primary: 'Demander un diagnostic gratuit',
		source: 'guide-visibilite-intro',
		href: '/diagnostic-gratuit/',
	},
	'guide-visibilite-final': {
		eyebrow: 'Vous avez la carte, passons à votre cas',
		title: 'Un diagnostic court pour savoir par où commencer.',
		description:
			'Pas un audit de plusieurs heures : un premier retour concret, avec ou sans site.',
		primary: 'Demander un diagnostic gratuit',
		source: 'guide-visibilite-final',
		href: '/diagnostic-gratuit/',
	},
	'installation-intro': {
		eyebrow: 'Vous préparez votre installation ?',
		title: 'Faites le point sur votre visibilité, même sans site.',
		description:
			'Fiche Google, Doctolib, cohérence des infos : je vous dis quoi traiter en premier.',
		primary: 'Demander un diagnostic gratuit',
		source: 'guide-installation-intro',
		href: '/diagnostic-gratuit/',
	},
	'installation-mid': {
		eyebrow: 'Étape visibilité',
		title: 'Pas encore de site ? Vérifions comment vous apparaissez en ligne.',
		description:
			'Quatre questions suffisent pour savoir si Google, une plateforme ou un site est le bon levier maintenant.',
		primary: 'Demander un diagnostic gratuit',
		source: 'guide-installation-mid',
		href: '/diagnostic-gratuit/',
	},
	'installation-final': {
		eyebrow: 'Le site professionnel',
		title: 'Avant de vous engager, un regard sur votre visibilité.',
		description:
			'Je vous indique si un site est pertinent maintenant, ou si une fiche Google bien tenue suffit.',
		primary: 'Demander un diagnostic gratuit',
		source: 'guide-installation-final',
		href: '/diagnostic-gratuit/',
	},
	'salaire-intro': {
		eyebrow: 'Passer des fourchettes à votre cas',
		title: 'Combien de séances pour que le cabinet tienne ?',
		description:
			'L’outil calcule un seuil à partir de votre tarif, de vos charges et du rythme que vous visez.',
		primary: 'Calculer le seuil de viabilité',
		source: 'article-salaire-intro',
		href: '/outils/seuil-viabilite-seances/',
	},
	'salaire-final': {
		eyebrow: 'Après les chiffres',
		title: 'Estimez le nombre de séances qu’il vous faut.',
		description:
			'Même logique que les fourchettes de cette page, appliquée à votre tarif et à vos charges.',
		primary: 'Calculer le seuil de viabilité',
		source: 'article-salaire-final',
		href: '/outils/seuil-viabilite-seances/',
	},
	'mentions-legales': {
		eyebrow: 'Prochaine étape',
		title: 'Ces mentions iront sur votre site. Avez-vous le reste en place ?',
		description:
			'Quatre questions pour un bilan rapide de votre visibilité cabinet.',
		primary: 'Demander un diagnostic gratuit',
		source: 'outil-mentions-legales',
		href: '/diagnostic-gratuit/',
	},
	'visibilite-tool': {
		eyebrow: 'Aller plus loin',
		title: 'Un regard personnalisé sur votre cabinet',
		description:
			'Ce questionnaire donne des pistes générales. Le diagnostic applique la même logique à votre cas.',
		primary: 'Demander un diagnostic gratuit',
		source: 'outil-visibilite-web',
		href: '/diagnostic-gratuit/',
	},
};

const copy = copies[variant];
const sourceEvent = copy.source.replaceAll('-', '_');
---

<aside
	id={id}
	class:list={[
		'not-prose rounded-xl border border-primary/25 bg-primary-50 p-5 shadow-sm sm:p-6',
		className,
		hidden && 'hidden',
	]}
	aria-label={copy.eyebrow}
>
	<p class="type-eyebrow text-primary-700">{copy.eyebrow}</p>
	<h2 class="mt-3 font-heading text-2xl font-semibold leading-tight text-foreground sm:text-3xl">
		{copy.title}
	</h2>
	<p class="mt-3 max-w-3xl text-base leading-relaxed text-muted">
		{copy.description}
	</p>
	<div class="mt-5">
		<a
			href={copy.href}
			class="btn-primary-solid inline-flex items-center justify-center rounded-lg px-5 py-3 font-semibold"
			data-lead-source={copy.source}
			data-analytics-event={copy.href === '/diagnostic-gratuit/' ? 'lead_click_diagnostic' : undefined}
			data-analytics-cta={copy.href === '/diagnostic-gratuit/' ? 'diagnostic' : undefined}
			data-analytics-location={sourceEvent}
		>
			{copy.primary}
		</a>
		{copy.href === '/diagnostic-gratuit/' && (
			<p class="mt-2 text-xs text-muted">Moins de 2 minutes. Sans engagement.</p>
		)}
	</div>
</aside>
