---
export interface Props {
	variant?: 'default' | 'stitch';
}

const { variant = 'default' } = Astro.props;
const isStitch = variant === 'stitch';

const stitchComparisonRows = [
	{
		label: 'Outil & temps',
		diy: 'Souvent chronophage. Nécessite un investissement régulier.',
		nicodev: 'Je prends le relais pour déléguer la technique et le cadrage.',
	},
	{
		label: 'Visibilité locale',
		diy: 'Référencement local rarement optimisé.',
		nicodev: 'Site optimisé pour (psychologue + ville + spécialités).',
	},
	{
		label: 'Sécurité',
		diy: 'Maintenance et mises à jour à gérer soi-même.',
		nicodev: 'Hébergement, domaine et sécurité 100% gérés.',
	},
	{
		label: 'Qualité',
		diy: "Erreurs fréquentes de design et d'accessibilité.",
		nicodev: 'Structure sobre et bonnes pratiques dès la conception.',
	},
] as const;

const comparisonRows = [
	{
		label: "Outil & temps",
		diyBalance: "nuanced" as const,
		diy: "Souvent chronophage au début. Si vous avez déjà l'habitude de WordPress (ou équivalent) et du temps à investir régulièrement, faire soi-même peut tout à fait suffire.",
		nicodev:
			"Je prends le relais quand vous voulez déléguer la technique et le cadrage — sans présenter l'autonomie comme un mauvais choix."
	},
	{
		label: "Rédaction & ton",
		diyBalance: "nuanced" as const,
		diy: "Si vous aimez écrire, que vous relisez et faites valider par un pair, des textes sérieux en autonomie sont possibles. Le piège fréquent reste un ton trop commercial ou trop vague.",
		nicodev:
			"Contenus structurés pour vos patients à partir de réponses simples à un formulaire guidé — utile quand vous voulez gagner du temps ou un regard confrère."
	},
	{
		label: "Visibilité locale",
		diy: "Référencement local rarement optimisé (psychologue + ville + spécialités)",
		nicodev: "Site optimisé pour votre visibilité locale (psychologue + ville + spécialités)"
	},
	{
		label: "Technique & sécurité",
		diy: "Maintenance, mises à jour et sécurité à gérer soi-même",
		nicodev:
			"Aucune gestion technique : hébergement, nom de domaine, sécurité et mises à jour pris en charge"
	},
	{
		label: "Qualité & cohérence",
		diy: "Erreurs fréquentes de design et de contenu, d'accessibilité et de référencement naturel",
		nicodev:
			"Structure, sobriété et bonnes pratiques intégrées dès la conception — pas une chaîne de gadgets à empiler seul."
	},
	{
		label: "Dans la durée",
		diy: "Résultat correct visuellement, mais sans garantie que le site vous apporte des demandes",
		nicodev:
			"Suivi dans la durée via l'abonnement, pour un site qui reste à jour et continue de fonctionner"
	}
] as const;

const iconCross =
	"M6 18 18 6M6 6l12 12";
const iconCheck =
	"m4.5 12.75l6 6l9-13.5";
---

<section id="accueil-differentiation" class="section-y scroll-mt-28 border-b border-border bg-white">
	<div class="shell-layout">
		<header class="shell-prose mx-auto mb-10 text-center md:mb-16">
			<h2 class="mb-4 font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				Faire seul vs. nicodev.fr
			</h2>
			<p class="text-lg text-muted">
				Le problème n’est pas d’avoir un site, mais d’avoir un site qui vous aide à être visible et à
				informer vos futurs patients.
			</p>
		</header>

		{
			isStitch ? (
				<div class="overflow-x-auto rounded-xl border border-border bg-white">
					<table class="w-full min-w-[36rem] border-collapse text-left">
						<caption class="sr-only">
							Comparaison entre créer son site en autonomie et être accompagné par nicodev.fr
						</caption>
						<thead class="border-b border-border bg-surface-alt">
							<tr>
								<th scope="col" class="type-label-mono w-1/4 p-6 text-foreground">Critère</th>
								<th scope="col" class="type-label-mono w-1/3 p-6 text-foreground">
									En autonomie (Wix, WP…)
								</th>
								<th scope="col" class="type-label-mono w-1/3 p-6 text-primary-500">Avec nicodev.fr</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							{stitchComparisonRows.map((row) => (
								<tr>
									<th scope="row" class="p-6 font-semibold text-foreground">
										{row.label}
									</th>
									<td class="p-6 text-base text-muted">{row.diy}</td>
									<td class="p-6 text-base font-medium text-foreground">{row.nicodev}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			) : (
				<div class="w-full overflow-hidden rounded-lg border border-border bg-surface shadow-sm">
			<div class="border-b border-border bg-[color-mix(in_srgb,var(--color-foreground)_4%,var(--color-surface))] px-4 py-3 sm:px-5">
				<p class="type-eyebrow text-muted">Comparaison rapide</p>
				<p class="mt-1 font-heading text-lg font-semibold text-foreground">Faire seul vs. nicodev</p>
			</div>
			<div class="hidden w-full overflow-x-auto md:block">
				<table class="diy-compare-table w-full min-w-0 table-fixed text-left text-base">
					<caption class="sr-only">
						Comparaison entre créer son site en autonomie avec un outil grand public et être accompagné par
						nicodev.fr : limites fréquentes, cas où l’autonomie peut suffire, et apports ligne par ligne.
					</caption>
					<thead>
						<tr>
							<th scope="col" class="diy-compare-th diy-compare-th--muted">Critère</th>
							<th scope="col" class="diy-compare-th diy-compare-th--diy">
								<span class="diy-compare-th__eyebrow">En autonomie</span>
								<span class="diy-compare-th__sub">Wix, WordPress, Hostinger…</span>
							</th>
							<th scope="col" class="diy-compare-th diy-compare-th--nico">
								<span class="diy-compare-th__eyebrow">Avec nicodev.fr</span>
								<span class="diy-compare-th__sub diy-compare-th__sub--accent">Sites pour psychologues</span>
							</th>
						</tr>
					</thead>
					<tbody>
						{comparisonRows.map((row) => (
							<tr class="diy-compare-tr">
								<th scope="row" class="diy-compare-rowlabel">
									{row.label}
								</th>
								<td class="diy-compare-td diy-compare-td--diy" data-col="En autonomie">
									<span class="diy-compare-cell">
										<span
											class:list={[
												'diy-compare-icon',
												'diyBalance' in row && row.diyBalance === 'nuanced'
													? 'diy-compare-icon--nuanced'
													: 'diy-compare-icon--bad',
											]}
											aria-hidden="true"
										>
											<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												{
													'diyBalance' in row && row.diyBalance === 'nuanced' ? (
														<path
															stroke-linecap="round"
															stroke-linejoin="round"
															stroke-width="1.5"
															d={iconCheck}
														/>
													) : (
														<path
															stroke-linecap="round"
															stroke-linejoin="round"
															stroke-width="1.5"
															d={iconCross}
														/>
													)
												}
											</svg>
										</span>
										<span class="text-muted">{row.diy}</span>
									</span>
								</td>
								<td class="diy-compare-td diy-compare-td--nico" data-col="Avec nicodev.fr">
									<span class="diy-compare-cell">
										<span class="diy-compare-icon diy-compare-icon--good" aria-hidden="true">
											<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="1.5"
													d={iconCheck}
												/>
											</svg>
										</span>
										<span class="text-muted">{row.nicodev}</span>
									</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
			<div class="space-y-5 p-4 md:hidden">
				{comparisonRows.map((row) => (
					<article class="border-b border-border/70 pb-4 last:border-b-0 last:pb-0">
						<h3 class="px-1 pb-2 font-heading text-lg font-semibold leading-snug text-foreground">
							{row.label}
						</h3>
						<div class="space-y-2.5">
							<div class="rounded-lg bg-[color-mix(in_srgb,var(--color-primary-500)_9%,var(--color-surface))] p-3">
								<p class="diy-compare-th__eyebrow mb-1.5">En autonomie</p>
								<p class="diy-compare-th__sub mb-2">Wix, WordPress, Hostinger…</p>
								<span class="diy-compare-cell">
									<span
										class:list={[
											'diy-compare-icon',
											'diyBalance' in row && row.diyBalance === 'nuanced'
												? 'diy-compare-icon--nuanced'
												: 'diy-compare-icon--bad',
										]}
										aria-hidden="true"
									>
										<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											{
												'diyBalance' in row && row.diyBalance === 'nuanced' ? (
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="1.5"
														d={iconCheck}
													/>
												) : (
													<path
														stroke-linecap="round"
														stroke-linejoin="round"
														stroke-width="1.5"
														d={iconCross}
													/>
												)
											}
										</svg>
									</span>
									<span class="text-muted">{row.diy}</span>
								</span>
							</div>
							<div class="rounded-lg bg-[color-mix(in_srgb,var(--color-foreground)_6%,var(--color-surface))] p-3">
								<p class="diy-compare-th__eyebrow mb-1.5">Avec nicodev.fr</p>
								<p class="diy-compare-th__sub diy-compare-th__sub--accent mb-2">Sites pour psychologues</p>
								<span class="diy-compare-cell">
									<span class="diy-compare-icon diy-compare-icon--good" aria-hidden="true">
										<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="1.5"
												d={iconCheck}
											/>
										</svg>
									</span>
									<span class="text-muted">{row.nicodev}</span>
								</span>
							</div>
						</div>
					</article>
				))}
			</div>
		</div>
			)
		}

		{
			!isStitch && (
				<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm text-muted max-w-2xl">
				Un abonnement peut sembler plus cher qu’un hébergement low cost. Mais si le site ne génère pas de
				demandes, le vrai coût est le temps perdu et les patients qui ne vous trouvent jamais.
			</p>
			<a
				href="/diagnostic-gratuit/"
				data-suppress-header-diagnostic-when-visible
				class="btn-primary-solid inline-flex items-center justify-center whitespace-nowrap rounded-lg px-5 py-3"
			>
				Demander un diagnostic gratuit
			</a>
				</div>
			)
		}
	</div>
</section>

<style>
	.diy-compare-table {
		border-collapse: collapse;
	}

	.diy-compare-th,
	.diy-compare-rowlabel,
	.diy-compare-td {
		padding: 0.85rem 1rem;
		vertical-align: top;
		border-bottom: 1px solid var(--color-border);
		overflow-wrap: anywhere;
	}

	.diy-compare-th {
		font-size: var(--text-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-muted);
	}

	.diy-compare-th--diy,
	.diy-compare-th--nico {
		font-size: unset;
		font-weight: unset;
		text-transform: none;
		letter-spacing: normal;
		color: unset;
	}

	/* Hiérarchie type Apple / Stripe : micro eyebrow + sous-titre lisible */
	.diy-compare-th__eyebrow {
		display: block;
		font-family: var(--font-sans);
		font-size: 0.6875rem;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
	}

	.diy-compare-th__sub {
		display: block;
		margin-top: 0.3125rem;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 400;
		line-height: 1.38;
		color: var(--color-foreground);
	}

	.diy-compare-th__sub--accent {
		font-weight: 500;
		color: var(--color-primary-foreground);
	}

	.diy-compare-th--diy {
		width: 39%;
		background: color-mix(in srgb, var(--color-primary-500) 11%, var(--color-surface));
	}

	.diy-compare-th--nico {
		width: 39%;
		background: color-mix(in srgb, var(--color-foreground) 6%, var(--color-surface));
	}

	.diy-compare-th--muted {
		width: 22%;
		min-width: 6.5rem;
	}

	.diy-compare-tr:last-child .diy-compare-rowlabel,
	.diy-compare-tr:last-child .diy-compare-td {
		border-bottom: none;
	}

	.diy-compare-rowlabel {
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-weight: 600;
		color: var(--color-foreground);
		line-height: 1.35;
		background: color-mix(in srgb, var(--color-foreground) 3%, var(--color-surface));
	}

	.diy-compare-td--diy {
		background: color-mix(in srgb, var(--color-primary-500) 8.5%, var(--color-surface));
	}

	.diy-compare-td--nico {
		background: color-mix(in srgb, var(--color-foreground) 6%, var(--color-surface));
	}

	.diy-compare-cell {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
	}

	.diy-compare-icon {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 1.625rem;
		height: 1.625rem;
		margin-top: 0.06rem;
		border-radius: var(--radius-full);
	}

	.diy-compare-icon--bad {
		color: var(--color-primary-700);
		background: color-mix(in srgb, var(--color-primary-100) 72%, transparent);
	}

	/* Autonomie possible sous conditions — pas une « case rouge », crédibilité du tableau */
	.diy-compare-icon--nuanced {
		color: color-mix(in srgb, var(--color-primary-900) 88%, var(--color-foreground) 12%);
		background: color-mix(in srgb, var(--color-primary-100) 55%, var(--color-surface) 45%);
		border: 1px solid color-mix(in srgb, var(--color-primary-300) 35%, transparent);
	}

	.diy-compare-icon--good {
		color: var(--color-foreground);
		background: color-mix(in srgb, var(--color-foreground) 14%, transparent);
	}

</style>
