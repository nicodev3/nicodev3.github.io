---
const comparisonRows = [
	{
		label: 'Outil & temps',
		diy: 'Souvent chronophage. Nécessite un investissement régulier.',
		nicodev: 'Je prends le relais pour déléguer la technique et le cadrage.',
	},
	{
		label: 'Visibilité locale',
		diy: 'Référencement local rarement optimisé.',
		nicodev: 'Site optimisé pour (psychologue + ville + spécialités).',
	},
	{
		label: 'Sécurité',
		diy: 'Maintenance et mises à jour à gérer soi-même.',
		nicodev: 'Hébergement, domaine et sécurité 100% gérés.',
	},
	{
		label: 'Qualité',
		diy: "Erreurs fréquentes de design et d'accessibilité.",
		nicodev: 'Structure sobre et bonnes pratiques dès la conception.',
	},
] as const;
---

<section id="accueil-differentiation" class="section-y scroll-mt-28 border-b border-border bg-white">
	<div class="shell-layout">
		<header class="shell-prose mx-auto mb-10 text-center md:mb-16">
			<h2 class="mb-4 font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				Faire seul vs. nicodev.fr
			</h2>
			<p class="text-lg text-muted">
				Le problème n’est pas d’avoir un site, mais d’avoir un site qui vous aide à être visible et à
				informer vos futurs patients.
			</p>
		</header>

		<div class="overflow-x-auto rounded-xl border border-border bg-white">
			<table class="w-full min-w-[36rem] border-collapse text-left">
				<caption class="sr-only">
					Comparaison entre créer son site en autonomie et être accompagné par nicodev.fr
				</caption>
				<thead class="border-b border-border bg-surface-alt">
					<tr>
						<th scope="col" class="type-label-mono w-1/4 p-6 text-foreground">Critère</th>
						<th scope="col" class="type-label-mono w-1/3 p-6 text-foreground">
							En autonomie (Wix, WP…)
						</th>
						<th scope="col" class="type-label-mono w-1/3 p-6 text-primary-500">Avec nicodev.fr</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border">
					{comparisonRows.map((row) => (
						<tr>
							<th scope="row" class="p-6 font-semibold text-foreground">
								{row.label}
							</th>
							<td class="p-6 text-base text-muted">{row.diy}</td>
							<td class="p-6 text-base font-medium text-foreground">{row.nicodev}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</section>
