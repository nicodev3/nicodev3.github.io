---
const comparisonRows = [
	{
		label: "Outil & temps",
		diy: "Beaucoup de temps passé à comprendre l'outil (Wix, WordPress, Hostinger...)",
		nicodev:
			"Accompagnement pensé pour les psychologues, avec une posture respectueuse de votre éthique"
	},
	{
		label: "Rédaction & ton",
		diy: "Textes à rédiger seul, avec le risque d'un ton trop commercial ou, au contraire, trop flou",
		nicodev: "Contenus structurés pour vos patients à partir de réponses simples à un formulaire guidé"
	},
	{
		label: "Visibilité locale",
		diy: "Référencement local rarement optimisé (psychologue + ville + spécialités)",
		nicodev: "Site optimisé pour votre visibilité locale (psychologue + ville + spécialités)"
	},
	{
		label: "Technique & sécurité",
		diy: "Maintenance, mises à jour et sécurité à gérer soi-même",
		nicodev:
			"Aucune gestion technique : hébergement, nom de domaine, sécurité et mises à jour pris en charge"
	},
	{
		label: "Qualité & cohérence",
		diy: "Erreurs fréquentes de design et de contenu, d'accessibilité et de référencement naturel",
		nicodev:
			"Structure, sobriété et bonnes pratiques intégrées dès la conception — pas une chaîne de gadgets à empiler seul."
	},
	{
		label: "Dans la durée",
		diy: "Résultat correct visuellement, mais sans garantie que le site vous apporte des demandes",
		nicodev:
			"Suivi dans la durée via l'abonnement, pour un site qui reste à jour et continue de fonctionner"
	}
] as const;

const iconCross =
	"M6 18 18 6M6 6l12 12";
const iconCheck =
	"m4.5 12.75l6 6l9-13.5";
---

<section class="py-16 bg-background border-b border-border">
	<div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
		<header class="max-w-3xl mb-10">
			<h2 class="text-3xl font-bold text-foreground mb-4">
				Le problème n’est pas d’avoir un site, mais d’avoir un site qui fonctionne
			</h2>
			<p class="text-lg text-muted">
				Vous pourriez créer un site vous-même avec un outil grand public. Mais pour un psychologue,
				l’enjeu n’est pas seulement d’«&nbsp;avoir un site&nbsp;»&nbsp;: c’est d’être visible, rassurant, conforme à votre
				posture professionnelle, sans y passer des heures.
			</p>
		</header>

		<div class="w-full overflow-hidden rounded-2xl border border-border bg-surface shadow-sm">
			<div class="border-b border-border bg-[color-mix(in_srgb,var(--color-foreground)_4%,var(--color-surface))] px-4 py-3 sm:px-5">
				<p class="text-sm font-medium text-muted">Comparaison rapide</p>
				<p class="font-heading text-lg font-semibold text-foreground">Faire seul vs. nicodev</p>
			</div>
			<div class="w-full overflow-x-auto">
				<table class="diy-compare-table w-full min-w-0 table-fixed text-left text-sm">
					<caption class="sr-only">
						Comparaison entre créer son site en autonomie avec un outil grand public et être accompagné par
						nicodev.fr : inconvénients et avantages ligne par ligne.
					</caption>
					<thead>
						<tr>
							<th scope="col" class="diy-compare-th diy-compare-th--muted">Critère</th>
							<th scope="col" class="diy-compare-th diy-compare-th--diy">
								<span class="block font-heading text-foreground">En autonomie</span>
								<span class="mt-0.5 block text-xs font-normal text-muted">Wix, WordPress, Hostinger…</span>
							</th>
							<th scope="col" class="diy-compare-th diy-compare-th--nico">
								<span class="block font-heading text-foreground">Avec nicodev.fr</span>
								<span class="mt-0.5 block text-xs font-normal text-primary-foreground">Sites pour psychologues</span>
							</th>
						</tr>
					</thead>
					<tbody>
						{comparisonRows.map((row) => (
							<tr class="diy-compare-tr">
								<th scope="row" class="diy-compare-rowlabel">
									{row.label}
								</th>
								<td class="diy-compare-td diy-compare-td--diy">
									<span class="diy-compare-cell">
										<span class="diy-compare-icon diy-compare-icon--bad" aria-hidden="true">
											<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="1.5"
													d={iconCross}
												/>
											</svg>
										</span>
										<span class="text-muted">{row.diy}</span>
									</span>
								</td>
								<td class="diy-compare-td diy-compare-td--nico">
									<span class="diy-compare-cell">
										<span class="diy-compare-icon diy-compare-icon--good" aria-hidden="true">
											<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="1.5"
													d={iconCheck}
												/>
											</svg>
										</span>
										<span class="text-muted">{row.nicodev}</span>
									</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>

		<div class="mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm text-muted max-w-2xl">
				Un abonnement peut sembler plus cher qu’un hébergement low cost. Mais si le site ne génère pas de
				demandes, le vrai coût est le temps perdu et les patients qui ne vous trouvent jamais.
			</p>
			<a
				href="/contact/#diagnostic"
				class="inline-flex justify-center items-center bg-primary-foreground text-on-primary px-6 py-3 rounded-lg font-semibold text-sm whitespace-nowrap hover:opacity-90 transition-colors"
			>
				Évaluer votre situation gratuitement
			</a>
		</div>
	</div>
</section>

<style>
	.diy-compare-table {
		border-collapse: collapse;
	}

	.diy-compare-th,
	.diy-compare-rowlabel,
	.diy-compare-td {
		padding: 0.85rem 1rem;
		vertical-align: top;
		border-bottom: 1px solid var(--color-border);
		overflow-wrap: anywhere;
	}

	.diy-compare-th {
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-muted);
	}

	.diy-compare-th--diy {
		width: 39%;
		background: color-mix(in srgb, #dc2626 7%, var(--color-surface));
	}

	.diy-compare-th--nico {
		width: 39%;
		background: color-mix(in srgb, #16a34a 8%, var(--color-surface));
	}

	.diy-compare-th--muted {
		width: 22%;
		min-width: 6.5rem;
	}

	.diy-compare-tr:last-child .diy-compare-rowlabel,
	.diy-compare-tr:last-child .diy-compare-td {
		border-bottom: none;
	}

	.diy-compare-rowlabel {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-foreground);
		line-height: 1.35;
		background: color-mix(in srgb, var(--color-foreground) 3%, var(--color-surface));
	}

	.diy-compare-td--diy {
		background: color-mix(in srgb, #dc2626 4.5%, var(--color-surface));
	}

	.diy-compare-td--nico {
		background: color-mix(in srgb, #16a34a 5%, var(--color-surface));
	}

	.diy-compare-cell {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
	}

	.diy-compare-icon {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 1.625rem;
		height: 1.625rem;
		margin-top: 0.06rem;
		border-radius: 9999px;
	}

	.diy-compare-icon--bad {
		color: #b91c1c;
		background: color-mix(in srgb, #fecaca 58%, transparent);
	}

	.diy-compare-icon--good {
		color: #166534;
		background: color-mix(in srgb, #bbf7d0 65%, transparent);
	}
</style>
