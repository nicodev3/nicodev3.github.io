---
import { Eye, Lock, MessagesSquare, ShieldCheck } from '@lucide/astro';

const benefits = [
	{
		Icon: ShieldCheck,
		text: 'Un langage commun avec votre métier, sans vous faire reformuler votre pratique comme un produit.',
	},
	{
		Icon: Eye,
		text: 'Une attention à ce que vos futurs patients doivent comprendre vite : cadre, publics, modalités, contact.',
	},
	{
		Icon: MessagesSquare,
		text: 'Des textes sobres, relus avec vous, sans pression commerciale ni promesse thérapeutique déplacée.',
	},
	{
		Icon: Lock,
		text: 'La technique prise en charge : hébergement, maintenance, sécurité et petites évolutions du site.',
	},
] as const;
---

<section
	id="expertise-contact"
	class="section-y scroll-mt-28 border-b border-border bg-surface-alt"
	aria-labelledby="expertise-heading"
>
	<div class="shell-layout">
		<div class="mx-auto max-w-4xl space-y-8">
			<h2
				id="expertise-heading"
				class="font-heading text-3xl font-semibold text-foreground sm:text-4xl"
			>
				Pourquoi je travaille avec psychologues, psychomotriciens, ergo et orthophonistes
			</h2>

			<div class="space-y-6">
				<p class="text-lg leading-relaxed text-muted">
					Parce qu’un site de psychologue, de psychomotricien, d’ergothérapeute ou d’orthophoniste ne se construit pas comme une vitrine ordinaire.
					Il doit informer sans forcer, rassurer sans promettre, et rester fidèle à votre manière de travailler.
				</p>
				<p class="text-lg leading-relaxed text-muted">
					Ma place est un peu particulière : je suis psychologue, psychomotricien et <a
						href="/about/#references-professionnelles"
						title="Voir mes références professionnelles et mon expérience de tech lead"
						class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary-foreground hover:decoration-primary-foreground"
						>développeur web</a
					>. Ça permet des échanges plus directs : on parle de cabinet, de cadre, de patients, mais je prends en charge
					la partie technique, de la <a
						href="/creation-site-internet-psychologue/"
						class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary-foreground hover:decoration-primary-foreground"
						>création site internet psychologue</a
					> aux bases de <a
						href="/referencement-site-psychologue/"
						class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary-foreground hover:decoration-primary-foreground"
						>référencement site psychologue</a
					>.
				</p>
			</div>

			<ul class="grid grid-cols-1 gap-x-12 gap-y-6 pt-2 md:grid-cols-2 md:pt-0">
				{
					benefits.map(({ Icon, text }) => (
						<li class="flex items-start gap-3">
							<Icon
								class="mt-1 h-5 w-5 shrink-0 text-primary-foreground"
								stroke-width={1.5}
								aria-hidden="true"
							/>
							<p class="text-base text-muted">{text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
