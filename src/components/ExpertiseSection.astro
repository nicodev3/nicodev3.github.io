---
import { Eye, Lock, MessagesSquare, ShieldCheck } from '@lucide/astro';

const benefits = [
	{
		Icon: ShieldCheck,
		text: 'Nous pouvons parler directement de votre approche, de votre cadre et de vos patients, sans traduire votre pratique en argumentaire commercial.',
	},
	{
		Icon: Eye,
		text: 'Je distingue ce qui doit être compris avant le premier contact : publics reçus, modalités, honoraires, accès et prise de rendez-vous.',
	},
	{
		Icon: MessagesSquare,
		text: 'Je structure et reformule vos textes pour le web. Vous gardez la main sur chaque mot avant la mise en ligne.',
	},
	{
		Icon: Lock,
		text: 'Je prends en charge la conception, le référencement de base, l’hébergement, la sécurité et les évolutions courantes.',
	},
] as const;
---

<section
	id="expertise-contact"
	class="section-y scroll-mt-28 border-b border-border bg-surface-alt"
	aria-labelledby="expertise-heading"
>
	<div class="shell-layout">
		<div class="mx-auto max-w-4xl space-y-8">
			<h2
				id="expertise-heading"
				class="font-heading text-3xl font-semibold text-foreground sm:text-4xl"
			>
				Je connais le cabinet. Je prends en charge le web.
			</h2>

			<div class="space-y-6">
				<p class="text-lg leading-relaxed text-muted">
					J’exerce comme psychologue en cabinet libéral et dans un service de santé pour les étudiants. Je
					connais les questions qui se posent lorsqu’il faut présenter une pratique clinique
					publiquement&nbsp;: trouver les mots justes, informer sans promettre et rester lisible pour une
					personne qui cherche de l’aide.
				</p>
				<p class="text-lg leading-relaxed text-muted">
					J’ai travaillé comme développeur puis comme responsable technique — tech lead — notamment au Figaro,
					et réalisé plus de 50 projets. Aujourd’hui, parallèlement à mon activité de psychologue, je consacre
					une partie de mon temps à la conception de sites pour mes collègues. Je prends en charge concrètement
					chaque projet, de la <a
						href="/creation-site-internet-psychologue/"
						class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary-foreground hover:decoration-primary-foreground"
						>création de votre site de psychologue</a
					>{' '}jusqu’aux bases de son <a
						href="/referencement-site-psychologue/"
						class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary-foreground hover:decoration-primary-foreground"
						>référencement local</a
					>, ainsi que sa fiabilité, ses performances et son évolution. Vous pouvez consulter le détail de mon <a
						href="/about/#references-professionnelles"
						class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary-foreground hover:decoration-primary-foreground"
						>parcours professionnel</a
					>.
				</p>
			</div>

			<ul class="grid grid-cols-1 gap-x-12 gap-y-6 pt-2 md:grid-cols-2 md:pt-0">
				{
					benefits.map(({ Icon, text }) => (
						<li class="flex items-start gap-3">
							<Icon
								class="mt-1 h-5 w-5 shrink-0 text-primary-foreground"
								stroke-width={1.5}
								aria-hidden="true"
							/>
							<p class="text-base text-muted">{text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
