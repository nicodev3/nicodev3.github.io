---
import { Eye, Lock, MessagesSquare, ShieldCheck } from '@lucide/astro';

const benefits = [
	{
		Icon: ShieldCheck,
		text: 'Ton et vocabulaire adaptés à votre pratique, sans promesses irréalistes.',
	},
	{
		Icon: Eye,
		text: 'Mise en avant claire de votre approche, de vos spécialisations et de vos modalités pratiques.',
	},
	{
		Icon: MessagesSquare,
		text: 'Pages pensées pour faciliter la prise de contact, sans pression ni discours commercial.',
	},
	{
		Icon: Lock,
		text: 'Attention portée à la confidentialité et au cadre déontologique de votre profession.',
	},
] as const;
---

<section
	id="expertise-contact"
	class="section-y scroll-mt-28 border-b border-border bg-surface-alt"
	aria-labelledby="expertise-heading"
>
	<div class="shell-layout">
		<div class="mx-auto max-w-4xl space-y-8">
			<h2
				id="expertise-heading"
				class="font-heading text-3xl font-semibold text-foreground sm:text-4xl"
			>
				J'accompagne les psychologues et professionnels du soin dans leur présence en ligne
			</h2>

			<div class="space-y-6">
				<p class="text-lg leading-relaxed text-muted">
					Je ne travaille pas comme une usine à sites : je prends peu de projets, avec attention, pour proposer des
					sites vraiment adaptés aux besoins de praticiens du soin qui veulent une présence claire, sobre et fiable.
				</p>
				<p class="text-lg leading-relaxed text-muted">
					En tant que psychologue en libéral, psychomotricien et <a
						href="/about/#references-professionnelles"
						title="Voir mes références professionnelles et mon expérience de tech lead"
						class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary-foreground hover:decoration-primary-foreground"
						>développeur web expérimenté</a
					>, je construis une présence claire, rassurante et professionnelle : je reprends, relis et ajuste chaque
					contenu avec soin pour votre pratique réelle, dans le respect de votre posture professionnelle et pour orienter vos
					futurs patients avec simplicité.
				</p>
			</div>

			<ul class="grid grid-cols-1 gap-x-12 gap-y-6 pt-2 md:grid-cols-2 md:pt-0">
				{
					benefits.map(({ Icon, text }) => (
						<li class="flex items-start gap-3">
							<Icon
								class="mt-1 h-5 w-5 shrink-0 text-primary-foreground"
								stroke-width={1.5}
								aria-hidden="true"
							/>
							<p class="text-base text-muted">{text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
