---
import { ChevronDown } from '@lucide/astro';
import { homeFaqItems } from '../data/faq-home';

export interface FaqItem {
	id?: string;
	question: string;
	answer: string;
	/** Lien de lecture complémentaire affiché sous la réponse (hors JSON-LD). */
	link?: { href: string; label: string };
}

export interface Props {
	items?: FaqItem[];
	title?: string;
	sectionId?: string;
	headingId?: string;
	background?: 'white' | 'surface';
	headingAlign?: 'left' | 'center';
	/** Lien vers la liste complète des questions, sous l’accordéon. */
	moreLink?: { href: string; label: string };
}

const {
	items = homeFaqItems,
	title = 'FAQ',
	sectionId = 'faq',
	headingId = 'faq-heading',
	background = 'white',
	headingAlign = 'left',
	moreLink,
} = Astro.props;

const sectionBgClass = background === 'surface' ? 'bg-surface' : 'bg-white';
const headingAlignClass = headingAlign === 'center' ? 'text-center' : '';
---

<section
	id={sectionId}
	class:list={['section-y scroll-mt-28 border-b border-border', sectionBgClass]}
	aria-labelledby={headingId}
>
	<div class="shell-layout">
		<h2
			id={headingId}
			class:list={[
				'mb-12 font-heading text-3xl font-semibold text-foreground sm:text-4xl',
				headingAlignClass,
			]}
		>
			{title}
		</h2>

		<div class="mx-auto max-w-3xl space-y-4">
			{items.map((item, index) => (
				<details
					{...(item.id && { id: item.id })}
					class:list={[
						'faq-details group overflow-hidden rounded-lg border border-border bg-white',
						item.id && 'scroll-mt-28',
					]}
					{...(index === 0 ? { open: true } : {})}
				>
					<summary class="faq-summary flex cursor-pointer list-none items-center justify-between gap-4 bg-[color-mix(in_srgb,var(--color-foreground)_4%,var(--color-background))] p-4 sm:p-6 transition-colors hover:bg-[color-mix(in_srgb,var(--color-foreground)_6%,var(--color-background))] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset">
						<span class="min-w-0 text-left text-base font-semibold leading-snug text-foreground sm:text-lg">
							{item.question}
						</span>
						<ChevronDown
							class="faq-chevron h-6 w-6 shrink-0 text-muted transition-transform duration-200 motion-reduce:transition-none"
							stroke-width={1.5}
							aria-hidden="true"
						/>
					</summary>
					<div class="border-t border-border p-6">
						<p class="max-w-[68ch] text-pretty text-base leading-relaxed text-muted">{item.answer}</p>
						{item.link && (
							<a
								href={item.link.href}
								class="mt-3 inline-flex min-h-11 items-center font-semibold text-primary-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
							>
								{item.link.label}
							</a>
						)}
					</div>
				</details>
			))}
			{moreLink && (
				<p class="pt-2 text-center">
					<a
						href={moreLink.href}
						class="inline-flex min-h-11 items-center font-semibold text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary"
					>
						{moreLink.label}
					</a>
				</p>
			)}
		</div>
	</div>
</section>

<style>
	.faq-details summary::-webkit-details-marker {
		display: none;
	}
	.faq-details summary {
		list-style: none;
	}
	.faq-details summary::marker {
		content: '';
		display: none;
	}

	.faq-details[open] .faq-chevron {
		transform: rotate(180deg);
	}

	.faq-details:not([open]) .faq-summary {
		background-color: var(--color-neutral-0);
	}
</style>

<script is:inline>
	(function () {
		function openFaqFromHash() {
			const id = window.location.hash.slice(1);
			if (!id) return;
			const el = document.getElementById(id);
			if (el instanceof HTMLDetailsElement) el.open = true;
		}
		openFaqFromHash();
		window.addEventListener('hashchange', openFaqFromHash);
	})();
</script>
