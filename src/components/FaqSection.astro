---
import { ChevronRight } from '@lucide/astro';
import { homeFaqItems } from '../data/faq-home';

export interface FaqItem {
	id?: string;
	question: string;
	answer: string;
}

export interface Props {
	items?: FaqItem[];
	title?: string;
	sectionId?: string;
	headingId?: string;
	background?: 'white' | 'surface';
	headingAlign?: 'left' | 'center';
}

const {
	items = homeFaqItems,
	title = 'FAQ',
	sectionId = 'faq',
	headingId = 'faq-heading',
	background = 'white',
	headingAlign = 'left'
} = Astro.props;

const sectionBgClass = background === 'surface' ? 'bg-surface' : 'bg-white';
const headingAlignClass = headingAlign === 'center' ? 'text-center' : '';
---

<section
	id={sectionId}
	class={`section-y scroll-mt-28 border-b border-border ${sectionBgClass}`}
	aria-labelledby={headingId}
>
	<div class="shell-layout">
		<h2 id={headingId} class:list={['mb-10 text-3xl font-bold text-foreground', headingAlignClass]}>
			{title}
		</h2>
		<div class="faq-accordion mx-auto max-w-[72ch] overflow-hidden rounded-lg border border-border bg-background divide-y divide-border">
			{items.map((item) => (
				<details {...(item.id && { id: item.id })} class:list={['faq-details', item.id && 'scroll-mt-28']}>
					<summary
						class="faq-summary grid cursor-pointer list-none grid-cols-[2.5rem_minmax(0,1fr)] items-center gap-x-3 px-4 py-6 transition-colors hover:bg-surface-alt sm:px-5 motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-inset"
					>
						<span class="faq-chevron-cell flex shrink-0 justify-center" aria-hidden="true">
							<span class="faq-chevron ui-icon-well transition-transform duration-200 ease-out motion-reduce:transition-none">
								<ChevronRight class="h-5 w-5 shrink-0" stroke-width={1.5} />
							</span>
						</span>
						<span class="faq-question min-w-0 text-left text-base font-semibold leading-normal text-foreground">
							{item.question}
						</span>
					</summary>
					<div class="border-t border-border px-4 pb-6 pt-5 sm:px-5">
						<div class="grid grid-cols-[2.5rem_minmax(0,1fr)] items-start gap-x-3">
							<span aria-hidden="true" class="faq-answer-spacer block min-h-px min-w-0 shrink-0"></span>
							<p class="faq-answer-text m-0 min-w-0 text-sm leading-relaxed text-muted sm:text-base">
								{item.answer}
							</p>
						</div>
					</div>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	/* Masquer le marqueur natif <details> (WebKit + Firefox + ::marker) */
	.faq-details summary::-webkit-details-marker {
		display: none;
	}
	.faq-details summary {
		list-style: none;
	}
	.faq-details summary::marker {
		content: '';
		display: none;
	}

	.faq-details[open] .faq-chevron {
		transform: rotate(90deg);
	}

	.faq-summary .faq-chevron {
		transform-origin: center;
	}

	/* Supprime l'espace baseline sous le SVG (alignement vertical avec le texte). */
	.faq-summary .faq-chevron :global(svg) {
		display: block;
	}
</style>

<script is:inline>
	(function () {
		function openFaqFromHash() {
			const id = window.location.hash.slice(1);
			if (!id) return;
			const el = document.getElementById(id);
			if (el instanceof HTMLDetailsElement) el.open = true;
		}
		openFaqFromHash();
		window.addEventListener('hashchange', openFaqFromHash);
	})();
</script>
