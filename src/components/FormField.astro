---
export interface Props {
	id: string;
	name: string;
	label: string;
	type?: 'text' | 'email' | 'tel';
	required?: boolean;
	placeholder?: string;
	autocomplete?: string;
	options?: { value: string; label: string }[];
	rows?: number;
	variant?: 'input' | 'select' | 'textarea';
}

const { id, name, label, type = 'text', required = false, placeholder, autocomplete, options = [], rows = 6, variant = 'input' } = Astro.props;

const inputClass =
	"w-full px-4 py-3 border border-border rounded-lg bg-background text-foreground placeholder:text-muted/70 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background focus-visible:border-transparent";
---

<div>
	<label for={id} class="block text-sm font-medium text-muted mb-2">
		{label}
	</label>
	{variant === 'input' && (
		<input
			type={type}
			id={id}
			name={name}
			required={required}
			placeholder={placeholder}
			autocomplete={autocomplete}
			class={inputClass}
		/>
	)}
	{variant === 'select' && (
		<select
			id={id}
			name={name}
			required={required}
			class={inputClass}
		>
			<slot>
				{options.map((opt) => (
					<option value={opt.value}>{opt.label}</option>
				))}
			</slot>
		</select>
	)}
	{variant === 'textarea' && (
		<textarea
			id={id}
			name={name}
			required={required}
			placeholder={placeholder}
			rows={rows}
			class={inputClass}
		></textarea>
	)}
</div>
