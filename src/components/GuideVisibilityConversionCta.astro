---
import DiagnosticLeadCta from './DiagnosticLeadCta.astro';

export interface Props {
	variant?: 'intro' | 'final';
}

const { variant = 'intro' } = Astro.props;
const mapped = variant === 'intro' ? 'guide-visibilite-intro' : 'guide-visibilite-final';
---

<DiagnosticLeadCta variant={mapped} class="my-10" />
