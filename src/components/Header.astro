---
export interface NavLink {
	href: string;
	label: string;
}

export interface Props {
	links?: NavLink[];
}

const defaultLinks: NavLink[] = [
	{ href: '/portfolio/', label: 'Portfolio' },
	{ href: '/tarifs/', label: 'Tarifs' },
	{ href: '/about/', label: 'À propos' },
	{ href: '/contact/', label: 'Contact' },
	{ href: '/blog/', label: 'Blog' },
];

const { links = defaultLinks } = Astro.props;

/** Chemin sans slash final sauf racine. */
function normalizePath(p: string): string {
	if (p === '/' || p === '') return '/';
	return p.replace(/\/+$/, '') || '/';
}

const currentPath = normalizePath(Astro.url.pathname);

function navLinkIsActive(href: string): boolean {
	const target = normalizePath(href);
	if (target === '/blog') {
		return currentPath === '/blog' || currentPath.startsWith('/blog/');
	}
	if (target === '/portfolio') {
		return currentPath === '/portfolio' || currentPath.startsWith('/portfolio/');
	}
	return currentPath === target || currentPath.startsWith(`${target}/`);
}
---

<header class="bg-white shadow-sm border-b border-border">
	<nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Navigation principale">
		<div class="flex flex-col sm:flex-row sm:justify-between sm:h-16 py-3 sm:py-0 gap-3 sm:gap-0">
			<div class="flex items-center">
				<a href="/" class="text-xl font-bold text-foreground flex flex-col items-start justify-start">
					<span class="font-bold text-foreground hover:text-primary">NICO<span class="text-primary-foreground">DEV</span></span>
	
					<span class="inline-flex items-center gap-1">
						<span class="inline-block pr-2 py-0.5 rounded-full bg-surface text-foreground text-xs font-semibold">psychologue</span>
						<span class="text-muted text-xl align-middle">+</span>
						<span class="inline-block px-2 py-0.5 rounded-full bg-surface text-foreground text-xs font-semibold">développeur web</span>
					</span>
				</a>
			</div>
			<div class="flex items-center gap-5 sm:gap-8 overflow-x-auto pb-1 sm:pb-0 text-sm sm:text-base">
				{links.map((link) => {
					const active = navLinkIsActive(link.href);
					return (
						<a
							href={link.href}
							class:list={[
								'whitespace-nowrap transition-colors',
								active ? 'font-medium text-primary' : 'text-muted hover:text-primary',
							]}
							aria-current={active ? 'page' : undefined}
						>
							{link.label}
						</a>
					);
				})}
			</div>
		</div>
	</nav>
</header>
