---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

export interface Props {
	title: string;
	subtitle?: string;
	variant?: 'full' | 'light';
	maxWidth?: '4xl' | '6xl' | '7xl';
	breadcrumb?: { label: string; href?: string }[];
	/** Image de couverture (asset optimisé ou URL publique /…) — dégradé de lisibilité appliqué automatiquement */
	coverImage?: string | ImageMetadata;
	coverImageAlt?: string;
}

const { title, subtitle, variant = 'full', maxWidth = '7xl', breadcrumb, coverImage, coverImageAlt } = Astro.props;

const hasCover = Boolean(coverImage);
const coverIsAsset = typeof coverImage === 'object' && coverImage !== null && 'src' in coverImage && 'width' in coverImage;

const sectionClass = [
	hasCover ? 'hero-shell--with-cover' : '',
	variant === 'full'
		? 'hero-shell hero-shell--full text-foreground py-16 md:py-20 border-b border-border'
		: 'hero-shell hero-shell--light text-foreground py-14 md:py-16 border-b border-border',
]
	.filter(Boolean)
	.join(' ');

const titleClass = variant === 'full'
	? 'text-4xl md:text-6xl font-bold mb-6 text-foreground'
	: 'text-4xl md:text-5xl font-bold text-foreground mb-5';

const subtitleClass = variant === 'full'
	? 'text-xl md:text-2xl mb-8 max-w-3xl mx-auto text-muted tracking-wide'
	: 'text-xl text-muted max-w-3xl mx-auto tracking-wide';

const maxWidthClass = { '4xl': 'max-w-4xl', '6xl': 'max-w-6xl', '7xl': 'max-w-7xl' }[maxWidth];
---

<section class={sectionClass}>
	{hasCover && coverImage && (
		<div class="hero-layer hero-layer--photo">
			{coverIsAsset ? (
				<Image
					src={coverImage}
					alt={coverImageAlt ?? ''}
					class="hero-cover-img"
					loading="eager"
					decoding="async"
					fetchpriority="high"
					width={1600}
					height={900}
				/>
			) : (
				<img
					src={coverImage as string}
					alt={coverImageAlt ?? ''}
					class="hero-cover-img"
					loading="eager"
					decoding="async"
					fetchpriority="high"
					width="1600"
					height="900"
				/>
			)}
		</div>
	)}
	{hasCover && <div class="hero-layer hero-layer--scrim" aria-hidden="true"></div>}
	<div class:list={['hero-layer hero-layer--wash', { 'hero-layer--hidden-when-cover': hasCover }]} aria-hidden="true"></div>
	<div class:list={['hero-layer hero-layer--grain', { 'hero-layer--hidden-when-cover': hasCover }]} aria-hidden="true"></div>
	<div class:list={['hero-orb hero-orb--left', { 'hero-orb--hidden-when-cover': hasCover }]} aria-hidden="true"></div>
	<div class:list={['hero-orb hero-orb--right', { 'hero-orb--hidden-when-cover': hasCover }]} aria-hidden="true"></div>

	<div class={`${maxWidthClass} relative z-10 mx-auto px-4 sm:px-6 lg:px-8 ${variant === 'light' ? 'text-center' : ''}`}>
		<div class:list={['text-center break-words', { 'hero-copy hero-copy--on-cover': hasCover }]}>
			{breadcrumb && breadcrumb.length > 0 && (
				<nav aria-label="Fil d'Ariane" class="mb-6">
					<ol class="flex flex-wrap justify-center gap-x-2 text-sm text-muted">
						{breadcrumb.map((item, index) => (
							<li class="flex items-center gap-x-2">
								{index > 0 && (
									<span aria-hidden="true" class="text-border">/</span>
								)}
								{item.href ? (
									<a href={item.href} class="hover:text-foreground transition-colors">
										{item.label}
									</a>
								) : (
									<span class="text-foreground">{item.label}</span>
								)}
							</li>
						))}
					</ol>
				</nav>
			)}
			<slot name="before" />
			<h1 class={titleClass}>
				{title}
			</h1>
			<div class="flex justify-center mb-6">
				<div class="h-1 w-16 rounded-full bg-primary" aria-hidden="true" />
			</div>
			{subtitle && (
				<p class={subtitleClass}>
					{subtitle}
				</p>
			)}
			<slot name="after" />
		</div>
	</div>
</section>

<style>
	.hero-shell {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background-color: var(--color-surface);
	}

	.hero-shell--with-cover {
		min-height: min(52vh, 28rem);
	}

	.hero-shell--with-cover.hero-shell--full,
	.hero-shell--with-cover.hero-shell--light {
		background-image: none;
	}

	.hero-layer--photo {
		z-index: 0;
		/* Évite les bords délavés quand l’image est floutée + agrandie */
		overflow: hidden;
	}

	.hero-cover-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
		transform: scale(1.07);
		transform-origin: center center;
		filter: blur(10px);
	}

	.hero-layer--scrim {
		z-index: 1;
		/* Assomplit légèrement l’image ; la lisibilité du texte repose sur .hero-copy--on-cover */
		background:
			radial-gradient(
				ellipse 120% 85% at 50% 45%,
				color-mix(in srgb, var(--color-surface) 22%, transparent) 0%,
				color-mix(in srgb, var(--color-surface) 48%, transparent) 62%,
				color-mix(in srgb, var(--color-surface) 38%, transparent) 100%
			);
	}

	@media (max-width: 768px) {
		.hero-cover-img {
			transform: scale(1.06);
			filter: blur(8px);
		}

		.hero-layer--scrim {
			background: linear-gradient(
				180deg,
				color-mix(in srgb, var(--color-surface) 18%, transparent) 0%,
				color-mix(in srgb, var(--color-surface) 52%, transparent) 55%,
				color-mix(in srgb, var(--color-surface) 35%, transparent) 100%
			);
		}
	}

	.hero-copy--on-cover {
		position: relative;
		z-index: 2;
		margin-inline: auto;
		width: fit-content;
		max-width: 100%;
		padding: clamp(1.35rem, 4vw, 2.75rem) clamp(1.15rem, 3.5vw, 2.25rem);
		border-radius: var(--radius-lg);
		background: color-mix(in srgb, var(--color-surface) 94%, transparent);
		backdrop-filter: blur(12px) saturate(1.1);
		-webkit-backdrop-filter: blur(12px) saturate(1.1);
		border: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
		box-shadow: var(--shadow-lg);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-copy--on-cover {
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			background: color-mix(in srgb, var(--color-surface) 97%, transparent);
		}
	}

	.hero-layer--hidden-when-cover,
	.hero-orb--hidden-when-cover {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.hero-shell--with-cover .hero-copy--on-cover h1 {
		text-shadow: none;
	}

	.hero-shell--full {
		background-image:
			linear-gradient(
				135deg,
				color-mix(in srgb, var(--color-primary) 10%, var(--color-surface)) 0%,
				var(--color-surface) 50%,
				color-mix(in srgb, var(--color-foreground) 7%, var(--color-surface)) 100%
			);
	}

	.hero-shell--light {
		background-image:
			linear-gradient(
				145deg,
				color-mix(in srgb, var(--color-primary) 6%, var(--color-surface)) 0%,
				var(--color-surface) 56%,
				color-mix(in srgb, var(--color-foreground) 5%, var(--color-surface)) 100%
			);
	}

	.hero-layer {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.hero-layer--wash {
		background:
			radial-gradient(circle at 15% 14%, color-mix(in srgb, var(--color-primary) 16%, transparent) 0, transparent 44%),
			radial-gradient(circle at 84% 20%, color-mix(in srgb, var(--color-foreground) 11%, transparent) 0, transparent 47%);
		opacity: 0.75;
	}

	.hero-layer--grain {
		background-image:
			linear-gradient(to right, color-mix(in srgb, var(--color-border) 22%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in srgb, var(--color-border) 20%, transparent) 1px, transparent 1px);
		background-size: 34px 34px;
		mask-image: linear-gradient(to bottom, black 40%, transparent 100%);
		opacity: 0.22;
	}

	.hero-orb {
		position: absolute;
		width: 18rem;
		height: 18rem;
		border-radius: var(--radius-full);
		filter: blur(48px);
		opacity: 0.35;
		pointer-events: none;
	}

	.hero-orb--left {
		top: -4.5rem;
		left: -5rem;
		background: color-mix(in srgb, var(--color-primary) 42%, transparent);
	}

	.hero-orb--right {
		top: -5.5rem;
		right: -5rem;
		background: color-mix(in srgb, var(--color-foreground) 20%, transparent);
	}

	@media (max-width: 768px) {
		.hero-layer--grain {
			background-size: 24px 24px;
			opacity: 0.16;
		}

		.hero-orb {
			width: 12rem;
			height: 12rem;
			filter: blur(32px);
			opacity: 0.28;
		}
	}
</style>
