---
export interface Props {
	title: string;
	subtitle?: string;
	variant?: 'full' | 'light';
	maxWidth?: '4xl' | '6xl' | '7xl';
}

const { title, subtitle, variant = 'full', maxWidth = '7xl' } = Astro.props;

const sectionClass = variant === 'full'
	? 'bg-opaline-100 text-foreground py-20'
	: 'py-16 bg-opaline-100';

const titleClass = variant === 'full'
	? 'text-4xl md:text-6xl font-bold mb-6 text-foreground'
	: 'text-4xl font-bold text-foreground mb-6';

const subtitleClass = variant === 'full'
	? 'text-xl md:text-2xl mb-8 max-w-3xl mx-auto text-mutedText'
	: 'text-xl text-mutedText max-w-3xl mx-auto';

const maxWidthClass = { '4xl': 'max-w-4xl', '6xl': 'max-w-6xl', '7xl': 'max-w-7xl' }[maxWidth];
---

<section class={sectionClass}>
	<div class={`${maxWidthClass} mx-auto px-4 sm:px-6 lg:px-8 ${variant === 'light' ? 'text-center' : ''}`}>
		<div class="text-center">
			<slot name="before" />
			<h1 class={titleClass}>
				{title}
			</h1>
			{subtitle && (
				<p class={subtitleClass}>
					{subtitle}
				</p>
			)}
			<slot name="after" />
		</div>
	</div>
</section>
