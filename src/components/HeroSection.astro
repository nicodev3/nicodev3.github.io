---
import { Image } from 'astro:assets';
import heroLaptop from '../assets/images/hero-laptop.webp';

const features = [
	{ icon: "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", label: "Délai : 2 à 3 semaines" },
	{ icon: "M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3", label: "Mobile et visible sur Google" },
	{ icon: "m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z", label: "Pages rapides" },
	{ icon: "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5", label: "Widget RDV (Doctolib...) + RGPD" }
];
---

<section class="hero-home text-foreground py-16 md:py-20">
	<div class="hero-layer hero-layer--wash" aria-hidden="true"></div>
	<div class="hero-layer hero-layer--grain" aria-hidden="true"></div>
	<div class="hero-orb hero-orb--left" aria-hidden="true"></div>
	<div class="hero-orb hero-orb--right" aria-hidden="true"></div>

	<div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-12 items-center">
			<div class="min-w-0">
				<p class="text-sm md:text-lg uppercase tracking-wider text-muted mb-4">Sites web pour psychologues</p>
				<h1 class="text-4xl md:text-6xl font-bold leading-tight max-w-4xl text-foreground">
					Un site clair et rassurant pour présenter votre offre de soins
				</h1>
				<p class="mt-6 text-lg md:text-2xl text-muted max-w-3xl">
					Psychologue et développeur web, je crée des sites clairs et rassurants pour présenter votre pratique. Je connais votre métier de l'intérieur et je vous aide à être visible sur Google, à expliquer votre approche et à faciliter la prise de rendez-vous.
				</p>
				<div class="mt-8 flex flex-col sm:flex-row gap-4">
					<a href="#lead-form" class="bg-primary text-on-primary px-7 py-3 rounded-lg font-semibold text-center hover:opacity-90 transition-colors flex items-center justify-center h-full">
						Obtenir ma proposition
					</a>
					<a href="#offres" class="border-2 border-border text-foreground px-7 py-3 rounded-lg font-semibold text-center hover:bg-background transition-colors">
						Découvrir les offres
					</a>
				</div>
			</div>
			<div class="hidden lg:block">
				<Image
					src={heroLaptop}
					alt="Site web professionnel sur ordinateur"
					width={672}
					height={420}
					widths={[384, 448, 672]}
					sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 448px"
					class="rounded-xl shadow-2xl w-full max-w-md mx-auto"
				/>
			</div>
		</div>
		<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
			{features.map((feature) => (
				<div class="bg-background rounded-lg p-4 border border-border flex items-center gap-3 hover:bg-surface transition-colors">
					<svg class="w-5 h-5 text-muted flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon} />
					</svg>
					<span>{feature.label}</span>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.hero-home {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		border-bottom: 1px solid var(--color-border);
		background-color: var(--color-surface);
		background-image:
			linear-gradient(
				135deg,
				color-mix(in srgb, var(--color-primary) 10%, var(--color-surface)) 0%,
				var(--color-surface) 48%,
				color-mix(in srgb, var(--color-foreground) 7%, var(--color-surface)) 100%
			);
	}

	.hero-layer {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.hero-layer--wash {
		background:
			radial-gradient(circle at 15% 14%, color-mix(in srgb, var(--color-primary) 16%, transparent) 0, transparent 44%),
			radial-gradient(circle at 84% 20%, color-mix(in srgb, var(--color-foreground) 11%, transparent) 0, transparent 47%);
		opacity: 0.75;
	}

	.hero-layer--grain {
		background-image:
			linear-gradient(to right, color-mix(in srgb, var(--color-border) 22%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in srgb, var(--color-border) 20%, transparent) 1px, transparent 1px);
		background-size: 34px 34px;
		mask-image: linear-gradient(to bottom, black 45%, transparent 100%);
		opacity: 0.22;
	}

	.hero-orb {
		position: absolute;
		width: 18rem;
		height: 18rem;
		border-radius: 9999px;
		filter: blur(48px);
		opacity: 0.35;
		pointer-events: none;
	}

	.hero-orb--left {
		top: -4.5rem;
		left: -5rem;
		background: color-mix(in srgb, var(--color-primary) 42%, transparent);
	}

	.hero-orb--right {
		top: -5.5rem;
		right: -5rem;
		background: color-mix(in srgb, var(--color-foreground) 20%, transparent);
	}

	@media (max-width: 768px) {
		.hero-layer--grain {
			background-size: 24px 24px;
			opacity: 0.16;
		}

		.hero-orb {
			width: 12rem;
			height: 12rem;
			filter: blur(32px);
			opacity: 0.28;
		}
	}
</style>
