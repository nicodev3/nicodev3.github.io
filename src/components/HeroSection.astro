---
const features = [
	{ icon: "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", label: "Délai : 2 à 3 semaines" },
	{ icon: "M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3", label: "Mobile et visible sur Google" },
	{ icon: "m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z", label: "Pages rapides" },
	{ icon: "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5", label: "Widget RDV (Doctolib...) + RGPD" }
];
---

<section class="hero-home text-foreground py-12 md:py-16 lg:py-20">
	<div class="hero-layer hero-layer--wash" aria-hidden="true"></div>
	<div class="hero-layer hero-layer--grain" aria-hidden="true"></div>
	<div class="hero-orb hero-orb--left" aria-hidden="true"></div>
	<div class="hero-orb hero-orb--right" aria-hidden="true"></div>

	<div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="hero-copy w-full max-w-2xl">
			<p class="hero-eyebrow text-muted">
				Sites web pour psychologues
			</p>
			<h1 class="hero-title text-foreground text-balance">
				Gagnez en visibilité avec un site internet pensé pour les{' '}
				<span class="text-[#722F37] not-italic">psychologues</span>.
			</h1>

			<p class="hero-lead text-muted text-pretty">
				Site professionnel, léger, sans charge technique : présenter votre pratique, rassurer et orienter vers le rendez-vous. Psychologue développeur, je connais votre métier — vous recevez vos patients, je m’occupe du site et de votre visibilité.
			</p>

			<div class="mt-7 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
				<a
					href="/contact/#diagnostic"
					class="inline-flex items-center justify-center rounded-lg bg-primary-foreground px-6 py-3 text-center text-[0.9375rem] font-semibold text-on-primary transition-opacity hover:opacity-90 sm:px-7 sm:text-base"
				>
					Demander un diagnostic gratuit
				</a>
				<a
					href="#comment-ca-marche"
					class="text-center text-[0.9375rem] font-semibold text-muted underline-offset-4 transition-colors hover:text-foreground hover:underline sm:text-base"
				>
					Comment ça marche ?
				</a>
			</div>

			<p class="hero-trust mt-4 text-muted">
				<span class="text-foreground/80">Déjà une dizaine de psychologues accompagnés</span>
				<span class="mx-1.5 text-muted/50" aria-hidden="true">·</span>
				<a
					href="#temoignages"
					class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
				>
					Avis à Brest, Paris, Lyon…
				</a>
			</p>
		</div>

		<div class="mt-9 grid grid-cols-1 gap-3 text-sm sm:mt-10 sm:grid-cols-2 sm:gap-4 lg:mt-11 lg:grid-cols-4">
			{features.map((feature) => (
				<div class="hero-feature-card group flex items-center gap-3">
					<svg
						class="hero-feature-card__icon h-5 w-5 shrink-0"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon} />
					</svg>
					<span class="hero-feature-card__label">{feature.label}</span>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.hero-home {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		border-bottom: 1px solid var(--color-border);
		background-color: var(--color-surface);
		background-image:
			linear-gradient(
				135deg,
				color-mix(in srgb, var(--color-primary) 10%, var(--color-surface)) 0%,
				var(--color-surface) 48%,
				color-mix(in srgb, var(--color-foreground) 7%, var(--color-surface)) 100%
			);
	}

	.hero-layer {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.hero-layer--wash {
		background:
			radial-gradient(circle at 15% 14%, color-mix(in srgb, var(--color-primary) 16%, transparent) 0, transparent 44%),
			radial-gradient(circle at 84% 20%, color-mix(in srgb, var(--color-foreground) 11%, transparent) 0, transparent 47%);
		opacity: 0.75;
	}

	.hero-layer--grain {
		background-image:
			linear-gradient(to right, color-mix(in srgb, var(--color-border) 22%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in srgb, var(--color-border) 20%, transparent) 1px, transparent 1px);
		background-size: 34px 34px;
		mask-image: linear-gradient(to bottom, black 45%, transparent 100%);
		opacity: 0.22;
	}

	.hero-orb {
		position: absolute;
		width: 18rem;
		height: 18rem;
		border-radius: 9999px;
		filter: blur(48px);
		opacity: 0.35;
		pointer-events: none;
	}

	.hero-orb--left {
		top: -4.5rem;
		left: -5rem;
		background: color-mix(in srgb, var(--color-primary) 42%, transparent);
	}

	.hero-orb--right {
		top: -5.5rem;
		right: -5rem;
		background: color-mix(in srgb, var(--color-foreground) 20%, transparent);
	}

	@media (max-width: 768px) {
		.hero-layer--grain {
			background-size: 24px 24px;
			opacity: 0.16;
		}

		.hero-orb {
			width: 12rem;
			height: 12rem;
			filter: blur(32px);
			opacity: 0.28;
		}
	}

	.hero-eyebrow {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 0.625rem;
	}

	@media (min-width: 768px) {
		.hero-eyebrow {
			font-size: 0.875rem;
			margin-bottom: 0.75rem;
		}
	}

	.hero-title {
		font-weight: 700;
		line-height: 1.06;
		letter-spacing: -0.032em;
		font-size: clamp(2rem, 3.6vw + 1rem, 3.25rem);
		max-width: none;
	}

	.hero-lead {
		margin-top: 1rem;
		font-size: clamp(1rem, 0.35vw + 0.94rem, 1.125rem);
		line-height: 1.5;
		font-weight: 400;
	}

	@media (min-width: 768px) {
		.hero-lead {
			margin-top: 1.125rem;
		}
	}

	.hero-trust {
		font-size: 0.8125rem;
		line-height: 1.45;
	}

	@media (min-width: 640px) {
		.hero-trust {
			font-size: 0.875rem;
		}
	}

	/* Glassmorphism — tuiles arguments (fond clair du hero visible à travers) */
	.hero-feature-card {
		border-radius: 0.875rem;
		padding: 0.9rem 1rem;
		color: color-mix(in srgb, #fff 94%, transparent);
		background: color-mix(in srgb, var(--color-foreground) 76%, transparent);
		border: 1px solid color-mix(in srgb, #fff 16%, transparent);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 12%, transparent) inset,
			0 12px 40px color-mix(in srgb, var(--color-foreground) 22%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.hero-feature-card:hover {
		background: color-mix(in srgb, var(--color-foreground) 84%, transparent);
		border-color: color-mix(in srgb, #fff 26%, transparent);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 16%, transparent) inset,
			0 16px 44px color-mix(in srgb, var(--color-foreground) 28%, transparent);
	}

	.hero-feature-card__icon {
		color: color-mix(in srgb, #fff 68%, transparent);
		transition: color 0.2s ease;
	}

	.hero-feature-card:hover .hero-feature-card__icon {
		color: color-mix(in srgb, #fff 88%, transparent);
	}

	.hero-feature-card__label {
		line-height: 1.35;
		font-weight: 500;
		letter-spacing: 0.01em;
	}

	@media (prefers-reduced-transparency: reduce) {
		.hero-feature-card {
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			background: color-mix(in srgb, var(--color-foreground) 92%, var(--color-surface));
		}

		.hero-feature-card:hover {
			background: color-mix(in srgb, var(--color-foreground) 96%, var(--color-surface));
		}
	}
</style>
