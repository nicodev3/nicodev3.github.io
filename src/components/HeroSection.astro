---
import { Image } from 'astro:assets';
import heroLaptop from '../assets/images/hero-laptop.webp';

const features = [
	{ icon: "M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", label: "Délai : 2 à 3 semaines" },
	{ icon: "M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3", label: "Mobile et visible sur Google" },
	{ icon: "m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z", label: "Pages rapides" },
	{ icon: "M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5", label: "Widget RDV (Doctolib...) + RGPD" }
];
---

<section class="hero-home text-foreground py-16 md:py-20">
	<div class="hero-layer hero-layer--wash" aria-hidden="true"></div>
	<div class="hero-layer hero-layer--grain" aria-hidden="true"></div>
	<div class="hero-orb hero-orb--left" aria-hidden="true"></div>
	<div class="hero-orb hero-orb--right" aria-hidden="true"></div>

	<div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-12 items-center">
			<div class="min-w-0">
				<p class="text-sm md:text-lg uppercase tracking-wider text-muted mb-4">Sites web pour psychologues</p>
				<h1 class="text-4xl md:text-6xl font-bold leading-tight max-w-4xl text-foreground">
					Gagnez en visibilité avec un site internet pensé pour les{' '}
					<span class="italic text-[#722F37]">psychologues</span>.
				</h1>
				<div class="mt-5 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-3 sm:gap-y-2">
					<p class="inline-flex w-fit max-w-full items-center gap-2 rounded-full border border-border/60 bg-background/70 px-3 py-1.5 text-xs font-medium text-foreground shadow-sm backdrop-blur-sm sm:text-sm">
						<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-primary" aria-hidden="true" />
						<span>Déjà une dizaine de psychologues accompagnés</span>
					</p>
					<p class="text-sm text-muted sm:text-base">
						<a
							href="#temoignages"
							class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
						>
							Avis de collègues à Brest, Paris, Lyon…
						</a>
					</p>
				</div>
				<p class="mt-6 text-lg md:text-2xl text-muted max-w-3xl">
					Un site professionnel, simple, sans gestion technique, conçu pour présenter votre pratique avec clarté, rassurer vos futurs patients et faciliter la prise de rendez-vous.
				</p>
				<p class="mt-4 text-base md:text-lg text-muted max-w-3xl">
					Conçu par un psychologue et développeur web qui connaît votre métier de l'intérieur. Vous vous occupez de vos patients, je m’occupe du site.
				</p>
				<p class="mt-4 max-w-3xl rounded-xl border border-border bg-background/80 px-4 py-3 text-sm md:text-base text-muted">
					Nicodev n’est pas une usine à sites. Je préfère accompagner peu de projets, avec attention, pour créer des sites de qualité vraiment adaptés aux besoins de mes collègues psychologues.
				</p>
				<div class="mt-8 flex flex-col sm:flex-row sm:items-center gap-4">
					<a href="/contact/#diagnostic" class="bg-primary-foreground text-on-primary px-7 py-3 rounded-lg font-semibold text-center hover:opacity-90 transition-colors flex items-center justify-center h-full">
						Demander un diagnostic gratuit
					</a>
					<a href="#comment-ca-marche" class="text-center font-semibold text-muted hover:text-foreground underline-offset-4 hover:underline transition-colors px-2 py-3 sm:py-0">
						Comment ça marche ?
					</a>
				</div>
			</div>
			<div class="hidden lg:block">
				<Image
					src={heroLaptop}
					alt="Site web professionnel sur ordinateur"
					width={672}
					height={420}
					widths={[384, 448, 672]}
					sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 448px"
					class="rounded-xl shadow-2xl w-full max-w-md mx-auto"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
		<div class="mt-8 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
			{features.map((feature) => (
				<div class="hero-feature-card group flex items-center gap-3">
					<svg
						class="hero-feature-card__icon h-5 w-5 shrink-0"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon} />
					</svg>
					<span class="hero-feature-card__label">{feature.label}</span>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.hero-home {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		border-bottom: 1px solid var(--color-border);
		background-color: var(--color-surface);
		background-image:
			linear-gradient(
				135deg,
				color-mix(in srgb, var(--color-primary) 10%, var(--color-surface)) 0%,
				var(--color-surface) 48%,
				color-mix(in srgb, var(--color-foreground) 7%, var(--color-surface)) 100%
			);
	}

	.hero-layer {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.hero-layer--wash {
		background:
			radial-gradient(circle at 15% 14%, color-mix(in srgb, var(--color-primary) 16%, transparent) 0, transparent 44%),
			radial-gradient(circle at 84% 20%, color-mix(in srgb, var(--color-foreground) 11%, transparent) 0, transparent 47%);
		opacity: 0.75;
	}

	.hero-layer--grain {
		background-image:
			linear-gradient(to right, color-mix(in srgb, var(--color-border) 22%, transparent) 1px, transparent 1px),
			linear-gradient(to bottom, color-mix(in srgb, var(--color-border) 20%, transparent) 1px, transparent 1px);
		background-size: 34px 34px;
		mask-image: linear-gradient(to bottom, black 45%, transparent 100%);
		opacity: 0.22;
	}

	.hero-orb {
		position: absolute;
		width: 18rem;
		height: 18rem;
		border-radius: 9999px;
		filter: blur(48px);
		opacity: 0.35;
		pointer-events: none;
	}

	.hero-orb--left {
		top: -4.5rem;
		left: -5rem;
		background: color-mix(in srgb, var(--color-primary) 42%, transparent);
	}

	.hero-orb--right {
		top: -5.5rem;
		right: -5rem;
		background: color-mix(in srgb, var(--color-foreground) 20%, transparent);
	}

	@media (max-width: 768px) {
		.hero-layer--grain {
			background-size: 24px 24px;
			opacity: 0.16;
		}

		.hero-orb {
			width: 12rem;
			height: 12rem;
			filter: blur(32px);
			opacity: 0.28;
		}
	}

	/* Glassmorphism — tuiles arguments (fond clair du hero visible à travers) */
	.hero-feature-card {
		border-radius: 0.875rem;
		padding: 0.9rem 1rem;
		color: color-mix(in srgb, #fff 94%, transparent);
		background: color-mix(in srgb, var(--color-foreground) 76%, transparent);
		border: 1px solid color-mix(in srgb, #fff 16%, transparent);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 12%, transparent) inset,
			0 12px 40px color-mix(in srgb, var(--color-foreground) 22%, transparent);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		transition:
			border-color 0.2s ease,
			background-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.hero-feature-card:hover {
		background: color-mix(in srgb, var(--color-foreground) 84%, transparent);
		border-color: color-mix(in srgb, #fff 26%, transparent);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 16%, transparent) inset,
			0 16px 44px color-mix(in srgb, var(--color-foreground) 28%, transparent);
	}

	.hero-feature-card__icon {
		color: color-mix(in srgb, #fff 68%, transparent);
		transition: color 0.2s ease;
	}

	.hero-feature-card:hover .hero-feature-card__icon {
		color: color-mix(in srgb, #fff 88%, transparent);
	}

	.hero-feature-card__label {
		line-height: 1.35;
		font-weight: 500;
		letter-spacing: 0.01em;
	}

	@media (prefers-reduced-transparency: reduce) {
		.hero-feature-card {
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			background: color-mix(in srgb, var(--color-foreground) 92%, var(--color-surface));
		}

		.hero-feature-card:hover {
			background: color-mix(in srgb, var(--color-foreground) 96%, var(--color-surface));
		}
	}
</style>
