---
import { ArrowRight, BadgeCheck } from '@lucide/astro';
import { Image } from 'astro:assets';
import portraitImage from '../assets/images/nicodev.webp';
---

<section id="site-hero" class="hero-home section-y border-b border-border bg-white overflow-hidden">
	<div class="shell-layout">
		<div class="hero-home__grid">
			<div class="hero-home__copy">
				<p class="type-label-mono text-primary-foreground">Sites internet pour psychologues, psychothérapeutes et psychomotriciens</p>
				<h1 class="hero-home__title text-balance text-foreground">
					Un site qui présente votre pratique de psychologue avec justesse
				</h1>
				<p class="hero-home__lead text-pretty text-muted">
					Psychologue en exercice et développeur web, je conçois le site de mes confrères en
					libéral&nbsp;: les textes, la visibilité locale sur Google et toute la technique. Vous restez sur
					votre pratique.
				</p>

				<div class="hero-home__actions">
					<a
						href="/diagnostic-gratuit/"
						class="btn-primary-solid mb-5 inline-flex items-center justify-center rounded-xl px-8 py-4 font-bold"
					>
						Faire le point sur votre site
					</a>
					<a
						href="/portfolio/"
						class="mb-5 inline-flex items-center justify-center gap-2 px-2 py-4 font-semibold text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary"
					>
						Voir les sites réalisés
						<ArrowRight class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
					</a>
				</div>

				<p class="type-label-mono hero-home__price flex items-center gap-1.5 text-muted">
					<BadgeCheck class="h-4 w-4 shrink-0 text-primary-foreground" stroke-width={1.75} aria-hidden="true" />
					À partir de 29&nbsp;€/mois, hébergement et maintenance inclus
				</p>

				<p class="hero-home__trust text-sm text-muted">
					<span class="text-foreground/85">Sites de psychologues réalisés depuis 2015</span>
					<span class="mx-1.5 text-muted/45" aria-hidden="true">·</span>
					<a
						href="#temoignages"
						class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary-foreground hover:decoration-primary-foreground"
					>
						Avis de collègues accompagnés
					</a>
				</p>
			</div>

			<div class="hero-home__visual">
				<div class="hero-home__portrait">
					<Image
						src={portraitImage}
						alt="Nicodev — Sites internet pour psychologues"
						class="h-full w-full object-cover"
						width={640}
						height={800}
						loading="eager"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<aside class="hero-home__card" aria-label="Présentation">
					<p class="font-heading text-xl font-semibold text-primary-foreground">Nicolas Devaux</p>
					<p class="mt-1 text-sm leading-relaxed text-muted">
						Psychologue, psychomotricien, psychothérapeute &amp; développeur web.
					</p>
				</aside>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-home {
		position: relative;
		overflow: hidden;
	}

	.hero-home__grid {
		display: grid;
		grid-template-columns: 1fr;
		align-items: center;
		gap: 2.5rem;
	}

	@media (min-width: 768px) {
		.hero-home__grid {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
			gap: 3rem;
		}
	}

	@media (min-width: 1024px) {
		.hero-home__grid {
			gap: 4rem;
		}
	}

	.hero-home__copy {
		text-align: center;
	}

	@media (min-width: 768px) {
		.hero-home__copy {
			text-align: left;
		}
	}

	.hero-home__title {
		margin-top: 0.75rem;
		font-family: var(--font-heading), ui-serif, Georgia, serif;
		font-size: clamp(2.125rem, 1.35vw + 1.65rem, 3.25rem);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.02em;
	}

	.hero-home__lead {
		margin-top: 1.25rem;
		max-width: 42rem;
		font-size: clamp(1rem, 0.25vw + 0.96rem, 1.125rem);
		line-height: 1.55;
	}

	@media (min-width: 768px) {
		.hero-home__lead {
			margin-inline: 0;
		}
	}

	.hero-home__actions {
		margin-top: 1.75rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	@media (min-width: 640px) {
		.hero-home__actions {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: center;
		}
	}

	@media (min-width: 768px) {
		.hero-home__actions {
			justify-content: flex-start;
		}
	}

	.hero-home__price {
		margin-top: 1rem;
		justify-content: center;
	}

	@media (min-width: 768px) {
		.hero-home__price {
			justify-content: flex-start;
		}
	}

	.hero-home__trust {
		margin-top: 1rem;
	}

	.hero-home__visual {
		position: relative;
		width: 100%;
		max-width: 28rem;
		margin-inline: auto;
	}

	@media (min-width: 768px) {
		.hero-home__visual {
			max-width: none;
			margin-inline: 0;
		}
	}

	.hero-home__portrait {
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-lg);
	}

	.hero-home__card {
		position: absolute;
		bottom: -1.25rem;
		left: -0.5rem;
		max-width: 16rem;
		padding: 1.25rem 1.5rem;
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-neutral-0);
		box-shadow: var(--shadow-md);
	}

	@media (min-width: 640px) {
		.hero-home__card {
			left: -1.25rem;
			max-width: 18rem;
		}
	}
</style>
