---
import { ArrowRight, CalendarClock, ShieldAlert, Sparkles } from '@lucide/astro';

const points = [
	{
		Icon: Sparkles,
		title: 'Ce que l’IA fait bien',
		description:
			'Une structure, une mise en page, un premier jet de texte, en une soirée. Fabriquer un site n’est plus l’obstacle — ça ne l’est plus pour personne.',
	},
	{
		Icon: ShieldAlert,
		title: 'Ce qu’elle ne sait pas',
		description:
			'Elle ne sait pas qu’un psychologue ne promet pas de résultat, qu’un titre est protégé, ni ce qui rassure une personne qui n’a jamais consulté. Elle écrit ce qui se dit partout.',
	},
	{
		Icon: CalendarClock,
		title: 'Ce qui vient après',
		description:
			'Un site vit : l’hébergement, l’indexation, la fiche Google, les honoraires qui changent, le lien de rendez-vous qui casse. C’est là que le temps part, pas à la mise en ligne.',
	},
] as const;
---

<section
	id="objection-ia"
	class="section-y scroll-mt-28 border-b border-border bg-surface-alt"
	aria-labelledby="objection-ia-heading"
>
	<div class="shell-layout">
		<header class="mx-auto max-w-3xl text-center">
			<p class="type-eyebrow mb-3 text-muted">Une question qui revient</p>
			<h2 id="objection-ia-heading" class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				Oui, vous pouvez faire votre site avec l’IA
			</h2>
			<p class="mt-4 text-lg leading-relaxed text-muted">
				Et le résultat sera souvent correct. La vraie question est ailleurs&nbsp;: que faut-il écrire de votre
				pratique, que vaut-il mieux ne pas promettre, et qui s’en occupe dans six mois.
			</p>
		</header>

		<div class="mx-auto mt-12 grid max-w-6xl grid-cols-1 gap-5 lg:grid-cols-3">
			{
				points.map(({ Icon, title, description }) => (
					<article class="flex h-full flex-col rounded-lg border border-border bg-white p-6 shadow-sm sm:p-8">
						<div class="ui-icon-well mb-5" aria-hidden="true">
							<Icon class="h-5 w-5" stroke-width={1.5} />
						</div>
						<h3 class="font-heading text-xl font-semibold text-foreground">{title}</h3>
						<p class="mt-3 text-base leading-relaxed text-muted">{description}</p>
					</article>
				))
			}
		</div>

		<p class="mx-auto mt-10 max-w-3xl text-center text-base leading-relaxed text-muted sm:text-lg">
			Vous pouvez faire ce travail vous-même. Vous pouvez aussi le confier à un confrère qui connaît le métier et
			la technique, et garder ce temps pour vos patients.
		</p>

		<div class="mt-8 text-center">
			<a
				href="/blog/creer-site-avec-ia-psychologue/"
				class="inline-flex items-center gap-2 font-semibold text-primary-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
				data-umami-event="lead_click_article_from_home_ia"
			>
				Créer son site avec l’IA quand on est psychologue
				<ArrowRight class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
			</a>
		</div>
	</div>
</section>
