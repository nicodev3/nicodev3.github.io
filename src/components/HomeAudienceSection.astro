---
import { Image } from 'astro:assets';
import { ArrowRight, Brain, HandHeart, Stethoscope } from '@lucide/astro';
import psychomotricienneImage from '../assets/images/psychomotricienne-2.webp';
import psychologueImage from '../assets/images/psychologue.webp';
import soinImage from '../assets/images/soignant.webp';

const audiences = [
	{
		Icon: Brain,
		image: psychologueImage,
		imageAlt: 'Exemple de site sobre pour une psychologue en libéral',
		imageClass: 'object-top',
		title: 'Psychologues',
		description:
			'Vous exercez en libéral et vous avez besoin d’un site sobre pour présenter votre approche, votre cadre clinique et vos informations pratiques avec justesse.',
		href: '/creation-site-internet-psychologue/',
		linkLabel: 'Voir la page psychologues',
	},
	{
		Icon: HandHeart,
		image: psychomotricienneImage,
		imageAlt: 'Espace de psychomotricité avec une professionnelle accompagnant un enfant',
		imageClass: 'object-center',
		title: 'Psychomotriciens',
		description:
			'Vous souhaitez expliquer clairement votre cabinet, vos publics accompagnés, le bilan, les suivis et les modalités de prise de rendez-vous.',
		href: '/site-internet-psychomotricien/',
		linkLabel: 'Voir la page psychomotriciens',
	},
	{
		Icon: Stethoscope,
		image: soinImage,
		imageAlt: 'Exemple de site clair pour une pratique de soin',
		imageClass: 'object-top',
		title: 'Professions du soin proches',
		description:
			'Vous êtes orthophoniste, ergothérapeute, neuropsychologue ou praticien du soin : nous pouvons vérifier ensemble si l’accompagnement correspond à votre pratique.',
		href: '/contact/',
		linkLabel: 'En parler simplement',
	},
] as const;
---

<section id="pour-qui" class="section-y scroll-mt-28 border-b border-border bg-surface" aria-labelledby="home-audience-heading">
	<div class="shell-layout">
		<header class="mx-auto mb-10 max-w-3xl text-center">
			<p class="type-eyebrow mb-3 text-muted">Pour qui ?</p>
			<h2 id="home-audience-heading" class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				Un site clair pour présenter votre pratique, avec les mots justes
			</h2>
			<p class="mt-4 text-lg leading-relaxed text-muted">
				Chaque métier du soin a son cadre, son vocabulaire et ses contraintes. L’accompagnement part de votre
				réalité de cabinet pour créer une présence en ligne lisible, rassurante et adaptée aux personnes qui vous
				cherchent.
			</p>
		</header>

		<div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
			{
				audiences.map(({ Icon, image, imageAlt, imageClass, title, description, href, linkLabel }) => (
					<article class="flex h-full overflow-hidden rounded-lg border border-border bg-white shadow-sm">
						<div class="flex w-full flex-col">
							<div class="relative aspect-[16/10] overflow-hidden border-b border-border bg-surface">
								<Image
									src={image}
									alt={imageAlt}
									widths={[360, 520, 720]}
									sizes="(min-width: 1024px) 31vw, (min-width: 640px) 70vw, 100vw"
									class:list={['h-full w-full object-cover', imageClass]}
									loading="lazy"
									decoding="async"
								/>
							</div>
							<div class="flex grow flex-col p-6">
								<div class="ui-icon-well mb-5" aria-hidden="true">
									<Icon class="h-5 w-5" stroke-width={1.5} />
								</div>
								<h3 class="font-heading text-xl font-semibold text-foreground">{title}</h3>
								<p class="mt-3 grow text-base leading-relaxed text-muted">{description}</p>
								<a
									href={href}
									class="mt-5 inline-flex items-center gap-2 font-semibold text-primary-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
								>
									{linkLabel}
									<ArrowRight class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
								</a>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
