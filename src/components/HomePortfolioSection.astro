---
import { Image } from 'astro:assets';
import { ArrowLeft, ArrowRight, ArrowUpRight } from '@lucide/astro';
import {
	getRecentPortfolioProjects,
	portfolioProjects,
} from '../data/portfolio-projects';

/**
 * Deux réalisations récentes (hors celle du hero), plus un site suivi depuis 2019 (dont l’autrice témoigne plus bas) :
 * la page montre à la fois le travail actuel et la durée de l’accompagnement.
 */
const LONG_TERM_TITLE = 'Séverine Reisser';
const longTerm = portfolioProjects.find((p) => p.title === LONG_TERM_TITLE);
// La plus récente est montrée dans le hero à partir de 768 px (capture masquée sur mobile) :
// elle ouvre donc le carrousel sur mobile uniquement.
const [heroProject, ...others] = getRecentPortfolioProjects(4);
const recent = others.filter((p) => p !== longTerm);
const projects = longTerm ? [...recent.slice(0, 2), longTerm] : recent.slice(0, 3);

const toCard = (project: (typeof projects)[number], mobileOnly = false) => ({
	title: project.title,
	// Lieu et année : une information propre à chaque projet (le métier est déjà dans le titre de section).
	meta: `${project.location} · ${project.year}`,
	description:
		project.description ??
		`Site réalisé pour ${project.title} (${project.location}).`,
	image: project.image,
	imageAlt: project.imageAlt ?? `Page d’accueil du site de ${project.title}`,
	href: project.url,
	mobileOnly,
});

const projectsForHome = [
	...(heroProject && heroProject !== longTerm ? [toCard(heroProject, true)] : []),
	...projects.map((project) => toCard(project)),
];
---

<section class="section-y border-b border-border" aria-labelledby="home-portfolio-heading">
	<div class="shell-layout">
		<header class="flex flex-wrap items-end justify-between gap-x-10 gap-y-4">
			<div class="max-w-2xl">
				<h2 id="home-portfolio-heading" class="text-balance font-heading text-3xl font-semibold text-foreground sm:text-4xl">
					Quelques sites réalisés pour des psychologues et psychothérapeutes
				</h2>
				<p class="mt-4 text-pretty text-base leading-relaxed text-muted sm:text-lg">
					Chaque site part de la pratique : l’approche, les personnes reçues, les modalités de consultation.
				</p>
			</div>
			<a
				href="/portfolio/"
				class="inline-flex min-h-11 items-center gap-2 font-semibold text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary"
			>
				Voir toutes les réalisations
				<ArrowRight class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
			</a>
		</header>

		<div class="relative mt-12 flex flex-col gap-4" data-home-portfolio-carousel>
			<div
				class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2 [scrollbar-width:none] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-primary-foreground focus-visible:ring-offset-2 lg:grid lg:grid-cols-3 lg:overflow-visible lg:snap-none lg:pb-0"
				data-carousel-track
				tabindex="0"
				role="region"
				aria-roledescription="carrousel"
				aria-label="Réalisations"
			>
				{
					projectsForHome.map(({ title, meta, description, image, imageAlt, href, mobileOnly }) => (
						<article
							class:list={[
								'group h-full w-full shrink-0 snap-start flex-col overflow-hidden rounded-xl border border-border bg-white shadow-sm sm:w-[85%] lg:w-auto lg:shrink',
								mobileOnly ? 'flex md:hidden' : 'flex',
							]}
						>
							<a
								href={href}
								target="_blank"
								rel="noopener noreferrer"
								class="block overflow-hidden border-b border-border bg-surface"
								aria-label={`Visiter le site de ${title}, nouvel onglet`}
							>
								<Image
									src={image}
									alt={imageAlt}
									widths={[420, 640, 840]}
									sizes="(min-width: 1024px) 30vw, (min-width: 640px) 85vw, 100vw"
									class="content-image aspect-[16/10] h-full w-full object-cover object-top motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-[1.02]"
									loading="lazy"
									decoding="async"
								/>
							</a>
							<div class="flex grow flex-col p-6">
								<p class="type-label-mono text-muted">{meta}</p>
								<h3 class="mt-2 font-heading text-xl font-semibold text-foreground">{title}</h3>
								<p class="mt-3 grow text-pretty text-base leading-relaxed text-muted">{description}</p>
								<a
									href={href}
									target="_blank"
									rel="noopener noreferrer"
									class="mt-3 inline-flex min-h-11 items-center gap-2 font-semibold text-primary-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary"
								>
									Visiter le site
									<ArrowUpRight class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
								</a>
							</div>
						</article>
					))
				}
			</div>

			<div
				class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2 sm:gap-x-4 lg:hidden"
				data-carousel-toolbar
			>
				<button
					type="button"
					class="inline-flex h-11 w-11 shrink-0 touch-manipulation items-center justify-center rounded-full border border-border bg-white text-foreground transition-colors hover:border-primary-foreground hover:text-primary-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-foreground disabled:cursor-not-allowed disabled:opacity-40"
					aria-label="Réalisation précédente"
					data-carousel-prev
				>
					<ArrowLeft class="h-5 w-5" stroke-width={1.75} aria-hidden="true" />
				</button>

				<div class="flex min-w-0 flex-col items-center gap-2 justify-self-center">
					<p class="text-base font-medium tabular-nums text-foreground sm:text-lg" aria-live="polite">
						<span data-carousel-current>1</span>
						<span class="text-muted" aria-hidden="true"> / </span>
						<span data-carousel-total>{projectsForHome.filter((p) => !p.mobileOnly).length}</span>
					</p>
					<div class="flex flex-wrap justify-center gap-2" data-carousel-dots role="group" aria-label="Pagination du carrousel"></div>
					<p
						data-carousel-swipe-hint
						class="hidden max-w-[16rem] text-center text-xs italic leading-snug text-muted motion-reduce:transition-none"
						aria-hidden="true"
					/>
				</div>

				<button
					type="button"
					class="inline-flex h-11 w-11 shrink-0 touch-manipulation items-center justify-center rounded-full border border-border bg-white text-foreground transition-colors hover:border-primary-foreground hover:text-primary-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-foreground disabled:cursor-not-allowed disabled:opacity-40"
					aria-label="Réalisation suivante"
					data-carousel-next
				>
					<ArrowRight class="h-5 w-5" stroke-width={1.75} aria-hidden="true" />
				</button>
			</div>
		</div>

	</div>
</section>

<script>
	let homePortfolioCarouselTeardown: (() => void) | undefined;

	function setupHomePortfolioCarousel() {
		homePortfolioCarouselTeardown?.();

		const carouselRoot = document.querySelector('[data-home-portfolio-carousel]');
		const carouselTrack = carouselRoot?.querySelector<HTMLElement>('[data-carousel-track]');
		const prevButton = carouselRoot?.querySelector<HTMLButtonElement>('[data-carousel-prev]');
		const nextButton = carouselRoot?.querySelector<HTMLButtonElement>('[data-carousel-next]');
		const currentLabel = carouselRoot?.querySelector<HTMLElement>('[data-carousel-current]');
		const totalLabel = carouselRoot?.querySelector<HTMLElement>('[data-carousel-total]');
		const dotsContainer = carouselRoot?.querySelector<HTMLElement>('[data-carousel-dots]');
		const swipeHint = carouselRoot?.querySelector<HTMLElement>('[data-carousel-swipe-hint]');

		if (
			!carouselRoot ||
			!carouselTrack ||
			!prevButton ||
			!nextButton ||
			!currentLabel ||
			!totalLabel ||
			!dotsContainer
		) {
			return;
		}

		const track = carouselTrack;
		const dotsEl = dotsContainer;
		const prevBtn = prevButton;
		const nextBtn = nextButton;
		const curLabel = currentLabel;
		const totLabel = totalLabel;

		const ac = new AbortController();
		const { signal } = ac;

		const isDesktopGrid = () => window.matchMedia('(min-width: 1024px)').matches;

		const getScrollStep = () => {
			const first = track.querySelector<HTMLElement>('article');
			if (!first) return track.clientWidth;
			const styles = getComputedStyle(track);
			const gap = Number.parseFloat(styles.columnGap || styles.gap || '0') || 0;
			return first.offsetWidth + gap;
		};

		const scrollBehavior = (): ScrollBehavior =>
			window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';

		const getPageCount = () => {
			if (isDesktopGrid()) return 1;
			// Une page par réalisation visible : chaque carte est un point d’accroche du défilement.
			const visible = Array.from(track.querySelectorAll<HTMLElement>('article')).filter((a) => a.offsetParent !== null);
			return Math.max(visible.length, 1);
		};

		const getMaxScroll = () => track.scrollWidth - track.clientWidth;

		function scrollToPage(pageIndex: number) {
			const maxScroll = getMaxScroll();
			const step = getScrollStep();
			const target = Math.min(Math.max(0, pageIndex) * step, maxScroll);
			track.scrollTo({ left: target, behavior: scrollBehavior() });
		}

		function rebuildDots(pageCount: number, activePage: number) {
			dotsEl.innerHTML = '';
			for (let i = 0; i < pageCount; i++) {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className =
					'h-6 w-6 p-1.5 [background-clip:content-box] shrink-0 touch-manipulation rounded-full transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-foreground ' +
					(i === activePage ? 'bg-primary-foreground scale-110' : 'bg-muted hover:bg-muted/80');
				btn.setAttribute('aria-label', `Afficher la réalisation ${i + 1} sur ${pageCount}`);
				if (i === activePage) btn.setAttribute('aria-current', 'true');
				btn.addEventListener(
					'click',
					() => {
						scrollToPage(i);
					},
					{ signal },
				);
				dotsEl.appendChild(btn);
			}
		}

		let dotRebuildScheduled = false;
		function scheduleDotRebuild() {
			if (dotRebuildScheduled) return;
			dotRebuildScheduled = true;
			requestAnimationFrame(() => {
				dotRebuildScheduled = false;
				updateButtons(false);
			});
		}

		// Les attributs de carrousel n’ont de sens que sous 1024 px ; au-delà, c’est une simple grille.
		function syncCarouselSemantics() {
			if (isDesktopGrid()) {
				track.removeAttribute('role');
				track.removeAttribute('aria-roledescription');
				track.removeAttribute('tabindex');
			} else {
				track.setAttribute('role', 'region');
				track.setAttribute('aria-roledescription', 'carrousel');
				track.setAttribute('tabindex', '0');
			}
		}

		function updateButtons(rebuildDotsMaybe = false) {
			syncCarouselSemantics();
			const scrollLeft = track.scrollLeft;
			const maxScroll = getMaxScroll();
			const step = Math.max(getScrollStep(), 1);
			const pageCount = getPageCount();
			const rawIndex = Math.round(scrollLeft / step);
			const clampedPage = Math.min(Math.max(rawIndex, 0), pageCount - 1);
			const needsRebuild = rebuildDotsMaybe || dotsEl.childElementCount !== pageCount;

			prevBtn.disabled = isDesktopGrid() || scrollLeft <= 8;
			nextBtn.disabled = isDesktopGrid() || scrollLeft >= maxScroll - 8;
			curLabel.textContent = String(clampedPage + 1);
			totLabel.textContent = String(pageCount);

			if (needsRebuild) {
				rebuildDots(pageCount, clampedPage);
			} else {
				Array.from(dotsEl.querySelectorAll('button')).forEach((btn, i) => {
					const on = i === clampedPage;
					btn.className =
						'h-6 w-6 p-1.5 [background-clip:content-box] shrink-0 touch-manipulation rounded-full transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-foreground ' +
						(on ? 'bg-primary-foreground scale-110' : 'bg-muted hover:bg-muted/80');
					if (on) btn.setAttribute('aria-current', 'true');
					else btn.removeAttribute('aria-current');
				});
			}
		}

		function setupSwipeHint() {
			const hintMaybe = swipeHint;
			if (!hintMaybe) return;
			const swipeHintEl = hintMaybe;
			const coarse = window.matchMedia('(pointer: coarse)').matches;
			if (!coarse || sessionStorage.getItem('home-portfolio-carousel-swipe-dismissed')) return;

			swipeHintEl.textContent = '← Glissez pour voir plus →';
			swipeHintEl.classList.remove('hidden');
			swipeHintEl.removeAttribute('aria-hidden');

			function hideSwipeHint() {
				swipeHintEl.classList.add('hidden');
				swipeHintEl.setAttribute('aria-hidden', 'true');
				sessionStorage.setItem('home-portfolio-carousel-swipe-dismissed', '1');
			}

			const onScrollDismiss = () => {
				if (sessionStorage.getItem('home-portfolio-carousel-swipe-dismissed')) return;
				if (track.scrollLeft > 12) hideSwipeHint();
			};

			track.addEventListener('scroll', onScrollDismiss, { passive: true, signal });
			window.setTimeout(hideSwipeHint, 10000);
		}

		prevBtn.addEventListener(
			'click',
			() => {
				track.scrollBy({ left: -getScrollStep(), behavior: scrollBehavior() });
			},
			{ signal },
		);

		nextBtn.addEventListener(
			'click',
			() => {
				track.scrollBy({ left: getScrollStep(), behavior: scrollBehavior() });
			},
			{ signal },
		);

		carouselRoot.addEventListener(
			'keydown',
			(e: Event) => {
				if (!(e instanceof KeyboardEvent)) return;
				if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
				const ae = document.activeElement;
				if (!(ae instanceof Node) || !track.contains(ae)) return;
				e.preventDefault();
				const dir = e.key === 'ArrowLeft' ? -1 : 1;
				track.scrollBy({ left: dir * getScrollStep(), behavior: scrollBehavior() });
			},
			{ capture: true, signal },
		);

		track.addEventListener('scroll', () => updateButtons(false), { passive: true, signal });
		window.addEventListener('resize', scheduleDotRebuild, { signal });

		updateButtons(true);
		setupSwipeHint();

		homePortfolioCarouselTeardown = () => {
			ac.abort();
			homePortfolioCarouselTeardown = undefined;
		};
	}

	setupHomePortfolioCarousel();
	document.addEventListener('astro:after-swap', setupHomePortfolioCarousel);
</script>
