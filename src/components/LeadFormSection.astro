---
---
<section id="lead-form" class="py-16 bg-surface-alt">
	<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="bg-background rounded-2xl shadow-lg border border-border p-6 md:p-8">
			<h2 class="text-3xl font-bold text-foreground">Demander un diagnostic gratuit de votre visibilité</h2>
			<p class="text-muted mt-3">
				Décrivez votre contexte en quelques mots. Je fais le point sur votre visibilité actuelle et vous recommande
				l’offre la plus adaptée, sans engagement.
			</p>

			<form
				name="lead"
				method="POST"
				action="/merci"
				data-netlify="true"
				netlify-honeypot="bot-field"
				data-umami-event="lead_form_submit"
				class="mt-6 space-y-4"
			>
				<input type="hidden" name="form-name" value="lead" />
				<p class="hidden" aria-hidden="true">
					<label for="bot-field">Ne pas remplir</label>
					<input id="bot-field" name="bot-field" type="text" tabindex="-1" autocomplete="off" />
				</p>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div>
						<label for="name" class="block text-sm font-medium text-muted mb-1">Nom et prénom *</label>
						<input id="name" name="name" required class="w-full border border-border rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
					</div>
					<div>
						<label for="email" class="block text-sm font-medium text-muted mb-1">Email *</label>
						<input id="email" name="email" type="email" required class="w-full border border-border rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none" />
					</div>
				</div>
				<div>
				<label for="formule" class="block text-sm font-medium text-muted mb-1">Offre envisagée *</label>
				<select id="formule" name="formule" required class="w-full border border-border rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none">
						<option value="">Sélectionnez une offre</option>
						<option value="serenite">Offre Sérénité — 29€/mois</option>
						<option value="visibilite-confiance">Offre Visibilité &amp; Confiance — 49€/mois</option>
						<option value="indecis">Je ne sais pas encore</option>
					</select>
				</div>
				<div>
					<label for="message" class="block text-sm font-medium text-muted mb-1">Votre situation actuelle *</label>
					<textarea id="message" name="message" rows="5" required class="w-full border border-border rounded-lg px-3 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none" placeholder="Type de pratique, délai, objectifs, éléments déjà disponibles..."></textarea>
				</div>
				<button type="submit" class="w-full bg-primary-foreground text-on-primary py-3 rounded-lg font-semibold hover:opacity-90 transition-colors">
					Demander mon diagnostic gratuit
				</button>
			</form>
		</div>
	</div>
</section>
