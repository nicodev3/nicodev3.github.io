---
export interface Props {
	name: string;
	price: string;
	description: string;
	features: string[];
	buttonLabel: string;
	buttonHref: string;
	recommended?: boolean;
	badgeText?: string;
}

const { name, price, description, features, buttonLabel, buttonHref, recommended = false, badgeText } = Astro.props;

const shellClasses =
	'relative flex flex-col rounded-lg bg-background shadow-sm transition-[transform,box-shadow] duration-200';

const recommendedShell = recommended
	? 'z-10 overflow-visible border-2 border-primary-foreground shadow-md -translate-y-2 md:-translate-y-3'
	: 'overflow-hidden border border-solid border-[oklch(0.9_0_0)] hover:shadow-md';

const articleClass = `${shellClasses} ${recommendedShell}`;
---

<article class={articleClass}>
	{
		recommended && badgeText && (
			<span
				class="type-eyebrow absolute left-1/2 top-0 z-20 max-w-[calc(100%-2rem)] -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded-full bg-primary-foreground px-4 py-1.5 text-center text-on-primary shadow-sm ring-2 ring-background"
			>
				{badgeText}
			</span>
		)
	}

	<div class="flex flex-1 flex-col p-6 sm:p-8">
		<header class="mb-6">
			<h3 class="text-xl font-semibold text-foreground sm:text-2xl">{name}</h3>
			<p class="mt-2 font-heading text-[2.25rem] font-bold leading-[1.08] tracking-tight text-[#0F2A2A] sm:text-[2.5rem]">
				{price}
				<span class="ml-1 font-sans text-base font-normal leading-normal tracking-normal text-muted">/mois</span>
			</p>
			<p class="mt-3 text-sm text-muted sm:text-base">{description}</p>
		</header>

		<ul class="mb-8 space-y-3 text-sm text-muted sm:text-base">
			{features.map((feature) => (
				<li class="flex items-start gap-3">
					<span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-surface text-foreground">
						<svg
							class="h-3 w-3"
							fill="none"
							stroke="currentColor"
							viewBox="0 0 24 24"
							aria-hidden="true"
						>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m4.5 12.75 6 6 9-13.5" />
						</svg>
					</span>
					<span>{feature}</span>
				</li>
			))}
		</ul>

		<div class="mt-auto">
			<a
				href={buttonHref}
				class="btn-primary-solid flex w-full items-center justify-center rounded-lg px-5 py-3 text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
			>
				{buttonLabel}
			</a>
		</div>
	</div>
</article>
