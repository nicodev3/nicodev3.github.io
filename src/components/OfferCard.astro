---
import { CircleCheck } from '@lucide/astro';

export interface Props {
	name: string;
	price: string;
	description: string;
	features: string[];
	buttonLabel: string;
	buttonHref: string;
	recommended?: boolean;
	badgeText?: string;
	/** Cartes tarifs type maquette Stitch. */
	variant?: 'default' | 'stitch';
}

const {
	name,
	price,
	description,
	features,
	buttonLabel,
	buttonHref,
	recommended = false,
	badgeText,
	variant = 'default',
} = Astro.props;

const isStitch = variant === 'stitch';

const shellClasses = isStitch
	? 'relative flex flex-col rounded-lg bg-white p-8 sm:p-10 transition-[border-color,box-shadow,transform] duration-200'
	: 'relative flex flex-col rounded-lg bg-background shadow-sm transition-[transform,box-shadow] duration-200';

const recommendedShell = recommended
	? isStitch
		? 'z-10 overflow-visible border-2 border-primary-foreground shadow-2xl md:scale-[1.05]'
		: 'z-10 overflow-visible border-2 border-primary-foreground shadow-md -translate-y-2 md:-translate-y-3'
	: isStitch
		? 'border border-border hover:border-primary-300/60'
		: 'overflow-hidden border border-solid border-[oklch(0.9_0_0)] hover:shadow-md';

const articleClass = `${shellClasses} ${recommendedShell}`;
const paddingClass = isStitch ? '' : 'p-6 sm:p-8';
---

<article class={articleClass}>
	{
		recommended && badgeText && (
			<span
				class:list={[
					'absolute left-1/2 top-0 z-20 max-w-[calc(100%-2rem)] -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded-full px-6 py-1 text-center shadow-sm',
					isStitch
						? 'type-label-mono bg-primary-foreground font-bold tracking-wider text-on-primary'
						: 'type-eyebrow bg-primary-foreground text-on-primary ring-2 ring-background',
				]}
			>
				{badgeText}
			</span>
		)
	}

	<div class:list={['flex flex-1 flex-col', !isStitch && paddingClass]}>
		<header class:list={[isStitch ? 'mb-8' : 'mb-6']}>
			<h3
				class:list={[
					'font-heading font-semibold text-foreground',
					isStitch ? 'text-2xl sm:text-3xl' : 'text-xl sm:text-2xl',
				]}
			>
				{name}
			</h3>
			<p
				class:list={[
					'mt-2 font-heading font-bold leading-[1.08] tracking-tight text-foreground',
					isStitch ? 'text-4xl sm:text-[2.75rem]' : 'text-[2.25rem] sm:text-[2.5rem]',
				]}
			>
				{price}
				<span class="ml-1 font-sans text-base font-normal tracking-normal text-muted">/mois</span>
			</p>
			<p class:list={['text-muted', isStitch ? 'mt-4 text-base' : 'mt-3 text-sm sm:text-base']}>
				{description}
			</p>
		</header>

		<ul class:list={['flex-grow space-y-4', isStitch ? 'mb-10 text-base text-foreground' : 'mb-8 text-sm text-muted sm:text-base']}>
			{features.map((feature) => (
				<li class="flex items-start gap-3">
					{isStitch ? (
						<CircleCheck
							class="mt-0.5 h-5 w-5 shrink-0 text-primary-foreground"
							stroke-width={1.75}
							aria-hidden="true"
						/>
					) : (
						<span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-surface text-foreground">
							<svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="m4.5 12.75 6 6 9-13.5"
								/>
							</svg>
						</span>
					)}
					<span>{feature}</span>
				</li>
			))}
		</ul>

		<div class="mt-auto">
			<a
				href={buttonHref}
				class:list={[
					'flex w-full items-center justify-center rounded-xl px-5 py-4 text-center font-bold transition-[background-color,opacity,box-shadow] duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background',
					isStitch && recommended
						? 'btn-primary-solid'
						: isStitch
							? 'border border-border text-foreground hover:bg-surface-alt'
							: 'btn-primary-solid',
				]}
			>
				{buttonLabel}
			</a>
			{
				isStitch && (
					<p class="mt-3 text-center type-label-mono text-muted">Sans engagement • Tout inclus</p>
				)
			}
		</div>
	</div>
</article>
