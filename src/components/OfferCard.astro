---
export interface Props {
	name: string;
	price: string;
	description: string;
	features: string[];
	buttonLabel: string;
	buttonHref: string;
	recommended?: boolean;
	badgeText?: string;
}

const { name, price, description, features, buttonLabel, buttonHref, recommended = false, badgeText } = Astro.props;

const baseClasses =
	'relative flex flex-col rounded-2xl border bg-white p-6 sm:p-8 shadow-sm transition-transform transition-shadow duration-200';

const recommendedClasses = recommended
	? ' border-teal-600 bg-gradient-to-b from-teal-50/80 to-white shadow-md ring-1 ring-teal-100 scale-[1.01]'
	: ' border-gray-200 bg-white hover:shadow-md';

const cardClass = `${baseClasses} ${recommendedClasses}`;
---

<article class={cardClass}>
	{recommended && badgeText && (
		<div class="absolute -top-4 left-1/2 -translate-x-1/2">
			<div class="rounded-full bg-teal-700 px-4 py-1 text-xs font-semibold uppercase tracking-wide text-white shadow">
				{badgeText}
			</div>
		</div>
	)}

	<header class="mb-6">
		<h3 class="text-xl font-semibold text-gray-900 sm:text-2xl">{name}</h3>
		<p class="mt-2 text-3xl font-bold text-teal-800 sm:text-4xl">
			{price}
			<span class="ml-1 text-base font-normal text-gray-600">/mois</span>
		</p>
		<p class="mt-3 text-sm text-gray-600 sm:text-base">{description}</p>
	</header>

	<ul class="mb-8 space-y-3 text-sm text-gray-700 sm:text-base">
		{features.map((feature) => (
			<li class="flex gap-3">
				<span class="mt-1 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-teal-100 text-teal-700">
					<svg
						class="h-3 w-3"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m4.5 12.75 6 6 9-13.5" />
					</svg>
				</span>
				<span>{feature}</span>
			</li>
		))}
	</ul>

	<div class="mt-auto">
		<a
			href={buttonHref}
			class="flex w-full items-center justify-center rounded-lg bg-teal-800 px-5 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-teal-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-700 focus-visible:ring-offset-2 focus-visible:ring-offset-gray-50"
		>
			{buttonLabel}
		</a>
	</div>
</article>

