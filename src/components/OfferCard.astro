---
import { CircleCheck } from '@lucide/astro';

export interface Props {
	name: string;
	price: string;
	description: string;
	summary?: string;
	features: string[];
	buttonLabel: string;
	buttonHref: string;
	/** Lien Stripe Payment Link (test ou live). Si défini, bouton principal vers le paiement. */
	subscribeHref?: string;
	subscribeLabel?: string;
	recommended?: boolean;
	badgeText?: string;
	/** Page d’où la carte est affichée (accueil, tarifs…) — utilisé pour la mesure. */
	source?: string;
}

const {
	name,
	price,
	description,
	summary,
	features,
	buttonLabel,
	buttonHref,
	subscribeHref,
	subscribeLabel = "S'abonner",
	recommended = false,
	badgeText,
	source = 'inconnu',
} = Astro.props;

const shellClasses =
	'relative flex flex-col rounded-lg bg-white p-8 sm:p-10 transition-[border-color,box-shadow,transform] duration-200';

const recommendedShell = recommended
	? 'z-10 overflow-visible border-2 border-primary-foreground shadow-2xl md:scale-[1.05]'
	: 'border border-border hover:border-primary-300/60';

const articleClass = `${shellClasses} ${recommendedShell}`;

const primaryButtonClass = [
	'flex w-full items-center justify-center rounded-xl px-5 py-4 text-center font-bold transition-[background-color,opacity,box-shadow] duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background',
	'btn-primary-solid',
];

const outlineButtonClass = [
	'flex w-full items-center justify-center rounded-xl px-5 py-4 text-center font-bold transition-[background-color,opacity,box-shadow] duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background',
	'border border-border text-foreground hover:bg-surface-alt',
];

const secondaryLinkClass =
	'block text-center text-sm font-medium text-muted underline decoration-border underline-offset-4 transition-colors hover:text-foreground';
---

<article class={articleClass}>
	{
		recommended && badgeText && (
			<span class="type-label-mono absolute left-1/2 top-0 z-20 max-w-[calc(100%-2rem)] -translate-x-1/2 -translate-y-1/2 whitespace-nowrap rounded-full bg-primary-foreground px-6 py-1 text-center font-bold tracking-wider text-on-primary shadow-sm">
				{badgeText}
			</span>
		)
	}

	<div class="flex flex-1 flex-col">
		<header class="mb-8">
			<h3 class="font-heading text-2xl font-semibold text-foreground sm:text-3xl">{name}</h3>
			<p class="mt-2 font-heading text-4xl font-bold leading-[1.08] tracking-tight text-foreground sm:text-[2.75rem]">
				{price}
				<span class="ml-1 font-sans text-base font-normal tracking-normal text-muted">/mois</span>
			</p>
			<p class="mt-4 text-base text-muted">{description}</p>
			{summary && (
				<p class="mt-4 border-l-2 border-primary-foreground pl-3 text-sm font-semibold leading-relaxed text-foreground">
					{summary}
				</p>
			)}
		</header>

		<ul class="mb-10 flex-grow space-y-4 text-base text-foreground">
			{features.map((feature) => (
				<li class="flex items-start gap-3">
					<CircleCheck
						class="mt-0.5 h-5 w-5 shrink-0 text-primary-foreground"
						stroke-width={1.75}
						aria-hidden="true"
					/>
					<span>{feature}</span>
				</li>
			))}
		</ul>

		<div class="mt-auto flex flex-col gap-3" data-suppress-whatsapp-when-visible>
			{
				subscribeHref ? (
					<>
						<a
							href={subscribeHref}
							class:list={primaryButtonClass}
							rel="noopener noreferrer"
							data-umami-event="stripe_payment_link_click"
							data-umami-event-offer={name}
							data-umami-event-source={source}
						>
							{subscribeLabel}
						</a>
						<a
							href={buttonHref}
							class={secondaryLinkClass}
							data-umami-event="lead_click_devis_from_offers"
							data-umami-event-offer={name}
							data-umami-event-source={source}
							data-lead-source={`offres-${source}`}
						>
							{buttonLabel}
						</a>
					</>
				) : (
					<a
						href={buttonHref}
						class:list={!recommended ? outlineButtonClass : primaryButtonClass}
						data-umami-event="lead_click_devis_from_offers"
						data-umami-event-offer={name}
						data-umami-event-source={source}
						data-lead-source={`offres-${source}`}
					>
						{buttonLabel}
					</a>
				)
			}
			<p class="mt-0 text-center type-label-mono text-muted">Sans engagement • Tout inclus</p>
		</div>
	</div>
</article>
