---
import OfferCard from './OfferCard.astro';
import { TARIFS_TRUST_SIGNALS } from '../data/tarifs-trust-signals';

export interface Props {
	background?: 'surface' | 'white' | 'background';
}

const { background = 'surface' } = Astro.props;

const stripePaymentLinkSerenite = import.meta.env.PUBLIC_STRIPE_PAYMENT_LINK_SERENITE?.trim();
const stripePaymentLinkVisibilite = import.meta.env.PUBLIC_STRIPE_PAYMENT_LINK_VISIBILITE?.trim();
const hasStripePaymentLinks = Boolean(stripePaymentLinkSerenite && stripePaymentLinkVisibilite);
const bgClass = { surface: 'bg-surface', white: 'bg-white', background: 'bg-background' }[background];

const serenityFeatures = [
	'Création ou refonte du site et accompagnement pour clarifier les textes',
	'Hébergement, nom de domaine et sauvegardes inclus*',
	'Intégration de votre widget ou lien de prise de RDV (Doctolib, Qare, Maiia, Calendly...)',
	'Mentions légales, informations obligatoires et base RGPD',
	'1 modification simple par mois (texte, photo, tarif, horaires ou lien RDV)',
];

const visibilityFeatures = [
	"Tout le contenu de l'offre Sérénité",
	'Rédaction régulière de contenus pour soutenir votre visibilité locale',
	'Fiche Google Business Profile mise en place ou optimisée',
	'Optimisation SEO locale et suivi mensuel des performances*',
	'Mises à jour de vos contenus courants : tarifs, horaires, spécialités, photos et pages déjà présentes',
	'Modernisation annuelle du site pour garder une présence claire et rassurante',
];
---

<section
	id="tarifs-offres"
	class:list={['section-y relative scroll-mt-28 border-b border-border', bgClass]}
	data-suppress-whatsapp-when-visible
>
	<span id="offres" class="absolute -mt-28" aria-hidden="true"></span>
	<div class="shell-layout">
		<header class="shell-prose mx-auto text-center">
			<h2 class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				Créer votre site, puis le faire vivre selon vos besoins
			</h2>
			<p class="mt-4 text-base text-muted sm:text-lg">
				Les deux formules comprennent la création du site, l’hébergement et la maintenance. La seconde ajoute
				un travail régulier sur votre présence dans les recherches locales.
			</p>
		</header>

		<div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-10 pt-0 md:grid-cols-2 lg:gap-12">
			<OfferCard
				name="Sérénité"
				price="29€"
				description="Pour créer ou refaire le site de votre cabinet, le relier à votre prise de rendez-vous et déléguer la partie technique."
				summary="Site + maintenance essentielle"
				features={serenityFeatures}
				buttonLabel={hasStripePaymentLinks ? 'Échanger avant de choisir' : 'Demander un échange'}
				buttonHref="/devis/"
				subscribeHref={stripePaymentLinkSerenite}
				subscribeLabel="Démarrer avec Sérénité"
			/>

			<OfferCard
				name="Visibilité & Confiance"
				price="49€"
				description="Pour travailler aussi la visibilité locale du cabinet, la fiche Google et les contenus du site dans la durée."
				summary="Site + SEO local + contenus + suivi"
				features={visibilityFeatures}
				buttonLabel={hasStripePaymentLinks ? 'Échanger avant de choisir' : 'Demander un échange'}
				buttonHref="/devis/"
				subscribeHref={stripePaymentLinkVisibilite}
				subscribeLabel="Démarrer avec Visibilité"
				recommended={true}
				badgeText="Recommandée"
			/>
		</div>

		<div class="mx-auto mt-10 max-w-4xl border-y border-border py-6">
			<h3 class="text-center font-heading text-xl font-semibold text-foreground">Pour vous repérer</h3>
			<div class="mt-5 grid gap-4 md:grid-cols-2">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.05em] text-primary">Sérénité</p>
					<p class="mt-2 text-sm leading-relaxed text-muted sm:text-base">
						Pour disposer d’un site professionnel que vous n’avez pas à construire, héberger ni maintenir
						vous-même.
					</p>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.05em] text-primary">Visibilité &amp; Confiance</p>
					<p class="mt-2 text-sm leading-relaxed text-muted sm:text-base">
						Pour ajouter un travail suivi sur votre visibilité locale, votre fiche Google et vos contenus.
						Voir la page{' '}
						<a
							href="/referencement-site-psychologue/"
							class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
						>
							référencement site psychologue
						</a>.
					</p>
				</div>
			</div>
		</div>

		<ul class="mx-auto mt-8 grid max-w-4xl gap-3 text-sm text-muted sm:grid-cols-3">
			{TARIFS_TRUST_SIGNALS.map((label) => (
				<li class="flex items-start gap-2">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-foreground"></span>
					<span>{label}</span>
				</li>
			))}
		</ul>

		{
			hasStripePaymentLinks && (
				<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-muted">
					Le paiement en ligne s’effectue sur une page sécurisée Stripe. Vous pouvez aussi commencer par un échange via le
					formulaire de devis.
				</p>
			)
		}

		<p class="mx-auto mt-6 max-w-3xl text-center text-xs leading-relaxed text-muted sm:text-sm">
			* Un nom de domaine coûte souvent autour de 10 à 30 € par an et un hébergement fiable autour de 8 à 40 € par
			mois lorsqu'ils sont pris séparément. Ici, ils sont inclus dans l'abonnement. La visibilité Google dépend
			ensuite de votre ville, de la concurrence locale et de la qualité des contenus.
		</p>
	</div>
</section>
