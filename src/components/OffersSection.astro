---
import { ArrowRight } from '@lucide/astro';
import OfferCard from './OfferCard.astro';
import EditionSurPageDemo from './EditionSurPageDemo.astro';
import { TARIFS_TRUST_SIGNALS } from '../data/tarifs-trust-signals';
import {
	PRICING_HEADLINE,
	PRICING_LEAD,
	SETUP_FEE_AMOUNT,
	SETUP_FEE_LABEL,
	SERENITE_MONTHLY,
	VISIBILITE_MONTHLY,
	SERENITE_MONTHLY_SPACED,
	VISIBILITE_MONTHLY_SPACED,
} from '../data/pricing';

export interface Props {
	background?: 'surface' | 'white' | 'background';
	/** Page hôte, distingue les clics accueil / tarifs dans la mesure d’audience. */
	source?: string;
	/** Accueil : cartes et intro courtes, détail sur /tarifs/. */
	variant?: 'full' | 'home';
}

const { background = 'surface', source = 'tarifs', variant = 'full' } = Astro.props;
const isHome = variant === 'home';

const stripePaymentLinkSerenite = import.meta.env.PUBLIC_STRIPE_PAYMENT_LINK_SERENITE?.trim();
const stripePaymentLinkVisibilite = import.meta.env.PUBLIC_STRIPE_PAYMENT_LINK_VISIBILITE?.trim();
const hasStripePaymentLinks = Boolean(stripePaymentLinkSerenite && stripePaymentLinkVisibilite);
const bgClass = { surface: 'bg-surface', white: 'bg-white', background: 'bg-background' }[background];

const serenityFeatures = [
	'Création ou refonte du site (0 € de frais de construction) et accompagnement pour clarifier les textes',
	'Hébergement, nom de domaine et sauvegardes inclus*',
	'Publier des articles',
	'Bases de référencement (SEO), fiche Google et bouton de rendez-vous (Doctolib, Perfactive ou autre)',
	'Veille SEO : je surveille votre visibilité, je détecte les problèmes et je corrige',
	'Mentions légales, base RGPD (protection des données), 1 modification simple par mois',
];

/** Accueil : trois inclusions qui distinguent vraiment les formules, le détail reste sur /tarifs/. */
const serenityHomeFeatures = [
	'Création ou refonte du site, textes clarifiés avec vous',
	'Hébergement, nom de domaine, fiche Google et bases de référencement inclus',
	'1 modification simple par mois',
];

const visibilityHomeFeatures = [
	'Tout Sérénité, avec 3 modifications simples par mois',
	'Support prioritaire et aide à la rédaction de vos contenus',
	'Suivi approfondi de votre visibilité dans Google et les assistants IA, modernisation annuelle du site',
];

const visibilityFeatures = [
	"Tout le contenu de l'offre Sérénité",
	{
		text: 'Modifier textes et tarifs directement sur la page, sans panneau d’administration séparé',
		badge: 'Nouveau',
	},
	{
		text: 'Connexion aux agents IA via MCP',
		detail: 'Utilisez l’IA pour modifier ou créer des contenus directement dans votre site.',
		badge: 'Nouveau',
	},
	'Support prioritaire : réponses plus rapides, modifications traitées en premier',
	'Analyse et optimisation approfondies de votre visibilité dans Google et les réponses des assistants IA**',
	'Aide à la rédaction : relecture, reformulation et idées d’articles à publier',
	'3 modifications simples par mois au lieu d’une, et modernisation annuelle du site',
];
---

<section
	id="tarifs-offres"
	class:list={['section-y relative scroll-mt-28 border-b border-border', bgClass]}
	data-suppress-whatsapp-when-visible
>
	<span id="offres" class="absolute -mt-28" aria-hidden="true"></span>
	<div class="shell-layout">
		<header class="shell-prose mx-auto text-center">
			<h2 class="text-balance font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				{isHome ? 'Deux formules, tout compris' : PRICING_HEADLINE}
			</h2>
			<p class="mt-4 text-pretty text-base text-muted sm:text-lg">
				{
					isHome ? (
						<>
							29&nbsp;€ ou 49&nbsp;€ par mois, soit 348&nbsp;€ ou 588&nbsp;€ par an, sans facture de construction.{' '}
							<strong class="font-semibold text-foreground">Sans engagement de durée</strong>&nbsp;: vous pouvez résilier à
							tout moment, avec effet à la fin du mois déjà payé, et le site et le nom de domaine vous sont remis.
						</>
					) : (
						<>
							{PRICING_LEAD} Les deux formules comprennent l’hébergement, les bases du référencement et la fiche Google.
							À 49 €, vous pouvez aussi modifier vos contenus directement sur la page, avec trois modifications simples
							par mois au lieu d’une, le support prioritaire, une aide à la rédaction et un travail de visibilité plus
							approfondi.
						</>
					)
				}
			</p>
		</header>

		{!isHome && <EditionSurPageDemo />}

		{
			!isHome && (
		<aside
			class="mx-auto mt-8 grid max-w-4xl grid-cols-1 gap-4 sm:grid-cols-2"
			aria-label="Coût de construction et propriété du site"
		>
			<div class="rounded-xl border border-primary/30 bg-white px-4 py-5 shadow-sm sm:px-6">
				<p class="type-label-mono text-primary">Aucun coût de base</p>
				<p class="mt-2 font-heading text-2xl font-semibold text-foreground">
					{SETUP_FEE_AMOUNT}
					<span class="ml-1 font-sans text-base font-normal text-muted">pour construire le site</span>
				</p>
				<p class="mt-2 text-sm leading-relaxed text-muted sm:text-base">
					Pas de devis à plusieurs milliers d’euros, pas de facture de création. Ensuite uniquement{' '}
					{SERENITE_MONTHLY_SPACED} ou {VISIBILITE_MONTHLY_SPACED} par mois, selon la formule.
				</p>
			</div>
			<div class="rounded-xl border border-border bg-white px-4 py-5 shadow-sm sm:px-6">
				<p class="type-label-mono text-primary">Votre site, pas une location</p>
				<p class="mt-2 font-heading text-2xl font-semibold text-foreground">Il vous appartient</p>
				<p class="mt-2 text-sm leading-relaxed text-muted sm:text-base">
					L’hébergement et le suivi s’arrêtent à la fin de la période déjà payée. Sur demande, je vous remets
					une copie exploitable du site et transfère le nom de domaine pour permettre son réhébergement ailleurs.
				</p>
			</div>
		</aside>
			)
		}

		<div class:list={['mx-auto mt-10 grid max-w-4xl grid-cols-1 pt-0 md:grid-cols-2', isHome ? 'gap-6 lg:gap-8' : 'gap-10 lg:gap-12']}>
			<OfferCard
				name="Sérénité"
				price={SERENITE_MONTHLY}
				setupPrice={isHome ? undefined : SETUP_FEE_AMOUNT}
				setupLabel={SETUP_FEE_LABEL}
				description={isHome ? undefined : 'Pour créer ou refaire le site de votre cabinet, y placer votre bouton de rendez-vous (Doctolib, Perfactive ou autre) et déléguer la technique.'}
				audience={isHome ? 'Si vous voulez un site juste et stable, que vous modifiez rarement.' : undefined}
				anchorId="offre-serenite"
				summary={isHome ? undefined : 'Site + hébergement + suivi technique + fiche Google'}
				features={isHome ? serenityHomeFeatures : serenityFeatures}
				showAction={!isHome}
				buttonLabel="Demander un diagnostic gratuit"
				buttonHref="/diagnostic-gratuit/"
				subscribeHref={stripePaymentLinkSerenite}
				subscribeLabel="Démarrer avec Sérénité"
				source={source}
			/>

			<OfferCard
				name="Visibilité & Confiance"
				price={VISIBILITE_MONTHLY}
				setupPrice={isHome ? undefined : SETUP_FEE_AMOUNT}
				setupLabel={SETUP_FEE_LABEL}
				description={isHome ? undefined : 'Pour faire évoluer votre site avec davantage de soutien : modifications plus fréquentes, aide à la rédaction et travail approfondi sur votre visibilité dans Google et les réponses des assistants IA.'}
				audience={isHome ? 'Si vous comptez publier, modifier souvent ou travailler votre visibilité.' : undefined}
				anchorId="offre-visibilite"
				summary={isHome ? undefined : '3 modifications par mois + support prioritaire + aide à la rédaction'}
				features={isHome ? visibilityHomeFeatures : visibilityFeatures}
				showAction={!isHome}
				buttonLabel="Demander un diagnostic gratuit"
				buttonHref="/diagnostic-gratuit/"
				subscribeHref={stripePaymentLinkVisibilite}
				subscribeLabel="Démarrer avec Visibilité"
				source={source}
			/>
		</div>

		{
			isHome && (
				<p class="mx-auto mt-6 max-w-2xl text-pretty text-center text-sm leading-relaxed text-muted">
					Le suivi de visibilité ne garantit ni une position dans Google ni une citation par un assistant IA.
				</p>
			)
		}

		{
			isHome && (
				<div class="mx-auto mt-10 flex max-w-xl flex-col items-center gap-3 text-center" data-suppress-whatsapp-when-visible>
					<p class="font-heading text-xl font-semibold text-foreground">Vous hésitez entre les deux&nbsp;?</p>
					<p class="text-balance text-base text-muted">Le diagnostic gratuit vous aide à choisir, ou à décider qu’un site n’est pas encore utile.</p>
					<a
						href="/diagnostic-gratuit/"
						class="btn-primary-solid mt-2 inline-flex items-center justify-center rounded-xl px-8 py-4 font-bold"
						data-analytics-event="lead_click_diagnostic"
						data-analytics-cta="diagnostic"
						data-analytics-location={`offres_${source}`}
						data-lead-source={`offres-${source}`}
						data-suppress-header-diagnostic-when-visible
					>
						Demander un diagnostic gratuit
					</a>
					<p class="text-sm text-muted">4 questions en ligne · retour sous 48&nbsp;h ouvrées · sans engagement</p>
					<a
						href="/tarifs/"
						class="mt-2 inline-flex min-h-11 items-center gap-2 font-semibold text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary"
						data-umami-event="lead_click_tarifs_from_home_offers"
					>
						Comparer les offres en détail
						<ArrowRight class="h-4 w-4" stroke-width={1.75} aria-hidden="true" />
					</a>
				</div>
			)
		}

		{
			!isHome && (
		<div class="mx-auto mt-10 max-w-4xl border-y border-border py-6">
			<h3 class="text-center font-heading text-xl font-semibold text-foreground">Pour vous repérer</h3>
			<div class="mt-5 grid gap-4 md:grid-cols-2">
				<div>
					<p class="text-sm font-semibold uppercase tracking-wider text-primary">Sérénité</p>
					<p class="mt-2 text-sm leading-relaxed text-muted sm:text-base">
						Un site professionnel avec hébergement, fiche Google et suivi technique. Une modification simple
						par mois est incluse ; vous pouvez aussi publier des articles.
					</p>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase tracking-wider text-primary">Visibilité &amp; Confiance</p>
					<p class="mt-2 text-sm leading-relaxed text-muted sm:text-base">
						La même base, avec l’édition sur la page, la connexion aux agents IA (MCP) pour créer ou modifier
						vos contenus, trois modifications simples par mois, le support prioritaire, une aide à la rédaction
						et une modernisation annuelle. Le travail de
						visibilité est également plus approfondi. Voir la page{' '}
						<a
							href="/referencement-site-psychologue/"
							class="font-medium text-foreground underline decoration-primary/40 underline-offset-4 transition-colors hover:text-primary hover:decoration-primary"
						>
							référencement site psychologue
						</a>.
					</p>
				</div>
			</div>
		</div>
			)
		}

		{
			!isHome && (
		<ul class="mx-auto mt-8 grid max-w-4xl gap-3 text-sm text-muted sm:grid-cols-2 lg:grid-cols-4">
			{TARIFS_TRUST_SIGNALS.map((label) => (
				<li class="flex items-start gap-2">
					<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-primary-foreground"></span>
					<span>{label}</span>
				</li>
			))}
		</ul>
			)
		}

		{
			hasStripePaymentLinks && !isHome && (
				<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-muted">
					Le paiement en ligne s’effectue sur une page sécurisée Stripe. Si vous hésitez encore, commencez par un
					diagnostic gratuit.
				</p>
			)
		}

		{
			!isHome && (
				<>
					<p class="mx-auto mt-6 max-w-3xl text-center text-xs leading-relaxed text-muted sm:text-sm">
						* Un nom de domaine coûte souvent autour de 10 à 30 € par an et un hébergement fiable autour de 8 à 40 € par
						mois lorsqu'ils sont pris séparément. Ici, ils sont inclus dans l'abonnement.
					</p>
					<p class="mx-auto mt-2 max-w-3xl text-center text-xs leading-relaxed text-muted sm:text-sm">
						** Ce travail complète la veille déjà incluse dans Sérénité : analyse et optimisation du site pour les
						recherches Google et les réponses des assistants IA. Il ne garantit ni une position dans Google ni une
						citation dans une réponse IA. Les résultats dépendent aussi de votre ville, de la concurrence et des contenus publiés.
					</p>
				</>
			)
		}
	</div>
</section>
