---
export interface ProcessStep {
	title: string;
	description: string;
}

const steps: ProcessStep[] = [
	{
		title: 'Nous faisons le point',
		description:
			'Lors d’un premier échange, vous me présentez votre pratique, votre situation et ce que vous attendez du site. Je vous indique ce qui me paraît utile, ou non.',
	},
	{
		title: 'Vous me transmettez la matière',
		description:
			'Un questionnaire vous guide sur votre parcours, votre approche et vos modalités. Je structure les pages, reformule les textes et réalise le site.',
	},
	{
		title: 'Vous relisez, je mets en ligne',
		description:
			'Vous découvrez une version de travail et nous l’ajustons ensemble. Après votre accord, je mets en ligne, et la facturation de l’abonnement commence alors.',
	},
];
---

<section id="comment-ca-marche" class="section-y scroll-mt-28 border-b border-border bg-white">
	<div class="shell-layout">
		<div class="mb-10 text-center md:mb-14">
			<h2 class="text-balance font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				Ce que vous avez à faire, et ce que je prends en charge
			</h2>
			<p class="mx-auto mt-4 max-w-2xl text-pretty text-muted sm:text-lg">
				Trois étapes, du premier échange à la mise en ligne. Comptez généralement deux à trois semaines.
			</p>
		</div>

		<ol class="process-steps mx-auto grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-3 md:gap-10">
			{steps.map((step, index) => (
				<li class="process-step">
					<span class="process-step__marker" aria-hidden="true">{index + 1}</span>
					<h3 class="mt-4 text-balance font-heading text-xl font-semibold leading-tight text-foreground">
						<span class="sr-only">Étape {index + 1} : </span>{step.title}
					</h3>
					<p class="mt-3 text-pretty text-base leading-relaxed text-muted">{step.description}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.process-step {
		position: relative;
	}

	.process-step__marker {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--color-primary-foreground);
		border-radius: 9999px;
		background: var(--color-neutral-0);
		color: var(--color-primary-foreground);
		font-family: var(--font-heading);
		font-size: var(--text-lg);
		font-weight: 600;
		font-variant-numeric: lining-nums tabular-nums;
	}

	/* Desktop : un trait relie les étapes pour lire la séquence. */
	@media (min-width: 768px) {
		.process-step:not(:last-child)::after {
			content: '';
			position: absolute;
			top: 1.25rem;
			left: 3.25rem;
			right: -1.75rem;
			border-top: 1px solid var(--color-border);
		}
	}
</style>
