---
export interface ProcessStep {
	title: string;
	description: string;
}

const steps: ProcessStep[] = [
	{
		title: 'On situe votre besoin',
		description: 'Un échange court pour comprendre votre pratique, votre ville et ce que le site doit vraiment porter.',
	},
	{
		title: 'Je structure avec vous',
		description: 'Vous répondez simplement aux questions utiles ; je mets en forme les contenus, les pages et le parcours.',
	},
	{
		title: 'On ajuste puis on met en ligne',
		description: 'Vous relisez une version de test, on corrige ce qui doit l’être, puis je m’occupe de la mise en ligne.',
	},
];
---

<section id="comment-ca-marche" class="section-y scroll-mt-28 border-b border-border bg-white">
	<div class="shell-layout">
		<div class="mb-10 text-center md:mb-16">
			<h2 class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				Un déroulé simple, sans jargon technique
			</h2>
			<p class="mx-auto mt-3 max-w-2xl text-muted">
				L’objectif n’est pas de vous faire devenir webmaster, mais de traduire votre cadre de pratique dans un site
				lisible.
			</p>
		</div>

		<div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-3 md:gap-8">
			{steps.map((step, index) => (
				<div class="process-step group space-y-4">
					<span class="type-label-mono text-muted transition-colors group-hover:text-primary-foreground">
						{String(index + 1).padStart(2, '0')}
					</span>
					<h3 class="font-heading text-xl font-semibold leading-tight text-foreground">{step.title}</h3>
					<p class="text-base leading-relaxed text-muted">{step.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
