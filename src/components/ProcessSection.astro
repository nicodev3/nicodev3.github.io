---
export interface ProcessStep {
	title: string;
	description: string;
}

const steps: ProcessStep[] = [
	{
		title: 'Nous faisons le point',
		description:
			'Lors d’un premier échange, vous me présentez votre pratique, votre situation et ce que vous attendez du site. Je vous indique ce qui me paraît utile — ou non.',
	},
	{
		title: 'Vous me transmettez la matière',
		description:
			'Un questionnaire vous guide sur votre parcours, votre approche et vos modalités. Je structure les pages, reformule les textes et réalise le site.',
	},
	{
		title: 'Vous relisez, je mets en ligne',
		description:
			'Vous découvrez une version de travail et nous l’ajustons ensemble. Après votre accord, je gère la mise en ligne, puis la maintenance.',
	},
];
---

<section id="comment-ca-marche" class="section-y scroll-mt-28 border-b border-border bg-white">
	<div class="shell-layout">
		<div class="mb-10 text-center md:mb-16">
			<h2 class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				Ce que vous avez à faire — et ce que je prends en charge
			</h2>
			<p class="mx-auto mt-3 max-w-2xl text-muted">
				Vous restez responsable de ce qui est dit sur votre pratique. Je prends en charge la structure,
				l’écriture web et toute la réalisation technique. Comptez généralement deux à trois semaines.
			</p>
		</div>

		<div class="mx-auto grid max-w-5xl grid-cols-1 gap-8 md:grid-cols-3 md:gap-8">
			{steps.map((step, index) => (
				<div class="process-step group space-y-4">
					<span class="type-label-mono text-muted transition-colors group-hover:text-primary-foreground">
						{String(index + 1).padStart(2, '0')}
					</span>
					<h3 class="font-heading text-xl font-semibold leading-tight text-foreground">{step.title}</h3>
					<p class="text-base leading-relaxed text-muted">{step.description}</p>
				</div>
			))}
		</div>
	</div>
</section>
