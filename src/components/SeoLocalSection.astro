---
import { ArrowRight, ListChecks, Search, TrendingUp, UserSearch } from '@lucide/astro';

const searchExamples = [
	'psychologue Sceaux',
	'psychomotricien Lyon',
	'psychothérapeute Bordeaux',
	'psychologue enfant Nantes',
] as const;

const benefits = [
	{
		Icon: TrendingUp,
		title: 'Signaux locaux plus clairs :',
		text: 'votre activité, votre zone et vos informations pratiques sont plus faciles à comprendre.',
	},
	{
		Icon: UserSearch,
		title: 'Visiteurs plus qualifiés :',
		text: 'des personnes qui cherchent activement un praticien près de chez elles.',
	},
	{
		Icon: ListChecks,
		title: 'Parcours de contact plus simple :',
		text: 'les informations essentielles réduisent les hésitations avant la prise de rendez-vous.',
	},
] as const;

const setupItems = [
	{
		title: 'Structure de pages claire',
		description: 'Hiérarchie optimisée pour les robots de recherche.',
		optimized: true,
	},
	{
		title: 'Titres & contenus optimisés',
		description: 'Mots-clés stratégiques intégrés naturellement.',
		optimized: true,
	},
	{
		title: 'Balises meta',
		description: 'Descriptions soignées pour faciliter la compréhension et le clic.',
		optimized: true,
	},
	{
		title: 'Performance',
		description: "Site rapide et stable, utile pour l'expérience mobile et la qualité technique.",
		optimized: true,
	},
	{
		title: 'Plan de site',
		description: "Sitemap XML pour faciliter l'exploration des pages importantes.",
		optimized: true,
	},
	{
		title: 'Données structurées',
		description: 'Schema.org pour aider Google à comprendre votre activité.',
		optimized: true,
	},
] as const;
---

<section id="seo-local" class="section-y scroll-mt-28 border-y border-border bg-surface-alt">
	<div class="shell-layout">
		<header class="mb-12 space-y-4 text-center md:mb-16">
			<h2 class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">
				Référencement local : apparaître quand on cherche un praticien près de chez soi
			</h2>
			<p class="mx-auto max-w-3xl text-lg text-muted">
				Vos futurs patients tapent souvent des recherches du type «&nbsp;profession&nbsp;» + leur ville ou quartier.
				Un site bien structuré aide Google à comprendre votre activité, votre localisation et vos modalités d'accueil.
			</p>
		</header>

		<div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-2">
			<div class="space-y-8">
				<div class="rounded-lg border border-border bg-white p-6 shadow-sm sm:p-8">
					<h3 class="mb-6 flex items-center gap-2 font-heading text-xl font-semibold text-primary-foreground">
						<Search class="h-6 w-6 shrink-0" stroke-width={1.5} aria-hidden="true" />
						Exemples concrets de recherches Google
					</h3>
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						{
							searchExamples.map((example) => (
								<div class="flex items-center gap-3 rounded-lg bg-surface-alt p-3">
									<Search
										class="h-[18px] w-[18px] shrink-0 text-primary-foreground"
										stroke-width={1.5}
										aria-hidden="true"
									/>
									<span class="type-label-mono text-foreground">{example}</span>
								</div>
							))
						}
					</div>
				</div>

				<div>
					<h3 class="mb-4 font-heading text-xl font-semibold text-foreground">Ce que ça change pour vous</h3>
					<ul class="space-y-4">
						{
							benefits.map(({ Icon, title, text }) => (
								<li class="flex items-start gap-3">
									<Icon
										class="mt-0.5 h-5 w-5 shrink-0 text-primary-foreground"
										stroke-width={1.5}
										aria-hidden="true"
									/>
									<p class="text-base text-muted">
										<strong class="font-semibold text-foreground">{title}</strong>
										{text}
									</p>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			<div class="rounded-lg border border-border bg-white p-6 sm:p-8">
				<h3 class="mb-8 font-heading text-xl font-semibold text-foreground">Ce que je mets en place</h3>
				<div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
					{
						setupItems.map(({ title, description, optimized }) => (
							<div class="space-y-2">
								<h4 class="flex flex-wrap items-center gap-2 font-semibold text-foreground">
									{title}
									{
										optimized && (
											<span class="rounded px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-[#00685d] bg-[color-mix(in_srgb,#008376_18%,transparent)]">
												Optimisé
											</span>
										)
									}
								</h4>
								<p class="text-sm text-muted">{description}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>

		<p class="mx-auto max-w-2xl pt-8 text-center text-base text-muted">
			Approfondir&nbsp;: pages dédiées{' '}
			<a href="/referencement-site-psychologue/" class="font-medium text-foreground underline-offset-2 hover:text-primary hover:underline">
				référencement site psychologue
			</a>
			{', '}
			<a href="/site-internet-psychomotricien/" class="font-medium text-foreground underline-offset-2 hover:text-primary hover:underline">
				site internet psychomotricien
			</a>
			{' '}et guide blog{' '}
			<a href="/blog/guide-complet-visibilite-en-ligne-psychologues/" class="font-medium text-foreground underline-offset-2 hover:text-primary hover:underline">
				visibilité en ligne pour psychologues
			</a>.
		</p>

		<div class="flex flex-wrap justify-center gap-4 pt-8 md:gap-6 md:pt-10">
			<a
				href="/diagnostic-gratuit/"
				data-suppress-header-diagnostic-when-visible
				class="btn-primary-solid inline-flex items-center justify-center gap-2 rounded-xl px-8 py-4"
			>
				Demander un diagnostic gratuit
				<ArrowRight class="h-5 w-5" stroke-width={1.75} aria-hidden="true" />
			</a>
			<a
				href="/creation-site-internet-psychologue/"
				class="btn-outline-terracotta inline-flex items-center justify-center rounded-xl border border-border bg-transparent px-8 py-4 font-bold text-foreground hover:bg-surface-alt"
			>
				Page psychologues
			</a>
			<a
				href="/site-internet-psychomotricien/"
				class="btn-outline-terracotta inline-flex items-center justify-center rounded-xl border border-border bg-transparent px-8 py-4 font-bold text-foreground hover:bg-surface-alt"
			>
				Page psychomotriciens
			</a>
			<a
				href="/tarifs/"
				class="btn-outline-terracotta inline-flex items-center justify-center rounded-xl border border-border bg-transparent px-8 py-4 font-bold text-foreground hover:bg-surface-alt"
			>
				Voir les tarifs
			</a>
		</div>
	</div>
</section>
