---
import { INSTAGRAM_HREF, SOCIAL_HANDLE_DISPLAY, WHATSAPP_HREF } from '../data/contact';

const baseUrl = Astro.site ?? Astro.url.origin;
const homePageUrl = new URL('/', baseUrl).href;

const footerLinkClass =
	'font-medium text-muted transition-colors hover:text-primary-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/35 focus-visible:ring-offset-2 focus-visible:ring-offset-surface-alt rounded-sm';
---

<footer class="border-t border-border bg-surface-alt py-16 md:py-20">
	<div class="shell-layout">
		<div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-5 md:gap-12">
			<div class="space-y-5 md:col-span-2">
				<h3 class="font-heading text-2xl font-semibold text-foreground">
					<a href="/" class="transition-opacity hover:opacity-90" aria-label="nicodev. — retour à l’accueil">
						<span class="text-foreground">nico</span><span class="text-primary-500">dev.</span>
					</a>
				</h3>
				<p class="max-w-sm text-base text-muted">
					Développeur web, psychologue et psychomotricien, spécialisé dans les sites internet sobres
					pour psychologues, psychomotriciens, ergothérapeutes et orthophonistes.
				</p>
				<address class="text-sm text-muted not-italic">
					Accompagnement à distance partout en France
				</address>
				<div class="flex flex-wrap gap-4 text-sm">
					<a href="/contact/" class={footerLinkClass}>Contact</a>
					<a
						href={WHATSAPP_HREF}
						class={footerLinkClass}
						target="_blank"
						rel="noopener noreferrer"
						data-umami-event="lead_click_whatsapp_from_footer"
					>
						WhatsApp {SOCIAL_HANDLE_DISPLAY}
					</a>
					<a
						href={INSTAGRAM_HREF}
						class={footerLinkClass}
						target="_blank"
						rel="me noopener noreferrer"
						data-umami-event="lead_click_instagram_from_footer"
					>
						Instagram {SOCIAL_HANDLE_DISPLAY}
					</a>
					<a
						href="https://www.linkedin.com/in/nicodev3/"
						class={footerLinkClass}
						target="_blank"
						rel="me noopener noreferrer"
					>
						LinkedIn
					</a>
					<a
						href="https://github.com/nicodev3"
						class={footerLinkClass}
						target="_blank"
						rel="me noopener noreferrer"
					>
						GitHub
					</a>
				</div>
			</div>
			<div class="space-y-3">
				<h4 class="type-label-mono text-foreground">Services</h4>
				<ul class="space-y-2 text-base">
					<li>
						<a href="/creation-site-internet-psychologue/" class={footerLinkClass}>Sites psychologues</a>
					</li>
					<li>
						<a href="/site-internet-psychomotricien/" class={footerLinkClass}>Sites psychomotriciens</a>
					</li>
					<li>
						<a href="/referencement-site-psychologue/" class={footerLinkClass}>Référencement</a>
					</li>
					<li>
						<a href="/diagnostic-gratuit/" class={footerLinkClass}>Diagnostic gratuit</a>
					</li>
					<li>
						<a href="/blog/installer-liberal-psychologue-par-ou-commencer/" class={footerLinkClass}
							>Guide installation</a
						>
					</li>
					<li>
						<a href="/tarifs/#faq-modifications" class={footerLinkClass}>Maintenance web</a>
					</li>
				</ul>
			</div>
			<div class="space-y-3">
				<h4 class="type-label-mono text-foreground">Outils gratuits</h4>
				<ul class="space-y-2 text-base">
					<li>
						<a href="/outils/" class={footerLinkClass}>Tous les outils</a>
					</li>
					<li>
						<a href="/outils/micro-bnc-auto-entrepreneur/" class={footerLinkClass}>Calculateur micro-BNC</a>
					</li>
					<li>
						<a href="/outils/seuil-viabilite-seances/" class={footerLinkClass}>Seuil de viabilité</a>
					</li>
					<li>
						<a href="/outils/visibilite-web-diagnostic/" class={footerLinkClass}>Diagnostic visibilité</a>
					</li>
					<li>
						<a href="/outils/generateur-mentions-legales/" class={footerLinkClass}>Générateur de mentions légales</a>
					</li>
				</ul>
			</div>
			<div class="space-y-3">
				<h4 class="type-label-mono text-foreground">Légal</h4>
				<ul class="space-y-2 text-base">
					<li>
						<a href="/plan-du-site/" class={footerLinkClass}>Plan du site</a>
					</li>
					<li>
						<a href="/mentions-legales/" class={footerLinkClass}>Mentions légales</a>
					</li>
					<li>
						<a href="/politique-confidentialite/" class={footerLinkClass}>Politique de confidentialité</a>
					</li>
					<li>
						<a href="/cgv/" class={footerLinkClass}>CGV</a>
					</li>
					<li>
						<a href="/contact/" class={footerLinkClass}>Contact</a>
					</li>
				</ul>
			</div>
		</div>

		<div
			class="flex flex-col items-center justify-between gap-4 border-t border-border pt-8 text-center md:flex-row md:text-left"
		>
			<p class="type-label-mono text-muted">
				© 2011–{new Date().getFullYear()} Nicolas Devaux — EI · SIRET 751 032 699 00033
			</p>
			<p class="type-label-mono text-muted">Fait avec soin à Paris</p>
		</div>
	</div>
</footer>
