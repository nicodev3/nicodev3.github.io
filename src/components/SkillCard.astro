---
export interface Props {
	title: string;
	description: string;
	centered?: boolean;
}

const { title, description, centered = true } = Astro.props;
---

<div class={`bg-opaline-50 p-6 rounded-lg shadow-lg border border-opaline-200 ${centered ? 'text-center' : ''}`}>
	<div class={`w-16 h-16 bg-opaline-100 rounded-full flex items-center justify-center ${centered ? 'mx-auto' : ''} mb-4`}>
		<div class="text-foreground">
			<slot name="icon" />
		</div>
	</div>
	<h3 class="text-lg font-semibold text-foreground mb-2">{title}</h3>
	<p class={`text-mutedText ${centered ? 'text-sm' : ''}`}>
		{description}
	</p>
</div>
