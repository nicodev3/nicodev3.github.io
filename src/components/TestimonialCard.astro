---
export interface Props {
	quote: string;
	author: string;
}

const { quote, author } = Astro.props;
---

<blockquote
	class="group relative flex h-full flex-col rounded-2xl border border-border/70 bg-background/80 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5"
>
	<div class="pointer-events-none absolute inset-x-6 top-0 h-16 bg-gradient-to-b from-primary/5 to-transparent opacity-0 blur-xl transition-opacity duration-300 group-hover:opacity-100" />
	<div class="relative">
		<div class="mb-4 inline-flex items-center gap-2 text-xs font-medium text-primary/80">
			<span class="flex h-6 w-6 items-center justify-center rounded-full bg-primary/10 text-primary">
				<span class="text-lg leading-none">“</span>
			</span>
			<span class="uppercase tracking-[0.18em] text-[0.65rem] text-muted">Témoignage client</span>
		</div>
		<p class="text-sm leading-relaxed text-foreground/90 mb-5">
			{quote}
		</p>
	</div>
	<footer class="mt-auto flex items-center gap-3 text-sm text-muted">
		<div class="h-9 w-9 rounded-full bg-gradient-to-tr from-primary/70 via-primary to-primary/60 opacity-90 shadow-sm ring-2 ring-background/90" />
		<div class="flex flex-col text-left">
			<span class="font-medium text-foreground">{author}</span>
			<span class="text-xs text-muted">Psychologue accompagnée avec un site clé en main</span>
		</div>
	</footer>
</blockquote>
