---
export interface Props {
	quote: string;
	highlight?: string;
	author: string;
}

const { quote, highlight, author } = Astro.props;
---

<blockquote class="bg-white rounded-xl border border-gray-200 p-6">
	<p class="text-gray-700">{quote}</p>
	{highlight && (
		<p class="text-gray-700 mt-3 italic">
			<span class="font-medium not-italic">Le + :</span> {highlight}
		</p>
	)}
	<footer class="mt-4 text-sm text-gray-500">{author}</footer>
</blockquote>
