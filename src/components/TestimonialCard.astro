---
import { Star } from '@lucide/astro';

export interface Props {
	quote: string;
	author: string;
	/** 0–2 : palette de cercle distincte pour chaque carte */
	variant?: number;
	/** Carte témoignage type maquette Stitch. */
	style?: 'default' | 'stitch';
	/** Plateforme d’origine de l’avis */
	source?: 'malt' | 'google';
	/** Note sur 5 (avis Google) */
	rating?: number;
}

const { quote, author, variant = 0, style = 'default', source = 'malt', rating } = Astro.props;

const isStitch = style === 'stitch';
const isGoogle = source === 'google';
const isMalt = source === 'malt';

const firstName = author.split(',')[0]?.trim() ?? '';
const shortAuthor = isStitch
	? author.includes(',')
		? `${firstName}, ${author.split(',')[1]?.trim() ?? ''}`
		: author
	: author;

const initial =
	firstName.length > 0 ? firstName.charAt(0).toLocaleUpperCase('fr-FR') : isGoogle ? 'G' : '?';

const VARIANT_CLASSES = [
	'bg-primary/20 text-primary-foreground shadow-sm ring-2 ring-primary/25',
	'bg-[color-mix(in_srgb,var(--color-link)_16%,var(--color-background))] text-[color:var(--color-link)] shadow-sm ring-2 ring-[color-mix(in_srgb,var(--color-link)_38%,transparent)]',
	'bg-[color-mix(in_srgb,var(--color-foreground)_12%,var(--color-background))] text-foreground shadow-sm ring-2 ring-foreground/18',
] as const;

const paletteIdx = Math.min(Math.max(variant, 0), VARIANT_CLASSES.length - 1);
const avatarPalette = isStitch
	? isGoogle
		? 'bg-[color-mix(in_srgb,#4285F4_14%,var(--color-background))] text-[#1a73e8] font-bold'
		: 'bg-primary-100 text-primary-foreground font-bold'
	: isGoogle
		? 'bg-[color-mix(in_srgb,#4285F4_14%,var(--color-background))] text-[#1a73e8] font-bold'
		: VARIANT_CLASSES[paletteIdx];

const avatarLabel = isGoogle
	? 'Logo Google'
	: firstName.length > 0
		? `Initiale « ${initial} », ${firstName}`
		: `Initiale « ${initial} »`;

const sourceLabel = isMalt ? 'Avis malt.fr' : 'Avis Google';
const sourceBadgeClass = isMalt
	? 'border-[color-mix(in_srgb,#FC5757_35%,var(--color-border))] bg-[color-mix(in_srgb,#FC5757_8%,var(--color-background))] text-[#c73e3e]'
	: 'border-[color-mix(in_srgb,#4285F4_35%,var(--color-border))] bg-[color-mix(in_srgb,#4285F4_8%,var(--color-background))] text-[#1a73e8]';

const footerNote = isMalt
	? 'Recommandation publiée sur malt.fr'
	: 'Avis publié sur Google (fiche nicodev)';

const starCount = typeof rating === 'number' ? Math.min(Math.max(Math.round(rating), 0), 5) : 5;
const showStars = isStitch || isGoogle;
---

{
	isStitch ? (
		<blockquote class="flex h-full flex-col rounded-lg border border-border bg-white p-8">
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
				<span
					class:list={[
						'inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold tracking-wide',
						sourceBadgeClass,
					]}
				>
					{sourceLabel}
				</span>
				{
					showStars && (
						<div
							class:list={['flex gap-0.5', !isGoogle && 'text-primary-foreground']}
							aria-hidden="true"
						>
							{Array.from({ length: 5 }).map((_, i) => {
								const filled = i < starCount;
								return (
									<Star
										class:list={[
											'h-5 w-5',
											isGoogle
												? filled
													? 'fill-[#FBBC04] text-[#FBBC04]'
													: 'fill-none text-[#DADCE0]'
												: filled
													? 'fill-current'
													: 'fill-none opacity-25',
										]}
										stroke-width={filled ? 0 : 1.5}
									/>
								);
							})}
						</div>
					)
				}
			</div>
			{quote ? <p class="mb-8 flex-grow text-base italic leading-relaxed text-muted">{quote}</p> : null}
			<footer class="flex items-center gap-3">
				<div
					class:list={[
						'flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm',
						avatarPalette,
					]}
					role="img"
					aria-label={avatarLabel}
				>
					{initial}
				</div>
				<div class="flex min-w-0 flex-col text-left">
					<span class="font-semibold text-foreground">{shortAuthor}</span>
					<span class="text-xs text-muted">{footerNote}</span>
				</div>
			</footer>
		</blockquote>
	) : (
		<blockquote class="group relative flex h-full flex-col rounded-lg border border-border/70 bg-background/80 p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/50 hover:shadow-md">
			<div class="pointer-events-none absolute inset-x-6 top-0 h-16 bg-gradient-to-b from-primary/5 to-transparent opacity-0 blur-xl transition-opacity duration-300 group-hover:opacity-100" />
			<div class="relative">
				<div class="mb-4 flex flex-wrap items-center gap-2">
					<span
						class:list={[
							'inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold tracking-wide',
							sourceBadgeClass,
						]}
					>
						{sourceLabel}
					</span>
					{!isMalt && <span class="type-eyebrow text-muted">Google Business Profile</span>}
				</div>
				{quote ? <p class="mb-5 text-sm leading-relaxed text-foreground/90">{quote}</p> : null}
			</div>
			<footer class="mt-auto flex items-center gap-3 text-sm text-muted">
				<div
					class:list={[
						'flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm font-semibold tracking-tight ring-offset-2 ring-offset-background',
						avatarPalette,
					]}
					role="img"
					aria-label={avatarLabel}
				>
					{initial}
				</div>
				<div class="flex flex-col text-left">
					<span class="font-medium text-foreground">{author}</span>
					<span class="text-xs text-muted">{footerNote}</span>
				</div>
			</footer>
		</blockquote>
	)
}
