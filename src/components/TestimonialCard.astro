---
export interface Props {
	quote: string;
	highlight?: string;
	author: string;
}

const { quote, highlight, author } = Astro.props;
---

<blockquote class="bg-opaline-50 rounded-xl border border-opaline-200 p-6">
	<p class="text-mutedText">{quote}</p>
	{highlight && (
		<p class="text-mutedText mt-3 italic">
			<span class="font-medium not-italic">Le + :</span> {highlight}
		</p>
	)}
	<footer class="mt-4 text-sm text-mutedText">{author}</footer>
</blockquote>
