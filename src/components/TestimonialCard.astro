---
export interface Props {
	quote: string;
	highlight?: string;
	author: string;
}

const { quote, highlight, author } = Astro.props;
---

<blockquote class="bg-background rounded-xl border border-border p-6">
	<p class="text-muted">{quote}</p>
	{highlight && (
		<p class="text-muted mt-3 italic">
			<span class="font-medium not-italic">Le + :</span> {highlight}
		</p>
	)}
	<footer class="mt-4 text-sm text-muted">{author}</footer>
</blockquote>
