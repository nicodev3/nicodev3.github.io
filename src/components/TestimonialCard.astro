---
import { Star } from '@lucide/astro';
import GoogleIcon from './GoogleIcon.astro';

export interface Props {
	quote: string;
	author: string;
	websiteUrl?: string;
	websiteLabel?: string;
	/** Plateforme d’origine de l’avis */
	source?: 'malt' | 'google';
	/** Note sur 5 (avis Google) */
	rating?: number;
}

const { quote, author, websiteUrl, websiteLabel, source = 'malt', rating } = Astro.props;

const isGoogle = source === 'google';
const isMalt = source === 'malt';

const firstName = author.split(',')[0]?.trim() ?? '';
const shortAuthor = author.includes(',')
	? `${firstName}, ${author.split(',')[1]?.trim() ?? ''}`
	: author;

const initial =
	firstName.length > 0 ? firstName.charAt(0).toLocaleUpperCase('fr-FR') : isGoogle ? 'G' : '?';

const avatarPalette = isGoogle
	? 'bg-white shadow-sm ring-1 ring-[color-mix(in_srgb,#4285F4_22%,var(--color-border))]'
	: 'bg-primary-100 text-primary-foreground font-bold';

const avatarLabel = isGoogle
	? 'Logo Google'
	: firstName.length > 0
		? `Initiale « ${initial} », ${firstName}`
		: `Initiale « ${initial} »`;

const sourceLabel = isMalt ? 'Avis malt.fr' : 'Avis Google';
const sourceBadgeClass = isMalt
	? 'border-[color-mix(in_srgb,#FC5757_35%,var(--color-border))] bg-[color-mix(in_srgb,#FC5757_8%,var(--color-background))] text-[#c73e3e]'
	: 'border-[color-mix(in_srgb,#4285F4_35%,var(--color-border))] bg-[color-mix(in_srgb,#4285F4_8%,var(--color-background))] text-[#1a73e8]';

const footerNote = isMalt
	? 'Recommandation publiée sur malt.fr'
	: 'Avis publié sur Google (fiche nicodev)';

const starCount = typeof rating === 'number' ? Math.min(Math.max(Math.round(rating), 0), 5) : 5;
const showStars = true;
---

<blockquote class="flex h-full flex-col rounded-lg border border-border bg-white p-8">
	<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
		<span
			class:list={[
				'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-semibold tracking-wide',
				sourceBadgeClass,
			]}
		>
				{isGoogle ? <GoogleIcon class="h-3.5 w-3.5" /> : null}
				{sourceLabel}
			</span>
		{
			showStars && (
				<div class:list={['flex gap-0.5', !isGoogle && 'text-primary-foreground']} aria-hidden="true">
					{Array.from({ length: 5 }).map((_, i) => {
						const filled = i < starCount;
						return (
							<Star
								class:list={[
									'h-5 w-5',
									isGoogle
										? filled
											? 'fill-[#FBBC04] text-[#FBBC04]'
											: 'fill-none text-[#DADCE0]'
										: filled
											? 'fill-current'
											: 'fill-none opacity-25',
								]}
								stroke-width={filled ? 0 : 1.5}
							/>
						);
					})}
				</div>
			)
		}
	</div>
	{quote ? <p class="mb-8 flex-grow text-base italic leading-relaxed text-muted">{quote}</p> : null}
	<footer class="flex items-center gap-3">
		<div
			class:list={[
				'flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-sm',
				avatarPalette,
			]}
			role="img"
			aria-label={avatarLabel}
		>
			{isGoogle ? <GoogleIcon class="h-5 w-5" /> : initial}
		</div>
		<div class="flex min-w-0 flex-col text-left">
			<span class="font-semibold text-foreground">{shortAuthor}</span>
			<span class="text-xs text-muted">{footerNote}</span>
			{
				websiteUrl && websiteLabel ? (
					<a
						href={websiteUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="text-xs font-semibold text-primary-foreground underline decoration-primary-foreground/35 underline-offset-4 hover:decoration-primary-foreground"
					>
						{websiteLabel}
					</a>
				) : null
			}
		</div>
	</footer>
</blockquote>
