---
import { ArrowUpRight, Star } from '@lucide/astro';
import { GOOGLE_REVIEWS_URL, googleTestimonials } from '../data/testimonials';

/**
 * Trois avis Google, choisis pour ce qu’ils disent du travail avec un confrère :
 * le premier est mis en avant, les deux suivants l’accompagnent.
 * Les recommandations Malt ne sont pas affichées ici (pas de note publiée).
 */
const FEATURED = 'Stéphanie Requet-Catinean';
const SUPPORTING = ['Séverine Reisser', 'Audrey Larcebau'];

const pick = (short: string) => {
	const found = googleTestimonials.find((t) => t.short === short);
	if (!found) throw new Error(`Avis introuvable : « ${short} »`);
	return found;
};

/** Extraits fidèles (passages coupés signalés par […]) pour les avis trop longs ; l’avis complet reste sur Google. */
const EXCERPTS: Record<string, string> = {
	'Séverine Reisser':
		'J’ai confié la création de mes sites à Nicolas en 2019 et j’ai toujours été très satisfaite de notre collaboration depuis. Au delà de la partie technique, il a su me conseiller judicieusement autant sur le fond que sur la forme […]',
};

const featured = pick(FEATURED);
const supporting = SUPPORTING.map(pick).map((t) => ({ ...t, excerpt: EXCERPTS[t.short] }));
const roleOf = (author: string) => author.split(',')[1]?.trim() ?? 'Psychologue';
const reviewCount = googleTestimonials.length;
const allFiveStars = googleTestimonials.every((t) => t.rating === 5);
---

<section
	id="temoignages"
	class="testimonials section-y scroll-mt-28 bg-foreground text-on-foreground"
	aria-labelledby="temoignages-heading"
>
	<div class="shell-layout">
		<div class="mx-auto max-w-5xl">
			<div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3">
				<h2 id="temoignages-heading" class="text-balance font-heading text-2xl font-semibold text-on-foreground sm:text-3xl">
					Ce qu’en disent les psychologues accompagnés
				</h2>
				<p class="testimonials__source flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
					{allFiveStars && (
						<span class="flex gap-0.5" aria-hidden="true">
							{Array.from({ length: 5 }).map(() => (
								<Star class="h-4 w-4 fill-current" stroke-width={0} />
							))}
						</span>
					)}
					<a
						href={GOOGLE_REVIEWS_URL}
						target="_blank"
						rel="noopener noreferrer"
						class="testimonials__link inline-flex min-h-11 items-center gap-1 underline underline-offset-4"
					>
						{reviewCount} avis Google{allFiveStars ? ', tous à 5/5' : ''}
						<span class="sr-only">(nouvel onglet)</span>
						<ArrowUpRight class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
					</a>
				</p>
			</div>

			<figure class="mt-10 md:mt-14">
				<blockquote>
					<p class="testimonials__featured text-pretty font-heading">
						«&nbsp;{featured.quote}&nbsp;»
					</p>
				</blockquote>
				<figcaption class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-base">
					<span class="font-semibold text-on-foreground">{featured.short}</span>
					<span class="testimonials__muted">{roleOf(featured.author)}</span>
					{featured.websiteUrl && (
						<a
							href={featured.websiteUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="testimonials__link inline-flex min-h-11 items-center gap-1 underline underline-offset-4"
						>
							{featured.websiteLabel}
							<span class="sr-only">(nouvel onglet)</span>
							<ArrowUpRight class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
						</a>
					)}
				</figcaption>
			</figure>

			<div class="testimonials__supporting mt-12 grid gap-10 pt-10 md:mt-16 md:grid-cols-2 md:gap-14">
				{supporting.map((t) => (
					<figure class="flex flex-col">
						<blockquote class="grow">
							<p class="text-pretty text-base leading-relaxed text-on-foreground/90 sm:text-lg">
								«&nbsp;{t.excerpt ?? t.quote}&nbsp;»
							</p>
							{t.excerpt && (
								<a
									href={GOOGLE_REVIEWS_URL}
									target="_blank"
									rel="noopener noreferrer"
									class="testimonials__link mt-1 inline-flex min-h-11 items-center gap-1 text-sm underline underline-offset-4"
								>
									Lire l’avis complet sur Google
									<span class="sr-only">(nouvel onglet)</span>
								</a>
							)}
						</blockquote>
						<figcaption class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
							<span class="font-semibold text-on-foreground">{t.short}</span>
							<span class="testimonials__muted">{roleOf(t.author)}</span>
							{t.websiteUrl && (
								<a
									href={t.websiteUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="testimonials__link inline-flex min-h-11 items-center gap-1 underline underline-offset-4"
								>
									{t.websiteLabel}
									<span class="sr-only">(nouvel onglet)</span>
									<ArrowUpRight class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
								</a>
							)}
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	.testimonials__source {
		color: color-mix(in srgb, var(--color-on-foreground) 78%, transparent);
	}

	.testimonials__source svg {
		color: var(--color-primary-300);
	}

	.testimonials__featured {
		font-size: clamp(1.375rem, 1.6vw + 1rem, 2.375rem);
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.01em;
		max-width: 34ch;
	}

	.testimonials__muted {
		color: color-mix(in srgb, var(--color-on-foreground) 72%, transparent);
	}

	/* primary-100 sur fond sombre : contraste AA pour le petit texte (primary-300 reste aux étoiles). */
	.testimonials__link {
		color: var(--color-primary-100);
		text-decoration-color: color-mix(in srgb, var(--color-primary-100) 45%, transparent);
		transition: text-decoration-color 160ms ease-out;
	}

	.testimonials__link:hover {
		text-decoration-color: var(--color-primary-100);
	}

	.testimonials__link:focus-visible {
		outline: 2px solid var(--color-primary-100);
		outline-offset: 3px;
		border-radius: var(--radius-sm);
	}

	.testimonials__supporting {
		border-top: 1px solid color-mix(in srgb, var(--color-on-foreground) 18%, transparent);
	}
</style>
