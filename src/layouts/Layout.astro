---
import type { ImageMetadata } from "astro";
import { Font } from "astro:assets";
import globalStylesUrl from "../styles/global.css?url";
import Header from "../components/Header.astro";
import ProfessionsSection from "../components/ProfessionsSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
import defaultOgImage from "../assets/images/blog/development.webp";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

export interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  noindex?: boolean;
  showFloatingWhatsApp?: boolean;
  /** Masque en impression (PDF navigateur) l’en-tête, le bandeau professions et le pied de page. */
  omitSiteChromeInPrint?: boolean;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}

const {
  title,
  description = "Nicolas Devaux est développeur web, psychologue et psychomotricien. Il crée des sites internet pour psychologues, psychomotriciens et professions du soin proches.",
  image,
  noindex = false,
  showFloatingWhatsApp = true,
  omitSiteChromeInPrint = false,
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, baseUrl).toString();
const ogImageSrc = image
  ? typeof image === "string"
    ? image
    : image.src
  : defaultOgImage.src;
const ogImage = new URL(ogImageSrc, baseUrl).toString();
const umamiId =
  import.meta.env.UMAMI_WEBSITE_ID ??
  import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL ?? import.meta.env.UMAMI_URL;
const umamiScriptSrc = umamiUrl ? `${umamiUrl.replace(/\/+$/, "")}/script.js` : "";
const ahrefsAnalyticsKey =
  import.meta.env.PUBLIC_AHREFS_ANALYTICS_KEY ??
  import.meta.env.AHREFS_ANALYTICS_KEY;

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Polices avant la CSS bloquante : les @font-face sont connus en parallèle du fetch CSS ; Source Sans en premier (corps). -->
    <Font cssVariable="--font-source-sans-3" />
    <Font cssVariable="--font-source-serif-4" />
    <link rel="preload" href={globalStylesUrl} as="style" />
    <link rel="stylesheet" href={globalStylesUrl} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Nicolas Devaux" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      ogType === "article" && articlePublishedTime && (
        <meta
          property="article:published_time"
          content={articlePublishedTime}
        />
      )
    }
    {
      ogType === "article" && articleModifiedTime && (
        <meta property="article:modified_time" content={articleModifiedTime} />
      )
    }
    {
      ogType === "article" && articleAuthor && (
        <meta property="article:author" content={articleAuthor} />
      )
    }

    <title>{title}</title>
    <slot name="head" />
    {umamiId && umamiUrl && (
      <script
        defer
        src={umamiScriptSrc}
        data-website-id={umamiId}
      ></script>
    )}
    {ahrefsAnalyticsKey && (
      <script
        src="https://analytics.ahrefs.com/analytics.js"
        data-key={ahrefsAnalyticsKey}
        async
      ></script>
    )}
  </head>
  <body
    class:list={[
      "bg-background text-foreground",
      omitSiteChromeInPrint && "omit-site-chrome-in-print",
    ]}
  >
    <Header />

    <!-- Contenu `position:fixed` relatif au viewport (évite un ancêtre transform/filter qui casse fixed dans <main>) -->
    <slot name="body-fixed" />

    {showFloatingWhatsApp ? <FloatingWhatsApp /> : null}

    <main>
      <slot />
    </main>

    <ProfessionsSection />

    <SiteFooter />

    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        function initScrollReveal() {
          var sections = document.querySelectorAll("main > section");
          if (!sections.length) return;
          var first = document.querySelector("main > section:first-of-type");
          for (var i = 0; i < sections.length; i++) {
            sections[i].classList.add("scroll-reveal");
          }
          var io = new IntersectionObserver(
            function (entries, obs) {
              for (var j = 0; j < entries.length; j++) {
                var e = entries[j];
                if (e.isIntersecting) {
                  e.target.classList.add("scroll-reveal--visible");
                  obs.unobserve(e.target);
                }
              }
            },
            { root: null, rootMargin: "0px 0px -6% 0px", threshold: 0.02 }
          );
          for (var k = 0; k < sections.length; k++) {
            if (sections[k] !== first) io.observe(sections[k]);
          }
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initScrollReveal, { once: true });
        } else {
          initScrollReveal();
        }
      })();
    </script>
  </body>
</html>
