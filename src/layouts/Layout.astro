---
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import defaultOgImage from "../assets/images/blog/development.webp";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import { getCanonicalUrl, normalizeCanonicalPath } from "../utils/seo";

export interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  noindex?: boolean;
  showFloatingWhatsApp?: boolean;
  /** Masque en impression (PDF navigateur) l’en-tête, le bandeau professions et le pied de page. */
  omitSiteChromeInPrint?: boolean;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}

const {
  title,
	description = "Psychologue et développeur web, Nicolas Devaux crée et référence des sites internet pour les psychologues en libéral.",
  image,
  noindex = false,
  showFloatingWhatsApp = true,
  omitSiteChromeInPrint = false,
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url.origin;
const canonicalPath = normalizeCanonicalPath(Astro.url.pathname);
const canonical = getCanonicalUrl(Astro.url.pathname, baseUrl);
/* Pages tags : utiles à la navigation mais pauvres pour Google — noindex en gardant le maillage (follow). */
const isBlogTagPage = canonicalPath.startsWith("/blog/tag/");
const robotsContent = isBlogTagPage
  ? "noindex, follow"
  : noindex
    ? "noindex, nofollow"
    : "index, follow";
const ogImageSrc = image
  ? typeof image === "string"
    ? image
    : image.src
  : defaultOgImage.src;
const ogImage = new URL(ogImageSrc, baseUrl).toString();
const umamiId =
  import.meta.env.UMAMI_WEBSITE_ID ??
  import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL ?? import.meta.env.UMAMI_URL;
const umamiScriptSrc = umamiUrl ? `${umamiUrl.replace(/\/+$/, "")}/script.js` : "";
const ahrefsAnalyticsKey =
  import.meta.env.PUBLIC_AHREFS_ANALYTICS_KEY ??
  import.meta.env.AHREFS_ANALYTICS_KEY;

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Nicolas Devaux" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      ogType === "article" && articlePublishedTime && (
        <meta
          property="article:published_time"
          content={articlePublishedTime}
        />
      )
    }
    {
      ogType === "article" && articleModifiedTime && (
        <meta property="article:modified_time" content={articleModifiedTime} />
      )
    }
    {
      ogType === "article" && articleAuthor && (
        <meta property="article:author" content={articleAuthor} />
      )
    }

    <title>{title}</title>
    <slot name="head" />
    {umamiId && umamiUrl && (
      <script
        defer
        src={umamiScriptSrc}
        data-website-id={umamiId}
        data-domains="nicodev.fr,www.nicodev.fr"
        data-exclude-search="true"
        data-exclude-hash="true"
        data-do-not-track="true"
      ></script>
    )}
    {ahrefsAnalyticsKey && (
      <script
        src="https://analytics.ahrefs.com/analytics.js"
        data-key={ahrefsAnalyticsKey}
        data-cfasync="false"
        async
      ></script>
    )}
  </head>
  <body
    class:list={[
      "bg-background text-foreground",
      omitSiteChromeInPrint && "omit-site-chrome-in-print",
    ]}
  >
    <Header />

    <!-- Contenu `position:fixed` relatif au viewport (évite un ancêtre transform/filter qui casse fixed dans <main>) -->
    <slot name="body-fixed" />

    {showFloatingWhatsApp ? <FloatingWhatsApp /> : null}

    <main>
      <slot />
    </main>

    <SiteFooter />

    <script>
      import { initAnalytics } from "../utils/analytics";

      initAnalytics();
      document.addEventListener("astro:page-load", initAnalytics);
    </script>

    <script is:inline>
      (function () {
        document.addEventListener("click", function (event) {
          var link = event.target && event.target.closest
            ? event.target.closest("a[data-lead-source]")
            : null;
          if (!link) return;
          var source = link.getAttribute("data-lead-source");
          if (!source) return;
          try {
            window.sessionStorage.setItem("nicodevLeadSource", source);
          } catch (_) {
            // Tracking storage is optional; navigation should never depend on it.
          }
        });
      })();
    </script>

    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        function revealIfInViewport(section) {
          var rect = section.getBoundingClientRect();
          var viewHeight = window.innerHeight || document.documentElement.clientHeight;
          if (rect.top < viewHeight && rect.bottom > 0) {
            section.classList.add("scroll-reveal--visible");
          }
        }
        function initScrollReveal() {
          var sections = document.querySelectorAll("main > section");
          if (!sections.length) return;
          var first = document.querySelector("main > section:first-of-type");
          for (var i = 0; i < sections.length; i++) {
            sections[i].classList.add("scroll-reveal");
          }
          var io = new IntersectionObserver(
            function (entries, obs) {
              for (var j = 0; j < entries.length; j++) {
                var e = entries[j];
                if (e.isIntersecting) {
                  e.target.classList.add("scroll-reveal--visible");
                  obs.unobserve(e.target);
                }
              }
            },
            { root: null, rootMargin: "0px 0px -2% 0px", threshold: 0 }
          );
          for (var k = 0; k < sections.length; k++) {
            if (sections[k] === first) continue;
            if (sections[k].hasAttribute("data-scroll-reveal-skip")) {
              sections[k].classList.add("scroll-reveal--visible");
              continue;
            }
            revealIfInViewport(sections[k]);
            io.observe(sections[k]);
          }
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initScrollReveal, { once: true });
        } else {
          initScrollReveal();
        }
      })();
    </script>
  </body>
</html>
