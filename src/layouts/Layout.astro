---
import type { ImageMetadata } from "astro";
import { Font } from "astro:assets";
import globalStylesUrl from "../styles/global.css?url";
import ObfuscatedEmail from "../components/ObfuscatedEmail.astro";
import Header from "../components/Header.astro";
import ProfessionsSection from "../components/ProfessionsSection.astro";
import defaultOgImage from "../assets/images/blog/development.webp";

export interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  noindex?: boolean;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}

const {
  title,
  description = "Nicolas Devaux est développeur web et crée des sites internet pour psychologues.",
  image,
  noindex = false,
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, baseUrl).toString();
const ogImageSrc = image
  ? typeof image === "string"
    ? image
    : image.src
  : defaultOgImage.src;
const ogImage = new URL(ogImageSrc, baseUrl).toString();

const umamiId =
  import.meta.env.UMAMI_WEBSITE_ID ??
  import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL ?? import.meta.env.UMAMI_URL;
const umamiScriptSrc = umamiUrl ? `${umamiUrl.replace(/\/+$/, "")}/script.js` : "";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={globalStylesUrl} as="style" />
    <link rel="stylesheet" href={globalStylesUrl} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Nicolas Devaux" />
    <meta property="og:locale" content="fr_FR" />
    <Font
      cssVariable="--font-source-sans-3"
      preload={[{ weight: "400 700", style: "normal", subset: "latin" }]}
    />
    <Font
      cssVariable="--font-lora"
      preload={[{ weight: "400 700", style: "normal", subset: "latin" }]}
    />
    {
      ogType === "article" && articlePublishedTime && (
        <meta
          property="article:published_time"
          content={articlePublishedTime}
        />
      )
    }
    {
      ogType === "article" && articleModifiedTime && (
        <meta property="article:modified_time" content={articleModifiedTime} />
      )
    }
    {
      ogType === "article" && articleAuthor && (
        <meta property="article:author" content={articleAuthor} />
      )
    }

    <title>{title}</title>
    <slot name="head" />
    {umamiId && umamiUrl && (
      <script
        defer
        src={umamiScriptSrc}
        data-website-id={umamiId}
      ></script>
    )}
  </head>
  <body class="bg-background text-foreground">
    <Header />

    <!-- Contenu `position:fixed` relatif au viewport (évite un ancêtre transform/filter qui casse fixed dans <main>) -->
    <slot name="body-fixed" />

    <main>
      <slot />
    </main>

    <ProfessionsSection />

    <footer class="bg-foreground text-on-foreground py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-semibold mb-4">Nicolas Devaux</h3>
            <p class="text-on-foreground">
              Développeur web et psychologue spécialisé dans la création de
              sites internet pour psychologues.
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Services</h3>
            <ul class="space-y-2 text-on-foreground">
              <li>Création de sites internet</li>
              <li>Visibilité locale sur Google</li>
              <li>Design responsive</li>
              <li>Maintenance web</li>
              <li>
                <a href="/exemples-sites-psychologue/" class="hover:opacity-80"
                  >Exemples de sites psychologues</a
                >
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Contact</h3>
            <p class="text-on-foreground">
              Email: <ObfuscatedEmail class="text-on-foreground hover:opacity-80" /><br />
              GitHub: <a
                href="https://github.com/nicodev3"
                class="text-on-foreground hover:opacity-80">@nicodev3</a
              >
            </p>
          </div>
        </div>
        <div
          class="border-t border-border mt-8 pt-8 text-center text-on-foreground"
        >
          <p>
            <a href="/cgv/" class="text-on-foreground hover:opacity-80"
              >Conditions générales de vente</a
            >
            <span class="mx-2">|</span>
            &copy; 2011-2026 Nicolas Devaux. Tous droits réservés.
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        function initScrollReveal() {
          var sections = document.querySelectorAll("main > section");
          if (!sections.length) return;
          var first = document.querySelector("main > section:first-of-type");
          for (var i = 0; i < sections.length; i++) {
            sections[i].classList.add("scroll-reveal");
          }
          var io = new IntersectionObserver(
            function (entries, obs) {
              for (var j = 0; j < entries.length; j++) {
                var e = entries[j];
                if (e.isIntersecting) {
                  e.target.classList.add("scroll-reveal--visible");
                  obs.unobserve(e.target);
                }
              }
            },
            { root: null, rootMargin: "0px 0px -6% 0px", threshold: 0.02 }
          );
          for (var k = 0; k < sections.length; k++) {
            if (sections[k] !== first) io.observe(sections[k]);
          }
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initScrollReveal, { once: true });
        } else {
          initScrollReveal();
        }
      })();
    </script>
  </body>
</html>
