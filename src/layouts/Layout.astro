---
import type { ImageMetadata } from "astro";
import { Font } from "astro:assets";
import globalStylesUrl from "../styles/global.css?url";
import ObfuscatedEmail from "../components/ObfuscatedEmail.astro";
import Header from "../components/Header.astro";
import ProfessionsSection from "../components/ProfessionsSection.astro";
import defaultOgImage from "../assets/images/blog/development.webp";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";

export interface Props {
  title: string;
  description?: string;
  image?: string | ImageMetadata;
  noindex?: boolean;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}

const {
  title,
  description = "Nicolas Devaux est développeur web et crée des sites internet pour psychologues.",
  image,
  noindex = false,
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, baseUrl).toString();
const ogImageSrc = image
  ? typeof image === "string"
    ? image
    : image.src
  : defaultOgImage.src;
const ogImage = new URL(ogImageSrc, baseUrl).toString();
const homePageUrl = new URL('/', baseUrl).href;

const umamiId =
  import.meta.env.UMAMI_WEBSITE_ID ??
  import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL ?? import.meta.env.UMAMI_URL;
const umamiScriptSrc = umamiUrl ? `${umamiUrl.replace(/\/+$/, "")}/script.js` : "";

/** Pied de page : soulignement animé au survol (voir `.footer-animated-underline` dans global.css). */
const footerLinkClass = "footer-animated-underline text-on-foreground";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={globalStylesUrl} as="style" />
    <link rel="stylesheet" href={globalStylesUrl} />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Nicolas Devaux" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <Font
      cssVariable="--font-source-sans-3"
      preload={[{ weight: "400 700", style: "normal", subset: "latin" }]}
    />
    <Font
      cssVariable="--font-lora"
      preload={[{ weight: "400 700", style: "normal", subset: "latin" }]}
    />
    {
      ogType === "article" && articlePublishedTime && (
        <meta
          property="article:published_time"
          content={articlePublishedTime}
        />
      )
    }
    {
      ogType === "article" && articleModifiedTime && (
        <meta property="article:modified_time" content={articleModifiedTime} />
      )
    }
    {
      ogType === "article" && articleAuthor && (
        <meta property="article:author" content={articleAuthor} />
      )
    }

    <title>{title}</title>
    <slot name="head" />
    {umamiId && umamiUrl && (
      <script
        defer
        src={umamiScriptSrc}
        data-website-id={umamiId}
      ></script>
    )}
  </head>
  <body class="bg-background text-foreground">
    <Header />

    <!-- Contenu `position:fixed` relatif au viewport (évite un ancêtre transform/filter qui casse fixed dans <main>) -->
    <slot name="body-fixed" />

    <FloatingWhatsApp />

    <main>
      <slot />
    </main>

    <ProfessionsSection />

    <footer class="bg-foreground text-on-foreground py-12">
      <div class="shell-layout">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="mb-4 font-sans text-xl font-bold leading-tight tracking-tight">
              <a
                href="/"
                class="text-on-foreground transition-colors hover:text-on-foreground/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/55 focus-visible:ring-offset-2 focus-visible:ring-offset-foreground rounded-sm"
                aria-label="NICODEV — Nicolas Devaux, retour à l’accueil"
              >
                NICO<span class="text-primary-300">DEV</span>
              </a>
            </h3>
            <p class="text-on-foreground">
              Développeur web et psychologue spécialisé dans la création de
              sites internet pour psychologues.
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Services</h3>
            <ul class="space-y-2">
              <li>
                <a href={`${homePageUrl}#offres`} class={footerLinkClass}>Création de sites internet</a>
              </li>
              <li>
                <a href={`${homePageUrl}#seo-local`} class={footerLinkClass}>Visibilité locale sur Google</a>
              </li>
              <li>
                <a href={`${homePageUrl}#faq-performance-mobile`} class={footerLinkClass}>Design responsive</a>
              </li>
              <li>
                <a href="/tarifs/#faq-modifications" class={footerLinkClass}>Maintenance web</a>
              </li>
              <li>
                <a href="/creation-site-internet-psychologue/" class={footerLinkClass}
                  >Création site psychologue</a
                >
              </li>
              <li>
                <a href="/referencement-site-psychologue/" class={footerLinkClass}>Référencement site psychologue</a>
              </li>
              <li>
                <a href="/webdesigner-site-psychologue/" class={footerLinkClass}>Webdesigner psychologues</a>
              </li>
              <li>
                <a href="/devis/" class={footerLinkClass}>Demande de devis</a>
              </li>
              <li>
                <a href="/exemples-sites-psychologue/" class={footerLinkClass}
                  >Exemples de sites psychologues</a
                >
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Contact</h3>
            <div class="space-y-3 text-on-foreground">
              <p>
                Email:
                <ObfuscatedEmail class={footerLinkClass} />
              </p>
              <p>
                GitHub:
                <a href="https://github.com/nicodev3" class={footerLinkClass}>@nicodev3</a>
              </p>
              <p>
                LinkedIn:
                <a
                  href="https://www.linkedin.com/in/nicodev3/"
                  class={footerLinkClass}
                  target="_blank"
                  rel="noopener noreferrer"
                  >linkedin.com/in/nicodev3</a
                >
              </p>
              <a
                href="https://wa.me/33629341367"
                class="inline-flex items-center justify-center rounded-lg border border-on-foreground/35 bg-transparent px-4 py-2 text-sm font-semibold text-on-foreground transition hover:border-on-foreground/55 hover:bg-white/8 focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2 focus-visible:ring-offset-foreground"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Contacter Nicolas Devaux sur WhatsApp"
              >
                WhatsApp
              </a>
            </div>
          </div>
        </div>
        <div
          class="border-t border-border mt-8 pt-8 text-center text-on-foreground"
        >
          <p class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
            <a href="/mentions-legales/" class={footerLinkClass}>Mentions légales</a>
            <span class="text-on-foreground/60" aria-hidden="true">|</span>
            <a href="/politique-confidentialite/" class={footerLinkClass}>Politique de confidentialité</a>
            <span class="text-on-foreground/60" aria-hidden="true">|</span>
            <a href="/cgv/" class={footerLinkClass}>Conditions générales de vente</a>
          </p>
          <p class="mt-4">&copy; 2011-2026 Nicolas Devaux. Tous droits réservés.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        function initScrollReveal() {
          var sections = document.querySelectorAll("main > section");
          if (!sections.length) return;
          var first = document.querySelector("main > section:first-of-type");
          for (var i = 0; i < sections.length; i++) {
            sections[i].classList.add("scroll-reveal");
          }
          var io = new IntersectionObserver(
            function (entries, obs) {
              for (var j = 0; j < entries.length; j++) {
                var e = entries[j];
                if (e.isIntersecting) {
                  e.target.classList.add("scroll-reveal--visible");
                  obs.unobserve(e.target);
                }
              }
            },
            { root: null, rootMargin: "0px 0px -6% 0px", threshold: 0.02 }
          );
          for (var k = 0; k < sections.length; k++) {
            if (sections[k] !== first) io.observe(sections[k]);
          }
        }
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initScrollReveal, { once: true });
        } else {
          initScrollReveal();
        }
      })();
    </script>
  </body>
</html>
