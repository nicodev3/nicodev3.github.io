---
import "../styles/global.css";
import Header from "../components/Header.astro";
import ProfessionsSection from "../components/ProfessionsSection.astro";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: "website" | "article";
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
}

const {
  title,
  description = "Nicolas Devaux est développeur web et crée des sites internet pour psychologues.",
  image,
  noindex = false,
  ogType = "website",
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
} = Astro.props;

const baseUrl = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, baseUrl).toString();
const ogImage = image
  ? new URL(image, baseUrl).toString()
  : new URL("/images/development.jpg", baseUrl).toString();

const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiUrl = import.meta.env.PUBLIC_UMAMI_URL;
const umamiScriptSrc = umamiUrl ? `${umamiUrl.replace(/\/+$/, "")}/script.js` : "";
---

<!doctype html>
<html lang="fr">
  <head>
    <script src="/tarteaucitron/tarteaucitron.js" is:inline></script>
    <script is:inline>
      tarteaucitron.init({
        "privacyUrl": "/politique-confidentialite/",
        "bodyPosition": "top",
        "hashtag": "#tarteaucitron",
        "cookieName": "tarteaucitron",
        "orientation": "bottom",
        "groupServices": false,
        "showDetailsOnClick": true,
        "serviceDefaultState": "wait",
        "showAlertSmall": false,
        "cookieslist": false,
        "closePopup": false,
        "showIcon": true,
        "iconPosition": "BottomLeft",
        "DenyAllCta": true,
        "AcceptAllCta": true,
        "highPrivacy": true,
        "removeCredit": false,
        "moreInfoLink": true,
        "googleConsentMode": true,
        "mandatory": true,
        "mandatoryCta": false
      });

      tarteaucitron.user.gtagUa = 'G-Y75K3GN27H';
      (tarteaucitron.job = tarteaucitron.job || []).push('gtag');
    </script>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Nicolas Devaux" />
    <meta property="og:locale" content="fr_FR" />
    {
      ogType === "article" && articlePublishedTime && (
        <meta
          property="article:published_time"
          content={articlePublishedTime}
        />
      )
    }
    {
      ogType === "article" && articleModifiedTime && (
        <meta property="article:modified_time" content={articleModifiedTime} />
      )
    }
    {
      ogType === "article" && articleAuthor && (
        <meta property="article:author" content={articleAuthor} />
      )
    }

    <title>{title}</title>
    <slot name="head" />
    {umamiId && umamiUrl && (
      <script
        defer
        src={umamiScriptSrc}
        data-website-id={umamiId}
      ></script>
    )}
  </head>
  <body class="bg-background text-foreground">
    <Header />

    <main>
      <slot />
    </main>

    <ProfessionsSection />

    <footer class="bg-foreground text-on-foreground py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-semibold mb-4">Nicolas Devaux</h3>
            <p class="text-on-foreground">
              Développeur web et psychologue spécialisé dans la création de
              sites internet pour psychologues.
            </p>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Services</h3>
            <ul class="space-y-2 text-on-foreground">
              <li>Création de sites internet</li>
              <li>Visibilité locale sur Google</li>
              <li>Design responsive</li>
              <li>Maintenance web</li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Contact</h3>
            <p class="text-on-foreground">
              Email: contact.nicodev@gmail.com<br />
              GitHub: <a
                href="https://github.com/nicodev3"
                class="text-on-foreground hover:opacity-80">@nicodev3</a
              >
            </p>
          </div>
        </div>
        <div
          class="border-t border-border mt-8 pt-8 text-center text-on-foreground"
        >
          <p>
            <a href="/cgv/" class="text-on-foreground hover:opacity-80"
              >Conditions générales de vente</a
            >
            <span class="mx-2">|</span>
            &copy; 2011-2026 Nicolas Devaux. Tous droits réservés.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
