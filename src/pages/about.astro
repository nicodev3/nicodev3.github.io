---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SkillCard from '../components/SkillCard.astro';
import CtaSection from '../components/CtaSection.astro';
import { Image } from 'astro:assets';
import developmentImage from '../assets/images/nicodev.webp';
import defaultOgWebp from '../assets/images/blog/development.webp';

const baseUrl = Astro.site ?? Astro.url.origin;
const aboutUrl = new URL('/about/', baseUrl).toString();

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Accueil',
      item: new URL('/', baseUrl).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'À propos',
      item: aboutUrl,
    },
  ],
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicolas Devaux',
  jobTitle: 'Psychologue et développeur web',
  description: 'Psychologue à Sceaux et développeur web, je crée des sites internet sur mesure pour psychologues.',
  url: aboutUrl,
  image: new URL(defaultOgWebp.src, baseUrl).toString(),
  knowsAbout: ['développement web', 'sites internet pour psychologues', 'SEO', 'performance web'],
  sameAs: [
    'https://www.malt.fr/profile/nicolasdevaux1',
    'https://github.com/nicodev3',
    'https://nicolas-devaux-psychologue.fr',
  ],
};
---

<Layout
  title="Psychologue et développeur web | Nicolas Devaux"
  description="Psychologue à Sceaux et développeur web, je crée des sites internet pour psychologues. 20 ans d'expérience. Sites sur mesure, SEO et performance."
  image={defaultOgWebp}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </Fragment>
  <Hero
    title="À propos"
    subtitle="Psychologue et développeur web, je crée des sites internet avec une approche sobre, attentive et artisanale"
    breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'À propos' }]}
  />

  <!-- About Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-foreground mb-6">Mon parcours</h2>
          <div class="prose prose-lg text-muted space-y-4">
            <p>
              Je suis <a
                href="https://nicolas-devaux-psychologue.fr"
                target="_blank"
                rel="noopener noreferrer"
                >psychologue à Sceaux</a
              > et développeur web.
            </p>
            <p>
              Ma double formation (psychologie et développement web à l'<a
                href="https://sfc.unistra.fr/formations/informatique_-_technologies-de-linternet_-_licence-professionnelle-developpement-web-communication-et-apprentissages_-_6187/"
                target="_blank"
                rel="noopener noreferrer"
                >Université de Strasbourg</a
              >) me permet de créer des <a href="/portfolio/">sites internet pour psychologues</a>
              à la fois performants, lisibles et adaptés à la pratique clinique.
            </p>
            <p>
              Je privilégie une approche artisanale : peu de projets, un accompagnement attentif,
              et une collaboration directe. Découvrez mes <a href="/portfolio/"
                >réalisations</a
              >, mes <a href="/tarifs/">tarifs</a> ou <a href="/contact/">contactez-moi</a> pour
              discuter de votre projet.
            </p>
          </div>
        </div>
        <div class="relative">
          <Image
            src={developmentImage}
            alt="Nicolas Devaux - Développeur web spécialisé sites pour psychologues"
            class="about-photo shadow-xl object-cover mx-auto"
            width={280}
            height={280}
            widths={[180, 240, 280]}
            sizes="(max-width: 768px) 70vw, 280px"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="references-professionnelles" class="py-16 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center text-foreground mb-12">
        Mon expérience professionnelle
      </h2>

      <div class="max-w-4xl mx-auto">
        <div class="bg-white p-8 rounded-lg shadow-lg border border-border">
          <div class="text-center mb-8">
            <div
              class="w-16 h-16 bg-surface rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <svg
                class="w-8 h-8 text-foreground"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18c-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48 48 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A24 24 0 0 1 12 15.75a24 24 0 0 1-7.577-1.22a2 2 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48 48 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a49 49 0 0 0-7.5 0M12 12.75h.008v.008H12z"
                ></path>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-foreground mb-2">
              <strong>20 ans d'expérience</strong> en développement de sites et en tant que psychologue
            </h3>
            <p class="text-muted">
              De 1996 à 2020, j'ai exercé comme psychomotricien puis psychologue, en institution et en cabinet libéral depuis 2008. Cette expérience de terrain nourrit ma
              compréhension fine des besoins des psychologues libéraux. Aujourd'hui, je suis psychologue en libéral, dans un service de Santé Etudiante et je crée des sites internet pour psychologues.
            </p>
          </div>

          <div class="space-y-8">
            <h4 class="text-lg font-semibold text-foreground">Mon expérience en tant que développeur</h4>

            <div class="border-l-4 border-border pl-6">
              <h4 class="text-xl font-semibold text-foreground mb-2">
                Tech Lead front-end - Le Figaro (2024-2025)
              </h4>
              <p class="text-muted mb-2">
                Direction technique de projets d'envergure pour l'un des plus grands médias français
              </p>
              <p class="text-sm text-muted">
                Management d'équipes de développement, architecture de solutions web complexes,
                optimisation des performances
              </p>
            </div>

            <div class="border-l-4 border-border pl-6">
              <h4 class="text-xl font-semibold text-foreground mb-2">
                Tech Lead front-end - Naxos (2020-2024)
              </h4>
              <p class="text-muted mb-2">
                Direction technique de solutions digitales innovantes pour le secteur immobilier
              </p>
              <p class="text-sm text-muted">
                Développement d'applications mobiles, sites web corporate, CRM immobilier,
                technologies Python/Django/Angular
              </p>
            </div>

            <div class="border-l-4 border-border pl-6">
              <h4 class="text-xl font-semibold text-foreground mb-2">
                Développeur Web free-lance (depuis 2005)
              </h4>
              <p class="text-muted mb-2">
                Plusieurs années d'expérience en tant que free-lance auprès de clients variés :
                indépendants, TPE/PME, associations, grands comptes. Plus de 50 projets réalisés.
              </p>
              <p class="text-sm text-muted">
                Création de sites sur mesure, accompagnement digital, référencement, conseil en
                identité numérique.<br />
                Retrouvez les avis de mes clients sur <a
                  href="https://www.malt.fr/profile/nicolasdevaux1"
                  target="_blank"
                  rel="noopener noreferrer"
                  >mon profil Malt</a
                >.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center text-foreground mb-12">Mes compétences</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <SkillCard
          title="Création de sites web"
          description="Sites rapides, modernes et adaptés à tous les écrans : ordinateur, tablette et téléphone."
        >
          <svg
            slot="icon"
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M14.25 9.75L16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25z"
            ></path>
          </svg>
        </SkillCard>
        <SkillCard
          title="Accompagnement de A à Z"
          description="J'ai dirigé des projets pour de grands médias. Je prends en charge tout votre projet."
        >
          <svg
            slot="icon"
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M18 18.72a9.1 9.1 0 0 0 3.741-.479q.01-.12.01-.241a3 3 0 0 0-4.692-2.478m.94 3.197l.001.031q0 .337-.037.666A11.94 11.94 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6 6 0 0 1 6 18.719m12 0a5.97 5.97 0 0 0-.941-3.197m0 0A6 6 0 0 0 12 12.75a6 6 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72a9 9 0 0 0 3.74.477m.94-3.197a5.97 5.97 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0a3 3 0 0 1 6 0m6 3a2.25 2.25 0 1 1-4.5 0a2.25 2.25 0 0 1 4.5 0m-13.5 0a2.25 2.25 0 1 1-4.5 0a2.25 2.25 0 0 1 4.5 0"
            ></path>
          </svg>
        </SkillCard>
        <SkillCard
          title="Visibilité sur Google"
          description="Référencement et rapidité optimisés pour que vos futurs patients vous trouvent facilement."
        >
          <svg
            slot="icon"
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M2.25 18L9 11.25l4.306 4.306a11.95 11.95 0 0 1 5.814-5.518l2.74-1.22m0 0l-5.94-2.281m5.94 2.28l-2.28 5.942"
            ></path>
          </svg>
        </SkillCard>
        <SkillCard
          title="Compréhension de votre métier"
          description="Psychologue de formation, je comprends vos enjeux et parle votre langage."
        >
          <svg
            slot="icon"
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4.26 10.147a60 60 0 0 0-.491 6.347A48.6 48.6 0 0 1 12 20.904a48.6 48.6 0 0 1 8.232-4.41a61 61 0 0 0-.491-6.347m-15.482 0a51 51 0 0 0-2.658-.813A60 60 0 0 1 12 3.493a60 60 0 0 1 10.399 5.84q-1.345.372-2.658.814m-15.482 0A51 51 0 0 1 12 13.489a50.7 50.7 0 0 1 7.74-3.342M6.75 15a.75.75 0 1 0 0-1.5a.75.75 0 0 0 0 1.5m0 0v-3.675A55 55 0 0 1 12 8.443m-7.007 11.55A5.98 5.98 0 0 0 6.75 15.75v-1.5"
            ></path>
          </svg>
        </SkillCard>
      </div>
    </div>
  </section>

  <!-- Philosophy Section -->
  <section class="py-16 bg-surface">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-center text-foreground mb-12">Ma philosophie</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <SkillCard
          title="Qualité du contenu"
          description="Je privilégie la qualité du contenu et du design plutôt que la quantité. Chaque site est pensé avec soin pour répondre aux besoins spécifiques de mes clients."
        >
          <svg
            slot="icon"
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 18v-5.25m0 0a6 6 0 0 0 1.5-.189m-1.5.189a6 6 0 0 1-1.5-.189m3.75 7.478a12.1 12.1 0 0 1-4.5 0m3.75 2.383a14.4 14.4 0 0 1-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 1 0-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"
            ></path>
          </svg>
        </SkillCard>
        <SkillCard
          title="Approche artisanale"
          description="Je ne produis pas des sites à la chaîne. Je préfère suivre peu de projets, avec un échange direct, pour livrer des sites solides et adaptés."
        >
          <svg
            slot="icon"
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M18 18.72a9.1 9.1 0 0 0 3.741-.479q.01-.12.01-.241a3 3 0 0 0-4.692-2.478m.94 3.197l.001.031q0 .337-.037.666A11.94 11.94 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6 6 0 0 1 6 18.719m12 0a5.97 5.97 0 0 0-.941-3.197m0 0A6 6 0 0 0 12 12.75a6 6 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72a9 9 0 0 0 3.74.477m.94-3.197a5.97 5.97 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0a3 3 0 0 1 6 0m6 3a2.25 2.25 0 1 1-4.5 0a2.25 2.25 0 0 1 4.5 0m-13.5 0a2.25 2.25 0 1 1-4.5 0a2.25 2.25 0 0 1 4.5 0"
            ></path>
          </svg>
        </SkillCard>
        <SkillCard
          title="Performance"
          description="Tous mes sites sont optimisés pour les performances et le référencement naturel. Un beau site doit aussi être efficace !"
        >
          <svg
            slot="icon"
            class="w-8 h-8"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="m3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75L12 13.5z"
            ></path>
          </svg>
        </SkillCard>
      </div>
    </div>
  </section>

  <CtaSection
    title="Prêt à créer votre site internet ?"
    description="Discutons de votre projet et créons ensemble votre présence en ligne."
    primaryButton={{ text: 'Voir mes réalisations', href: '/portfolio/' }}
    secondaryButton={{ text: 'Me contacter', href: '/contact/' }}
    background="white"
  />

  <style>
    .about-photo {
      border-radius: 54% 46% 43% 57% / 47% 53% 47% 53%;
      box-shadow:
        0 10px 22px rgba(15, 23, 42, 0.1),
        0 3px 8px rgba(15, 23, 42, 0.06);
    }
  </style>
</Layout>
