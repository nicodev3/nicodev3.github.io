---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { BLOG_TAG_ORDER } from '../data/blog-tags';
import {
	comparePostsByPubDateDesc,
	GUIDE_INSTALLATION_PILLAR_SLUG,
	GUIDE_VISIBILITE_PILLAR_SLUG,
	toTagHref,
} from '../utils/blog';
import defaultBlogCover from '../assets/images/blog/development.webp';
import blogHeroImage from '../assets/images/blog-image.webp';

const baseUrl = Astro.site ?? Astro.url.origin;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', baseUrl).toString() }
	]
};

const posts = await getCollection('blog');

const usedTags = new Set(posts.flatMap((p) => p.data.tags ?? []));
const allTags = BLOG_TAG_ORDER.filter((tag) => usedTags.has(tag));

const sortedPosts = [...posts].sort(comparePostsByPubDateDesc);

const hubPosts = [GUIDE_INSTALLATION_PILLAR_SLUG, GUIDE_VISIBILITE_PILLAR_SLUG].map((id) => {
	const post = posts.find((entry) => entry.id === id);
	if (!post) throw new Error(`Blog : page pilier introuvable « ${id} »`);
	return post;
});
---

<Layout 
	title="Blog sites psychologues et psychomotriciens | Nicolas Devaux"
	description="Installation en libéral, visibilité Google et création de site pour psychologues et psychomotriciens."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>
	<Hero 
		title="Blog" 
		subtitle="Installation en libéral, visibilité Google et création de site pour cabinets de soin"
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Blog' }]}
		coverImage={blogHeroImage}
		coverImageAlt="Bureau professionnel avec ordinateur, symbole des articles et conseils pour cabinets de soin"
		coverBlur="light"
	/>

	<section class="py-16 bg-white" data-scroll-reveal-skip>
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			{allTags.length > 0 && (
				<nav class="mb-10" aria-label="Filtrer par tag">
				<h2 class="type-eyebrow text-muted mb-3">Parcourir par thématique</h2>
				<div class="flex flex-wrap gap-2">
					{allTags.map((t) => (
						<a href={toTagHref(t)} class="inline-flex items-center px-4 py-2 rounded-full bg-surface text-foreground hover:bg-surface-alt font-medium text-sm transition-colors">
								{t}
							</a>
						))}
					</div>
				</nav>
			)}
			<aside class="mb-10" aria-labelledby="blog-pages-piliers">
				<h2 id="blog-pages-piliers" class="type-eyebrow text-muted mb-3">Pages repères</h2>
				<div class="grid gap-4 sm:grid-cols-2">
					{hubPosts.map((post) => (
						<a
							href={`/blog/${post.id}/`}
							class="rounded-lg border border-border bg-surface p-6 transition-colors hover:border-primary/40 hover:bg-white"
						>
							<p class="text-sm font-semibold text-foreground">{post.data.title}</p>
							<p class="mt-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
						</a>
					))}
				</div>
			</aside>
			{sortedPosts.length === 0 ? (
				<p class="text-center text-muted py-12">Aucun article pour le moment.</p>
			) : (
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
					{sortedPosts.map((post) => (
						<BlogCard
							title={post.data.title}
							description={post.data.description}
							href={`/blog/${post.id}/`}
							image={post.data.image ?? defaultBlogCover}
							imageAlt={post.data.title}
							pubDate={post.data.pubDate}
							author={post.data.author}
							tags={post.data.tags}
						/>
					))}
				</div>
			)}
			<div class="mt-16 pt-12 border-t border-border text-center">
				<p class="text-muted mb-4">Un projet de site web pour votre cabinet ?</p>
				<div class="flex flex-wrap justify-center gap-4">
					<a href="/diagnostic-gratuit/" class="text-foreground font-medium hover:text-primary">Demander un diagnostic gratuit</a>
					<a href="/tarifs/" class="text-foreground font-medium hover:text-primary">Voir les tarifs</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
