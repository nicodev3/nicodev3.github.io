---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';

const posts = await getCollection('blog');

const sortedPosts = posts.sort((a, b) => {
	const dateA = new Date(a.data.pubDate).getTime();
	const dateB = new Date(b.data.pubDate).getTime();
	return dateB - dateA;
});
---

<Layout 
	title="Blog - Nicolas Devaux"
	description="Articles et conseils sur la création de sites internet, le développement web et le référencement"
>
	<Hero 
		title="Blog" 
		subtitle="Conseils et articles sur la création de sites internet"
	/>

	<section class="py-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{sortedPosts.map((post) => (
					<BlogCard
						title={post.data.title}
						description={post.data.description}
						href={`/blog/${post.id}`}
						image={post.data.image || "/images/development.jpg"}
						imageAlt={post.data.title}
						tag={post.data.tags?.[0] || "Web"}
						pubDate={post.data.pubDate}
						author={post.data.author}
						tags={post.data.tags}
					/>
				))}
			</div>
		</div>
	</section>
</Layout>
