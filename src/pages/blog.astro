---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import { toTagHref } from '../utils/blog';

const baseUrl = Astro.site ?? Astro.url.origin;

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', baseUrl).toString() }
	]
};

const posts = await getCollection('blog');

// Récupérer tous les tags uniques pour la navigation
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort((a, b) => a.localeCompare(b));

const sortedPosts = posts.sort((a, b) => {
	const dateA = new Date(a.data.pubDate).getTime();
	const dateB = new Date(b.data.pubDate).getTime();
	return dateB - dateA;
});
---

<Layout 
	title="Blog - Conseils création de site pour psychologues | Nicolas Devaux"
	description="Conseils création de site pour psychologues : SEO local, visibilité Google, développement web et référencement."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>
	<Hero 
		title="Blog" 
		subtitle="Conseils et articles sur la création de sites internet"
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Blog' }]}
	/>

	<section class="py-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			{allTags.length > 0 && (
				<nav class="mb-10" aria-label="Filtrer par tag">
				<h2 class="text-sm font-semibold text-muted uppercase tracking-wider mb-3">Parcourir par thématique</h2>
				<div class="flex flex-wrap gap-2">
					{allTags.map((t) => (
						<a href={toTagHref(t)} class="inline-flex items-center px-4 py-2 rounded-full bg-surface text-foreground hover:bg-surface-alt font-medium text-sm transition-colors">
								{t}
							</a>
						))}
					</div>
				</nav>
			)}
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
				{sortedPosts.map((post) => (
					<BlogCard
						title={post.data.title}
						description={post.data.description}
						href={`/blog/${post.id}/`}
						image={post.data.image || "/images/development.webp"}
						imageAlt={post.data.title}
						tag={post.data.tags?.[0] || "Web"}
						pubDate={post.data.pubDate}
						updatedDate={post.data.updatedDate}
						author={post.data.author}
						tags={post.data.tags}
					/>
				))}
			</div>
			<div class="mt-16 pt-12 border-t border-border text-center">
				<p class="text-muted mb-4">Un projet de site web pour votre cabinet ?</p>
				<div class="flex flex-wrap justify-center gap-4">
					<a href="/tarifs/" class="text-foreground font-medium hover:text-primary">Voir mes tarifs</a>
					<a href="/contact/" class="text-foreground font-medium hover:text-primary">Me contacter</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
