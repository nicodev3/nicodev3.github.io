---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';

// Récupérer le slug depuis l'URL
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	
	return posts.map((post) => ({
		params: { slug: post.id.replace(/\.md$/, '') },
		props: { entry: post }
	}));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Articles similaires (même tag ou récents, hors l'article actuel)
const allPosts = await getCollection('blog');
const currentTags = entry.data.tags ?? [];
const relatedPosts = allPosts
	.filter((p) => p.id !== entry.id)
	.sort((a, b) => {
		const aScore = (a.data.tags ?? []).filter((t: string) => currentTags.includes(t)).length;
		const bScore = (b.data.tags ?? []).filter((t: string) => currentTags.includes(t)).length;
		if (bScore !== aScore) return bScore - aScore;
		return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
	})
	.slice(0, 3);

const baseUrl = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, baseUrl).toString();
const imageUrl = entry.data.image
	? new URL(entry.data.image.startsWith('/') ? entry.data.image : `/${entry.data.image}`, baseUrl).toString()
	: undefined;
const updatedDate = (entry.data as any).updateDate ?? entry.data.updatedDate;
const dateModified = updatedDate ?? entry.data.pubDate;

const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: entry.data.title,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonical
	},
	author: {
		'@type': 'Person',
		name: entry.data.author
	},
	publisher: {
		'@type': 'Organization',
		name: 'Nicolas Devaux',
		url: 'https://nicodev.fr'
	},
	datePublished: entry.data.pubDate,
	dateModified: dateModified,
	description: entry.data.description,
	url: canonical,
	...(imageUrl && { image: imageUrl })
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', baseUrl).toString() },
		{ '@type': 'ListItem', position: 3, name: entry.data.title, item: canonical }
	]
};
---

<Layout 
	title={`${entry.data.title} - Nicolas Devaux`}
	description={entry.data.description}
	image={entry.data.image}
	ogType="article"
	articlePublishedTime={entry.data.pubDate}
	articleModifiedTime={dateModified}
	articleAuthor="Nicolas Devaux"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>
	<Hero title={entry.data.title} subtitle={entry.data.description} maxWidth="4xl">
		<div slot="before" class="flex flex-wrap items-center justify-center gap-2 text-sm mb-4">
			<span>
				<time datetime={entry.data.pubDate}>
					{new Date(entry.data.pubDate).toLocaleDateString('fr-FR', {
						year: 'numeric',
						month: 'long',
						day: 'numeric'
					})}
				</time>
			</span>
			<span>•</span>
			<span>{entry.data.author}</span>
			{updatedDate && updatedDate !== entry.data.pubDate && (
				<>
					<span>•</span>
					<span>
						Mis à jour le{' '}
						<time datetime={updatedDate}>
							{new Date(updatedDate).toLocaleDateString('fr-FR', {
								year: 'numeric',
								month: 'long',
								day: 'numeric'
							})}
						</time>
					</span>
				</>
			)}
		</div>
		<div slot="after" class="flex flex-wrap justify-center gap-2">
			{entry.data.tags?.map((t: string) => (
				<a href={`/blog/tag/${encodeURIComponent(t)}/`} class="bg-white bg-opacity-20 hover:bg-opacity-30 text-gray-900 px-3 py-1 rounded-full text-sm transition-colors">
					{t}
				</a>
			))}
		</div>
	</Hero>

	<!-- Article Content -->
	<article class="py-16 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="prose prose-lg prose-slate max-w-none
				prose-headings:font-heading prose-headings:font-bold prose-headings:text-gray-900
				prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-gray-200 prose-h2:pb-2
				prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-teal-700
				prose-p:text-gray-700 prose-p:leading-relaxed
				prose-a:text-teal-600 prose-a:font-medium prose-a:no-underline hover:prose-a:underline
				prose-strong:text-gray-900
				prose-blockquote:border-l-4 prose-blockquote:border-teal-500 prose-blockquote:bg-teal-50 prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-blockquote:not-italic prose-blockquote:text-gray-700
				prose-code:text-teal-700 prose-code:bg-teal-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
				prose-pre:bg-gray-900 prose-pre:text-gray-100 prose-pre:rounded-xl prose-pre:shadow-lg
				prose-ul:my-4 prose-li:my-1 prose-li:text-gray-700
				prose-ol:my-4
				prose-img:rounded-xl prose-img:shadow-md prose-img:mx-auto
				prose-hr:border-gray-200">
				<Content />
			</div>
		</div>
	</article>

	<!-- Liens internes : tarifs et contact -->
	<section class="py-12 bg-teal-50 border-t border-teal-100">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-xl font-semibold text-gray-900 mb-4">Un projet de site web ?</h2>
			<p class="text-gray-700 mb-6">
				Vous cherchez un site professionnel pour votre cabinet ? Consultez mes <a href="/tarifs/" class="text-teal-600 font-medium hover:underline">tarifs</a> ou <a href="/contact/" class="text-teal-600 font-medium hover:underline">contactez-moi</a> pour en discuter.
			</p>
			<div class="flex flex-wrap gap-3">
				<a href="/tarifs/" class="inline-flex items-center bg-teal-600 text-white px-5 py-2.5 rounded-lg font-medium hover:bg-teal-700 transition-colors">
					Voir les tarifs
				</a>
				<a href="/contact/" class="inline-flex items-center bg-white text-teal-700 border-2 border-teal-600 px-5 py-2.5 rounded-lg font-medium hover:bg-teal-50 transition-colors">
					Me contacter
				</a>
			</div>
		</div>
	</section>

	<!-- Articles similaires -->
	{relatedPosts.length > 0 && (
		<section class="py-16 bg-gray-50">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-xl font-semibold text-gray-900 mb-6">À lire aussi</h2>
				<ul class="space-y-3">
					{relatedPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id.replace(/\.md$/, '')}/`} class="group flex items-start gap-3 text-gray-700 hover:text-teal-600">
								<span class="text-teal-500 group-hover:text-teal-600 mt-0.5">→</span>
								<span class="font-medium group-hover:underline">{post.data.title}</span>
								<span class="text-sm text-gray-500">
									{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' })}
								</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- Navigation -->
	<section class="py-16 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center">
				<a 
					href="/blog/"
					class="inline-flex items-center bg-teal-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-teal-700 transition-colors"
				>
					← Retour au blog
				</a>
			</div>
		</div>
	</section>
</Layout>
