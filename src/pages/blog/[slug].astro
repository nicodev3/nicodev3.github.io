---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import BlogShare from '../../components/BlogShare.astro';
import BlogArticleToc from '../../components/BlogArticleToc.astro';
import BlogPillarClusterLink from '../../components/BlogPillarClusterLink.astro';
import {
	GUIDE_VISIBILITE_CLUSTER_IDS,
	toTagHref,
} from '../../utils/blog';
import defaultOgWebp from '../../assets/images/blog/development.webp';

// Récupérer le slug depuis l'URL
export async function getStaticPaths() {
	const posts = await getCollection('blog');
	
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { entry: post }
	}));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const allPosts = await getCollection('blog');

const clusterForPillar = GUIDE_VISIBILITE_CLUSTER_IDS.map((id) => allPosts.find((p) => p.id === id)).filter(
	(p): p is CollectionEntry<'blog'> => Boolean(p),
);

const currentTags = entry.data.tags ?? [];
const relatedPosts = entry.data.guidePillarHub
	? clusterForPillar
	: allPosts
			.filter((p) => p.id !== entry.id)
			.sort((a, b) => {
				const aScore = (a.data.tags ?? []).filter((t: string) => currentTags.includes(t)).length;
				const bScore = (b.data.tags ?? []).filter((t: string) => currentTags.includes(t)).length;
				if (bScore !== aScore) return bScore - aScore;
				return new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime();
			})
			.slice(0, 3);

const showArticleToc = !entry.data.hideArticleToc;
const tocItems = showArticleToc
	? (headings ?? [])
			.filter((h) => h.depth === 2 && h.slug)
			.map((h) => ({ slug: h.slug, text: h.text }))
	: [];

const baseUrl = Astro.site ?? Astro.url.origin;
const siteOrigin = new URL('/', baseUrl).href;
const publisherLogoUrl = new URL('/favicon.svg', baseUrl).toString();
const canonical = new URL(Astro.url.pathname, baseUrl).toString();
const metaTitleSuffix = entry.data.metaTitleSuffix ?? 'Site web psychologues';
const layoutTitle = `${entry.data.title} | ${metaTitleSuffix}`;
const imageUrl = entry.data.image
	? new URL(entry.data.image.src, baseUrl).toString()
	: undefined;
const updatedDate = (entry.data as any).updateDate ?? entry.data.updatedDate;
const dateModified = updatedDate ?? entry.data.pubDate;

const blogPostingSchema = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: entry.data.title,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonical
	},
	author: {
		'@type': 'Person',
		name: entry.data.author,
		url: new URL('/about/', baseUrl).toString(),
	},
	publisher: {
		'@type': 'Organization',
		name: 'Nicolas Devaux',
		url: siteOrigin,
		logo: {
			'@type': 'ImageObject',
			url: publisherLogoUrl
		}
	},
	datePublished: entry.data.pubDate,
	dateModified: dateModified,
	description: entry.data.description,
	url: canonical,
	...(imageUrl && { image: imageUrl })
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 3, name: entry.data.title, item: canonical }
	]
};

const guideClusterItemListSchema =
	entry.data.guidePillarHub && clusterForPillar.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'ItemList',
				name: 'Guides de visibilité en ligne pour psychologues',
				description:
					'Articles détaillés reliés au guide complet : fiche Google, SEO local, site, coûts, acquisition de patients, Doctolib et technique.',
				numberOfItems: clusterForPillar.length,
				itemListElement: clusterForPillar.map((post, i) => ({
					'@type': 'ListItem',
					position: i + 1,
					name: post.data.title,
					url: new URL(`/blog/${post.id}/`, baseUrl).toString(),
				})),
			}
		: null;
---

<Layout 
	title={layoutTitle}
	description={entry.data.description}
	image={entry.data.image}
	ogType="article"
	articlePublishedTime={entry.data.pubDate}
	articleModifiedTime={dateModified}
	articleAuthor="Nicolas Devaux"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		{guideClusterItemListSchema && (
			<script type="application/ld+json" set:html={JSON.stringify(guideClusterItemListSchema)} />
		)}
	</Fragment>
	<Hero 
		title={entry.data.title} 
		subtitle={entry.data.description} 
		maxWidth="4xl"
		breadcrumb={[
			{ label: 'Accueil', href: '/' },
			{ label: 'Blog', href: '/blog/' },
			{ label: entry.data.title }
		]}
		{...(entry.data.image
			? {
					coverImage: entry.data.image,
					coverImageAlt: `Illustration de l'article : ${entry.data.title}`,
				}
			: {})}
	>
		<div slot="before" class="flex flex-wrap items-center justify-center gap-2 text-sm mb-4">
			<span>
				<time datetime={entry.data.pubDate}>
					{new Date(entry.data.pubDate).toLocaleDateString('fr-FR', {
						year: 'numeric',
						month: 'long',
						day: 'numeric'
					})}
				</time>
			</span>
			<span>•</span>
			<span>{entry.data.author}</span>
			{updatedDate && updatedDate !== entry.data.pubDate && (
				<>
					<span>•</span>
					<span>
						Mis à jour le{' '}
						<time datetime={updatedDate}>
							{new Date(updatedDate).toLocaleDateString('fr-FR', {
								year: 'numeric',
								month: 'long',
								day: 'numeric'
							})}
						</time>
					</span>
				</>
			)}
		</div>
		<div slot="after" class="flex w-full max-w-4xl flex-col items-center gap-3">
			{entry.data.tags && entry.data.tags.length > 0 && (
				<div class="flex flex-wrap justify-center gap-2">
					{entry.data.tags.map((t: string) => (
						<a href={toTagHref(t)} class="bg-surface hover:bg-surface-alt text-foreground px-3 py-1 rounded-full text-sm transition-colors">
							{t}
						</a>
					))}
				</div>
			)}
			<BlogShare url={canonical} title={entry.data.title} />
		</div>
	</Hero>

	<!-- Article Content -->
	<article class="py-16 bg-white">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="prose prose-lg max-w-none
				prose-headings:font-heading prose-headings:font-bold prose-headings:text-foreground
				prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-border prose-h2:pb-2 prose-h2:scroll-mt-28
				prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-foreground prose-h3:scroll-mt-28
				prose-p:text-muted prose-p:leading-relaxed
				prose-a:text-foreground prose-a:font-medium prose-a:no-underline hover:prose-a:text-primary
				prose-strong:text-foreground
				prose-blockquote:border-l-4 prose-blockquote:border-border prose-blockquote:bg-surface prose-blockquote:rounded-r-lg prose-blockquote:py-1 prose-blockquote:not-italic prose-blockquote:text-muted
				prose-code:text-foreground prose-code:bg-surface prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
				prose-pre:bg-foreground prose-pre:text-on-foreground prose-pre:rounded-lg prose-pre:shadow-md
				prose-ul:my-4 prose-li:my-1 prose-li:text-muted
				prose-ol:my-4
				prose-img:rounded-lg prose-img:shadow-sm prose-img:mx-auto
				prose-hr:border-border">
				<BlogPillarClusterLink currentArticleId={entry.id} />
				<BlogArticleToc items={tocItems} />
				<Content />
			</div>
		</div>
	</article>

	<!-- Liens internes : diagnostic et tarifs (alignés avec le reste du site) -->
	<section class="py-12 bg-surface border-t border-border">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-xl font-semibold text-foreground mb-4">Un projet de site web ?</h2>
			<p class="text-muted mb-6">
				Vous cherchez un site professionnel pour votre cabinet ? Voir la page{' '}
				<a href="/creation-site-internet-psychologue/" class="text-foreground font-medium hover:text-primary">création de site pour psychologue</a>
				, la page{' '}
				<a href="/site-internet-psychomotricien/" class="text-foreground font-medium hover:text-primary">site internet psychomotricien</a>
				, la page{' '}
				<a href="/referencement-site-psychologue/" class="text-foreground font-medium hover:text-primary">référencement site psychologue</a>
				, un diagnostic gratuit pour faire le point, et les{' '}
				<a href="/tarifs/" class="text-foreground font-medium hover:text-primary">tarifs</a>
				. Pour vous projeter visuellement :{' '}
				<a href="/exemples-sites-psychologue/" class="text-foreground font-medium hover:text-primary">exemples de sites pour psychologues</a>.
			</p>
			<div class="flex flex-wrap gap-3">
				<a href="/diagnostic-gratuit/" class="btn-primary-solid inline-flex items-center rounded-lg px-5 py-3">
					Demander un diagnostic gratuit
				</a>
				<a href="/tarifs/" class="btn-outline-accent inline-flex items-center rounded-lg border-2 border-primary bg-background px-5 py-3 text-foreground hover:bg-surface">
					Voir les tarifs
				</a>
			</div>
		</div>
	</section>

	<!-- Articles similaires (sur la page pilier : tout le cluster) -->
	{relatedPosts.length > 0 && (
		<section class="py-16 bg-white">
			<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
				<h2 class="text-xl font-semibold text-foreground mb-6">
					{entry.data.guidePillarHub ? 'Guides détaillés du cluster' : 'À lire aussi'}
				</h2>
				<ul class="space-y-3">
					{relatedPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="group flex items-start gap-3 text-muted hover:text-primary">
								<span class="text-foreground group-hover:text-primary mt-0.5">→</span>
								<span class="font-medium group-hover:underline">{post.data.title}</span>
								<span class="text-sm text-muted">
									{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { month: 'short', year: 'numeric' })}
								</span>
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- Navigation -->
	<section class="py-16 bg-surface">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center">
				<a 
					href="/blog/"
					class="btn-primary-solid inline-flex items-center rounded-lg px-5 py-3"
				>
					← Retour au blog
				</a>
			</div>
		</div>
	</section>
</Layout>
