---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Hero from '../../../components/Hero.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { BLOG_TAG_DESCRIPTIONS } from '../../../data/blog-tags';
import { slugifyTag } from '../../../utils/blog';
import defaultBlogCover from '../../../assets/images/blog/development.webp';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tagMap = new Map<string, string>();
	posts.forEach((post) => {
		post.data.tags?.forEach((tag: string) => {
			const slug = slugifyTag(tag);
			if (!tagMap.has(slug)) {
				tagMap.set(slug, tag);
			}
		});
	});
	return Array.from(tagMap.entries()).map(([tagSlug, tagLabel]) => ({
		params: { tag: tagSlug },
		props: { tagSlug, tagLabel }
	}));
}

const { tagSlug, tagLabel } = Astro.props;
const posts = await getCollection('blog');
const tagDescription =
	BLOG_TAG_DESCRIPTIONS[tagLabel as keyof typeof BLOG_TAG_DESCRIPTIONS] ??
	`Articles sur ${tagLabel} : site web, visibilité locale et cadre professionnel pour cabinets de soin.`;

const tagTitleCandidates = [
	`${tagLabel} : articles site web et SEO cabinet | Nicodev`,
	`Articles ${tagLabel} — site web et visibilité | Nicodev`,
	`${tagLabel} : blog site internet cabinet soin | Nicodev`,
];
const tagSeoTitle =
	tagTitleCandidates.find((candidate) => Array.from(candidate).length >= 50 && Array.from(candidate).length <= 60) ??
	`${tagLabel} : articles blog | Nicodev`;

const filteredPosts = posts
	.filter((post) => post.data.tags?.some((t: string) => slugifyTag(t) === tagSlug))
	.sort((a, b) => {
		const dateA = new Date(a.data.pubDate).getTime();
		const dateB = new Date(b.data.pubDate).getTime();
		return dateB - dateA;
	});

const baseUrl = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 3, name: tagLabel, item: new URL(`/blog/tag/${tagSlug}/`, baseUrl).toString() }
	]
};

const itemListSchema =
	filteredPosts.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'ItemList',
				name: `Articles — ${tagLabel}`,
				numberOfItems: filteredPosts.length,
				itemListElement: filteredPosts.map((post, index) => ({
					'@type': 'ListItem',
					position: index + 1,
					name: post.data.title,
					url: new URL(`/blog/${post.id}/`, baseUrl).toString(),
				})),
			}
		: null;
---

<Layout title={tagSeoTitle} description={tagDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
		{itemListSchema && <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />}
	</Fragment>
	<Hero
		title={tagLabel}
		subtitle={tagDescription}
		breadcrumb={[
			{ label: 'Accueil', href: '/' },
			{ label: 'Blog', href: '/blog/' },
			{ label: tagLabel }
		]}
	/>

	<section class="py-16 bg-white" data-scroll-reveal-skip>
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="mb-8">
				<a href="/blog/" class="text-foreground hover:text-primary font-medium inline-flex items-center gap-2">
					← Retour au blog
				</a>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
				{filteredPosts.map((post) => (
					<BlogCard
						title={post.data.title}
						description={post.data.description}
						href={`/blog/${post.id}/`}
						image={post.data.image ?? defaultBlogCover}
						imageAlt={post.data.title}
						pubDate={post.data.pubDate}
						author={post.data.author}
						tags={post.data.tags}
					/>
				))}
			</div>
			{filteredPosts.length === 0 && (
				<p class="text-muted text-center py-12">Aucun article avec ce tag pour le moment.</p>
			)}
		</div>
	</section>
</Layout>
