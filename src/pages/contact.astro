---
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';

const baseUrl = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Contact', item: new URL('/contact', baseUrl).toString() }
	]
};
---

<Layout 
	title="Contact - Échange rapide pour psychologues | Nicolas Devaux"
	description="Une question sur votre site de psychologue, vos contenus ou votre visibilité locale ? Écrivez-moi, je vous réponds sous 48h."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>
	<Hero 
		title="Un échange rapide, simplement" 
		subtitle="Si vous avez une question ponctuelle sur votre site de psychologue ou toute autre demande, je vous réponds avec plaisir." 
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Contact' }]}
	/>

	<section class="py-16 bg-surface-alt">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
				<div>
					<h2 class="text-3xl font-bold text-foreground mb-4">
						Parlons de votre situation
					</h2>
					<p class="text-muted mb-8">
						Vous pouvez utiliser ce formulaire pour une question simple : clarification sur mes services, point de blocage sur votre
						site actuel, ou premier échange avant de décider.
						Si vous souhaitez une proposition tarifaire, la page devis est plus adaptée.
					</p>
					<ContactForm mode="contact" />
				</div>
				<div>
					<h2 class="text-3xl font-bold text-foreground mb-8">
						Mes coordonnées
					</h2>
					<div class="space-y-8">
						<div class="flex items-start space-x-4">
							<div class="w-12 h-12 bg-surface rounded-lg flex items-center justify-center shrink-0">
								<svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
								</svg>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-foreground mb-2">Email</h3>
								<p class="text-muted">
									<ObfuscatedEmail class="text-foreground hover:text-primary" />
								</p>
							</div>
						</div>
						<div class="flex items-start space-x-4">
							<div class="w-12 h-12 bg-surface rounded-lg flex items-center justify-center shrink-0">
								<svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 1 1-6 0a3 3 0 0 1 6 0"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0"/>
								</svg>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-foreground mb-2">Zone d'intervention</h3>
								<p class="text-muted">
									France entière (travail à distance)
								</p>
							</div>
						</div>
					</div>
					<div class="mt-12 rounded-xl border border-border bg-white p-6">
						<h3 class="text-xl font-semibold text-foreground mb-4">
							Vous préférez un cadre plus guidé ?
						</h3>
						<div class="space-y-3">
							<a href="/devis/" data-umami-event="lead_click_cta_devis_from_contact_simple" class="block rounded-lg border border-border px-4 py-3 text-foreground hover:bg-surface transition-colors">
								Recevoir un devis personnalisé
							</a>
							<a href="/diagnostic-gratuit/" data-umami-event="lead_click_cta_diagnostic_from_contact_simple" class="block rounded-lg border border-border px-4 py-3 text-foreground hover:bg-surface transition-colors">
								Demander un diagnostic gratuit
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script is:inline>
		(() => {
			if (window.umami && typeof window.umami.track === 'function') {
				window.umami.track('lead_view_contact_simple');
			}
		})();
	</script>
</Layout>
