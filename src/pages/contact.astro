---
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import {
	INSTAGRAM_HREF,
	SOCIAL_HANDLE_DISPLAY,
	WHATSAPP_DISPLAY,
	WHATSAPP_HREF
} from '../data/contact';

const baseUrl = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Contact', item: new URL('/contact/', baseUrl).toString() }
	]
};
---

<Layout 
	title="Contact site psychologue et psychomotricien | Nicodev"
	description="Une question sur votre site de psychologue, de psychomotricien ou votre visibilité locale ? Écrivez-moi, je vous réponds sous 48h."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>
	<Hero 
		title="Contact — site web pour psychologues et psychomotriciens" 
		subtitle="Une question sur votre site, votre visibilité locale ou l’adaptation de l’accompagnement à votre pratique ? Je vous réponds avec plaisir." 
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Contact' }]}
	/>

	<section class="py-16 bg-surface-alt" aria-labelledby="contact-main-heading">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-14">
				<div>
					<p class="type-eyebrow text-muted mb-2">Formulaire</p>
					<h2 id="contact-main-heading" class="text-3xl font-bold text-foreground mb-4">
						Parlons de votre situation
					</h2>
					<p class="text-muted mb-8 max-w-prose">
						Vous pouvez utiliser ce formulaire pour une question simple : clarification sur mes services, point de blocage sur votre
						site actuel, ou premier échange avant de décider. L’accompagnement s’adresse d’abord aux psychologues et s’ouvre aux
						psychomotriciens, avec une vérification au cas par cas pour les autres métiers du soin.
						Si vous souhaitez une proposition tarifaire, la page devis est plus adaptée.
					</p>
					<p class="mb-8 rounded-lg border border-border bg-white p-4 text-sm leading-relaxed text-muted max-w-prose">
						<strong class="text-foreground">Besoin d’un prix&nbsp;?</strong>{' '}
						<a href="/devis/" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">Demande de devis</a>.
						<span class="mt-2 block">
							<strong class="text-foreground">Pas encore prêt pour un devis&nbsp;?</strong>{' '}
							<a href="/diagnostic-gratuit/" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">Diagnostic gratuit</a>.
						</span>
					</p>
					<ContactForm mode="contact" />
				</div>
				<aside aria-labelledby="contact-aside-heading">
					<p class="type-eyebrow text-muted mb-2">Informations</p>
					<h3 id="contact-aside-heading" class="text-xl font-semibold text-foreground tracking-tight mb-6">
						Coordonnées et disponibilité
					</h3>

					<ul class="mb-8 space-y-2 text-sm text-muted border-l-2 border-primary-300 pl-4">
						<li>
							<strong class="font-semibold text-foreground">Réponse sous 48&nbsp;h</strong>
							<span class="text-muted"> (jours ouvrés)</span>
						</li>
						<li>Fuseau horaire : Europe / Paris</li>
						<li>Données utilisées uniquement pour répondre à votre message — pas de newsletter.</li>
					</ul>

					<dl class="space-y-5 mb-10">
						<div class="flex gap-3">
							<svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
							</svg>
							<div>
								<dt class="text-sm font-semibold text-foreground">Email</dt>
								<dd class="mt-1 text-sm text-muted">
									<ObfuscatedEmail class="text-foreground hover:text-primary transition-colors" />
								</dd>
							</div>
						</div>
						<div class="flex gap-3">
							<svg class="mt-0.5 h-5 w-5 shrink-0 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
							</svg>
							<div>
								<dt class="text-sm font-semibold text-foreground">WhatsApp</dt>
								<dd class="mt-1 text-sm">
									<a
										href={WHATSAPP_HREF}
										target="_blank"
										rel="noopener noreferrer"
										data-umami-event="lead_click_whatsapp_from_contact_aside"
										class="font-medium text-[#128C7E] hover:text-[#25D366] transition-colors"
									>
										{WHATSAPP_DISPLAY}
									</a>
									<span class="text-muted">
										{' '}
										— profil {SOCIAL_HANDLE_DISPLAY}
									</span>
								</dd>
							</div>
						</div>
						<div class="flex gap-3">
							<svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-foreground" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
							</svg>
							<div>
								<dt class="text-sm font-semibold text-foreground">Instagram</dt>
								<dd class="mt-1 text-sm">
									<a
										href={INSTAGRAM_HREF}
										target="_blank"
										rel="me noopener noreferrer"
										data-umami-event="lead_click_instagram_from_contact_aside"
										class="font-medium text-foreground hover:text-primary transition-colors"
									>
										{SOCIAL_HANDLE_DISPLAY}
									</a>
									<span class="text-muted"> — même identifiant que WhatsApp</span>
								</dd>
							</div>
						</div>
						<div class="flex gap-3">
							<svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 1 1-6 0a3 3 0 0 1 6 0"/>
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0"/>
							</svg>
							<div>
								<dt class="text-sm font-semibold text-foreground">Zone d'intervention</dt>
								<dd class="mt-1 text-sm text-muted">
									France entière (travail à distance)
								</dd>
							</div>
						</div>
					</dl>

					<div class="mb-10 rounded-lg border border-border bg-background p-5">
						<p class="type-eyebrow text-muted mb-3">Après envoi</p>
						<ol class="list-decimal space-y-2 pl-5 text-sm text-muted marker:text-foreground">
							<li class="pl-1"><span class="text-foreground font-medium">Réception</span> — votre message arrive directement.</li>
							<li class="pl-1"><span class="text-foreground font-medium">Lecture</span> — je traite les demandes dans l'ordre d'arrivée.</li>
							<li class="pl-1"><span class="text-foreground font-medium">Réponse</span> — retour personnalisé sous 48&nbsp;h ouvrées.</li>
						</ol>
					</div>

					<div class="rounded-lg border border-border bg-background p-6">
						<h4 class="text-lg font-semibold text-foreground mb-1">
							Autres parcours
						</h4>
						<p class="text-sm text-muted mb-5">
							Besoin d'un chiffrage ou d'un premier regard sur votre site&nbsp;? Ces pages sont faites pour ça.
						</p>
						<div class="flex flex-col gap-3">
							<a
								href="/devis/"
								data-umami-event="lead_click_cta_devis_from_contact_simple"
								class="btn-primary-solid inline-flex w-full items-center justify-between gap-3 rounded-lg px-5 py-3 text-left font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
							>
								<span>Recevoir un devis personnalisé</span>
								<svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
								</svg>
							</a>
							<a
								href="/diagnostic-gratuit/"
								data-umami-event="lead_click_cta_diagnostic_from_contact_simple"
								class="btn-outline-terracotta inline-flex w-full items-center justify-between gap-3 rounded-lg border border-primary-foreground bg-transparent px-5 py-3 text-left font-semibold text-primary-foreground hover:bg-primary-foreground/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-foreground"
							>
								<span>Demander un diagnostic gratuit</span>
								<svg class="h-5 w-5 shrink-0 opacity-90" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
								</svg>
							</a>
						</div>
					</div>
				</aside>
			</div>
		</div>
	</section>

	<script is:inline>
		(() => {
			if (window.umami && typeof window.umami.track === 'function') {
				window.umami.track('lead_view_contact_simple');
			}
		})();
	</script>
</Layout>
