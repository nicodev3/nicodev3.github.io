---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FormField from '../components/FormField.astro';

const baseUrl = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Contact', item: new URL('/contact', baseUrl).toString() }
	]
};
---

<Layout 
	title="Contact - Création site internet pour psychologue | Nicolas Devaux"
	description="Contactez-moi pour votre projet de site internet pour psychologue. Devis gratuit, création sur mesure, réponse sous 48h."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>
	<Hero title="Contactez-moi" subtitle="Discutons de votre projet de site internet" />

	<!-- Contact Section -->
	<section class="py-16 bg-background">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
				<!-- Contact Form -->
				<div>
					<h2 class="text-3xl font-bold text-foreground mb-8">
						Envoyez-moi un message
					</h2>
					
					<div id="form-success" class="hidden bg-surface border border-border rounded-xl p-8 text-center">
					<svg class="w-12 h-12 text-foreground mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15L15 9.75M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0"/>
					</svg>
					<h3 class="text-xl font-semibold text-foreground mb-2">Message envoyé !</h3>
					<p class="text-muted">Merci pour votre message. Je vous répondrai dans les plus brefs délais.</p>
				</div>

				<form id="contact-form" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
						<input type="hidden" name="form-name" value="contact" />
						<p class="hidden" aria-hidden="true">
							<label for="contact-bot-field">Ne pas remplir</label>
							<input id="contact-bot-field" name="bot-field" type="text" tabindex="-1" autocomplete="off" />
						</p>
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<FormField id="firstName" name="firstName" label="Prénom *" type="text" required />
							<FormField id="lastName" name="lastName" label="Nom *" type="text" required />
						</div>
						
						<FormField id="email" name="email" label="Email *" type="email" required />
						<FormField id="phone" name="phone" label="Téléphone" type="tel" />

						<FormField id="profession" name="profession" label="Votre profession *" required variant="select">
							<option value="">Sélectionnez votre profession</option>
							<option value="psychologue">Psychologue</option>
						</FormField>
						
						<FormField id="formule" name="formule" label="Offre souhaitée *" required variant="select">
							<option value="">Sélectionnez une offre</option>
							<option value="serenite">Offre Sérénité — 29€/mois</option>
							<option value="visibilite-confiance">Offre Visibilité &amp; Confiance — 49€/mois</option>
							<option value="indecis">Je ne sais pas encore</option>
						</FormField>
						
						<FormField id="message" name="message" label="Votre projet *" required variant="textarea" placeholder="Décrivez votre activité, vos besoins, vos objectifs..." rows={6} />
						
					<button 
						type="submit"
						id="submit-btn"
						class="w-full bg-primary text-on-primary py-3 px-6 rounded-lg font-semibold hover:opacity-90 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
					>
						Envoyer le message
					</button>
				</form>

				<script>
					const form = document.getElementById('contact-form') as HTMLFormElement;
					const successMsg = document.getElementById('form-success') as HTMLElement;
					const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

					form.addEventListener('submit', async (e) => {
						e.preventDefault();
						submitBtn.disabled = true;
						submitBtn.textContent = 'Envoi en cours...';

						const formData = new FormData(form);
						const params = new URLSearchParams();
						formData.forEach((value, key) => params.append(key, typeof value === 'string' ? value : (value as File).name));

						const response = await fetch(document.location.pathname, {
							method: 'POST',
							body: params.toString(),
							headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
						});

						if (response.ok) {
							form.classList.add('hidden');
							successMsg.classList.remove('hidden');
						} else {
							submitBtn.disabled = false;
							submitBtn.textContent = 'Envoyer le message';
							alert('Une erreur est survenue. Veuillez réessayer ou me contacter par email.');
						}
					});
				</script>
				</div>
				
				<!-- Contact Info -->
				<div>
					<h2 class="text-3xl font-bold text-foreground mb-8">
						Mes coordonnées
					</h2>
					
					<div class="space-y-8">
						<div class="flex items-start space-x-4">
							<div class="w-12 h-12 bg-surface rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
								</svg>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-foreground mb-2">Email</h3>
								<p class="text-muted">
									<a href="mailto:contact.nicodev@gmail.com" class="text-foreground hover:text-primary">
										contact.nicodev@gmail.com
									</a>
								</p>
							</div>
						</div>
						
						<div class="flex items-start space-x-4">
							<div class="w-12 h-12 bg-surface rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
								</svg>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-foreground mb-2">GitHub</h3>
								<p class="text-muted">
									<a href="https://github.com/nicodev3" target="_blank" rel="noopener noreferrer" class="text-foreground hover:text-primary">
										github.com/nicodev3
									</a>
								</p>
							</div>
						</div>
						
						<div class="flex items-start space-x-4">
							<div class="w-12 h-12 bg-surface rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 1 1-6 0a3 3 0 0 1 6 0"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0"/>
								</svg>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-foreground mb-2">Zone d'intervention</h3>
								<p class="text-muted">
									France entière (travail à distance)
								</p>
							</div>
						</div>
					</div>
					
					<!-- Rappel des offres -->
					<div class="mt-12">
						<h3 class="text-xl font-semibold text-foreground mb-6">
							Rappel des offres
						</h3>
						
						<div class="space-y-4">
							<div class="bg-surface p-4 rounded-lg border-l-4 border-border">
								<h4 class="font-medium text-foreground mb-1">
									Sérénité — 29€/mois
								</h4>
								<p class="text-muted text-sm">
									Un site en ligne en continu, votre adresse internet gérée pour vous, sécurité, sauvegardes,
									1 modification simple par mois (texte ou photo) et support par email.
								</p>
							</div>
							
							<div class="bg-surface p-4 rounded-lg border-l-4 border-border">
								<h4 class="font-medium text-foreground mb-1">
									Visibilité &amp; Confiance — 49€/mois
								</h4>
								<p class="text-muted text-sm">
									Tout ce qui est inclus dans l’offre Sérénité, avec en plus un accompagnement pour votre
									visibilité sur Google, votre fiche Google, une vérification annuelle du site, une relecture
									RGPD, 2 modifications simples par mois et une modernisation légère tous les 2 ans.
								</p>
							</div>

							<p class="text-sm text-muted pt-2">
								Vous hésitez entre les offres ? Décrivez simplement votre situation dans le formulaire,
								je vous indique ce qui semble le plus adapté.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
