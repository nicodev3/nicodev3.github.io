---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FormField from '../components/FormField.astro';
---

<Layout 
	title="Contact - Nicolas Devaux"
	description="Contactez-moi pour discuter de votre projet de site internet"
>
	<Hero title="Contactez-moi" subtitle="Discutons de votre projet de site internet" />

	<!-- Contact Section -->
	<section class="py-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
				<!-- Contact Form -->
				<div>
					<h2 class="text-3xl font-bold text-gray-900 mb-8">
						Envoyez-moi un message
					</h2>
					
					<div id="form-success" class="hidden bg-green-50 border border-green-200 rounded-xl p-8 text-center">
					<svg class="w-12 h-12 text-green-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15L15 9.75M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0"/>
					</svg>
					<h3 class="text-xl font-semibold text-green-800 mb-2">Message envoyé !</h3>
					<p class="text-green-700">Merci pour votre message. Je vous répondrai dans les plus brefs délais.</p>
				</div>

				<form id="contact-form" class="space-y-6">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<FormField id="firstName" name="firstName" label="Prénom *" type="text" required />
							<FormField id="lastName" name="lastName" label="Nom *" type="text" required />
						</div>
						
						<FormField id="email" name="email" label="Email *" type="email" required />
						<FormField id="phone" name="phone" label="Téléphone" type="tel" />

						<FormField id="profession" name="profession" label="Votre profession *" required variant="select">
							<option value="">Sélectionnez votre profession</option>
							<option value="psychologue">Psychologue</option>
							<option value="medecin">Médecin</option>
							<option value="psychotherapeute">Psychothérapeute</option>
							<option value="kinesitherapeute">Kinésithérapeute</option>
							<option value="osteopathe">Ostéopathe</option>
							<option value="autre-praticien">Autre praticien libéral</option>
							<option value="autre">Autre</option>
						</FormField>
						
						<FormField id="formule" name="formule" label="Formule souhaitée *" required variant="select">
							<option value="">Sélectionnez une formule</option>
							<option value="forfait">Forfait Création — 490€ (sans abonnement)</option>
							<option value="vitrine">Pack Site Vitrine — 59€/mois</option>
							<option value="blog">Pack Site + Blog — 89€/mois</option>
							<option value="indecis">Je ne sais pas encore</option>
						</FormField>
						
						<FormField id="message" name="message" label="Votre projet *" required variant="textarea" placeholder="Décrivez votre activité, vos besoins, vos objectifs..." rows={6} />
						
					<button 
						type="submit"
						id="submit-btn"
						class="w-full bg-teal-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-teal-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
					>
						Envoyer le message
					</button>
				</form>

				<script>
					const form = document.getElementById('contact-form') as HTMLFormElement;
					const successMsg = document.getElementById('form-success') as HTMLElement;
					const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

					form.addEventListener('submit', async (e) => {
						e.preventDefault();
						submitBtn.disabled = true;
						submitBtn.textContent = 'Envoi en cours...';

						const data = new FormData(form);
						const response = await fetch('https://formspree.io/f/xqedyrwy', {
							method: 'POST',
							body: data,
							headers: { Accept: 'application/json' },
						});

						if (response.ok) {
							form.classList.add('hidden');
							successMsg.classList.remove('hidden');
						} else {
							submitBtn.disabled = false;
							submitBtn.textContent = 'Envoyer le message';
							alert('Une erreur est survenue. Veuillez réessayer ou me contacter par email.');
						}
					});
				</script>
				</div>
				
				<!-- Contact Info -->
				<div>
					<h2 class="text-3xl font-bold text-gray-900 mb-8">
						Mes coordonnées
					</h2>
					
					<div class="space-y-8">
						<div class="flex items-start space-x-4">
							<div class="w-12 h-12 bg-teal-100 rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
								</svg>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-gray-900 mb-2">Email</h3>
								<p class="text-gray-600">
									<a href="mailto:contact.nicodev@gmail.com" class="text-teal-600 hover:text-teal-800">
										contact.nicodev@gmail.com
									</a>
								</p>
							</div>
						</div>
						
						<div class="flex items-start space-x-4">
							<div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
								</svg>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-gray-900 mb-2">GitHub</h3>
								<p class="text-gray-600">
									<a href="https://github.com/nicodev3" target="_blank" rel="noopener noreferrer" class="text-teal-600 hover:text-teal-800">
										github.com/nicodev3
									</a>
								</p>
							</div>
						</div>
						
						<div class="flex items-start space-x-4">
							<div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 1 1-6 0a3 3 0 0 1 6 0"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0"/>
								</svg>
							</div>
							<div>
								<h3 class="text-lg font-semibold text-gray-900 mb-2">Zone d'intervention</h3>
								<p class="text-gray-600">
									France entière (travail à distance)
								</p>
							</div>
						</div>
					</div>
					
					<!-- Rappel des formules -->
					<div class="mt-12">
						<h3 class="text-xl font-semibold text-gray-900 mb-6">
							Rappel des formules
						</h3>
						
						<div class="space-y-4">
							<div class="bg-gray-50 p-4 rounded-lg border-l-4 border-gray-400">
								<h4 class="font-medium text-gray-900 mb-1">
									Forfait Création — 490€
								</h4>
								<p class="text-gray-600 text-sm">
									Site livré clé en main, hébergement inclus la 1ère année. Modifications ultérieures facturées 50€/h.
								</p>
							</div>
							
							<div class="bg-teal-50 p-4 rounded-lg border-l-4 border-teal-400">
								<h4 class="font-medium text-gray-900 mb-1">
									Pack Site Vitrine — 59€/mois
								</h4>
								<p class="text-gray-600 text-sm">
									Site + hébergement + modifications de contenu illimitées + support. Sans engagement.
								</p>
							</div>
							
							<div class="bg-teal-50 p-4 rounded-lg border-l-4 border-teal-600">
								<h4 class="font-medium text-gray-900 mb-1">
									Pack Site + Blog — 89€/mois
								</h4>
								<p class="text-gray-600 text-sm">
									Tout du Pack Vitrine + 2 articles de santé rédigés et publiés chaque mois pour améliorer votre visibilité sur Google.
								</p>
							</div>

							<p class="text-sm text-gray-500 pt-2">
								Vous hésitez entre les formules ? Décrivez votre situation dans le formulaire, je vous conseille gratuitement.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
