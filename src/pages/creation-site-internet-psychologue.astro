---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaSection from '../components/CtaSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import { Phone, MessageCircle } from '@lucide/astro';
import { WHATSAPP_HREF, WHATSAPP_DISPLAY, WHATSAPP_PHONE_E164 } from '../data/contact';
import psychologueImage from '../assets/images/psychologue.webp';

const baseUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL('/creation-site-internet-psychologue/', baseUrl).href;

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: "Combien coûte la création d'un site internet pour psychologue ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "L'offre fonctionne par abonnement mensuel tout inclus dès 29 EUR/mois (création, hébergement, nom de domaine, maintenance). L'offre Visibilité & Confiance à 49 EUR/mois ajoute fiche Google, contenus réguliers et suivi SEO local.",
			},
		},
		{
			'@type': 'Question',
			name: 'Création site internet psychologue : que comprend la prestation ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Structure de pages adaptée au cabinet, rédaction guidée à partir de vos réponses, design sobre, intégration Doctolib ou équivalent, bases SEO, hébergement, nom de domaine et mises à jour inclus dans l'abonnement.",
			},
		},
		{
			'@type': 'Question',
			name: 'Création site psychologue : combien ça coûte ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "L'offre fonctionne par abonnement mensuel tout inclus dès 29 EUR/mois (création, hébergement, nom de domaine, maintenance). L'offre Visibilité & Confiance à 49 EUR/mois ajoute fiche Google, contenus réguliers et suivi SEO local.",
			},
		},
		{
			'@type': 'Question',
			name: 'Le site convient-il aussi aux psychomotriciens, ergothérapeutes et orthophonistes ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Oui. Nicodev accompagne les psychologues, ainsi que les psychomotriciens, ergothérapeutes et orthophonistes en libéral : site vitrine sobre, cadre professionnel respecté, hors annuaires et plateformes.",
			},
		},
		{
			'@type': 'Question',
			name: 'Combien de temps faut-il pour créer un site de psychologue ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "En général deux à trois semaines entre le premier échange et la mise en ligne, selon la rapidité avec laquelle vous complétez le formulaire de contenu.",
			},
		},
		{
			'@type': 'Question',
			name: 'Pourquoi créer un site internet quand on est psychologue ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Pour disposer d'un espace que vous contrôlez : présentation de votre approche, publics accompagnés, honoraires, modalités pratiques. Les annuaires et plateformes imposent leur format ; un site vitrine de psychologue rassure les patients avant le premier contact et soutient votre visibilité locale.",
			},
		},
		{
			'@type': 'Question',
			name: 'Un site internet peut-il aider à trouver des patients ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Oui, indirectement : un site bien structuré et cohérent avec votre fiche Google Business Profile améliore vos chances d'être trouvé sur des recherches locales. Il aide aussi les personnes à comprendre votre cadre avant de prendre contact. Aucune place dans Google ne peut en revanche être garantie.",
			},
		},
		{
			'@type': 'Question',
			name: "Faut-il un site si j'ai déjà Doctolib ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Doctolib gère la prise de rendez-vous mais ne présente ni votre approche ni votre cadre avec vos mots. Le site et Doctolib jouent des rôles complémentaires : le site explique et rassure, la plateforme réserve.",
			},
		},
		{
			'@type': 'Question',
			name: 'Quelles pages mettre sur un site de psychologue ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "En général : accueil, présentation de votre parcours et de votre approche, consultations proposées (publics, motifs, modalités), informations pratiques (honoraires, accès, horaires) et contact. Le détail s'adapte à votre pratique en cabinet libéral.",
			},
		},
		{
			'@type': 'Question',
			name: 'Combien coûte un site internet pour psychologue ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "L'offre fonctionne par abonnement mensuel tout inclus : création, hébergement, nom de domaine et mises à jour. Le détail des formules est présenté sur la page Tarifs.",
			},
		},
		{
			'@type': 'Question',
			name: 'Est-ce compatible avec la déontologie des psychologues ?',
			acceptedAnswer: {
				'@type': 'Answer',
