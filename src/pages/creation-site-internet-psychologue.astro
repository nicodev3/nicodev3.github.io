---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaSection from '../components/CtaSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import DiagnosticLeadCta from '../components/DiagnosticLeadCta.astro';
import { AtSign, Phone, MessageCircle } from '@lucide/astro';
import {
	INSTAGRAM_HREF,
	SOCIAL_HANDLE_DISPLAY,
	WHATSAPP_HREF,
	WHATSAPP_DISPLAY,
	WHATSAPP_PHONE_E164
} from '../data/contact';
import psychologueImage from '../assets/images/psychologue.webp';

const baseUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL('/creation-site-internet-psychologue/', baseUrl).href;

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: "Combien coûte la création d'un site internet pour psychologue ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "L'offre fonctionne par abonnement mensuel tout inclus dès 29 EUR/mois (création, hébergement, nom de domaine, CMS, bases SEO, fiche Google, maintenance). L'offre Visibilité & Confiance à 49 EUR/mois ajoute une veille SEO d'expert : suivi, relecture et optimisation des contenus.",
			},
		},
		{
			'@type': 'Question',
			name: 'Création site internet psychologue : que comprend la prestation ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Structure de pages adaptée au cabinet, rédaction guidée à partir de vos réponses, design sobre, CMS, intégration Doctolib ou équivalent, bases SEO, fiche Google, hébergement, nom de domaine et mises à jour inclus dans l'abonnement.",
			},
		},
		{
			'@type': 'Question',
			name: 'Création site psychologue : combien ça coûte ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "L'offre fonctionne par abonnement mensuel tout inclus dès 29 EUR/mois (création, hébergement, nom de domaine, CMS, bases SEO, fiche Google, maintenance). L'offre Visibilité & Confiance à 49 EUR/mois ajoute une veille SEO d'expert : suivi, relecture et optimisation des contenus.",
			},
		},
		{
			'@type': 'Question',
			name: 'Le site convient-il aussi aux psychothérapeutes et aux psychomotriciens ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Oui : l'offre s'adresse aux psychologues, aux psychothérapeutes autorisés à faire usage du titre (RPPS) et aux psychomotriciens. Les psychopraticiens et les praticiens en psychothérapie sans titre de psychothérapeute ne font pas partie de l'offre.",
			},
		},
		{
			'@type': 'Question',
			name: 'Combien de temps faut-il pour créer un site de psychologue ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "En général deux à trois semaines entre le premier échange et la mise en ligne, selon la rapidité avec laquelle vous complétez le formulaire de contenu.",
			},
		},
		{
			'@type': 'Question',
			name: 'Pourquoi créer un site internet quand on est psychologue ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Pour disposer d'un espace que vous contrôlez : présentation de votre approche, publics accompagnés, honoraires, modalités pratiques. Les annuaires et plateformes imposent leur format ; un site vitrine de psychologue rassure les patients avant le premier contact et soutient votre visibilité locale.",
			},
		},
		{
			'@type': 'Question',
			name: 'Un site internet peut-il aider à trouver des patients ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Oui, indirectement : un site bien structuré et cohérent avec votre fiche Google Business Profile améliore vos chances d'être trouvé sur des recherches locales. Il aide aussi les personnes à comprendre votre cadre avant de prendre contact. Aucune place dans Google ne peut en revanche être garantie.",
			},
		},
		{
			'@type': 'Question',
			name: "Faut-il un site si j'ai déjà Doctolib ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Doctolib gère la prise de rendez-vous mais ne présente ni votre approche ni votre cadre avec vos mots. Le site et Doctolib jouent des rôles complémentaires : le site explique et rassure, la plateforme réserve.",
			},
		},
		{
			'@type': 'Question',
			name: 'Quelles pages mettre sur un site de psychologue ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "En général : accueil, présentation de votre parcours et de votre approche, consultations proposées (publics, motifs, modalités), informations pratiques (honoraires, accès, horaires) et contact. Le détail s'adapte à votre pratique en cabinet libéral.",
			},
		},
		{
			'@type': 'Question',
			name: 'Combien coûte un site internet pour psychologue ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "L'offre fonctionne par abonnement mensuel tout inclus : création, hébergement, nom de domaine et mises à jour. Le détail des formules est présenté sur la page Tarifs.",
			},
		},
		{
			'@type': 'Question',
			name: 'Est-ce compatible avec la déontologie des psychologues ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Oui : le code de déontologie n'interdit pas d'avoir un site, il encadre la manière de se présenter. Les contenus restent informatifs et sobres, sans affirmation de résultat ni discours publicitaire déplacé.",
			},
		},
		{
			'@type': 'Question',
			name: 'Faut-il rédiger tout le contenu soi-même ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Non : vous répondez à un formulaire guidé ; j'organise et reformule pour le web en respectant votre ton.",
			},
		},
		{
			'@type': 'Question',
			name: "Combien de temps avant d'être visible sur Google ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Le site peut être indexé en quelques semaines ; une présence locale stable demande souvent plusieurs mois de régularité (fiche Google + site cohérents).',
			},
		},
		{
			'@type': 'Question',
			name: "Que comprend l'abonnement mensuel ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Hébergement, nom de domaine, mises à jour et support selon la formule choisie.',
			},
		},
		{
			'@type': 'Question',
			name: 'Le site appartient-il au psychologue ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Oui. Le site, son nom de domaine et ses contenus appartiennent au client. En cas de résiliation, Nicodev remet une copie exploitable du site afin qu'il puisse être réhébergé ailleurs.",
			},
		},
	],
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Création de site internet pour psychologue',
	description:
		'Création ou refonte de site internet pour psychologues, psychothérapeutes et psychomotriciens : contenu guidé, prise de rendez-vous, hébergement, maintenance et bases SEO inclus dès 29 EUR par mois.',
	provider: {
		'@type': 'Person',
		name: 'Nicolas Devaux',
		url: new URL('/about/', baseUrl).href,
	},
	serviceType: 'Création de site internet',
	areaServed: { '@type': 'Country', name: 'France' },
	audience: {
		'@type': 'Audience',
		audienceType: 'Psychologues, psychothérapeutes et psychomotriciens en libéral',
	},
	offers: {
		'@type': 'AggregateOffer',
		priceCurrency: 'EUR',
		lowPrice: '29',
		highPrice: '49',
		offerCount: 2,
		url: new URL('/tarifs/', baseUrl).href,
	},
	url: pageUrl,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Création de site internet pour psychologue',
			item: pageUrl
		}
	]
};
---

<Layout
	title="Création de site internet pour psychologue | Nicodev"
	description="Création ou refonte de site internet pour psychologue : contenu guidé, prise de rendez-vous, hébergement, maintenance et bases SEO dès 29 €/mois."
	image={psychologueImage}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<Hero
		title="Création de site internet pour psychologue"
		subtitle="Un site vitrine sobre pour présenter votre cadre, rassurer avant le premier contact et soutenir votre visibilité locale — conçu par un psychologue, psychomotricien et psychothérapeute devenu développeur web."
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Création de site internet pour psychologue' }]}
		coverImage={psychologueImage}
		coverImageAlt="Exemple de site sobre pour une psychologue en libéral"
	/>

	<div class="border-b border-border bg-white py-3">
		<div class="shell-layout flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
			<a
				href={`tel:+${WHATSAPP_PHONE_E164}`}
				class="inline-flex items-center gap-1.5 font-medium text-muted transition-colors hover:text-primary"
			>
				<Phone class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				{WHATSAPP_DISPLAY}
			</a>
			<a
				href={WHATSAPP_HREF}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 font-semibold text-primary-500 transition-colors hover:text-primary"
				data-analytics-event="lead_click_whatsapp"
				data-analytics-cta="whatsapp"
				data-analytics-location="creation_page"
			>
				<MessageCircle class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				WhatsApp {SOCIAL_HANDLE_DISPLAY}
			</a>
			<a
				href={INSTAGRAM_HREF}
				target="_blank"
				rel="me noopener noreferrer"
				class="inline-flex items-center gap-1.5 font-medium text-muted transition-colors hover:text-primary"
				data-umami-event="lead_click_instagram_from_creation_page"
			>
				<AtSign class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				Instagram {SOCIAL_HANDLE_DISPLAY}
			</a>
		</div>
	</div>

	<section class="section-y border-b border-border bg-white">
		<div class="shell-layout">
			<div class="mx-auto max-w-[72ch] prose prose-lg prose-headings:text-foreground prose-p:text-muted prose-li:text-muted prose-strong:text-foreground">
				<p>
					La <strong>création d’un site internet pour psychologue</strong> sert surtout à une chose&nbsp;:
					présenter clairement votre pratique, vos publics et vos modalités, pour que les personnes
					qui vous cherchent puissent décider de vous contacter — sans dépendre uniquement d’un annuaire
					ou d’une plateforme de rendez-vous.
				</p>
				<p>
					La prestation est conçue pour les <strong>psychologues en libéral</strong>&nbsp;: structure,
					contenu guidé, design, intégration de votre outil de rendez-vous, hébergement, maintenance et bases
					SEO. Elle tient compte de votre cadre professionnel sans transformer votre pratique en produit.
				</p>

				<blockquote>
					<p><strong>En bref</strong></p>
					<ul>
						<li><strong>Offre Sérénité</strong>&nbsp;: 29&nbsp;EUR/mois — site vitrine, CMS, bases SEO, fiche Google, hébergement</li>
						<li><strong>Offre Visibilité &amp; Confiance</strong>&nbsp;: 49&nbsp;EUR/mois — + veille SEO d’expert, entretien</li>
						<li><strong>Délai</strong>&nbsp;: 2 à 3 semaines en moyenne</li>
						<li><strong>Contenu</strong>&nbsp;: formulaire guidé, pas de rédaction seul·e obligatoire</li>
						<li><strong>Propriété</strong>&nbsp;: votre site vous appartient et peut être transféré ailleurs</li>
						<li><strong>Spécialisation</strong>&nbsp;: confrère du métier (psychologue, psychomotricien, psychothérapeute) et développeur web — cadre déontologique intégré</li>
					</ul>
					<p>
						Comparer les formules sur les <a href="/tarifs/">tarifs</a>.
						Priorité visibilité locale&nbsp;? Voir <a href="/referencement-site-psychologue/">référencement site psychologue</a>.
						Vous vous installez&nbsp;? Le guide <a href="/blog/installer-liberal-psychologue-par-ou-commencer/">ouvrir un cabinet de psychologue</a>{' '}
						place le site au bon moment dans le planning.
					</p>
				</blockquote>

				<div class="not-prose my-8">
					<DiagnosticLeadCta variant="installation-mid" />
				</div>

				<div class="not-prose my-8 grid gap-4 md:grid-cols-2">
					<div class="rounded-xl border border-border bg-surface p-5">
						<h2 class="font-heading text-xl font-semibold text-foreground">C’est adapté si…</h2>
						<ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
							<li>vous voulez présenter votre cabinet avec sobriété et justesse&nbsp;;</li>
							<li>vous préférez déléguer l’hébergement, la maintenance et les réglages SEO&nbsp;;</li>
							<li>vous avez besoin d’un site relié à Doctolib, Qare, Maiia ou à un formulaire simple&nbsp;;</li>
							<li>vous cherchez un accompagnement qui comprend le cadre déontologique des psychologues (et titres réglementés proches)&nbsp;;</li>
							<li>vous préférez travailler avec un confrère plutôt qu’avec une agence multi-métiers.</li>
						</ul>
					</div>
					<div class="rounded-xl border border-border bg-white p-5">
						<h2 class="font-heading text-xl font-semibold text-foreground">Ce n’est pas adapté si…</h2>
						<ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
							<li>vous cherchez une garantie de place précise dans Google&nbsp;;</li>
							<li>vous voulez une plateforme complexe sur mesure ou un espace patient&nbsp;;</li>
							<li>vous préférez tout gérer vous-même, y compris technique et maintenance&nbsp;;</li>
							<li>vous exercez hors titre de psychologue, de psychothérapeute (RPPS) ou de psychomotricien (ex.&nbsp;psychopraticien)&nbsp;;</li>
							<li>vous attendez un discours publicitaire ou des affirmations thérapeutiques excessives.</li>
						</ul>
					</div>
				</div>

				<h2>Ce que comprend la création d’un site pour psychologue</h2>
				<p>
					Avant de comparer les solutions possibles, voici ce qui distingue un site simplement présent en ligne
					d’un site qui aide réellement à présenter votre cadre, vos modalités et les informations utiles avant le premier contact.
				</p>
				<ol>
					<li><strong>Message clair dès l&apos;accueil</strong> — qui vous êtes, où vous exercez, pour quels publics.</li>
					<li><strong>Pages essentielles bien structurées</strong> — approche, consultations, informations pratiques, contact.</li>
					<li><strong>Ton professionnel et sobre</strong> — informatif, conforme au cadre déontologique, sans affirmation excessive.</li>
					<li><strong>Parcours court vers le contact</strong> — téléphone, formulaire ou widget RDV visible sur mobile.</li>
					<li><strong>Bases SEO livrées</strong> — titres, descriptions, performances, données structurées, sitemap.</li>
					<li><strong>Cohérence avec la fiche Google</strong> — même nom, adresse, téléphone (NAP) entre site et fiche.</li>
					<li><strong>Maintenance incluse</strong> — hébergement, mises à jour, petites modifications sans gérer la technique.</li>
				</ol>

				<h2>Pourquoi confier la création à un confrère psychologue-développeur&nbsp;?</h2>
				<p>
					La <strong>création site web psychologue</strong> par une agence généraliste ou une plateforme multi-métiers pose souvent le même problème&nbsp;:
					il faut tout réexpliquer (cadre clinique, déontologie, ton attendu, ce qu&apos;on peut dire ou non) — et votre cabinet devient un segment parmi d&apos;autres, y compris des pratiques hors titre réglementé.
				</p>
				<p>
					Je suis <a href="/about/">psychologue, psychomotricien et psychothérapeute</a>, et développeur web.
					Je connais ces contraintes d&apos;emblée&nbsp;: pas besoin de «&nbsp;traduire&nbsp;» votre métier à une équipe marketing.
					Je prends aussi en charge la technique (structure, performance, SEO, hébergement).
				</p>
				<p>
					Des confrères accompagnés le confirment dans les <a href="/tarifs/">témoignages</a>&nbsp;: site performant,
					formulation juste, collaboration patiente. Voir aussi le <a href="/portfolio/">portfolio</a> et l&apos;article{' '}
					<a href="/blog/pourquoi-services-web-exclusifs-psychologues/">pourquoi une spécialisation web pour les psychologues</a>
					et <a href="/blog/site-psychologue-confrere-vs-agence-multi-metiers/">confrère vs agence multi-métiers</a>.
				</p>

				<h2>Site web, site internet, site vitrine&nbsp;: même besoin</h2>
				<p>
					Les recherches <strong>site web psychologue</strong>, <strong>site internet psychologue</strong> ou <strong>création site psychologue</strong> désignent en pratique la même attente&nbsp;: un lieu stable où vous contrôlez le message — approche, publics accompagnés, honoraires, accès au cabinet ou téléconsultation — alors que les annuaires et plateformes imposent leur mise en forme.
				</p>
				<p>
					Doctolib, Qare ou Maiia facilitent la prise de rendez-vous&nbsp;; ils ne remplacent pas un site qui explique <em>qui vous êtes</em> cliniquement et qui vous rend visible sur votre nom ou vos spécialités. Le <a href="/blog/site-internet-psychologue-doctolib/">comparatif site vs Doctolib</a> du blog détaille cette articulation&nbsp;; le <a href="/blog/guide-complet-visibilite-en-ligne-psychologues/">guide complet de la visibilité en ligne</a> pose le cadre global (fiche Google, SEO local, contenu).
				</p>

				<h2>Aussi pour psychothérapeutes (titre + RPPS) et psychomotriciens</h2>
				<p>
					Nicodev s’adresse aux <strong>psychologues</strong>, aux <strong>psychothérapeutes</strong> autorisés à faire usage du titre (inscription RPPS) et aux <strong>psychomotriciens</strong>.
					Même logique&nbsp;: site vitrine sobre, contenu guidé, cadre professionnel respecté.
					Les psychomotriciens ont une page dédiée&nbsp;: <a href="/site-internet-psychomotricien/">site internet psychomotricien</a>.
				</p>
				<p>
					<strong>Psychothérapeute</strong> (titre réglementé) et <strong>psychopraticien</strong> ne sont pas la même chose.
					Les psychopraticiens, praticiens en psychothérapie sans titre de psychothérapeute, coachs et «&nbsp;thérapeutes&nbsp;» génériques ne font <strong>pas</strong> partie de l’offre&nbsp;:
					l’enjeu est de ne pas brouiller les repères des patients ni diluer les titres protégés.
				</p>

				<h2>Ce que je fais pour vous</h2>
				<p>
					Je vous propose un <strong>site vitrine sur mesure</strong>, pensé pour le cabinet&nbsp;: pages lisibles sur téléphone, formulation adaptée à votre métier, pas de discours publicitaire déplacé ni de jargon technique imposé à vos patients.
				</p>
				<p>
					Vous n’êtes pas un «&nbsp;secteur parmi d’autres&nbsp;» dans une agence multi-métiers&nbsp;:
					le socle de pages, les exemples de formulation et les contraintes (cadre professionnel, RGPD, ton adapté) restent alignés sur votre réalité de libéral — pas sur un catalogue qui mélange titres réglementés et pratiques hors titre.
				</p>

				<h2>Ce que comprend la création</h2>
				<ul>
					<li>Une <strong>arborescence éprouvée</strong> (accueil, présentation de votre approche, informations pratiques, contact) que nous adaptons à votre ton et à vos spécialités</li>
					<li>Un <strong>contenu structuré à partir de vos réponses</strong> à un formulaire — vous n’avez pas à rédiger seul de longs textes&nbsp;: vous répondez à des questions courtes, je les organise pour le web</li>
					<li>Une mise en ligne <strong>rapide et sobre techniquement</strong>, lisible par Google (titres, descriptions, données structurées de base, bonnes performances sur mobile)</li>
					<li>L’intégration de votre <strong>outil de rendez-vous</strong> (Doctolib, Qare, Maiia ou équivalent) lorsque vous en utilisez un</li>
					<li>L’<strong>hébergement</strong>, le <strong>nom de domaine</strong> et les <strong>mises à jour</strong> inclus dans un abonnement mensuel — montants et périmètre détaillés sur la page <a href="/tarifs/">Tarifs</a></li>
				</ul>

				<h2>Les pages indispensables d’un site de psychologue</h2>
				<p>
					Un site vitrine de psychologue n’a pas besoin d’être volumineux pour être efficace. Quatre à cinq pages bien
					pensées suffisent le plus souvent&nbsp;: un <strong>accueil</strong> qui situe immédiatement qui vous êtes et où
					vous exercez, une <strong>présentation</strong> de votre parcours et de votre approche sans jargon, une page{' '}
					<strong>consultations</strong> (publics accompagnés, motifs fréquents, modalités, téléconsultation éventuelle),
					les <strong>informations pratiques</strong> (honoraires, accès, horaires) et un <strong>contact</strong> simple.
				</p>
				<p>
					L’enjeu n’est pas d’impressionner mais de <strong>rassurer avant le premier contact</strong>&nbsp;: un futur
					patient hésite souvent plusieurs jours avant d’appeler. Des informations claires, un ton juste et un parcours
					court vers le contact font la différence — bien plus qu’un design spectaculaire.
				</p>

				<h2>Faire soi-même, plateforme clé en main ou accompagnement sur mesure&nbsp;?</h2>
				<p>
					Avant de vous engager, il est sain de comparer les options&nbsp;: <a href="/blog/faire-son-site-soi-meme-psychologue/">faire son site soi-même</a>,{' '}
					<a href="/blog/creer-site-avec-ia-psychologue/">le créer avec l&apos;IA</a>, passer par une plateforme spécialisée ou un accompagnement personnalisé — en gardant un œil critique sur{' '}
					<a href="/blog/site-internet-psychologue-promesses-trop-belles/">les discours trop assurés de certaines offres</a>.
				</p>

				<div class="not-prose my-8 overflow-x-auto rounded-xl border border-border">
					<table class="w-full min-w-[36rem] border-collapse text-left text-sm">
						<caption class="sr-only">
							Comparaison entre faire soi-même, plateforme clé en main et accompagnement Nicodev pour la création d'un site internet psychologue
						</caption>
						<thead class="border-b border-border bg-surface-alt">
							<tr>
								<th scope="col" class="type-label-mono p-4 text-foreground">Option</th>
								<th scope="col" class="type-label-mono p-4 text-foreground">Avantages</th>
								<th scope="col" class="type-label-mono p-4 text-foreground">Limites</th>
								<th scope="col" class="type-label-mono p-4 text-foreground">Pour qui</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							<tr>
								<td class="p-4 font-medium text-foreground">Faire soi-même (Wix, WordPress…)</td>
