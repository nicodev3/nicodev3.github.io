				'@type': 'Answer',
				text: "Non : vous répondez à un formulaire guidé ; j'organise et reformule pour le web en respectant votre ton.",
			},
		},
		{
			'@type': 'Question',
			name: "Combien de temps avant d'être visible sur Google ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Le site peut être indexé en quelques semaines ; une présence locale stable demande souvent plusieurs mois de régularité (fiche Google + site cohérents).',
			},
		},
		{
			'@type': 'Question',
			name: "Que comprend l'abonnement mensuel ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Hébergement, nom de domaine, mises à jour et support selon la formule choisie.',
			},
		},
	],
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Création site internet psychologue — création site psychologue',
	description:
		'Création site internet psychologue et création site psychologue : structure claire, contenu guidé, design sobre, prise de rendez-vous intégrée, hébergement et bases SEO inclus.',
	provider: {
		'@type': 'Person',
		name: 'Nicolas Devaux',
		url: new URL('/about/', baseUrl).href,
	},
	serviceType: 'Création de site internet',
	areaServed: { '@type': 'Country', name: 'France' },
	audience: {
		'@type': 'Audience',
		audienceType: 'Psychologues, psychomotriciens, ergothérapeutes et orthophonistes en libéral',
	},
	offers: {
		'@type': 'AggregateOffer',
		priceCurrency: 'EUR',
		lowPrice: '29',
		highPrice: '49',
		offerCount: 2,
		url: new URL('/tarifs/', baseUrl).href,
	},
	url: pageUrl,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Création site internet psychologue',
			item: pageUrl
		}
	]
};
---

<Layout
	title="Création site internet psychologue | Création site psychologue"
	description="Création site internet psychologue et création site psychologue : site vitrine sobre, contenu guidé, hébergement et bases SEO inclus dès 29 €/mois."
	image={psychologueImage}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<Hero
		title="Création site internet psychologue"
		subtitle="Création site psychologue : présenter votre pratique, rassurer vos futurs patients et les orienter vers le contact ou le rendez-vous. Psychologue et développeur web."
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Création site internet psychologue' }]}
		coverImage={psychologueImage}
		coverImageAlt="Exemple de site sobre pour une psychologue en libéral"
	/>

	<div class="border-b border-border bg-white py-3">
		<div class="shell-layout flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
			<a
				href={`tel:+${WHATSAPP_PHONE_E164}`}
				class="inline-flex items-center gap-1.5 font-medium text-muted transition-colors hover:text-primary"
			>
				<Phone class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				{WHATSAPP_DISPLAY}
			</a>
			<a
				href={WHATSAPP_HREF}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 font-semibold text-primary-500 transition-colors hover:text-primary"
				data-umami-event="lead_click_whatsapp_from_creation_page"
			>
				<MessageCircle class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				WhatsApp — réponse rapide
			</a>
		</div>
	</div>

	<section class="section-y border-b border-border bg-white">
		<div class="shell-layout">
			<div class="mx-auto max-w-[72ch] prose prose-lg prose-headings:text-foreground prose-p:text-muted prose-li:text-muted prose-strong:text-foreground">
				<p>
					Vous cherchez un accompagnement pour la <strong>création site internet psychologue</strong>
					ou la <strong>création site psychologue</strong>&nbsp;?
					Cette page détaille ce que comprend la prestation&nbsp;: structure, contenu guidé, design sobre,
					intégration de votre outil de rendez-vous, hébergement et bases SEO — pour un site que vous contrôlez,
					sans discours de visibilité garanti.
				</p>

				<blockquote>
					<p><strong>En bref — création site internet psychologue</strong></p>
					<ul>
						<li><strong>Offre Sérénité</strong>&nbsp;: 29&nbsp;EUR/mois — site vitrine, hébergement, domaine, maintenance</li>
						<li><strong>Offre Visibilité &amp; Confiance</strong>&nbsp;: 49&nbsp;EUR/mois — + fiche Google, contenus, suivi SEO</li>
						<li><strong>Délai</strong>&nbsp;: 2 à 3 semaines en moyenne</li>
						<li><strong>Contenu</strong>&nbsp;: formulaire guidé, pas de rédaction seul·e obligatoire</li>
						<li><strong>Spécialisation</strong>&nbsp;: psychologue-développeur, cadre déontologique intégré</li>
					</ul>
					<p>
						Pour comparer les formules, consultez les <a href="/tarifs/">tarifs site internet psychologue</a>.
						Si votre priorité est surtout la visibilité locale, la page <a href="/referencement-site-psychologue/">référencement psychologue</a>
						précise le travail sur la fiche Google et le suivi SEO.
					</p>
				</blockquote>

				<div class="not-prose my-8 grid gap-4 md:grid-cols-2">
					<div class="rounded-xl border border-border bg-surface p-5">
						<h2 class="font-heading text-xl font-semibold text-foreground">C’est adapté si…</h2>
						<ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
							<li>vous voulez présenter votre cabinet avec sobriété et justesse&nbsp;;</li>
							<li>vous préférez déléguer l’hébergement, la maintenance et les réglages SEO&nbsp;;</li>
							<li>vous avez besoin d’un site relié à Doctolib, Qare, Maiia ou à un formulaire simple&nbsp;;</li>
							<li>vous cherchez un accompagnement qui comprend le cadre déontologique des psychologues.</li>
						</ul>
					</div>
					<div class="rounded-xl border border-border bg-white p-5">
						<h2 class="font-heading text-xl font-semibold text-foreground">Ce n’est pas adapté si…</h2>
						<ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
							<li>vous cherchez une garantie de place précise dans Google&nbsp;;</li>
							<li>vous voulez une plateforme complexe sur mesure ou un espace patient&nbsp;;</li>
							<li>vous préférez tout gérer vous-même, y compris technique et maintenance&nbsp;;</li>
							<li>vous attendez un discours publicitaire ou des affirmations thérapeutiques excessives.</li>
						</ul>
					</div>
				</div>

				<h2>Création site psychologue&nbsp;: ce que comprend la prestation</h2>
				<p>
					Avant de comparer les solutions possibles, voici ce qui distingue un site simplement présent en ligne
					d’un site qui aide réellement à présenter votre cadre, vos modalités et les informations utiles avant le premier contact.
				</p>
				<ol>
					<li><strong>Message clair dès l&apos;accueil</strong> — qui vous êtes, où vous exercez, pour quels publics.</li>
					<li><strong>Pages essentielles bien structurées</strong> — approche, consultations, informations pratiques, contact.</li>
					<li><strong>Ton professionnel et sobre</strong> — informatif, conforme au cadre déontologique, sans affirmation excessive.</li>
					<li><strong>Parcours court vers le contact</strong> — téléphone, formulaire ou widget RDV visible sur mobile.</li>
					<li><strong>Bases SEO livrées</strong> — titres, descriptions, performances, données structurées, sitemap.</li>
					<li><strong>Cohérence avec la fiche Google</strong> — même nom, adresse, téléphone (NAP) entre site et fiche.</li>
					<li><strong>Maintenance incluse</strong> — hébergement, mises à jour, petites modifications sans gérer la technique.</li>
				</ol>

				<h2>Pourquoi confier la création à un psychologue-développeur&nbsp;?</h2>
				<p>
					La <strong>création site web psychologue</strong> par une agence généraliste pose souvent le même problème&nbsp;:
					il faut tout réexpliquer (cadre clinique, déontologie, ton attendu, ce qu&apos;on peut dire ou non).
					En tant que <a href="/about/">psychologue, psychomotricien et développeur web</a>, je connais ces contraintes
					d&apos;emblée — et je prends en charge la technique (structure, performance, SEO, hébergement).
				</p>
				<p>
					Des confrères accompagnés le confirment dans les <a href="/tarifs/">témoignages</a>&nbsp;: site performant,
					formulation juste, collaboration patiente. Voir aussi le <a href="/portfolio/">portfolio</a>.
				</p>

				<h2>Site web, site internet, site vitrine&nbsp;: même besoin</h2>
				<p>
					Les recherches <strong>site web psychologue</strong>, <strong>site internet psychologue</strong> ou <strong>création site psychologue</strong> désignent en pratique la même attente&nbsp;: un lieu stable où vous contrôlez le message — approche, publics accompagnés, honoraires, accès au cabinet ou téléconsultation — alors que les annuaires et plateformes imposent leur mise en forme.
				</p>
				<p>
					Doctolib, Qare ou Maiia facilitent la prise de rendez-vous&nbsp;; ils ne remplacent pas un site qui explique <em>qui vous êtes</em> cliniquement et qui vous rend visible sur votre nom ou vos spécialités. Le <a href="/blog/site-internet-psychologue-doctolib/">comparatif site vs Doctolib</a> du blog détaille cette articulation&nbsp;; le <a href="/blog/guide-complet-visibilite-en-ligne-psychologues/">guide complet de la visibilité en ligne</a> pose le cadre global (fiche Google, SEO local, contenu).
				</p>

				<h2>Aussi pour psychomotriciens, ergothérapeutes et orthophonistes</h2>
				<p>
					Nicodev a été pensé d&apos;abord pour les <strong>psychologues en libéral</strong>.
					Le même type d&apos;accompagnement — site vitrine sobre, contenu guidé, cadre professionnel respecté — s&apos;applique aux <strong>psychomotriciens</strong> (voir la page <a href="/site-internet-psychomotricien/">site internet psychomotricien</a>), aux <strong>ergothérapeutes</strong> et aux <strong>orthophonistes</strong>.
					Ce n&apos;est pas une offre générique «&nbsp;thérapeutes&nbsp;»&nbsp;: chaque métier garde son vocabulaire, ses publics et ses contraintes.
				</p>
				<p>
					Si vous êtes ergothérapeute ou orthophoniste et souhaitez un site adapté à votre pratique, passez par la page <a href="/contact/">contact</a> pour vérifier ensemble la faisabilité.
				</p>

				<h2>Ce que je fais pour vous</h2>
				<p>
					Je vous propose un <strong>site vitrine sur mesure</strong>, pensé pour le cabinet&nbsp;: pages lisibles sur téléphone, formulation adaptée au métier de psychologue, pas de discours publicitaire déplacé ni de jargon technique imposé à vos patients.
				</p>
				<p>
					Nicodev a été construit <strong>d’abord pour les psychologues</strong>. Vous n’êtes pas un «&nbsp;secteur parmi d’autres&nbsp;» dans une agence généraliste&nbsp;: le socle de pages, les exemples de formulation et les contraintes (cadre déontologique, RGPD, ton de site de santé) restent alignés sur votre réalité de libéral. L’accompagnement s’étend aux <strong>psychomotriciens</strong>, <strong>ergothérapeutes</strong> et <strong>orthophonistes</strong>, sans élargir hors de ce périmètre.
				</p>

				<h2>Ce que comprend la création</h2>
				<ul>
					<li>Une <strong>arborescence éprouvée</strong> (accueil, présentation de votre approche, informations pratiques, contact) que nous adaptons à votre ton et à vos spécialités</li>
					<li>Un <strong>contenu structuré à partir de vos réponses</strong> à un formulaire — vous n’avez pas à rédiger seul de longs textes&nbsp;: vous répondez à des questions courtes, je les organise pour le web</li>
					<li>Une mise en ligne <strong>rapide et sobre techniquement</strong>, lisible par Google (titres, descriptions, données structurées de base, bonnes performances sur mobile)</li>
					<li>L’intégration de votre <strong>outil de rendez-vous</strong> (Doctolib, Qare, Maiia ou équivalent) lorsque vous en utilisez un</li>
					<li>L’<strong>hébergement</strong>, le <strong>nom de domaine</strong> et les <strong>mises à jour</strong> inclus dans un abonnement mensuel — montants et périmètre détaillés sur la page <a href="/tarifs/">Tarifs</a></li>
				</ul>

				<h2>Les pages indispensables d’un site de psychologue</h2>
				<p>
					Un site vitrine de psychologue n’a pas besoin d’être volumineux pour être efficace. Quatre à cinq pages bien
					pensées suffisent le plus souvent&nbsp;: un <strong>accueil</strong> qui situe immédiatement qui vous êtes et où
					vous exercez, une <strong>présentation</strong> de votre parcours et de votre approche sans jargon, une page{' '}
					<strong>consultations</strong> (publics accompagnés, motifs fréquents, modalités, téléconsultation éventuelle),
					les <strong>informations pratiques</strong> (honoraires, accès, horaires) et un <strong>contact</strong> simple.
				</p>
				<p>
					L’enjeu n’est pas d’impressionner mais de <strong>rassurer avant le premier contact</strong>&nbsp;: un futur
					patient hésite souvent plusieurs jours avant d’appeler. Des informations claires, un ton juste et un parcours
					court vers le contact font la différence — bien plus qu’un design spectaculaire.
				</p>

				<h2>Faire soi-même, plateforme clé en main ou accompagnement sur mesure&nbsp;?</h2>
				<p>
					Avant de vous engager, il est sain de comparer les options&nbsp;: <a href="/blog/faire-son-site-soi-meme-psychologue/">faire son site soi-même</a>,{' '}
					<a href="/blog/creer-site-avec-ia-psychologue/">le créer avec l&apos;IA</a>, passer par une plateforme spécialisée ou un accompagnement personnalisé — en gardant un œil critique sur{' '}
					<a href="/blog/site-internet-psychologue-promesses-trop-belles/">les discours trop assurés de certaines offres</a>.
				</p>

				<div class="not-prose my-8 overflow-x-auto rounded-xl border border-border">
					<table class="w-full min-w-[36rem] border-collapse text-left text-sm">
						<caption class="sr-only">
							Comparaison entre faire soi-même, plateforme clé en main et accompagnement Nicodev pour la création d'un site internet psychologue
						</caption>
						<thead class="border-b border-border bg-surface-alt">
							<tr>
								<th scope="col" class="type-label-mono p-4 text-foreground">Option</th>
								<th scope="col" class="type-label-mono p-4 text-foreground">Avantages</th>
								<th scope="col" class="type-label-mono p-4 text-foreground">Limites</th>
								<th scope="col" class="type-label-mono p-4 text-foreground">Pour qui</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							<tr>
								<td class="p-4 font-medium text-foreground">Faire soi-même (Wix, WordPress…)</td>
								<td class="p-4 text-muted">Coût initial faible, contrôle total</td>
								<td class="p-4 text-muted">Temps, technique, SEO, maintenance, ton parfois inadapté au métier</td>
								<td class="p-4 text-muted">Si vous aimez la technique et du temps à y consacrer</td>
							</tr>
							<tr>
								<td class="p-4 font-medium text-foreground">Plateforme spécialisée (Visipsy, Psy-Site…)</td>
								<td class="p-4 text-muted">Modèles prêts, mise en ligne rapide</td>
								<td class="p-4 text-muted">Moins de personnalisation, contenus parfois génériques, dépendance à la plateforme</td>
								<td class="p-4 text-muted">Si vous voulez aller vite avec un modèle existant</td>
							</tr>
							<tr>
								<td class="p-4 font-medium text-foreground">Nicodev (psychologue-développeur)</td>
								<td class="p-4 text-muted">Cadre clinique intégré, contenu guidé, technique prise en charge, maintenance incluse</td>
								<td class="p-4 text-muted">Abonnement mensuel, délai de 2 à 3 semaines</td>
								<td class="p-4 text-muted"><strong class="text-foreground">Si vous préférez vous concentrer sur la clinique</strong></td>
							</tr>
						</tbody>
					</table>
				</div>

				<p>
					Côté budget, l&apos;article <a href="/blog/combien-coute-site-internet-2026/">combien coûte un site internet pour psychologue en 2026</a> donne des fourchettes réalistes pour comparer avec les offres du marché.
				</p>

				<h2>Combien coûte la création d&apos;un site internet pour psychologue&nbsp;?</h2>
				<p>
					La <strong>création site internet psychologue</strong> chez Nicodev fonctionne par <strong>abonnement mensuel tout inclus</strong>&nbsp;— pas de devis opaque ni de facture de maintenance surprise six mois plus tard.
				</p>
				<div class="not-prose my-8 rounded-xl border border-border bg-surface p-6">
					<h3 class="font-heading text-2xl font-semibold text-foreground">Prix et inclus&nbsp;: deux formules lisibles</h3>
					<div class="mt-5 grid gap-4 md:grid-cols-2">
						<div class="rounded-lg border border-border bg-white p-5">
							<p class="text-sm font-semibold uppercase tracking-wide text-muted">Sérénité</p>
							<p class="mt-2 text-3xl font-semibold text-foreground">29&nbsp;EUR/mois</p>
