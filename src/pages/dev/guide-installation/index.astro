---
import fs from "node:fs/promises";
import Layout from "../../../layouts/Layout.astro";

const isDev = import.meta.env.DEV;
const chapterPath = new URL(
  "../../../../docs/lead-magnets/sinstaller-en-liberal-comme-psychologue/guide-installation-en-liberal-pour-psychologues.md",
  import.meta.url,
);

let markdown = "";

if (isDev) {
  markdown = await fs.readFile(chapterPath, "utf-8");
}

const escapeHtml = (value: string): string =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");

const slugify = (value: string): string =>
  value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9\s-]/g, "")
    .trim()
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-");

const renderInline = (value: string): string =>
  escapeHtml(value)
    .replace(
      /\[([^\]]+)\]\((#[^)]+)\)/g,
      '<a href="$2" class="font-medium text-teal-700 underline decoration-teal-300 underline-offset-4 hover:text-teal-900">$1</a>',
    )
    .replace(
      /`([^`]+)`/g,
      '<code class="rounded bg-slate-100 px-1.5 py-0.5 text-[0.95em] text-slate-800">$1</code>',
    )
    .replace(
      /\*\*([^*]+)\*\*/g,
      '<strong class="font-semibold text-slate-900">$1</strong>',
    )
    .replace(
      /\*([^*]+)\*/g,
      '<em>$1</em>',
    );

const renderImage = (altText: string, src: string): string => {
  const safeAlt = escapeHtml(altText);
  const safeSrc = escapeHtml(src);
  return `<figure class="my-8"><img src="${safeSrc}" alt="${safeAlt}" loading="lazy" decoding="async" class="w-full rounded-lg border border-slate-200 bg-white shadow-sm" /><figcaption class="mt-3 text-sm text-slate-600">${safeAlt}</figcaption></figure>`;
};

const buildNavigation = (source: string) => {
  const lines = source.split(/\r?\n/);
  const items = [];

  for (const rawLine of lines) {
    const line = rawLine.trim();
    const match = line.match(/^(#{1,2})\s+(.*)$/);
    if (!match) continue;

    const level = match[1].length;
    const text = match[2].trim();

    if (level === 1 && text !== "Guide de l'installation en libéral pour psychologues") {
      items.push({
        level,
        text,
        id: slugify(text),
      });
    }
  }

  return items;
};

const renderMarkdown = (source: string): string => {
  const lines = source.split(/\r?\n/);
  const html: string[] = [];
  let paragraph: string[] = [];
  let listItems: string[] = [];
  let orderedItems: string[] = [];
  let boxType: "ATTENTION" | "ASTUCE" | "INFO" | null = null;
  let boxLines: string[] = [];

  const flushParagraph = () => {
    if (!paragraph.length) return;
    html.push(`<p>${renderInline(paragraph.join(" "))}</p>`);
    paragraph = [];
  };

  const flushList = () => {
    if (!listItems.length) return;
    html.push(
      `<ul>${listItems.map((item) => `<li>${renderInline(item)}</li>`).join("")}</ul>`,
    );
    listItems = [];
  };

  const flushOrdered = () => {
    if (!orderedItems.length) return;
    html.push(
      `<ol>${orderedItems.map((item) => `<li>${renderInline(item)}</li>`).join("")}</ol>`,
    );
    orderedItems = [];
  };

  const flushBox = () => {
    if (!boxType) return;
    const styles = {
      ATTENTION:
        "border-amber-300 bg-amber-50 text-amber-950",
      ASTUCE:
        "border-teal-300 bg-teal-50 text-teal-950",
      INFO:
        "border-sky-300 bg-sky-50 text-sky-950",
    };

    html.push(
      `<aside class="my-6 rounded-lg border px-5 py-4 ${styles[boxType] ?? styles.INFO}"><p class="mb-2 text-sm font-bold uppercase tracking-[0.18em]">${boxType}</p><p>${renderInline(
        boxLines.join(" "),
      )}</p></aside>`,
    );

    boxType = null;
    boxLines = [];
  };

  for (const rawLine of lines) {
    const line = rawLine.trim();

    if (line === "[ENCADRE_ATTENTION]") {
      flushParagraph();
      flushList();
      flushOrdered();
      boxType = "ATTENTION";
      continue;
    }

    if (line === "[ENCADRE_ASTUCE]") {
      flushParagraph();
      flushList();
      flushOrdered();
      boxType = "ASTUCE";
      continue;
    }

    if (line === "[ENCADRE_INFO]") {
      flushParagraph();
      flushList();
      flushOrdered();
      boxType = "INFO";
      continue;
    }

    if (
      line === "[/ENCADRE_ATTENTION]" ||
      line === "[/ENCADRE_ASTUCE]" ||
      line === "[/ENCADRE_INFO]"
    ) {
      flushBox();
      continue;
    }

    if (boxType) {
      if (line) boxLines.push(line);
      continue;
    }

    if (!line) {
      flushParagraph();
      flushList();
      flushOrdered();
      continue;
    }

    if (line.startsWith("[ILLUSTRATION :") && line.endsWith("]")) {
      flushParagraph();
      flushList();
      flushOrdered();
      html.push(
        `<div class="my-8 rounded-lg border-2 border-dashed border-slate-300 bg-slate-50 px-6 py-8 text-center text-slate-700"><p class="mb-2 text-sm font-semibold uppercase tracking-[0.18em]">Illustration</p><p>${renderInline(
          line.slice(15, -1).trim(),
        )}</p></div>`,
      );
      continue;
    }

    const imageMatch = line.match(/^!\[(.*)\]\((.+)\)$/);
    if (imageMatch) {
      flushParagraph();
      flushList();
      flushOrdered();
      const altText = imageMatch[1].trim();
      const src = imageMatch[2].trim();
      html.push(renderImage(altText, src));
      continue;
    }

    if (line.startsWith("# ")) {
      flushParagraph();
      flushList();
      flushOrdered();
      const text = line.slice(2);
      const isMainGuideTitle =
        text === "Guide de l'installation en libéral pour psychologues";
      if (!isMainGuideTitle) {
        html.push(
          '<hr class="chapter-separator" role="presentation" aria-hidden="true" />',
        );
      }
      html.push(`<h1 id="${slugify(text)}" class="scroll-mt-40">${renderInline(text)}</h1>`);
      continue;
    }

    if (line.startsWith("## ")) {
      flushParagraph();
      flushList();
      flushOrdered();
      const text = line.slice(3);
      html.push(`<h2 id="${slugify(text)}" class="scroll-mt-40">${renderInline(text)}</h2>`);
      continue;
    }

    if (line.startsWith("### ")) {
      flushParagraph();
      flushList();
      flushOrdered();
      const text = line.slice(4);
      html.push(`<h3 id="${slugify(text)}" class="scroll-mt-40">${renderInline(text)}</h3>`);
      continue;
    }

    if (line.match(/^\d+\.\s+/)) {
      flushParagraph();
      flushList();
      orderedItems.push(line.replace(/^\d+\.\s+/, ""));
      continue;
    }

    if (line.startsWith("- ")) {
      flushParagraph();
      flushOrdered();
      listItems.push(line.slice(2));
      continue;
    }

    paragraph.push(line);
  }

  flushParagraph();
  flushList();
  flushOrdered();
  flushBox();

  return html.join("\n");
};

const navigation = isDev ? buildNavigation(markdown) : [];
const renderedHtml = isDev ? renderMarkdown(markdown) : "";
const urssafRates = {
  cipav: 0.232,
  bncGeneral: 0.256,
};
---

<Layout
  title="Prévisualisation locale - Guide de l'installation en libéral pour psychologues"
  description="Prévisualisation locale du guide PDF."
  noindex={true}
  showFloatingWhatsApp={false}
>
  <section class:list={["bg-slate-100 pb-16", isDev ? "pt-0" : "py-16"]}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      {
        isDev ? (
          <>
            <div class="pt-28 sm:pt-32">
              <section class="calculator-panel mx-auto mb-8 max-w-4xl rounded-lg bg-white px-6 py-8 shadow-sm sm:px-10">
                <h2 class="text-2xl font-bold text-slate-900">
                  Outil 1 - Simulateur micro-BNC / auto-entrepreneur (psychologue)
                </h2>
                <p class="mt-3 text-slate-700">
                  Estime rapidement ta recette nette apres URSSAF a partir du tarif d'une seance.
                </p>
                <p class="mt-1 text-sm text-slate-600">
                  Taux URSSAF utilises (source URSSAF, actualite mise a jour le 30/01/2026) :
                  <strong>{(urssafRates.cipav * 100).toFixed(1)} %</strong> pour les professions liberales
                  CIPAV et <strong>{(urssafRates.bncGeneral * 100).toFixed(1)} %</strong> pour le BNC regime
                  general.
                </p>

                <div class="mt-6 grid gap-4 sm:grid-cols-3">
                  <label class="flex flex-col gap-1">
                    <span class="text-sm font-semibold text-slate-800">Tarif d'une seance (EUR)</span>
                    <input
                      id="session-price"
                      type="number"
                      min="1"
                      step="1"
                      value="60"
                      class="rounded-md border border-slate-300 px-3 py-2 text-slate-900"
                    />
                  </label>

                  <label class="flex flex-col gap-1">
                    <span class="text-sm font-semibold text-slate-800">Regime social</span>
                    <select id="social-rate" class="rounded-md border border-slate-300 px-3 py-2 text-slate-900">
                      <option value={urssafRates.cipav.toString()}>Profession liberale CIPAV (23,2 %)</option>
                      <option value={urssafRates.bncGeneral.toString()}>
                        BNC regime general auto-entrepreneur (25,6 %)
                      </option>
                    </select>
                  </label>

                  <label class="flex flex-col gap-1">
                    <span class="text-sm font-semibold text-slate-800">Seances par mois (focus)</span>
                    <input
                      id="sessions-focus"
                      type="number"
                      min="1"
                      step="1"
                      value="50"
                      class="rounded-md border border-slate-300 px-3 py-2 text-slate-900"
                    />
                  </label>
                </div>

                <div class="mt-6 rounded-md border border-teal-200 bg-teal-50 p-4">
                  <p class="text-sm text-teal-900">
                    Par seance, il reste environ <strong id="net-per-session">0 EUR</strong> apres URSSAF.
                  </p>
                  <p class="mt-1 text-sm text-teal-900">
                    Pour <strong id="focus-count">0</strong> seances/mois, recette nette estimee :
                    <strong id="focus-net">0 EUR</strong>.
                  </p>
                </div>

                <div class="mt-6 overflow-x-auto">
                  <table class="min-w-full border-collapse text-left text-sm">
                    <thead>
                      <tr class="border-b border-slate-200 bg-slate-50">
                        <th class="px-3 py-2 font-semibold text-slate-800">Seances / mois</th>
                        <th class="px-3 py-2 font-semibold text-slate-800">CA brut</th>
                        <th class="px-3 py-2 font-semibold text-slate-800">Cotisations URSSAF</th>
                        <th class="px-3 py-2 font-semibold text-slate-800">Recette nette apres URSSAF</th>
                      </tr>
                    </thead>
                    <tbody id="results-table-body"></tbody>
                  </table>
                </div>
              </section>

              <article
                class="guide-preview prose prose-slate mx-auto max-w-4xl rounded-lg bg-white px-6 py-10 shadow-sm sm:px-10"
                set:html={renderedHtml}
              />
            </div>
          </>
        ) : (
          <div class="rounded-lg bg-white px-8 py-10 shadow-sm">
            <h1 class="text-3xl font-bold text-slate-900">Prévisualisation indisponible</h1>
            <p class="mt-4 text-slate-700">
              Cette route est réservée au développement local et n’affiche pas le contenu du guide en production.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const priceInput = document.getElementById("session-price");
    const rateSelect = document.getElementById("social-rate");
    const focusInput = document.getElementById("sessions-focus");
    const tableBody = document.getElementById("results-table-body");
    const netPerSessionEl = document.getElementById("net-per-session");
    const focusCountEl = document.getElementById("focus-count");
    const focusNetEl = document.getElementById("focus-net");

    if (
      !(priceInput instanceof HTMLInputElement) ||
      !(rateSelect instanceof HTMLSelectElement) ||
      !(focusInput instanceof HTMLInputElement) ||
      !(tableBody instanceof HTMLElement) ||
      !(netPerSessionEl instanceof HTMLElement) ||
      !(focusCountEl instanceof HTMLElement) ||
      !(focusNetEl instanceof HTMLElement)
    ) {
      return;
    }

    const sessionScenarios = [20, 30, 40, 50, 60, 80];
    const eur = new Intl.NumberFormat("fr-FR", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 2,
    });

    const toPositiveNumber = (raw, fallback) => {
      const parsed = Number(raw);
      if (!Number.isFinite(parsed) || parsed <= 0) {
        return fallback;
      }
      return parsed;
    };

    const render = () => {
      const sessionPrice = toPositiveNumber(priceInput.value, 60);
      const urssafRate = toPositiveNumber(rateSelect.value, 0.232);
      const focusSessions = Math.round(toPositiveNumber(focusInput.value, 50));

      const netPerSession = sessionPrice * (1 - urssafRate);
      netPerSessionEl.textContent = eur.format(netPerSession);
      focusCountEl.textContent = String(focusSessions);
      focusNetEl.textContent = eur.format(netPerSession * focusSessions);

      const allScenarios = Array.from(new Set([...sessionScenarios, focusSessions])).sort((a, b) => a - b);
      tableBody.innerHTML = allScenarios
        .map((sessions) => {
          const gross = sessionPrice * sessions;
          const urssaf = gross * urssafRate;
          const net = gross - urssaf;
          const isFocus = sessions === focusSessions;

          return `<tr class="border-b border-slate-100 ${isFocus ? "bg-teal-50" : ""}">
            <td class="px-3 py-2 font-medium text-slate-900">${sessions}</td>
            <td class="px-3 py-2 text-slate-700">${eur.format(gross)}</td>
            <td class="px-3 py-2 text-slate-700">${eur.format(urssaf)}</td>
            <td class="px-3 py-2 font-semibold text-slate-900">${eur.format(net)}</td>
          </tr>`;
        })
        .join("");
    };

    priceInput.addEventListener("input", render);
    rateSelect.addEventListener("change", render);
    focusInput.addEventListener("input", render);
    render();
  })();
</script>

<style>
  .calculator-panel table th,
  .calculator-panel table td {
    white-space: nowrap;
  }

  .guide-preview :global(h2 + ol) {
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    padding-left: 1.25rem;
  }

  .guide-preview :global(h2 + ol li) {
    margin-top: 0.2rem;
    margin-bottom: 0.2rem;
  }

  .guide-preview :global(h2 + ol li p) {
    margin: 0;
  }

  /* Séparateur entre chapitres (# Chapitre N — …) */
  .guide-preview :global(hr.chapter-separator) {
    margin: 2.75rem 0;
    max-width: 100%;
    border: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(148 163 184 / 0.25) 15%,
      rgb(13 148 136 / 0.45) 50%,
      rgb(148 163 184 / 0.25) 85%,
      transparent
    );
    position: relative;
    overflow: visible;
  }

  .guide-preview :global(hr.chapter-separator)::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 0.45rem;
    height: 0.45rem;
    border-radius: var(--radius-full);
    background: rgb(15 118 110);
    box-shadow: 0 0 0 3px rgb(255 255 255);
  }
</style>
