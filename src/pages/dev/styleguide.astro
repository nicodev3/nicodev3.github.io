---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import SkillCard from '../../components/SkillCard.astro';
import OfferCard from '../../components/OfferCard.astro';
import FormField from '../../components/FormField.astro';

if (!import.meta.env.DEV) {
	return Astro.redirect('/');
}
---

<Layout
	title="Styleguide interne | Dev"
	description="Page de reference interne pour les composants et tokens visuels"
	noindex={true}
>
	<Hero
		title="Styleguide interne"
		subtitle="Reference visuelle privee pour le developpement"
		variant="light"
		maxWidth="6xl"
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Styleguide interne' }]}
	/>

	<section class="bg-white py-12 border-b border-border">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
			<div>
				<h2 class="text-2xl font-bold text-foreground mb-2">Tokens couleur</h2>
				<p class="text-muted">
					Palette et typo dans <code>global.css</code> ; rayons et ombres dans <code>src/styles/design-tokens.css</code>.
					Rayons&nbsp;: <code>rounded-sm</code> (8px, contrôles / chips compacts), <code>rounded-lg</code> et alias <code
						>rounded-md</code>–<code>rounded-4xl</code> (14px, surfaces), <code>rounded-full</code> (pilules).
				</p>
			</div>
			<p class="text-sm text-muted">
				<code>primary</code> = <code>primary-500</code> · <code>primary-foreground</code> = <code>primary-700</code> (boutons pleins,
				texte terracotta foncé).
			</p>
			<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-primary-50"></div>
					<div class="p-3 text-sm">
						<strong>primary-50</strong><br />
						<code>bg-primary-50</code>
					</div>
				</div>
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-primary-100"></div>
					<div class="p-3 text-sm">
						<strong>primary-100</strong><br />
						<code>bg-primary-100</code>
					</div>
				</div>
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-primary-300"></div>
					<div class="p-3 text-sm">
						<strong>primary-300</strong><br />
						<code>bg-primary-300</code>
					</div>
				</div>
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-primary"></div>
					<div class="p-3 text-sm">
						<strong>primary-500</strong><br />
						<code>bg-primary</code>
					</div>
				</div>
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-primary-foreground"></div>
					<div class="p-3 text-sm">
						<strong>primary-700</strong><br />
						<code>bg-primary-foreground</code>
					</div>
				</div>
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-primary-900"></div>
					<div class="p-3 text-sm">
						<strong>primary-900</strong><br />
						<code>bg-primary-900</code>
					</div>
				</div>
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-foreground"></div>
					<div class="p-3 text-sm">
						<strong>foreground</strong><br />
						#0F2A2A<br />
						<code>bg-foreground</code> · <code>text-foreground</code>
					</div>
				</div>
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-background"></div>
					<div class="p-3 text-sm">
						<strong>background</strong><br />
						#FAFAFA<br />
						<code>bg-background</code>
					</div>
				</div>
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-surface"></div>
					<div class="p-3 text-sm">
						<strong>surface</strong><br />
						#FAFAFA<br />
						<code>bg-surface</code> · <code>text-muted</code>
					</div>
				</div>
				<div class="rounded-lg border border-border overflow-hidden">
					<div class="h-20 bg-white"></div>
					<div class="p-3 text-sm">
						<strong>neutral-0</strong><br />
						#FFFFFF<br />
						<code>bg-white</code> · <code>text-on-primary</code>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-background py-12 border-b border-border">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
			<div>
				<h2 class="text-2xl font-bold text-foreground mb-2">Typographie</h2>
				<p class="text-muted">
					Titres en Lora, texte courant en Source Sans 3. Échelle indicative&nbsp;: caption <code class="text-foreground">12</code>,
					small <code class="text-foreground">14</code>, corps <code class="text-foreground">16</code>, chapô <code class="text-foreground">18</code>,
					puis <code class="text-foreground">20–44px</code> pour les niveaux de titre (tokens <code class="text-foreground">text-*</code> dans{' '}
					<code class="text-foreground">global.css</code>). Eyebrows&nbsp;: classe <code class="text-foreground">type-eyebrow</code>.
				</p>
				<p class="type-eyebrow text-muted mb-2">Exemple de ligne type-eyebrow</p>
			</div>
			<div class="rounded-lg border border-border bg-white p-6">
				<h1 class="text-4xl font-bold mb-2">Titre H1 de reference</h1>
				<h2 class="text-3xl font-bold mb-2">Titre H2 de reference</h2>
				<h3 class="text-2xl font-bold mb-4">Titre H3 de reference</h3>
				<p class="text-base text-muted mb-2">Texte courant pour verifier la lisibilite sur plusieurs longueurs de phrase.</p>
				<p class="text-sm text-muted">Texte secondaire pour les aides, labels et descriptions.</p>
			</div>
		</div>
	</section>

	<section class="bg-white py-12 border-b border-border">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
			<div>
				<h2 class="text-2xl font-bold text-foreground mb-2">Elements UI</h2>
			</div>
			<div class="rounded-lg border border-border bg-background p-6">
				<div class="flex flex-wrap gap-3 mb-6">
					<a href="#" class="btn-primary-solid rounded-lg px-5 py-3">Bouton principal</a>
					<a href="#" class="btn-outline-accent rounded-lg border-2 border-primary px-5 py-3 text-foreground">Bouton secondaire</a>
				</div>
				<div class="grid grid-cols-1 gap-6 pt-10 md:grid-cols-2 md:gap-8">
					<SkillCard title="SkillCard" description="Exemple de carte competence.">
						<svg slot="icon" class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v12m6-6H6"></path>
						</svg>
					</SkillCard>
					<OfferCard
						name="Offre test"
						price="190 EUR"
						description="Bloc de reference visuelle"
						features={['Bloc hero', 'Section services', 'Formulaire contact']}
						buttonLabel="Action"
						buttonHref="#"
						recommended={true}
						badgeText="Demo"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-background py-12">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
			<div>
				<h2 class="text-2xl font-bold text-foreground mb-2">Formulaires</h2>
			</div>
			<form class="rounded-lg border border-border bg-white p-6 grid grid-cols-1 md:grid-cols-2 gap-4" aria-label="Exemple formulaire styleguide">
				<FormField id="name" name="name" label="Nom" placeholder="Votre nom" />
				<FormField id="email" name="email" label="Email" type="email" placeholder="vous@email.fr" />
				<div class="md:col-span-2">
					<FormField id="message" name="message" label="Message" variant="textarea" rows={4} placeholder="Votre message" />
				</div>
			</form>
		</div>
	</section>
</Layout>
