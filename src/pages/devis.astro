---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';

const baseUrl = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Devis', item: new URL('/devis/', baseUrl).toString() }
	]
};
---

<Layout
	title="Devis site psychologue ou psychomotricien | Nicodev"
	description="Demandez un devis personnalisé pour votre site internet de psychologue, psychomotricien ou profession du soin proche. Réponse sous 48 h."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<Hero
		title="Devis pour site internet de praticien du soin"
		subtitle="Décrivez votre besoin pour recevoir une proposition adaptée à votre pratique."
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Devis' }]}
	/>

	<section class="py-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
				<div>
					<p class="mb-6 rounded-lg border border-border bg-surface p-4 text-sm leading-relaxed text-muted">
						<strong class="text-foreground">Devis — prix et formule sur dossier.</strong> Si vous préférez d’abord un éclairage sans engagement sur vos priorités,
						utilisez le{' '}
						<a href="/diagnostic-gratuit/" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">diagnostic gratuit</a>.
						<span class="mt-2 block">
							<strong class="text-foreground">Simple question&nbsp;?</strong>{' '}
							<a href="/contact/" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">Page contact</a>.
						</span>
					</p>
					<h2 class="text-3xl font-bold text-foreground mb-4">Votre demande de devis</h2>
					<p class="text-muted mb-8">
						Vous indiquez votre profession, votre contexte et vos objectifs. Je vous réponds avec une recommandation claire, le cadre de travail, et
						la formule la plus pertinente pour votre situation.
					</p>
					<p class="text-sm text-muted mb-6">
						Temps estimé : 3 à 5 minutes. Aucun engagement.
					</p>
					<ContactForm mode="devis" />
				</div>
				<div class="space-y-6">
					<div class="rounded-lg border border-border bg-surface p-6">
						<h3 class="text-xl font-semibold text-foreground mb-3">Ce que vous recevez</h3>
						<ul class="space-y-2 text-muted">
							<li>Une recommandation sur la formule la plus adaptée.</li>
							<li>Un cadrage du périmètre et des livrables.</li>
							<li>Une estimation claire avec prochaine étape concrète.</li>
						</ul>
					</div>
					<div class="rounded-lg border border-border bg-surface p-6">
						<h3 class="text-xl font-semibold text-foreground mb-3">Délais</h3>
						<p class="text-muted">
							Je réponds en général sous 48 h ouvrées. Si votre demande est urgente, précisez-le dans le message.
						</p>
					</div>
					<div class="rounded-lg border border-border bg-surface p-6">
						<h3 class="text-xl font-semibold text-foreground mb-3">Plutôt besoin d'un diagnostic ?</h3>
						<p class="text-muted mb-4">
							Si vous hésitez sur la bonne direction, commencez par un diagnostic gratuit de votre situation actuelle.
						</p>
						<a href="/diagnostic-gratuit/" data-umami-event="lead_click_cta_diagnostic_from_devis" class="inline-flex items-center rounded-lg border border-border px-4 py-2 text-foreground hover:bg-white transition-colors">
							Demander un diagnostic gratuit
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script is:inline>
		(() => {
			if (window.umami && typeof window.umami.track === 'function') {
				window.umami.track('lead_view_devis');
			}
		})();
	</script>
</Layout>
