---
import Layout from '../layouts/Layout.astro';
import DiagnosticForm from '../components/DiagnosticForm.astro';

const baseUrl = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Diagnostic gratuit', item: new URL('/diagnostic-gratuit/', baseUrl).toString() }
	]
};
---

<Layout
	title="Diagnostic visibilité cabinet psychologue | Nicodev"
	description="Diagnostic gratuit de visibilité pour psychologues : 4 questions, retour sous 48 h sur votre fiche Google, vos profils et l’intérêt d’un site."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<section class="border-b border-border bg-white pb-12 pt-6 md:pt-8">
		<div class="mx-auto max-w-xl px-4 sm:px-6">
			<nav class="mb-3 text-sm text-muted" aria-label="Fil d’Ariane">
				<ol class="flex flex-wrap items-center gap-1.5">
					<li><a href="/" class="underline-offset-4 hover:text-primary hover:underline">Accueil</a></li>
					<li aria-hidden="true">/</li>
					<li class="text-foreground">Diagnostic gratuit</li>
				</ol>
			</nav>
			<h1 class="font-heading text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">
				Diagnostic visibilité, en 4 questions
			</h1>
			<p class="mt-2 text-base leading-relaxed text-muted">
				Je vous dis quoi prioriser pour votre cabinet, avec ou sans site.
			</p>

			<div class="mt-4">
				<DiagnosticForm />
			</div>

			<ul class="mt-8 space-y-2 text-sm text-muted">
				<li>Clarté de votre positionnement et de vos infos essentielles.</li>
				<li>Visibilité locale : site, fiche Google, profils en ligne.</li>
				<li>Trois recommandations adaptées à votre situation.</li>
			</ul>
		</div>
	</section>
</Layout>
