---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import DiagnosticForm from '../components/DiagnosticForm.astro';

const baseUrl = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Diagnostic gratuit', item: new URL('/diagnostic-gratuit/', baseUrl).toString() }
	]
};
---

<Layout
	title="Diagnostic site psychologue ou psychomotricien | Nicodev"
	description="Obtenez un diagnostic gratuit de votre visibilité web : site de psychologue, psychomotricien ou profession du soin proche, priorités et formule adaptée."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<Hero
		title="Diagnostic gratuit pour votre site professionnel"
		subtitle="Faites le point sur votre visibilité web avant de lancer ou refondre votre site."
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Diagnostic gratuit' }]}
	/>

	<section class="py-16 bg-surface-alt">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
				<div>
					<p class="mb-6 rounded-lg border border-border bg-white p-4 text-sm leading-relaxed text-muted">
						<strong class="text-foreground">Pas encore prêt à vous engager&nbsp;?</strong> Ce diagnostic gratuit suffit pour un premier retour.
						<span class="mt-2 block">
							<strong class="text-foreground">Budget ou périmètre déjà clairs&nbsp;?</strong> Préférez la{' '}
							<a href="/devis/" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">demande de devis</a>
							. <strong class="text-foreground">Question ponctuelle&nbsp;?</strong>{' '}
							<a href="/contact/" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">Contact</a>.
						</span>
					</p>
					<h2 class="text-3xl font-bold text-foreground mb-4">Demander un diagnostic gratuit</h2>
					<p class="text-muted mb-8">
						Expliquez votre situation actuelle, votre niveau de visibilité et votre objectif principal. Vous obtenez un retour utile
						pour prioriser les bonnes actions, que vous soyez psychologue, psychomotricien ou dans une profession du soin proche.
					</p>
					<p class="text-sm text-muted mb-6">
						Temps estimé : 4 à 6 minutes. Retour sous 48 h.
					</p>
					<DiagnosticForm />
				</div>
				<div class="space-y-6">
					<div class="rounded-lg border border-border bg-white p-6">
						<h3 class="text-xl font-semibold text-foreground mb-3">Ce diagnostic inclut</h3>
						<ul class="space-y-2 text-muted">
							<li>Un regard externe sur ce qui freine vos demandes.</li>
							<li>Des priorités concrètes pour améliorer votre présence en ligne.</li>
							<li>Une orientation vers la formule la plus adaptée.</li>
						</ul>
					</div>
					<div class="rounded-lg border border-border bg-white p-6">
						<h3 class="text-xl font-semibold text-foreground mb-3">Ce diagnostic n'est pas</h3>
						<p class="text-muted">
							Un audit technique exhaustif de plusieurs heures. L'objectif est de vous aider à prendre la bonne décision rapidement
							avec une base claire.
						</p>
					</div>
					<div class="rounded-lg border border-border bg-white p-6">
						<h3 class="text-xl font-semibold text-foreground mb-3">Vous etes deja decide ?</h3>
						<p class="text-muted mb-4">
							Si votre besoin est déjà cadré, vous pouvez passer directement à la demande de devis.
						</p>
						<a href="/devis/" data-umami-event="lead_click_cta_devis_from_diagnostic" class="inline-flex items-center rounded-lg border border-border px-4 py-2 text-foreground hover:bg-surface transition-colors">
							Accéder à la page devis
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<script is:inline>
		(() => {
			if (window.umami && typeof window.umami.track === 'function') {
				window.umami.track('lead_view_diagnostic');
			}
		})();
	</script>
</Layout>
