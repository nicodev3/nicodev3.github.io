---
import { Image } from "astro:assets";
import { ArrowLeft, ArrowRight, Check, ExternalLink, Quote } from "@lucide/astro";
import CtaSection from "../../components/CtaSection.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../layouts/Layout.astro";
import { caseStudies, type CaseStudy } from "../../data/case-studies";

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
const baseUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(`/etudes-de-cas/${study.slug}/`, baseUrl).toString();
const pageTitle = `${study.person} : étude de cas site et SEO | Nicodev`;
const currentIndex = caseStudies.findIndex((item) => item.slug === study.slug);
const nextStudy = caseStudies[(currentIndex + 1) % caseStudies.length];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Accueil",
      item: new URL("/", baseUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Études de cas",
      item: new URL("/etudes-de-cas/", baseUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: study.person,
      item: pageUrl,
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={study.summary}
  image={study.image}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Hero
    title={study.title}
    subtitle={study.summary}
    maxWidth="6xl"
    coverImage={study.image}
    coverImageAlt=""
    coverBlur="medium"
    breadcrumb={[
      { label: "Accueil", href: "/" },
      { label: "Études de cas", href: "/etudes-de-cas/" },
      { label: study.person },
    ]}
  >
    <div slot="before" class="type-eyebrow mb-4 text-primary">
      Étude de cas · {study.profession}
    </div>
  </Hero>

  <section class="section-y border-b border-border bg-white">
    <div class="shell-layout">
      <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16">
        <div class="overflow-hidden rounded-lg border border-border bg-surface shadow-md">
          <Image
            src={study.image}
            alt={study.imageAlt}
            class="h-auto w-full"
            widths={[640, 960, 1280]}
            sizes="(max-width: 1023px) 100vw, 58vw"
            loading="eager"
            decoding="async"
          />
        </div>
        <div>
          <p class="type-eyebrow mb-3 text-primary">Le projet</p>
          <h2 class="mb-6 text-3xl font-semibold text-foreground sm:text-4xl">
            {study.person}
          </h2>
          <dl class="mb-7 divide-y divide-border border-y border-border">
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-3">
              <dt class="text-sm font-semibold text-foreground">Activité</dt>
              <dd class="text-sm text-muted">{study.profession}</dd>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-3">
              <dt class="text-sm font-semibold text-foreground">Zone</dt>
              <dd class="text-sm text-muted">{study.location}</dd>
            </div>
            <div class="grid grid-cols-[7rem_1fr] gap-4 py-3">
              <dt class="text-sm font-semibold text-foreground">Site</dt>
              <dd class="text-sm text-muted">{study.siteName}</dd>
            </div>
          </dl>
          <a
            href={study.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-sm font-semibold text-primary transition-colors hover:text-primary-900 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
            data-umami-event="case_study_site_click"
            data-umami-event-case={study.slug}
          >
            Voir le site en ligne
            <ExternalLink class="h-4 w-4" stroke-width={1.5} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-y border-b border-border bg-background">
    <div class="shell-layout">
      <div class="mx-auto max-w-4xl">
        <p class="type-eyebrow mb-3 text-primary">Le point de départ</p>
        <h2 class="mb-6 text-3xl font-semibold text-foreground sm:text-4xl">
          Le problème à résoudre
        </h2>
        <p class="text-lg leading-relaxed text-muted sm:text-xl">
          {study.challenge}
        </p>
      </div>
    </div>
  </section>

  <section class="section-y border-b border-border bg-white">
    <div class="shell-layout">
      <div class="grid gap-8 lg:grid-cols-2">
        <div class="rounded-lg border border-border bg-background p-6 sm:p-8">
          <p class="type-eyebrow mb-3 text-primary">Le cap</p>
          <h2 class="mb-6 text-2xl font-semibold text-foreground sm:text-3xl">
            Les objectifs
          </h2>
          <ul class="space-y-4">
            {study.objectives.map((objective) => (
              <li class="flex gap-3 leading-relaxed text-muted">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary-100 text-primary-700">
                  <Check class="h-4 w-4" stroke-width={2} aria-hidden="true" />
                </span>
                <span>{objective}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-lg border border-border bg-surface p-6 sm:p-8">
          <p class="type-eyebrow mb-3 text-primary">La réponse</p>
          <h2 class="mb-6 text-2xl font-semibold text-foreground sm:text-3xl">
            Le travail réalisé
          </h2>
          <ol class="space-y-4">
            {study.work.map((item, index) => (
              <li class="flex gap-4 leading-relaxed text-muted">
                <span class="type-label-mono mt-0.5 text-primary">{String(index + 1).padStart(2, "0")}</span>
                <span>{item}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section-y border-b border-border bg-foreground text-on-foreground">
    <div class="shell-layout">
      <div class="mx-auto max-w-5xl">
        <p class="type-eyebrow mb-3 text-primary-300">Premiers signes de visibilité</p>
        <h2 class="mb-5 text-3xl font-semibold text-white sm:text-4xl">
          Le site est-il trouvé dans Google ?
        </h2>
        <p class="mb-10 max-w-3xl text-lg leading-relaxed text-white/75">
          {study.resultsIntro}
        </p>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {study.metrics.map((metric) => (
            <div class="rounded-lg border border-white/15 bg-white/5 p-5">
              <p class="font-heading text-3xl font-semibold text-white">{metric.value}</p>
              <p class="mt-2 text-sm font-medium text-white/80">{metric.label}</p>
              {metric.detail && <p class="mt-1 text-xs text-white/55">{metric.detail}</p>}
            </div>
          ))}
        </div>

        <div class="mt-10 grid gap-8 border-t border-white/15 pt-8 lg:grid-cols-[1fr_2fr]">
          <div class="text-sm leading-relaxed text-white/60">
            <p class="font-semibold text-white/85">Période observée</p>
            <p class="mt-1">{study.dataPeriod}</p>
            <p class="mt-4 font-semibold text-white/85">D’où viennent ces chiffres ?</p>
            <p class="mt-1">{study.dataSource}</p>
          </div>
          <ul class="space-y-3 text-sm leading-relaxed text-white/75 sm:text-base">
            {study.interpretation.map((item) => (
              <li class="border-l-2 border-primary-300 pl-4">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {
    study.testimonial && (
      <section class="section-y border-b border-border bg-surface">
        <div class="shell-layout">
          <figure class="mx-auto max-w-4xl text-center">
            <Quote class="mx-auto mb-6 h-9 w-9 text-primary" stroke-width={1.5} aria-hidden="true" />
            <blockquote class="font-heading text-2xl leading-relaxed text-foreground sm:text-3xl">
              « {study.testimonial.quote} »
            </blockquote>
            <figcaption class="mt-6 text-sm font-semibold text-muted">
              {study.testimonial.author} · Avis Google
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <section class="border-b border-border bg-white py-10">
    <div class="shell-layout flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
      <a
        href="/etudes-de-cas/"
        class="inline-flex items-center gap-2 font-semibold text-muted transition-colors hover:text-primary"
      >
        <ArrowLeft class="h-4 w-4" stroke-width={1.5} aria-hidden="true" />
        Toutes les études de cas
      </a>
      <a
        href={`/etudes-de-cas/${nextStudy.slug}/`}
        class="inline-flex items-center gap-2 font-semibold text-primary transition-colors hover:text-primary-900"
      >
        Cas suivant : {nextStudy.person}
        <ArrowRight class="h-4 w-4" stroke-width={1.5} aria-hidden="true" />
      </a>
    </div>
  </section>

  <CtaSection
    title="Vous vous reconnaissez dans cette situation ?"
    description="Un premier échange permet d’identifier ce qui freine votre visibilité et ce qui mérite réellement d’être repris."
    primaryButton={{ text: "Faire le point sur votre visibilité", href: "/diagnostic-gratuit/", leadSource: `case_study_${study.slug}` }}
    secondaryButton={{ text: "Voir les tarifs", href: "/tarifs/" }}
  />
</Layout>
