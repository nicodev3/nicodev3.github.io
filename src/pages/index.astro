---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import OffersSection from '../components/OffersSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import SeoLocalSection from '../components/SeoLocalSection.astro';
import FaqSection from '../components/FaqSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ExpertiseSection from '../components/ExpertiseSection.astro';
import HeroSection from '../components/HeroSection.astro';
import DifferenciationDiySection from '../components/DifferenciationDiySection.astro';
import BlogHomeSection from '../components/BlogHomeSection.astro';
import CtaSection from '../components/CtaSection.astro';
import defaultOgWebp from '../assets/images/blog/development.webp';

const allBlogPosts = await getCollection('blog');
const preferredBlogIds = [
	'comment-trouver-premiers-patients-psychologue',
	'google-business-profile-psychologue',
	'site-internet-psychologues'
] as const;
const byBlogId = new Map(allBlogPosts.map((p) => [p.id, p]));
const homeBlogPosts = [];
for (const id of preferredBlogIds) {
	const post = byBlogId.get(id);
	if (post) homeBlogPosts.push(post);
}
const HOME_BLOG_POSTS_LIMIT = 9;

const byDateDesc = [...allBlogPosts].sort(
	(a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
for (const post of byDateDesc) {
	if (homeBlogPosts.length >= HOME_BLOG_POSTS_LIMIT) break;
	if (!homeBlogPosts.some((p) => p.id === post.id)) homeBlogPosts.push(post);
}

const baseUrl = Astro.site ?? Astro.url.origin;

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Nicolas Devaux',
	description: 'Création de sites internet pour psychologues.',
	url: baseUrl,
	telephone: '+33629341367',
	address: {
		'@type': 'PostalAddress',
		streetAddress: '63 rue Houdan',
		postalCode: '92330',
		addressLocality: 'Sceaux',
		addressRegion: 'Île-de-France',
		addressCountry: 'FR'
	},
	priceRange: '29€ - 49€',
	sameAs: [
		'https://www.malt.fr/profile/nicolasdevaux1',
		'https://github.com/nicodev3'
	],
	areaServed: 'France',
	slogan: 'Création de sites internet',
	makesOffer: [
		{ '@type': 'Offer', name: 'Pack Site Vitrine', price: '29', priceCurrency: 'EUR' },
		{ '@type': 'Offer', name: 'Pack Site + Blog', price: '49', priceCurrency: 'EUR' }
	]
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: "Combien de temps faut-il pour lancer le site ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "En général deux à trois semaines selon vos disponibilités et le temps nécessaire pour compléter le formulaire de contenu ; cela peut être un peu plus rapide lorsque les éléments sont fournis vite."
			}
		},
		{
			'@type': 'Question',
			name: "Que couvre le seul aller-retour inclus ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Les ajustements de textes, sections et style prévus dans le brief initial."
			}
		},
		{
			'@type': 'Question',
			name: "Que couvrent les modifications incluses dans les abonnements ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Textes, coordonnées, tarifs, photo, horaires et lien widget RDV (Doctolib, Qare...). Pour le Pack Blog, s'ajoutent 2 articles par mois pour vous faire mieux apparaître sur Google. Les changements de structure (nouvelles pages, refonte du design) restent hors périmètre."
			}
		},
		{
			'@type': 'Question',
			name: "Je ne suis pas à l'aise pour écrire. Comment ça se passe pour le contenu ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Le formulaire vous pose des questions courtes et concrètes : vos spécialités, votre approche, tarifs, horaires, lieu... Vos futurs patients cherchent surtout à être rassurés et à comprendre comment vous travaillez. Pas besoin de rédiger des textes longs : vous répondez simplement, et je structure le contenu pour qu'il soit clair et rassurant."
			}
		},
		{
			'@type': 'Question',
			name: "Puis-je changer d'offre plus tard ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Oui, vous pouvez passer d'un plan à l'autre selon l'évolution de votre activité."
			}
		},
		{
			'@type': 'Question',
			name: "Pourquoi dit-on que le site est rapide et léger ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Le site est conçu sans systèmes lourds en arrière-plan. Les pages sont légères et s'affichent rapidement, même sur mobile ou avec une connexion limitée. C'est agréable pour vos visiteurs et bien vu par les moteurs de recherche."
			}
		},
		{
			'@type': 'Question',
			name: "Puis-je utiliser Doctolib, Qare ou un autre service de prise de rendez-vous ?",
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Oui. J'intègre le widget de prise de rendez-vous de votre plateforme (Doctolib, Qare, Maiia ou équivalent) directement sur le site. Les sites sont aussi optimisés pour le mobile."
			}
		}
	]
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Nicolas Devaux',
	alternateName: 'Nicodev',
	url: baseUrl,
	description: 'Création de sites internet pour psychologues.'
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: baseUrl + '/' }
	]
};
---

<Layout
	title="Sites web pour psychologues par un psychologue | SEO local"
	description="Création de sites internet pour psychologues, optimisés pour le référencement local (psychologue + ville). Packs simples, visibilité Google, widget Doctolib."
	image={defaultOgWebp}
>
	<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<HeroSection />

	<DifferenciationDiySection />

	<ExpertiseSection />

	<BlogHomeSection posts={homeBlogPosts} />

	<ProcessSection />

	<OffersSection />

	<SeoLocalSection />

	<TestimonialsSection />

	<FaqSection />

	<CtaSection
		anchorId="contact-accueil"
		title="Diagnostic gratuit, sans engagement"
		description="Quelques questions pour comprendre votre situation et vous orienter vers l'offre la plus adaptée, sans engagement."
		primaryButton={{ text: 'Demander un diagnostic gratuit', href: '/diagnostic-gratuit/' }}
		secondaryButton={{ text: 'Voir les tarifs', href: '/tarifs/' }}
	/>
</Layout>
