---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import TestimonialCard from '../components/TestimonialCard.astro';

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Nicolas Devaux',
	description: 'Création de sites internet pour psychologues, psychomotriciens, psychothérapeutes, psychopraticiens, praticiens en psychothérapie, thérapeutes et coachs.',
	url: 'https://nicodev-astro.netlify.app/',
	email: 'contact.nicodev@gmail.com',
	areaServed: 'France',
	slogan: 'Création de sites internet',
	makesOffer: [
		{ '@type': 'Offer', name: 'Forfait Création', price: '490', priceCurrency: 'EUR' },
		{ '@type': 'Offer', name: 'Pack Site Vitrine', price: '59', priceCurrency: 'EUR' },
		{ '@type': 'Offer', name: 'Pack Site + Blog', price: '89', priceCurrency: 'EUR' }
	]
};
---

<Layout
	title="Site pour psychologue | SEO local + Packs simples"
	description="Création de sites internet pour psychologues, optimisés pour le référencement local (psychologue + ville). Packs simples, visibilité Google, widget Doctolib."
	image="/images/development.jpg"
>
	<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />

	<section class="bg-gradient-to-br from-teal-700 via-teal-600 to-slate-700 text-white py-16 md:py-24">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-12 items-center">
				<div class="min-w-0">
			<p class="text-sm md:text-base uppercase tracking-wider text-teal-100 mb-4">Sites web pour psychologues et professionnels du soin psychique</p>
			<h1 class="text-4xl md:text-6xl font-bold leading-tight max-w-4xl">
				Un site clair et rassurant pour présenter votre offre de soins
			</h1>
			<p class="mt-6 text-lg md:text-2xl text-teal-50 max-w-3xl">
				Je crée votre site avec un cadre simple: 3 offres lisibles, un déroulé guidé étape par étape et une phase de retours incluse avant la mise en ligne.
			</p>
			<div class="mt-8 flex flex-col sm:flex-row gap-4">
				<a href="#lead-form" class="bg-white text-teal-700 px-7 py-3 rounded-lg font-semibold text-center hover:bg-slate-100 transition-colors flex items-center justify-center h-full">
					Obtenir ma proposition gratuite
				</a>
				<a href="#offres" class="border-2 border-white/90 text-white px-7 py-3 rounded-lg font-semibold text-center hover:bg-white hover:text-teal-700 transition-colors">
					Découvrir les offres
				</a>
			</div>
				</div>
				<div class="hidden lg:block">
					<Image
						src="/images/hero-laptop.webp"
						alt="Site web professionnel sur ordinateur"
						width={672}
						height={420}
						widths={[384, 448, 672]}
						sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 448px"
						class="rounded-xl shadow-2xl w-full max-w-md mx-auto"
					/>
				</div>
			</div>
			<p class="mt-6 text-sm text-teal-100">Quelques projets par mois pour garantir la qualité et le suivi.</p>
			<div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
				<div class="bg-white/10 rounded-lg p-4 border border-white/20 flex items-center gap-3 hover:bg-white/15 transition-colors">
					<svg class="w-5 h-5 text-teal-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
					</svg>
					<span>Délai : 2 à 3 semaines</span>
				</div>
				<div class="bg-white/10 rounded-lg p-4 border border-white/20 flex items-center gap-3 hover:bg-white/15 transition-colors">
					<svg class="w-5 h-5 text-teal-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/>
					</svg>
					<span>Mobile et visible sur Google</span>
				</div>
				<div class="bg-white/10 rounded-lg p-4 border border-white/20 flex items-center gap-3 hover:bg-white/15 transition-colors">
					<svg class="w-5 h-5 text-teal-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m3.75 13.5 10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75Z"/>
					</svg>
					<span>Pages rapides</span>
				</div>
				<div class="bg-white/10 rounded-lg p-4 border border-white/20 flex items-center gap-3 hover:bg-white/15 transition-colors">
					<svg class="w-5 h-5 text-teal-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/>
					</svg>
					<span>Widget RDV (Doctolib...) + RGPD</span>
				</div>
			</div>
		</div>
	</section>

	<section class="py-14 bg-white">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-12 items-center">
				<div class="min-w-0">
					<h2 class="text-3xl font-bold text-gray-900 mb-6">Une expertise métier + web</h2>
					<p class="text-lg text-gray-700 max-w-4xl">
						Psychologue et développeur web, je connais vos enjeux : rassurer des patients, présenter clairement votre approche et rester conforme aux règles de communication selon votre profession (psychologues, psychothérapeutes, coachs, etc.).
					</p>
				</div>
				<div class="flex justify-center lg:justify-end">
					<Image
						src="/images/expertise-venn.webp"
						alt="Psychologie et technologie au service de votre site"
						width={665}
						height={363}
						widths={[384, 530, 665]}
						sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 665px"
						class="rounded-xl w-full max-w-sm"
					/>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 bg-stone-50">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl font-bold text-gray-900 mb-6">Pourquoi beaucoup de psychologues ont peu de visibilité</h2>
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
				<div>
					<p class="text-lg text-gray-700 mb-4">
						En libéral, vous misez sur le bouche-à-oreille et les plateformes (Doctolib, annuaires). Ces canaux apparaissent dans les résultats Google, mais sans site dédié vous dépendez entièrement d'eux : présentation limitée, concurrence sur la fiche, pas d'espace pour détailler votre approche et rassurer avant la prise de rendez-vous.
					</p>
					<p class="text-gray-700">
						Les futurs patients tapent ces recherches avant de consulter. Un site professionnel, optimisé pour le référencement local, vous positionne dans ces résultats et attire des personnes déjà à la recherche de votre profil.
					</p>
				</div>
				<ul class="space-y-3 text-gray-700">
					<li class="flex items-start">
						<svg class="w-5 h-5 text-teal-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z"/>
						</svg>
						<span>Pas de site = invisible sur les recherches locales</span>
					</li>
					<li class="flex items-start">
						<svg class="w-5 h-5 text-teal-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z"/>
						</svg>
						<span>Un site non optimisé = peu de chances d'apparaître en première page</span>
					</li>
					<li class="flex items-start">
						<svg class="w-5 h-5 text-teal-600 mr-3 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126z"/>
						</svg>
						<span>Un site clair + SEO local = plus de demandes qualifiées</span>
					</li>
				</ul>
			</div>
		</div>
	</section>

	<section class="py-16 bg-white">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr] gap-12 items-center">
				<div class="order-2 lg:order-1 flex justify-center lg:justify-start">
					<Image
						src="/images/mobile-fast.webp"
						alt="Site optimisé pour mobile et chargement rapide"
						width={665}
						height={363}
						widths={[384, 530, 665]}
						sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 665px"
						class="rounded-xl w-full max-w-sm"
					/>
				</div>
				<div class="order-1 lg:order-2 min-w-0">
					<h2 class="text-3xl font-bold text-gray-900 mb-6">Un site rapide et accessible pour tous vos visiteurs</h2>
					<p class="text-lg text-gray-700 max-w-4xl mb-4">
						Vos patients consultent souvent depuis leur téléphone ou une connexion limitée. Les sites que je crée sont légers et chargent vite&nbsp;: les pages s'affichent quasi immédiatement, ce qui réduit la frustration et encourage à rester sur le site.
					</p>
					<p class="text-lg text-gray-700 max-w-4xl">
						Ils sont hébergés sur une infrastructure fiable et sécurisée, disponible 24h/24. Vous n'avez rien à gérer côté technique, tout fonctionne en continu.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section id="offres" class="py-16 bg-stone-50">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-10">
				<h2 class="text-3xl font-bold text-gray-900">3 offres packagées</h2>
				<p class="text-gray-600 mt-3">Des choix clairs pour avancer vite, sans devis complexe.</p>
				<p class="text-gray-600 mt-2 text-sm max-w-2xl mx-auto">Les abonnements incluent la maintenance et les modifications de contenu. Avec le forfait unique, chaque modification est facturée 50€/h.</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<article class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
					<h3 class="text-xl font-semibold text-gray-900">Forfait Création</h3>
					<p class="text-4xl font-bold text-gray-900 mt-4">490€</p>
					<p class="text-sm text-gray-500 mt-1">Paiement unique, sans abonnement</p>
					<ul class="mt-6 space-y-2 text-gray-700">
						<li>Site vitrine (template + vos contenus)</li>
						<li>Visible sur Google (optimisation de base)</li>
						<li>Hébergement fiable et sécurisé inclus</li>
						<li>Widget de prise de RDV (Doctolib, Qare, Maiia...)</li>
						<li>1 aller-retour inclus</li>
						<li class="text-gray-500">Modifications ultérieures : 50€/h</li>
					</ul>
					<p class="mt-4 text-sm text-teal-700 font-medium">Idéal pour une première présence web, tester le besoin en toute simplicité.</p>
					<a href="#lead-form" class="mt-6 inline-block w-full text-center bg-gray-900 text-white py-3 rounded-lg font-semibold hover:bg-black transition-colors">Demander ce forfait</a>
				</article>

				<article class="bg-white rounded-xl border-2 border-teal-600 shadow-lg p-6 relative">
					<p class="absolute -top-3 left-1/2 -translate-x-1/2 bg-teal-800 text-white text-xs px-3 py-1 rounded-full">Le plus choisi</p>
					<h3 class="text-xl font-semibold text-gray-900">Pack Site Vitrine</h3>
					<p class="text-4xl font-bold text-gray-900 mt-4">59€</p>
					<p class="text-sm text-gray-500 mt-1">Par mois, sans engagement</p>
					<ul class="mt-6 space-y-2 text-gray-700">
						<li>Tout du Forfait Création</li>
						<li>Hébergement sécurisé 24h/24 + nom de domaine</li>
						<li><strong>Maintenance et modifications incluses</strong> <a href="#faq-modifications" class="text-teal-600 hover:text-teal-700 no-underline font-normal" title="Détails des modifications incluses">*</a></li>
						<li>Support prioritaire</li>
					</ul>
					<p class="mt-4 text-sm text-teal-700 font-medium">Idéal pour une activité établie qui veut un site évolutif sans gérer la technique.</p>
					<a href="#lead-form" class="mt-6 inline-block w-full text-center bg-teal-800 text-white py-3 rounded-lg font-semibold hover:bg-teal-900 transition-colors">Demander ce pack</a>
				</article>

				<article class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
					<h3 class="text-xl font-semibold text-gray-900">Pack Site + Blog</h3>
					<p class="text-4xl font-bold text-gray-900 mt-4">89€</p>
					<p class="text-sm text-gray-500 mt-1">Par mois, sans engagement</p>
					<ul class="mt-6 space-y-2 text-gray-700">
						<li>Tout du Pack Site Vitrine</li>
						<li><strong>Maintenance et modifications incluses</strong> <a href="#faq-modifications" class="text-teal-600 hover:text-teal-700 no-underline font-normal" title="Détails des modifications incluses">*</a></li>
						<li>2 articles de blog par mois</li>
						<li>Visibilité continue sur Google</li>
						<li>Optimisé pour attirer plus de demandes</li>
					</ul>
					<p class="mt-4 text-sm text-teal-700 font-medium">Idéal pour maximiser la visibilité et attirer plus de patients via le référencement.</p>
					<a href="#lead-form" class="mt-6 inline-block w-full text-center bg-gray-900 text-white py-3 rounded-lg font-semibold hover:bg-black transition-colors">Demander ce pack</a>
				</article>
			</div>
		</div>
	</section>

	<section id="process" class="py-16 bg-white">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-10">
				<h2 class="text-3xl font-bold text-gray-900">Comment ça fonctionne</h2>
				<p class="text-gray-600 mt-3">5 étapes simples, un process cadré pour avancer sereinement.</p>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
				<div class="bg-stone-50 rounded-xl p-5 border border-stone-200">
					<div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.625 9.75a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 0 1 .778-.332 48.294 48.294 0 0 0 5.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z"/>
						</svg>
					</div>
					<h3 class="text-teal-700 font-semibold">1. Diagnostic express (10–15 min)</h3>
					<p class="text-gray-700 mt-2 text-sm">Court échange pour vérifier que l'offre correspond au besoin, choisir le pack et confirmer le délai.</p>
				</div>
				<div class="bg-stone-50 rounded-xl p-5 border border-stone-200">
					<div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008Z"/>
						</svg>
					</div>
					<h3 class="text-teal-700 font-semibold">2. Choix du template</h3>
					<p class="text-gray-700 mt-2 text-sm">Le client choisit parmi des modèles prédéfinis + palette de couleurs. Pas de design sur mesure.</p>
				</div>
				<div class="bg-stone-50 rounded-xl p-5 border border-stone-200">
					<div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>
						</svg>
					</div>
					<h3 class="text-teal-700 font-semibold">3. Contenu via formulaire guidé</h3>
					<p class="text-gray-700 mt-2 text-sm">Des questions guidées (20–40 min). Pas besoin de rédiger : vous répondez, je m'occupe de la mise en forme pour vos patients.</p>
				</div>
				<div class="bg-stone-50 rounded-xl p-5 border border-stone-200">
					<div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
						</svg>
					</div>
					<h3 class="text-teal-700 font-semibold">4. Prévisualisation sous 5–7 jours</h3>
					<p class="text-gray-700 mt-2 text-sm">Envoi d'une URL de prévisualisation + checklist de validation.</p>
				</div>
				<div class="bg-stone-50 rounded-xl p-5 border border-stone-200">
					<div class="w-10 h-10 bg-teal-100 rounded-lg flex items-center justify-center mb-4">
						<svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
						</svg>
					</div>
					<h3 class="text-teal-700 font-semibold">5. 1 aller-retour inclus + mise en ligne</h3>
					<p class="text-gray-700 mt-2 text-sm">Corrections mineures incluses. Toute modification supplémentaire est facturée.</p>
				</div>
			</div>

			<p class="text-center text-sm text-gray-500 mt-8">
				Délai moyen : 7 à 10 jours après réception du formulaire complet.
			</p>

			<div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
				<div class="bg-stone-50 rounded-xl p-6 border border-stone-200">
					<h3 class="text-lg font-semibold text-gray-900 mb-4">Ce qui est inclus</h3>
					<ul class="space-y-3">
