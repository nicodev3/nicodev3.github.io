	<section id="lead-form" class="py-16 bg-gradient-to-br from-teal-50 to-slate-100">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="bg-white rounded-2xl shadow-lg border border-teal-100 p-6 md:p-8">
				<h2 class="text-3xl font-bold text-gray-900">Recevoir une proposition en 48h</h2>
				<p class="text-gray-600 mt-3">Décrivez votre contexte. Je vous recommande l'offre la plus adaptée.</p>

				<div id="home-form-success" class="hidden mt-6 bg-green-50 border border-green-200 rounded-lg p-4 text-green-800">
					Message envoyé. Je reviens vers vous rapidement.
				</div>

				<form id="home-contact-form" class="mt-6 space-y-4">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nom et prénom *</label>
							<input id="name" name="name" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" />
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
							<input id="email" name="email" type="email" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" />
						</div>
					</div>
					<div>
						<label for="formule" class="block text-sm font-medium text-gray-700 mb-1">Formule souhaitée *</label>
						<select id="formule" name="formule" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none">
							<option value="">Sélectionnez une formule</option>
							<option value="forfait">Forfait Création - 490€ (sans abonnement)</option>
							<option value="vitrine">Pack Site Vitrine - 59€/mois</option>
							<option value="blog">Pack Site + Blog - 89€/mois</option>
							<option value="indecis">Je ne sais pas encore</option>
						</select>
					</div>
					<div>
						<label for="message" class="block text-sm font-medium text-gray-700 mb-1">Votre besoin *</label>
						<textarea id="message" name="message" rows="5" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-teal-500 focus:border-teal-500 outline-none" placeholder="Type de pratique, délai, objectifs, éléments déjà disponibles..."></textarea>
					</div>
					<button id="home-submit-btn" type="submit" class="w-full bg-teal-600 text-white py-3 rounded-lg font-semibold hover:bg-teal-700 transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
						Envoyer ma demande
					</button>
				</form>
			</div>
		</div>
	</section>

	<script>
		const homeForm = document.getElementById('home-contact-form');
		const homeSubmit = document.getElementById('home-submit-btn');
		const homeSuccess = document.getElementById('home-form-success');

		if (homeForm && homeSubmit && homeSuccess) {
			homeForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				homeSubmit.setAttribute('disabled', 'true');
				homeSubmit.textContent = 'Envoi en cours...';

				const data = new FormData(homeForm as HTMLFormElement);
				const response = await fetch('https://formspree.io/f/xqedyrwy', {
					method: 'POST',
					body: data,
					headers: { Accept: 'application/json' }
				});

				if (response.ok) {
					homeForm.classList.add('hidden');
					homeSuccess.classList.remove('hidden');
				} else {
					homeSubmit.removeAttribute('disabled');
					homeSubmit.textContent = 'Envoyer ma demande';
					alert('Une erreur est survenue. Veuillez réessayer.');
				}
			});
		}
	</script>
</Layout>
