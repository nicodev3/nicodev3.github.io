---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BulletList from '../components/BulletList.astro';
import CtaSection from '../components/CtaSection.astro';
---

<Layout 
	title="Création de sites internet - Nicolas Devaux"
	description="Nicolas Devaux, psychologue, développeur web et webdesigner. Création de sites sur mesure pour psychologues et professionnels libéraux"
>
	<Hero 
		title="Sites internet pour psychologues" 
		subtitle="Je suis psychologue, développeur web et webdesigner, spécialisé dans la création de sites sur mesure pour psychologues et professionnels libéraux"
	>
		<div slot="after" class="flex flex-col sm:flex-row gap-4 justify-center">
			<a href="/portfolio" class="bg-white text-teal-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors">
				Voir mes réalisations
			</a>
			<a href="/contact" class="border-2 border-white text-white px-8 py-3 rounded-lg font-semibold hover:bg-white hover:text-teal-600 transition-colors">
				Me contacter
			</a>
		</div>
	</Hero>

	<!-- About Section -->
	<section class="py-16 bg-gradient-to-br from-stone-50 to-slate-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<div>
					<h2 class="text-3xl font-bold text-gray-900 mb-6">
						Sites internet sur mesure pour praticiens libéraux
					</h2>
					<div class="prose prose-lg text-gray-600 space-y-4">
						<p>
							<strong>Psychologue en libéral</strong> et passionné du web depuis 20 ans, fort de multiples expériences en tant que développeur web puis technical leader pour le compte de grandes entreprises, je mets ma double expertise au service des psychologues. Je sais exactement comment valoriser votre profession en ligne.
						</p>
						<p>
							Je crée des <strong>sites personnalisés</strong> qui s'adaptent à votre pratique, votre approche thérapeutique et votre personnalité. Pas de templates génériques, mais une solution sur mesure qui vous ressemble.
						</p>
						<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 my-6">
							<h3 class="text-lg font-semibold text-gray-900 mb-4">Pourquoi choisir un site sur mesure ?</h3>
							<BulletList 
								items={[
									"Un design qui inspire confiance et professionnalisme",
									"Une présentation claire de vos spécialités et approches",
									"Une intégration fluide avec Doctolib et vos outils de prise de RDV",
									"Un référencement optimisé pour être trouvé par vos futurs patients"
								]} 
							/>
						</div>
						<p>
							Chaque site est conçu avec les <strong>dernières technologies</strong>, optimisé pour tous les appareils (mobile, tablette, ordinateur) et respecte les règles de communication des professions de santé.
						</p>
					</div>
				</div>
				<div class="relative">
					<div class="bg-white p-4 rounded-lg shadow-xl">
						<img 
							src="/images/development.jpg" 
							alt="Création de sites web sur mesure" 
							class="rounded-lg w-full"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-teal-600/20 to-transparent rounded-lg"></div>
					</div>
					<div class="absolute -bottom-4 -right-4 bg-teal-600 text-white p-4 rounded-lg shadow-lg">
						<div class="text-sm font-semibold">100% sur mesure</div>
						<div class="text-xs opacity-90">Pas de templates</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Skills & Services Section -->
	<section class="py-16 bg-gray-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl font-bold text-center text-gray-900 mb-12">
				Compétences et prestations
			</h2>
			
			<div class="max-w-4xl mx-auto">
				<!-- Services unifiés -->
				<div class="bg-gradient-to-br from-stone-50 to-slate-50 p-8 rounded-xl shadow-lg border border-teal-100">
					<h3 class="text-2xl font-semibold text-gray-900 mb-6 flex items-center">
						<svg class="w-6 h-6 text-teal-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15L15 9.75M21 12a9 9 0 1 1-18 0a9 9 0 0 1 18 0"/>
						</svg>
						Mes services pour praticiens libéraux
					</h3>
					
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
						<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
							<h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
								<svg class="w-5 h-5 text-teal-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25"/>
								</svg>
								Création de sites web
							</h4>
							<BulletList items={["Psychologues et psychiatres", "Kinésithérapeutes et ostéopathes", "Médecins spécialistes", "Praticiens en médecine douce"]} color="teal" />
						</div>
						
						<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
							<h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
								<svg class="w-5 h-5 text-green-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75L12 13.5z"/>
								</svg>
								Visibilité et référencement
							</h4>
							<BulletList items={["Référencement local (Google Maps)", "Optimisation pour les recherches santé", "Intégration réseaux sociaux", "Vitesse et performance"]} color="green" />
						</div>
						
						<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
							<h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
								<svg class="w-5 h-5 text-purple-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 6.878V6a2.25 2.25 0 0 1 2.25-2.25h7.5A2.25 2.25 0 0 1 18 6v.878m-12 0q.354-.126.75-.128h10.5q.396.002.75.128m-12 0A2.25 2.25 0 0 0 4.5 9v.878m13.5-3A2.25 2.25 0 0 1 19.5 9v.878m0 0a2.3 2.3 0 0 0-.75-.128H5.25q-.396.002-.75.128m15 0A2.25 2.25 0 0 1 21 12v6a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 18v-6c0-.98.626-1.813 1.5-2.122"/>
								</svg>
								Fonctionnalités spécialisées
							</h4>
							<BulletList items={["Intégration Doctolib/prise de RDV", "Articles de santé et bien-être", "Présentation de vos spécialités", "Espace témoignages patients"]} color="purple" />
						</div>
						
						<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100">
							<h4 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
								<svg class="w-5 h-5 text-orange-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15L15 9.75m-3-7.036A11.96 11.96 0 0 1 3.598 6A12 12 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623c5.176-1.332 9-6.03 9-11.622c0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285"/>
								</svg>
								Sécurité et accompagnement
							</h4>
							<BulletList items={["Conformité RGPD", "Certificat SSL sécurisé", "Formation à la gestion du site", "Support technique continu"]} color="orange" />
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<CtaSection 
		title="Prêt à créer votre site internet ?"
		description="Découvrez mes réalisations et contactez-moi pour discuter de votre projet."
		primaryButton={{ text: "Voir mon portfolio", href: "/portfolio" }}
		secondaryButton={{ text: "Me contacter", href: "/contact" }}
	/>
</Layout>
