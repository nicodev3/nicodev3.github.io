---
import Layout from '../layouts/Layout.astro';
import OffersSection from '../components/OffersSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ExpertiseSection from '../components/ExpertiseSection.astro';
import HeroSection from '../components/HeroSection.astro';
import HomeAudienceSection from '../components/HomeAudienceSection.astro';
import CtaSection from '../components/CtaSection.astro';
import portraitImage from '../assets/images/nicodev.webp';
import { INSTAGRAM_HREF, WHATSAPP_PHONE_E164 } from '../data/contact';

const baseUrl = Astro.site ?? Astro.url.origin;
const siteRootHref = new URL('/', baseUrl).href;

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Nicolas Devaux',
	legalName: 'Nicolas Devaux — EI',
	identifier: { '@type': 'PropertyValue', propertyID: 'SIRET', value: '75103269900033' },
	description:
		'Création de sites internet pour psychologues, psychomotriciens, ergothérapeutes et orthophonistes. Abonnement mensuel tout inclus dès 29 EUR.',
	url: siteRootHref,
	telephone: `+${WHATSAPP_PHONE_E164}`,
	address: {
		'@type': 'PostalAddress',
		postalCode: '92330',
		addressLocality: 'Sceaux',
		addressRegion: 'Île-de-France',
		addressCountry: 'FR'
	},
	priceRange: '€€',
	sameAs: [
		'https://www.malt.fr/profile/nicolasdevaux1',
		'https://github.com/nicodev3',
		'https://www.linkedin.com/in/nicodev3/',
		INSTAGRAM_HREF
	],
	areaServed: { '@type': 'Country', name: 'France' },
	slogan: 'Création de sites internet pour psychologues, psychomotriciens, ergothérapeutes et orthophonistes',
	makesOffer: [
		{
			'@type': 'Offer',
			name: 'Pack Site Vitrine',
			description: 'Abonnement mensuel — création et maintenance du site incluses',
			priceSpecification: {
				'@type': 'UnitPriceSpecification',
				price: '29',
				priceCurrency: 'EUR',
				unitText: 'MONTH'
			}
		},
		{
			'@type': 'Offer',
			name: 'Pack Site + Blog',
			description: 'Abonnement mensuel — site vitrine et contenus éditoriaux pour la visibilité',
			priceSpecification: {
				'@type': 'UnitPriceSpecification',
				price: '49',
				priceCurrency: 'EUR',
				unitText: 'MONTH'
			}
		}
	]
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Nicolas Devaux',
	alternateName: 'Nicodev',
	url: siteRootHref,
	description: 'Création de sites internet pour psychologues, psychomotriciens, ergothérapeutes et orthophonistes.'
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: siteRootHref }
	]
};
---

<Layout
	title="Nicodev — Sites pour psychologues, psychomotriciens, ergo et orthophonistes"
	description="Création de sites internet pour psychologues, psychomotriciens, ergothérapeutes et orthophonistes : sites sobres, clairs, visibilité locale et rendez-vous."
	image={portraitImage}
>
	<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<HeroSection />

	<HomeAudienceSection />

	<TestimonialsSection />

	<OffersSection />

	<ProcessSection />

	<ExpertiseSection />

	<CtaSection
		variant="accent-band"
		anchorId="contact-accueil"
		title="Envie d’en parler simplement ?"
		description="Le diagnostic gratuit sert surtout à situer votre contexte : votre pratique, votre ville, vos besoins réels et ce qui serait utile, ou non, pour votre site."
		primaryButton={{ text: 'Demander un diagnostic gratuit', href: '/diagnostic-gratuit/' }}
		secondaryButton={{ text: 'Voir les tarifs', href: '/tarifs/' }}
	/>
</Layout>
