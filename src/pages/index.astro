---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import OffersSection from '../components/OffersSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ExpertiseSection from '../components/ExpertiseSection.astro';
import HeroSection from '../components/HeroSection.astro';
import HomeAudienceSection from '../components/HomeAudienceSection.astro';
import HomeAiObjectionSection from '../components/HomeAiObjectionSection.astro';
import HomeVisibilityPathSection from '../components/HomeVisibilityPathSection.astro';
import HomePortfolioSection from '../components/HomePortfolioSection.astro';
import BlogHomeSection from '../components/BlogHomeSection.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaSection from '../components/CtaSection.astro';
import portraitImage from '../assets/images/nicodev.webp';
import { INSTAGRAM_HREF, WHATSAPP_PHONE_E164 } from '../data/contact';
import { homeFaqShortlist } from '../data/faq-home';
import { compoundMonthlyPriceSpec } from '../data/pricing';

const baseUrl = Astro.site ?? Astro.url.origin;
const siteRootHref = new URL('/', baseUrl).href;

/**
 * Sélection éditoriale plutôt que les trois derniers publiés : l’accueil met en avant
 * l’installation, Doctolib et le budget — trois questions fréquentes avant un projet de site.
 */
const HOME_POST_IDS = [
	'installer-liberal-psychologue-par-ou-commencer',
	'site-internet-psychologue-doctolib',
	'combien-coute-site-internet-2026',
];

const blogPosts = await getCollection('blog');
const homePosts = HOME_POST_IDS.map((id) => {
	const post = blogPosts.find((entry) => entry.id === id);
	if (!post) throw new Error(`Accueil : article introuvable « ${id} »`);
	return post;
});

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Nicolas Devaux',
	legalName: 'Nicolas Devaux — EI',
	identifier: { '@type': 'PropertyValue', propertyID: 'SIRET', value: '75103269900033' },
	description:
		'Création et référencement de sites internet pour psychologues, psychothérapeutes et psychomotriciens par un confrère développeur. 0 EUR de frais de construction, puis 29 ou 49 EUR par mois tout inclus.',
	url: siteRootHref,
	telephone: `+${WHATSAPP_PHONE_E164}`,
	address: {
		'@type': 'PostalAddress',
		postalCode: '92330',
		addressLocality: 'Sceaux',
		addressRegion: 'Île-de-France',
		addressCountry: 'FR'
	},
	priceRange: '€€',
	sameAs: [
		'https://www.malt.fr/profile/nicolasdevaux1',
		'https://github.com/nicodev3',
		'https://www.linkedin.com/in/nicodev3/',
		INSTAGRAM_HREF
	],
	areaServed: { '@type': 'Country', name: 'France' },
	slogan: 'Création de sites internet pour psychologues',
	makesOffer: [
		{
			'@type': 'Offer',
			name: 'Sérénité',
			description: 'Création ou refonte du site, CMS, bases SEO, fiche Google, hébergement et maintenance inclus. 0 EUR de frais de construction.',
			priceSpecification: compoundMonthlyPriceSpec('29'),
		},
		{
			'@type': 'Offer',
			name: 'Visibilité & Confiance',
			description: 'Veille SEO d’expert, relecture et optimisation des contenus, entretien dans la durée. 0 EUR de frais de construction.',
			priceSpecification: compoundMonthlyPriceSpec('49'),
		}
	]
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Nicolas Devaux',
	alternateName: 'Nicodev',
	url: siteRootHref,
	description: 'Création de sites internet pour psychologues en libéral.'
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: siteRootHref }
	]
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: homeFaqShortlist.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: { '@type': 'Answer', text: item.answer }
	}))
};
---

<Layout
	title="Création de sites internet pour psychologues | Nicodev"
	description="Psychologue, psychomotricien et psychothérapeute, je crée ou refais les sites de mes confrères en libéral : 0 € de construction, puis 29 € ou 49 €/mois tout inclus."
	image={portraitImage}
>
	<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<HeroSection />

	<HomeAudienceSection />

	<HomeAiObjectionSection />

	<HomeVisibilityPathSection />

	<ExpertiseSection />

	<HomePortfolioSection />

	<TestimonialsSection />

	<OffersSection source="accueil" />

	<ProcessSection />

	<FaqSection
		items={homeFaqShortlist}
		title="Questions fréquentes"
		sectionId="faq"
		headingId="faq-accueil-heading"
		background="surface"
		headingAlign="center"
	/>

	<BlogHomeSection posts={homePosts} />

	<CtaSection
		variant="accent-band"
		anchorId="contact-accueil"
		title="Où en êtes-vous avec votre site ?"
		description="Installation, premier site, refonte ou manque de visibilité : présentez-moi votre situation. Je vous répondrai sur ce qui me paraît utile, sans vous orienter systématiquement vers la formule la plus complète."
		primaryButton={{
			text: 'Faire le point sur votre visibilité',
			href: '/diagnostic-gratuit/',
			umamiEvent: 'lead_click_diagnostic_from_home_final',
			leadSource: 'home-final'
		}}
		secondaryButton={{
			text: 'Voir les tarifs',
			href: '/tarifs/',
			umamiEvent: 'lead_click_tarifs_from_home_final'
		}}
	/>
</Layout>
