---
import Layout from '../layouts/Layout.astro';
import OffersSection from '../components/OffersSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ExpertiseSection from '../components/ExpertiseSection.astro';
import HeroSection from '../components/HeroSection.astro';
import HomeAudienceSection from '../components/HomeAudienceSection.astro';
import HomeVisibilityPathSection from '../components/HomeVisibilityPathSection.astro';
import HomePortfolioSection from '../components/HomePortfolioSection.astro';
import CtaSection from '../components/CtaSection.astro';
import portraitImage from '../assets/images/nicodev.webp';
import { INSTAGRAM_HREF, WHATSAPP_PHONE_E164 } from '../data/contact';

const baseUrl = Astro.site ?? Astro.url.origin;
const siteRootHref = new URL('/', baseUrl).href;

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Nicolas Devaux',
	legalName: 'Nicolas Devaux — EI',
	identifier: { '@type': 'PropertyValue', propertyID: 'SIRET', value: '75103269900033' },
	description:
		'Création et référencement de sites internet pour psychologues en libéral par un psychologue-développeur. Hébergement et maintenance inclus dès 29 EUR par mois.',
	url: siteRootHref,
	telephone: `+${WHATSAPP_PHONE_E164}`,
	address: {
		'@type': 'PostalAddress',
		postalCode: '92330',
		addressLocality: 'Sceaux',
		addressRegion: 'Île-de-France',
		addressCountry: 'FR'
	},
	priceRange: '€€',
	sameAs: [
		'https://www.malt.fr/profile/nicolasdevaux1',
		'https://github.com/nicodev3',
		'https://www.linkedin.com/in/nicodev3/',
		INSTAGRAM_HREF
	],
	areaServed: { '@type': 'Country', name: 'France' },
	slogan: 'Création de sites internet pour psychologues',
	makesOffer: [
		{
			'@type': 'Offer',
			name: 'Sérénité',
			description: 'Création ou refonte du site, hébergement et maintenance inclus',
			priceSpecification: {
				'@type': 'UnitPriceSpecification',
				price: '29',
				priceCurrency: 'EUR',
				unitText: 'MONTH'
			}
		},
		{
			'@type': 'Offer',
			name: 'Visibilité & Confiance',
			description: 'Création du site, référencement local, contenus et suivi inclus',
			priceSpecification: {
				'@type': 'UnitPriceSpecification',
				price: '49',
				priceCurrency: 'EUR',
				unitText: 'MONTH'
			}
		}
	]
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Nicolas Devaux',
	alternateName: 'Nicodev',
	url: siteRootHref,
	description: 'Création de sites internet pour psychologues en libéral.'
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: siteRootHref }
	]
};
---

<Layout
	title="Création de sites internet pour psychologues | Nicodev"
	description="Psychologue et développeur web, je crée ou refais les sites de psychologues en libéral : contenus, visibilité locale, hébergement et maintenance dès 29 €/mois."
	image={portraitImage}
>
	<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<HeroSection />

	<HomeAudienceSection />

	<HomeVisibilityPathSection />

	<ExpertiseSection />

	<HomePortfolioSection />

	<TestimonialsSection />

	<OffersSection />

	<ProcessSection />

	<CtaSection
		variant="accent-band"
		anchorId="contact-accueil"
		title="Où en êtes-vous avec votre site ?"
		description="Installation, premier site, refonte ou manque de visibilité : présentez-moi votre situation. Je vous répondrai sur ce qui me paraît utile, sans vous orienter systématiquement vers la formule la plus complète."
		primaryButton={{ text: 'Faire le point sur mon projet', href: '/diagnostic-gratuit/' }}
		secondaryButton={{ text: 'Voir les tarifs', href: '/tarifs/' }}
	/>
</Layout>
