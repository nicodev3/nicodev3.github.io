	<script>
		const homeForm = document.getElementById('home-contact-form');
		const homeSubmit = document.getElementById('home-submit-btn');
		const homeSuccess = document.getElementById('home-form-success');

		if (homeForm && homeSubmit && homeSuccess) {
			homeForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				homeSubmit.setAttribute('disabled', 'true');
				homeSubmit.textContent = 'Envoi en cours...';

				const form = homeForm as HTMLFormElement;
				const formData = new FormData(form);
				const params = new URLSearchParams();
				formData.forEach((value, key) => params.append(key, typeof value === 'string' ? value : (value as File).name));
				const response = await fetch('/', {
					method: 'POST',
					body: params.toString(),
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
				});

				if (response.ok) {
					form.classList.add('hidden');
					homeSuccess.classList.remove('hidden');
				} else {
					homeSubmit.removeAttribute('disabled');
					homeSubmit.textContent = 'Recevoir ma proposition';
					alert('Une erreur est survenue. Veuillez réessayer.');
				}
			});
		}
	</script>
