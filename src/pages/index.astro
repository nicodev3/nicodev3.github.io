---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import OffersSection from '../components/OffersSection.astro';
import ProcessSection from '../components/ProcessSection.astro';
import SeoLocalSection from '../components/SeoLocalSection.astro';
import FaqSection from '../components/FaqSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ExpertiseSection from '../components/ExpertiseSection.astro';
import HeroSection from '../components/HeroSection.astro';
import HomeTrustStrip from '../components/HomeTrustStrip.astro';
import DifferenciationDiySection from '../components/DifferenciationDiySection.astro';
import BlogHomeSection from '../components/BlogHomeSection.astro';
import CtaSection from '../components/CtaSection.astro';
import defaultOgWebp from '../assets/images/blog/development.webp';
import { homeFaqItems } from '../data/faq-home';

const allBlogPosts = await getCollection('blog');
const preferredBlogIds = [
	'guide-complet-visibilite-en-ligne-psychologues',
	'comment-trouver-premiers-patients-psychologue',
	'google-business-profile-psychologue',
	'site-internet-psychologues',
] as const;
const byBlogId = new Map(allBlogPosts.map((p) => [p.id, p]));
const homeBlogPosts = [];
for (const id of preferredBlogIds) {
	const post = byBlogId.get(id);
	if (post) homeBlogPosts.push(post);
}
const HOME_BLOG_POSTS_LIMIT = 9;

const byDateDesc = [...allBlogPosts].sort(
	(a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
for (const post of byDateDesc) {
	if (homeBlogPosts.length >= HOME_BLOG_POSTS_LIMIT) break;
	if (!homeBlogPosts.some((p) => p.id === post.id)) homeBlogPosts.push(post);
}

const baseUrl = Astro.site ?? Astro.url.origin;
const siteRootHref = new URL('/', baseUrl).href;

const businessSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Nicolas Devaux',
	description:
		'Création de sites internet pour psychologues. Abonnement mensuel tout inclus dès 29 EUR.',
	url: siteRootHref,
	telephone: '+33629341367',
	address: {
		'@type': 'PostalAddress',
		streetAddress: '63 rue Houdan',
		postalCode: '92330',
		addressLocality: 'Sceaux',
		addressRegion: 'Île-de-France',
		addressCountry: 'FR'
	},
	priceRange: '€€',
	sameAs: [
		'https://www.malt.fr/profile/nicolasdevaux1',
		'https://github.com/nicodev3',
		'https://www.linkedin.com/in/nicodev3/'
	],
	areaServed: { '@type': 'Country', name: 'France' },
	slogan: 'Création de sites internet pour psychologues',
	makesOffer: [
		{
			'@type': 'Offer',
			name: 'Pack Site Vitrine',
			description: 'Abonnement mensuel — création et maintenance du site incluses',
			priceSpecification: {
				'@type': 'UnitPriceSpecification',
				price: '29',
				priceCurrency: 'EUR',
				unitText: 'MONTH'
			}
		},
		{
			'@type': 'Offer',
			name: 'Pack Site + Blog',
			description: 'Abonnement mensuel — site vitrine et contenus éditoriaux pour la visibilité',
			priceSpecification: {
				'@type': 'UnitPriceSpecification',
				price: '49',
				priceCurrency: 'EUR',
				unitText: 'MONTH'
			}
		}
	]
};

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: homeFaqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer
		}
	}))
};

const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Nicolas Devaux',
	alternateName: 'Nicodev',
	url: siteRootHref,
	description: 'Création de sites internet pour psychologues.'
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: siteRootHref }
	]
};
---

<Layout
	title="Sites web pour psychologues par un psychologue | SEO local"
	description="Création de sites internet pour psychologues, optimisés pour le référencement local (psychologue + ville). Packs simples, visibilité Google, widget Doctolib."
	image={defaultOgWebp}
>
	<script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

	<HeroSection />

	<HomeTrustStrip />

	<DifferenciationDiySection variant="stitch" />

	<ExpertiseSection />

	<ProcessSection variant="stitch" />

	<SeoLocalSection />

	<OffersSection variant="stitch" />

	<TestimonialsSection variant="stitch" />

	<BlogHomeSection posts={homeBlogPosts} />

	<FaqSection headingAlign="center" variant="stitch" />

	<CtaSection
		variant="accent-band"
		anchorId="contact-accueil"
		title="Prêt à lancer votre site professionnel ?"
		description="Diagnostic gratuit et sans engagement. Quelques questions pour comprendre votre situation et vous orienter vers l'offre la plus adaptée."
		primaryButton={{ text: 'Demander un diagnostic gratuit', href: '/diagnostic-gratuit/' }}
		secondaryButton={{ text: 'Voir les tarifs détaillés', href: '/tarifs/' }}
	/>
</Layout>
