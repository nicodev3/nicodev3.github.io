---
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title="Merci pour votre message | Contact site psy Nicodev"
	description="Votre message de contact a bien été envoyé. Réponse sous 48 h."
	noindex={true}
>
	<section class="py-24 bg-surface min-h-[60vh] flex items-center">
		<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<div class="bg-background rounded-lg shadow-lg border border-border p-8 md:p-12">
				<h1 class="text-3xl font-bold text-foreground">Message bien envoyé</h1>
				<p class="mt-4 text-muted text-lg">Merci. Je vous réponds sous 48 h ouvrées.</p>
				<a href="/" class="btn-primary-solid inline-block mt-8 rounded-lg px-5 py-3">
					Retour à l'accueil
				</a>
			</div>
		</div>
	</section>
</Layout>
