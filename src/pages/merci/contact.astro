---
import Layout from '../../layouts/Layout.astro';
---

<Layout
	title="Merci pour votre message | Nicolas Devaux"
	description="Votre message de contact a bien ete envoye. Reponse sous 48h."
	noindex={true}
>
	<section class="py-24 bg-surface min-h-[60vh] flex items-center">
		<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<div class="bg-background rounded-2xl shadow-lg border border-border p-8 md:p-12">
				<h1 class="text-3xl font-bold text-foreground">Message bien envoye</h1>
				<p class="mt-4 text-muted text-lg">Merci. Je vous reponds sous 48h ouvrees.</p>
				<a href="/" class="inline-block mt-8 bg-primary-foreground text-on-primary px-6 py-3 rounded-lg font-semibold hover:opacity-90 transition-opacity">
					Retour a l'accueil
				</a>
			</div>
		</div>
	</section>
	<script is:inline>
		(() => {
			if (window.umami && typeof window.umami.track === 'function') {
				window.umami.track('lead_success_contact_simple');
			}
		})();
	</script>
</Layout>
