---
import Layout from "../../layouts/Layout.astro";
import DiagnosticLeadCta from "../../components/DiagnosticLeadCta.astro";
---

<Layout
  title="Générateur de mentions légales cabinet | Outils Nicodev"
  description="Générez des mentions légales pour votre site de cabinet : éditeur, hébergeur, RGPD, cookies et informations obligatoires."
>
  <section class="section-y bg-slate-50">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-teal-700">Outil 4</p>
        <h1 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">
          Générateur de mentions légales pour cabinet
        </h1>
        <p class="mt-4 max-w-3xl text-slate-700">
          Renseignez les informations de votre cabinet et obtenez des mentions légales complètes,
          rédigées en français juridique clair, adaptées aux professionnels de santé et de la santé
          mentale en libéral (psychologue, psychomotricien, psychothérapeute, psychiatre) :
          identification de l&apos;éditeur, hébergement, propriété intellectuelle, responsabilité,
          RGPD (données de santé, article 9), cookies et droits des personnes.
        </p>
        <p class="mt-3 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
          Modèle indicatif fourni à titre informatif : il couvre les obligations usuelles (loi pour
          la confiance dans l&apos;économie numérique du 21 juin 2004, RGPD, loi Informatique et
          Libertés). Il ne constitue pas un avis juridique et ne remplace pas la validation par un
          professionnel du droit pour votre situation particulière.
        </p>
      </div>

      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <h2 class="text-xl font-bold text-slate-900">Informations du cabinet</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">Nom et prénom du praticien</span>
            <input
              id="ml-nom"
              type="text"
              placeholder="Ex. Marie Dupont"
              class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">Titre professionnel</span>
            <select id="ml-titre" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900">
              <option value="Psychologue">Psychologue</option>
              <option value="Psychomotricien">Psychomotricien</option>
              <option value="Psychothérapeute">Psychothérapeute</option>
              <option value="Psychiatre">Psychiatre</option>
            </select>
            <span id="ml-titre-aide" class="text-xs text-slate-500"></span>
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">Statut juridique</span>
            <select id="ml-statut" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900">
              <option value="Entrepreneur individuel (EI)">Entrepreneur individuel (EI)</option>
              <option value="Micro-entrepreneur">Micro-entrepreneur</option>
              <option value="EURL">EURL</option>
              <option value="SELARL">SELARL</option>
              <option value="Autre">Autre</option>
            </select>
          </label>

          <label class="flex flex-col gap-1.5">
            <span id="ml-numero-label" class="text-sm font-semibold text-slate-800">Numéro RPPS</span>
            <input
              id="ml-adeli"
              type="text"
              placeholder="Ex. 10009123456"
              class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
            />
            <span id="ml-numero-aide" class="text-xs text-slate-500"></span>
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">Numéro SIRET</span>
            <input
              id="ml-siret"
              type="text"
              placeholder="Ex. 123 456 789 00012"
              class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
            />
          </label>

          <div id="ml-societe-fields" class="contents">
            <label class="flex flex-col gap-1.5 sm:col-span-2">
              <span class="text-sm font-semibold text-slate-800">Dénomination sociale (si société)</span>
              <input
                id="ml-denomination"
                type="text"
                placeholder="Ex. Cabinet Horizon SELARL"
                class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
              />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-semibold text-slate-800">Capital social (si société)</span>
              <input
                id="ml-capital"
                type="text"
                placeholder="Ex. 5 000 €"
                class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
              />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="text-sm font-semibold text-slate-800">Ville du RCS (si société)</span>
              <input
                id="ml-rcs-ville"
                type="text"
                placeholder="Ex. Paris"
                class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
              />
            </label>
          </div>

          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-sm font-semibold text-slate-800">Adresse du cabinet</span>
            <input
              id="ml-adresse"
              type="text"
              placeholder="Ex. 12 rue de la Paix, 75002 Paris"
              class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">Téléphone de contact</span>
            <input
              id="ml-telephone"
              type="tel"
              placeholder="Ex. 01 23 45 67 89"
              class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">Email de contact</span>
            <input
              id="ml-email"
              type="email"
              placeholder="Ex. contact@cabinet-dupont.fr"
              class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
            />
          </label>

          <label class="flex flex-col gap-1.5 sm:col-span-2">
            <span class="text-sm font-semibold text-slate-800">Hébergeur du site</span>
            <input
              id="ml-hebergeur"
              type="text"
              placeholder="Ex. OVH SAS, 2 rue Kellermann, 59100 Roubaix — tél. 1007"
              class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">
              Le site collecte-t-il des données via un formulaire de contact ?
            </span>
            <select id="ml-formulaire" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900">
              <option value="oui">Oui</option>
              <option value="non">Non</option>
            </select>
            <span id="ml-formulaire-aide" class="text-xs text-slate-500"></span>
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">Mesure d&apos;audience du site</span>
            <select id="ml-cookies-audience" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900">
              <option value="aucune">Aucune</option>
              <option value="exemptee">Oui, sans cookie (ex. Umami, Matomo exempté)</option>
              <option value="consentement">Oui, avec cookies (ex. Google Analytics)</option>
            </select>
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">
              Contenus tiers intégrés au site (carte, vidéo embarquée…) ?
            </span>
            <select id="ml-cookies-tiers" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900">
              <option value="non">Non — uniquement des liens sortants (ex. Doctolib)</option>
              <option value="oui">Oui — iframe ou widget affiché sur le site</option>
            </select>
          </label>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-xl font-bold text-slate-900">Vos documents juridiques</h2>
          <div class="flex flex-wrap gap-3">
            <button
              id="ml-copier"
              type="button"
              class="inline-flex items-center rounded-lg bg-teal-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-teal-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2"
            >
              Copier le texte
            </button>
            <button
              id="ml-export-html"
              type="button"
              class="inline-flex items-center rounded-lg border border-teal-700 px-4 py-2 text-sm font-semibold text-teal-800 transition hover:bg-teal-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 focus-visible:ring-offset-2"
            >
              Exporter en HTML
            </button>
          </div>
        </div>
        <p
          id="ml-copie-info"
          class="mt-3 hidden rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900"
        >
        </p>
        <div
          id="ml-resultat"
          class="prose prose-slate mt-5 max-w-none rounded-lg border border-slate-200 bg-slate-50 px-5 py-4 text-sm leading-relaxed text-slate-800 sm:text-base"
        >
        </div>

        <DiagnosticLeadCta
          id="ml-post-generation-cta"
          variant="mentions-legales"
          class="mt-8 hidden"
          hidden
        />
      </div>

      <div class="mt-6 rounded-xl border border-slate-200 bg-white px-5 py-4 text-sm text-slate-600">
        Pensez aussi à publier une <strong>politique de confidentialité</strong> détaillée (liste
        des traceurs, durées, sous-traitants). Si des cookies soumis à consentement sont utilisés,
        mettez en place un bandeau conforme aux lignes directrices de la CNIL et bloquez les
        traceurs tant que l&apos;utilisateur n&apos;a pas accepté.
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const fields = {
      nom: document.getElementById("ml-nom"),
      titre: document.getElementById("ml-titre"),
      statut: document.getElementById("ml-statut"),
      adeli: document.getElementById("ml-adeli"),
      siret: document.getElementById("ml-siret"),
      adresse: document.getElementById("ml-adresse"),
      telephone: document.getElementById("ml-telephone"),
      email: document.getElementById("ml-email"),
      denomination: document.getElementById("ml-denomination"),
      capital: document.getElementById("ml-capital"),
      rcsVille: document.getElementById("ml-rcs-ville"),
      hebergeur: document.getElementById("ml-hebergeur"),
      formulaire: document.getElementById("ml-formulaire"),
      cookiesAudience: document.getElementById("ml-cookies-audience"),
      cookiesTiers: document.getElementById("ml-cookies-tiers"),
    };
    const resultEl = document.getElementById("ml-resultat");
    const copyBtn = document.getElementById("ml-copier");
    const exportBtn = document.getElementById("ml-export-html");
    const titleHelpEl = document.getElementById("ml-titre-aide");
    const numberLabelEl = document.getElementById("ml-numero-label");
    const numberHelpEl = document.getElementById("ml-numero-aide");
    const formHelpEl = document.getElementById("ml-formulaire-aide");
    const societeFieldsEl = document.getElementById("ml-societe-fields");

    if (
      !resultEl ||
      !copyBtn ||
      !exportBtn ||
      !titleHelpEl ||
      !numberLabelEl ||
      !numberHelpEl ||
      !formHelpEl ||
      !societeFieldsEl ||
      Object.values(fields).some((el) => !el)
    ) {
      return;
    }

    const escapeHtml = (value) =>
      value
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");

    const valueOr = (input, fallback) => {
      const v = input.value.trim();
      return escapeHtml(v === "" ? fallback : v);
    };

    const rawValue = (input) => input.value.trim();

    const titleUiConfigs = {
      Psychologue: {
        numberLabel: "Numéro RPPS",
        numberPlaceholder: "Ex. 10009123456",
        numberHelp:
          "Renseignez votre numéro RPPS tel qu'utilisé pour votre identification professionnelle.",
        titleHelp:
          "Le texte généré emploie des formulations prudentes adaptées à l'usage du titre de psychologue.",
        formHelp:
          "Si vous utilisez un formulaire, invitez les patients à ne pas y décrire leur situation psychologique en détail.",
      },
      Psychomotricien: {
        numberLabel: "Numéro RPPS",
        numberPlaceholder: "Ex. 10009123456",
        numberHelp:
          "Renseignez votre numéro RPPS tel qu'utilisé pour votre identification professionnelle.",
        titleHelp:
          "Le texte généré rappelle le caractère réglementé de la profession et son rattachement au Code de la santé publique.",
        formHelp:
          "Si vous utilisez un formulaire, limitez les informations demandées au strict nécessaire pour une première prise de contact.",
      },
      Psychothérapeute: {
        numberLabel: "Numéro professionnel / RPPS",
        numberPlaceholder: "Ex. 10009123456",
        numberHelp:
          "Renseignez votre numéro RPPS si vous en disposez et l'utilisez dans votre communication professionnelle ; à défaut, adaptez le texte exporté à votre situation.",
        titleHelp:
          "Le texte généré rappelle l'inscription au registre national des psychothérapeutes.",
        formHelp:
          "En présence d'un formulaire, évitez toute collecte de détails médicaux ou psychologiques non indispensables.",
      },
      Psychiatre: {
        numberLabel: "Numéro RPPS",
        numberPlaceholder: "Ex. 10009123456",
        numberHelp:
          "Renseignez votre numéro RPPS de médecin.",
        titleHelp:
          "Le texte généré mentionne l'inscription à l'Ordre des médecins et le cadre déontologique médical.",
        formHelp:
          "Si vous utilisez un formulaire, veillez à ne collecter que les éléments nécessaires à l'orientation de la demande.",
      },
    };

    const titreConfigs = {
      Psychologue: {
        inscription: (nom, rpps) =>
          `Le présent site est édité par ${nom}, psychologue exerçant à titre libéral et référencé(e) au Répertoire partagé des professionnels de santé (RPPS) sous le numéro ${rpps}.`,
        titreProtege:
          "Le titre de psychologue est un titre protégé par la loi. Son usage est réservé aux personnes remplissant les conditions légales de diplôme et d'usage professionnel du titre, et disposant des enregistrements administratifs applicables.",
        cadreReglementaire:
          "Le psychologue exerce dans le respect des textes encadrant l'usage du titre de psychologue ainsi que des règles déontologiques applicables à sa profession.",
        responsabilite:
          "Les informations diffusées sur ce site le sont à titre purement informatif. Elles ne constituent en aucun cas une consultation, un avis psychologique individualisé, ni un diagnostic. Elles ne sauraient se substituer à une consultation auprès d'un psychologue ou d'un autre professionnel compétent.",
        urgence:
          "En cas d'urgence ou de détresse psychologique aiguë, il convient de contacter le 15 (SAMU), le 112 ou le 3114 (numéro national de prévention du suicide, gratuit, 24 h/24).",
        rgpdSante:
          "Attention particulière relative aux données sensibles : les informations communiquées dans le cadre d'une prise de contact avec un psychologue peuvent révéler, directement ou indirectement, des éléments relatifs à la santé ou à la vie personnelle de la personne concernée. Lorsqu'elles relèvent de l'article 9 du RGPD, ces données bénéficient d'une protection renforcée. Il est recommandé de ne pas détailler votre situation médicale ou psychologique dans un message en ligne et de réserver ces échanges au cadre confidentiel de la consultation.",
        confidentialite:
          (nom) => `Les données éventuellement recueillies sont traitées avec une obligation particulière de confidentialité, dans le respect des règles légales applicables, de l'article 226-13 du Code pénal lorsqu'il trouve à s'appliquer, ainsi que des règles déontologiques attachées à l'exercice professionnel de ${nom}.`,
      },
      Psychomotricien: {
        inscription: (nom, rpps) =>
          `Le présent site est édité par ${nom}, psychomotricien exerçant à titre libéral, inscrit(e) au Répertoire partagé des professionnels de santé (RPPS) sous le numéro ${rpps}.`,
        titreProtege:
          "Le titre de psychomotricien est un titre protégé par la loi. Son usage est réservé aux titulaires du diplôme d'État de psychomotricien disposant des enregistrements administratifs applicables.",
        cadreReglementaire:
          "Le psychomotricien exerce une profession réglementée relevant du Code de la santé publique et intervient dans le respect des règles professionnelles applicables à sa profession.",
        responsabilite:
          "Les informations diffusées sur ce site le sont à titre purement informatif. Elles ne constituent en aucun cas une consultation, un avis thérapeutique, un bilan psychomoteur en ligne, ni un diagnostic. Elles ne sauraient se substituer à une prise en charge auprès d'un psychomotricien ou d'un autre professionnel de santé.",
        urgence:
          "En cas d'urgence médicale, il convient de contacter le 15 (SAMU) ou le 112. En cas de détresse psychologique, le 3114 (numéro national de prévention du suicide, gratuit, 24 h/24) est également disponible.",
        rgpdSante:
          "Attention particulière relative aux données de santé : les informations communiquées dans le cadre d'une prise de contact avec un professionnel de santé peuvent révéler, directement ou indirectement, des données concernant la santé, qui constituent des données sensibles au sens de l'article 9 du RGPD. Il est recommandé de ne pas détailler votre situation médicale dans un message en ligne et de réserver ces échanges au cadre confidentiel de la consultation.",
        confidentialite:
          (nom) => `Les données éventuellement recueillies sont en outre couvertes par le secret professionnel auquel est tenu(e) ${nom} en application des textes régissant la profession et de l'article 226-13 du Code pénal.`,
      },
      Psychothérapeute: {
        inscription: (nom, rpps) =>
          `Le présent site est édité par ${nom}, psychothérapeute exerçant à titre libéral, inscrit(e) au registre national des psychothérapeutes et au Répertoire partagé des professionnels de santé (RPPS) sous le numéro ${rpps}.`,
        titreProtege:
          "L'usage du titre de psychothérapeute est réservé aux professionnels inscrits au registre national des psychothérapeutes, conformément aux textes en vigueur.",
        cadreReglementaire:
          "Le professionnel déclare exercer dans le respect du cadre légal propre à l'usage du titre de psychothérapeute et des règles déontologiques applicables à son exercice.",
        responsabilite:
          "Les informations diffusées sur ce site le sont à titre purement informatif. Elles ne constituent en aucun cas une consultation, un avis thérapeutique ou psychologique, ni un diagnostic. Elles ne sauraient se substituer à une prise en charge auprès d'un psychothérapeute ou d'un autre professionnel de santé.",
        urgence:
          "En cas d'urgence ou de détresse psychologique aiguë, il convient de contacter le 15 (SAMU), le 112 ou le 3114 (numéro national de prévention du suicide, gratuit, 24 h/24).",
        rgpdSante:
          "Attention particulière relative aux données de santé : les informations communiquées dans le cadre d'une prise de contact avec un professionnel de la santé mentale peuvent révéler, directement ou indirectement, des données concernant la santé, qui constituent des données sensibles au sens de l'article 9 du RGPD. Il est recommandé de ne pas détailler votre situation médicale ou psychologique dans un message en ligne et de réserver ces échanges au cadre confidentiel de la consultation.",
        confidentialite:
          (nom) => `Les données éventuellement recueillies sont traitées avec une obligation particulière de confidentialité dans le respect des règles légales et déontologiques applicables à l'exercice professionnel de ${nom}.`,
      },
      Psychiatre: {
        inscription: (nom, rpps) =>
          `Le présent site est édité par ${nom}, médecin psychiatre exerçant à titre libéral, inscrit(e) à l'Ordre des médecins et au Répertoire partagé des professionnels de santé (RPPS) sous le numéro ${rpps}.`,
        titreProtege:
          "Le titre de médecin psychiatre est un titre protégé. Son exercice est réservé aux médecins inscrits au tableau de l'Ordre des médecins et titulaires d'une spécialité ou d'une qualification en psychiatrie.",
        cadreReglementaire:
          "Le médecin psychiatre exerce dans le respect du Code de la santé publique et des règles déontologiques applicables à la profession médicale.",
        responsabilite:
          "Les informations diffusées sur ce site le sont à titre purement informatif. Elles ne constituent en aucun cas une consultation médicale, un avis médical ou un diagnostic. Elles ne sauraient se substituer à une consultation auprès d'un médecin psychiatre ou d'un autre professionnel de santé.",
        urgence:
          "En cas d'urgence ou de détresse psychologique aiguë, il convient de contacter le 15 (SAMU), le 112 ou le 3114 (numéro national de prévention du suicide, gratuit, 24 h/24).",
        rgpdSante:
          "Attention particulière relative aux données de santé : les informations communiquées dans le cadre d'une prise de contact avec un professionnel de la santé mentale peuvent révéler, directement ou indirectement, des données concernant la santé, qui constituent des données sensibles au sens de l'article 9 du RGPD. Il est recommandé de ne pas détailler votre situation médicale ou psychologique dans un message en ligne et de réserver ces échanges au cadre confidentiel de la consultation.",
        confidentialite:
          (nom) => `Les données éventuellement recueillies sont en outre couvertes par le secret professionnel auquel est tenu(e) ${nom} en application des textes régissant la profession et de l'article 226-13 du Code pénal.`,
      },
    };

    const isSocieteStatut = (statut) => ["EURL", "SELARL"].includes(statut);

    const updateSocieteFieldsVisibility = () => {
      const visible = isSocieteStatut(fields.statut.value);
      societeFieldsEl.classList.toggle("hidden", !visible);
      if (!visible) {
        fields.denomination.value = "";
        fields.capital.value = "";
        fields.rcsVille.value = "";
      }
    };

    const updateProfessionUi = () => {
      const config = titleUiConfigs[fields.titre.value] || titleUiConfigs.Psychologue;
      numberLabelEl.textContent = config.numberLabel;
      fields.adeli.placeholder = config.numberPlaceholder;
      numberHelpEl.textContent = config.numberHelp;
      titleHelpEl.textContent = config.titleHelp;
      formHelpEl.textContent = config.formHelp;
    };

    const buildCookiesParagraphs = (hebergeur, audience, embedsTiers) => {
      const paragraphs = [
        "Lors de votre navigation, des cookies ou autres traceurs peuvent être déposés ou lus sur votre terminal (ordinateur, tablette, smartphone). Un cookie est un petit fichier texte enregistré par votre navigateur, permettant notamment de mémoriser des préférences ou de mesurer l'audience du site.",
        "Conformément à l'article 82 de la loi n° 78-17 du 6 janvier 1978 modifiée (loi Informatique et Libertés) et aux recommandations de la CNIL, les cookies et traceurs sont classés selon leur finalité. Seuls les cookies strictement nécessaires au fonctionnement du site peuvent être déposés sans consentement préalable.",
        `Cookies strictement nécessaires : ils assurent le bon fonctionnement technique du site (session, sécurité, mémorisation de vos choix de consentement le cas échéant). Ils ne nécessitent pas votre accord préalable. Des journaux techniques peuvent également être traités par l'hébergeur (${hebergeur}) pour la sécurité, la disponibilité du service et la prévention des abus ; ces traitements relèvent de l'intérêt légitime et ne servent pas au suivi publicitaire.`,
      ];

      if (audience === "exemptee") {
        paragraphs.push(
          "Mesure d'audience : le site utilise un outil de mesure d'audience configuré pour produire des statistiques agrégées de fréquentation (pages consultées, type d'appareil, provenance approximative), dans une finalité strictement interne d'amélioration du site. Cette mesure est mise en œuvre sans cookie publicitaire ni profilage marketing, et sans finalité de suivi de votre navigation sur d'autres sites. Sous réserve de la configuration effectivement retenue, elle peut ne pas nécessiter de bandeau de consentement.",
        );
      } else if (audience === "consentement") {
        paragraphs.push(
          "Mesure d'audience soumise au consentement : le site utilise un outil de mesure d'audience déposant des cookies ou traceurs (par exemple Google Analytics). Finalité : établir des statistiques de fréquentation et comprendre l'usage du site. Base légale : votre consentement (article 82 de la loi Informatique et Libertés). Durée maximale de conservation des cookies de mesure d'audience : treize mois à compter de leur dépôt. Destinataire : l'éditeur du site et, le cas échéant, le prestataire d'analyse (par exemple Google LLC pour Google Analytics — consultez sa politique de confidentialité : policies.google.com/privacy).",
        );
      } else {
        paragraphs.push(
          "Mesure d'audience : aucun outil de mesure d'audience déposant des cookies ou traceurs soumis au consentement n'est utilisé sur le site.",
        );
      }

      if (embedsTiers) {
        paragraphs.push(
          "Contenus tiers intégrés : le site affiche des contenus ou services fournis par des tiers directement dans ses pages (par exemple carte interactive, lecteur vidéo embarqué, widget de formulaire hébergé par un tiers). Lorsque vous consultez une page comportant ces éléments, le tiers concerné peut déposer des cookies ou traceurs sur votre terminal. Ces dépôts ne doivent intervenir qu'après recueil de votre consentement, sauf si le traceur relève de l'exemption « strictement nécessaire » au sens de la CNIL. Les conditions de traitement des données par ces tiers sont régies par leurs propres politiques de confidentialité.",
        );
      } else {
        paragraphs.push(
          "Contenus tiers intégrés : aucun contenu intégré au site (iframe, widget, lecteur vidéo embarqué, carte interactive) susceptible de déposer des cookies de tiers n'est présent sur les pages.",
        );
      }

      paragraphs.push(
        "Liens vers des sites externes : le site peut proposer des liens ou boutons renvoyant vers des plateformes tierces (par exemple Doctolib, Maiia ou tout autre service de prise de rendez-vous en ligne). Il s'agit de simples hyperliens : aucun cookie ni traceur de ces plateformes n'est déposé sur le présent site tant que vous n'avez pas cliqué sur le lien et accédé au service concerné. Une fois redirigé(e), les cookies et la politique de confidentialité du site externe s'appliquent exclusivement sur la plateforme visitée.",
      );

      const needsConsentBanner = audience === "consentement" || embedsTiers;
      if (needsConsentBanner) {
        paragraphs.push(
          "Gestion du consentement : lors de votre première visite, un bandeau vous informe de la présence de cookies soumis à consentement et vous permet d'accepter, de refuser ou de paramétrer vos choix par finalité. Votre consentement est recueilli avant tout dépôt de traceur non exempté. Vous pouvez à tout moment retirer votre consentement ou modifier vos préférences via le module de gestion des cookies accessible en pied de page ou via le bandeau. Le choix exprimé par l'utilisateur (acceptation ou refus) a vocation à être conservé pour une durée limitée, en principe de six mois, avant qu'un nouveau recueil puisse être proposé. Les cookies de mesure d'audience soumis à consentement, lorsqu'ils sont utilisés, ne doivent pas être conservés au-delà de treize mois.",
        );
      } else {
        paragraphs.push(
          "Bandeau de consentement : dans la configuration décrite ci-dessus, aucun cookie ou traceur soumis au consentement préalable n'est déposé. Aucun bandeau de consentement n'est donc affiché. Si des outils soumis au consentement venaient à être ajoutés ultérieurement, un bandeau conforme aux lignes directrices de la CNIL devra être mis en place avant leur activation.",
        );
      }

      paragraphs.push(
        "Paramétrage de votre navigateur : vous pouvez à tout moment configurer votre navigateur pour accepter ou refuser les cookies, les supprimer ou être alerté(e) de leur dépôt. Le refus de certains cookies peut toutefois dégrader certaines fonctionnalités du site. Pour en savoir plus sur les cookies et les moyens de les limiter, consultez le site de la CNIL : www.cnil.fr/fr/cookies-et-autres-traceurs.",
        "Pour une description détaillée des traceurs utilisés, de leurs finalités, de leurs durées de conservation et des sous-traitants concernés, reportez-vous à la politique de confidentialité du site, document complémentaire aux présentes mentions légales.",
      );

      return paragraphs;
    };

    const buildDocuments = () => {
      const nom = valueOr(fields.nom, "[Nom et prénom du praticien]");
      const titreKey = fields.titre.value;
      const config = titreConfigs[titreKey] || titreConfigs.Psychologue;
      const statut = escapeHtml(fields.statut.value);
      const adeli = valueOr(fields.adeli, "[Numéro RPPS]");
      const siret = valueOr(fields.siret, "[Numéro SIRET]");
      const denomination = valueOr(fields.denomination, "[Dénomination sociale]");
      const capital = valueOr(fields.capital, "[Capital social]");
      const rcsVille = valueOr(fields.rcsVille, "[Ville du RCS]");
      const adresse = valueOr(fields.adresse, "[Adresse du cabinet]");
      const telephone = valueOr(fields.telephone, "[Numéro de téléphone]");
      const email = valueOr(fields.email, "[Email de contact]");
      const hebergeur = valueOr(fields.hebergeur, "[Nom et coordonnées de l'hébergeur]");
      const aFormulaire = fields.formulaire.value === "oui";
      const audienceCookies = fields.cookiesAudience.value;
      const embedsTiers = fields.cookiesTiers.value === "oui";
      const statutRaw = rawValue(fields.statut);
      const isSociete = isSocieteStatut(statutRaw);

      const sections = [];

      const mentionsLegales = [
        {
          titre: "1. Identification de l'éditeur du site",
          paragraphes: [
            `${config.inscription(nom, adeli)} Statut juridique : ${statut}. SIRET : ${siret}.`,
            ...(isSociete
              ? [
                  `La structure d'exercice est : ${denomination}. Siège social : ${adresse}. Capital social : ${capital}. Immatriculation : RCS ${rcsVille}.`,
                ]
              : []),
            `Adresse professionnelle : ${adresse}.`,
            `Téléphone : ${telephone}.`,
            `Adresse électronique de contact : ${email}.`,
            `Directeur de la publication : ${nom}.`,
            config.titreProtege,
            config.cadreReglementaire,
          ],
        },
        {
          titre: "2. Hébergement",
          paragraphes: [
            `Le site est hébergé par : ${hebergeur}.`,
            `Conformément à l'article 6 de la loi n° 2004-575 du 21 juin 2004 pour la confiance dans l'économie numérique (LCEN), l'hébergeur assure le stockage du site ; il peut être contacté pour toute question relative à cette prestation aux coordonnées indiquées ci-dessus.`,
          ],
        },
        {
          titre: "3. Propriété intellectuelle",
          paragraphes: [
            `L'ensemble des éléments composant le présent site (textes, images, graphismes, logo, structure, mise en forme) est protégé par les dispositions du Code de la propriété intellectuelle. Sauf mention contraire, ces éléments sont la propriété exclusive de ${nom}.`,
            `Toute reproduction, représentation, modification ou diffusion, totale ou partielle, du site ou de son contenu, par quelque procédé que ce soit et sur quelque support que ce soit, est interdite sans l'autorisation écrite et préalable de l'éditeur. Toute utilisation non autorisée est susceptible de constituer une contrefaçon sanctionnée par les articles L.335-2 et suivants du Code de la propriété intellectuelle.`,
          ],
        },
        {
          titre: "4. Responsabilité et limites",
          paragraphes: [
            config.responsabilite,
            config.urgence,
            `L'éditeur s'efforce d'assurer l'exactitude et la mise à jour des informations publiées, sans toutefois pouvoir en garantir l'exhaustivité ou l'absence d'erreur. Sa responsabilité ne saurait être engagée en cas d'inexactitude, d'omission ou d'indisponibilité temporaire du site.`,
            `Le site peut contenir des liens vers des sites tiers. L'éditeur n'exerce aucun contrôle sur leur contenu et décline toute responsabilité à leur égard.`,
          ],
        },
      ];

      const confidentialite = [];

      const rgpd = [
        `Le traitement des données à caractère personnel effectué à partir de ce site est régi par le règlement (UE) 2016/679 du 27 avril 2016 (RGPD) et par la loi n° 78-17 du 6 janvier 1978 modifiée, dite « Informatique et Libertés ». Le responsable du traitement est ${nom}, joignable à l'adresse ${email}.`,
      ];
      if (aFormulaire) {
        rgpd.push(
          `Le site met à disposition un formulaire de contact. Les données ainsi collectées (identité, coordonnées, contenu du message) sont traitées à la seule fin de répondre aux sollicitations adressées au cabinet, sur le fondement des mesures précontractuelles prises à la demande de la personne concernée (article 6, paragraphe 1, b, du RGPD) et, selon les cas, de l'intérêt légitime du cabinet à traiter les demandes entrantes (article 6, paragraphe 1, f). Les personnes sont invitées à ne pas transmettre, via ce formulaire, d'informations inutiles ou détaillées relatives à leur état de santé. Si des données relevant de l'article 9 du RGPD sont néanmoins communiquées de manière volontaire dans le message, elles sont traitées uniquement dans la mesure nécessaire à l'examen et au traitement de la demande. Les données sont destinées exclusivement à ${nom}, ne font l'objet d'aucune cession à des tiers et sont conservées pendant une durée maximale de douze mois à compter du dernier contact, sauf ouverture d'un suivi thérapeutique ou obligation légale particulière.`,
        );
      } else {
        rgpd.push(
          `Le site ne comporte pas de formulaire de collecte de données : aucune donnée à caractère personnel n'est recueillie par son intermédiaire. Les seules données susceptibles d'être traitées sont celles que vous transmettez volontairement par courriel ou par téléphone, à la seule fin de répondre à votre demande.`,
        );
      }
      rgpd.push(
        config.rgpdSante,
        config.confidentialite(nom),
      );
      confidentialite.push({
        titre: "1. Données personnelles et finalités",
        paragraphes: rgpd,
      });

      confidentialite.push({
        titre: "2. Exercice des droits",
        paragraphes: [
          `Conformément aux articles 15 à 22 du RGPD, vous disposez d'un droit d'accès, de rectification, d'effacement et, lorsque les conditions légales sont réunies, d'un droit à la portabilité de vos données, ainsi que d'un droit d'opposition et de limitation du traitement. Vous pouvez également définir des directives relatives au sort de vos données après votre décès.`,
          `Ces droits s'exercent auprès de ${nom}, par courriel à l'adresse ${email} ou par courrier à l'adresse suivante : ${adresse}. Une réponse vous sera adressée dans un délai d'un mois à compter de la réception de la demande ; un justificatif d'identité pourra être demandé en cas de doute raisonnable sur l'identité du demandeur.`,
          `Si vous estimez, après avoir contacté le cabinet, que vos droits ne sont pas respectés, vous pouvez adresser une réclamation à la Commission nationale de l'informatique et des libertés (CNIL), 3 place de Fontenoy, TSA 80715, 75334 Paris Cedex 07 — www.cnil.fr.`,
        ],
      });

      const cookies = [
        {
          titre: "1. Cookies et traceurs",
          paragraphes: buildCookiesParagraphs(hebergeur, audienceCookies, embedsTiers),
        },
      ];

      return [
        { titre: "Mentions légales", sections: mentionsLegales },
        { titre: "Politique de confidentialité", sections: confidentialite },
        { titre: "Politique de cookies", sections: cookies },
      ];
    };

    const postGenerationCta = document.getElementById("ml-post-generation-cta");

    const revealPostGenerationCta = () => {
      if (!(postGenerationCta instanceof HTMLElement)) return;
      postGenerationCta.classList.remove("hidden");
      postGenerationCta.removeAttribute("hidden");
    };

    const render = () => {
      const documents = buildDocuments();
      resultEl.innerHTML = documents
        .map(
          (document) =>
            `<h2 class="mt-6 first:mt-0 text-lg font-extrabold text-slate-900 sm:text-xl">${document.titre}</h2>` +
            document.sections
              .map(
                (section) =>
                  `<h3 class="mt-5 text-base font-bold text-slate-900 sm:text-lg">${section.titre}</h3>` +
                  section.paragraphes.map((p) => `<p class="mt-2 text-slate-800">${p}</p>`).join(""),
              )
              .join(""),
        )
        .join("");
      revealPostGenerationCta();
    };

    const buildPlainText = () => {
      const documents = buildDocuments();
      const decode = (html) => {
        const tmp = document.createElement("textarea");
        tmp.innerHTML = html;
        return tmp.value;
      };
      return documents
        .map(
          (document) =>
            decode(document.titre) +
            "\n\n" +
            document.sections
              .map((s) => decode(s.titre) + "\n\n" + s.paragraphes.map(decode).join("\n\n"))
              .join("\n\n"),
        )
        .join("\n\n");
    };

    const copyInfoEl = document.getElementById("ml-copie-info");

    const fieldLabels = {
      nom: "Nom et prénom du praticien",
      adeli: "Numéro professionnel",
      siret: "Numéro SIRET",
      adresse: "Adresse du cabinet",
      telephone: "Téléphone de contact",
      email: "Email de contact",
      hebergeur: "Hébergeur du site",
      denomination: "Dénomination sociale",
      capital: "Capital social",
      rcsVille: "Ville du RCS",
    };

    const missingFields = () => {
      const required = ["nom", "adeli", "siret", "adresse", "telephone", "email", "hebergeur"];
      if (isSocieteStatut(fields.statut.value)) {
        required.push("denomination", "capital", "rcsVille");
      }
      return required.filter((key) => fields[key].value.trim() === "").map((key) => fieldLabels[key]);
    };

    const showCopyInfo = (message) => {
      if (!copyInfoEl) return;
      copyInfoEl.textContent = message;
      copyInfoEl.classList.remove("hidden");
    };

    const hideCopyInfo = () => {
      copyInfoEl?.classList.add("hidden");
    };

    const copyToClipboard = async (text) => {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        let ok = false;
        try {
          ok = document.execCommand("copy");
        } catch {
          ok = false;
        }
        textarea.remove();
        return ok;
      }
    };

    copyBtn.addEventListener("click", async () => {
      const missing = missingFields();
      if (missing.length > 0) {
        showCopyInfo(
          `Copie impossible : tous les champs ne sont pas renseignés. Complétez d'abord : ${missing.join(", ")}.`,
        );
        return;
      }

      const original = "Copier le texte";
      if (await copyToClipboard(buildPlainText())) {
        hideCopyInfo();
        copyBtn.textContent = "Copié !";
        setTimeout(() => {
          copyBtn.textContent = original;
        }, 2000);
      } else {
        showCopyInfo(
          "La copie automatique a été bloquée par votre navigateur. Sélectionnez le texte ci-dessous puis copiez-le manuellement (Ctrl + C).",
        );
      }
    });

    const onFieldUpdate = () => {
      updateProfessionUi();
      updateSocieteFieldsVisibility();
      render();
      if (missingFields().length === 0) {
        hideCopyInfo();
      }
    };

    const buildHtmlDocument = () => {
      const documents = buildDocuments();
      const body = documents
        .map(
          (document) =>
            `    <h2>${document.titre}</h2>\n` +
            document.sections
              .map(
                (section) =>
                  `    <h3>${section.titre}</h3>\n` +
                  section.paragraphes.map((p) => `    <p>${p}</p>`).join("\n"),
              )
              .join("\n"),
        )
        .join("\n");
      return `<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Documents juridiques du site</title>
  <style>
    body { font-family: Georgia, "Times New Roman", serif; max-width: 50rem; margin: 2rem auto; padding: 0 1.25rem; line-height: 1.6; color: #1e293b; }
    h1 { font-size: 1.75rem; }
    h2 { font-size: 1.2rem; margin-top: 2rem; }
  </style>
</head>
<body>
  <main>
    <h1>Mentions légales</h1>
${body}
  </main>
</body>
</html>
`;
    };

    exportBtn.addEventListener("click", () => {
      const missing = missingFields();
      if (missing.length > 0) {
        showCopyInfo(
          `Export impossible : tous les champs ne sont pas renseignés. Complétez d'abord : ${missing.join(", ")}.`,
        );
        return;
      }
      hideCopyInfo();
      const blob = new Blob([buildHtmlDocument()], { type: "text/html;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = "mentions-legales.html";
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    });

    Object.values(fields).forEach((el) => {
      el.addEventListener("input", onFieldUpdate);
      el.addEventListener("change", onFieldUpdate);
    });
    updateProfessionUi();
    updateSocieteFieldsVisibility();
    render();
  })();
</script>
