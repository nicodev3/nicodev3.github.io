---
import Layout from "../../layouts/Layout.astro";

const contributionRates = {
  socialPlusCfp: 0.234,
  socialCfpAndLiberatoryTax: 0.256,
};

const toolUrl = "https://nicodev.fr/outils/micro-bnc-auto-entrepreneur/";
const webApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Calculateur micro-BNC pour psychologue",
  description:
    "Calculateur gratuit pour estimer la recette nette d'un psychologue en micro-BNC selon son tarif, son activité et ses prélèvements.",
  url: toolUrl,
  applicationCategory: "BusinessApplication",
  applicationSubCategory: "Calculateur financier",
  operatingSystem: "Tous",
  browserRequirements: "JavaScript activé",
  isAccessibleForFree: true,
  inLanguage: "fr-FR",
  dateModified: "2026-08-16",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "EUR",
  },
  provider: {
    "@type": "Person",
    name: "Nicolas Devaux",
    url: "https://nicodev.fr/about/",
  },
};
---

<Layout
  title="Calculateur micro-BNC psychologue | Outils Nicodev"
  description="Calculez votre recette nette en micro-BNC ou auto-entrepreneur selon votre tarif de séance, vos cotisations URSSAF et votre activité."
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(webApplicationSchema)} />
  <section class="section-y bg-slate-50">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-teal-700">Outil 1</p>
        <h1 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">
          Calculateur micro-BNC / auto-entrepreneur
        </h1>
        <p class="mt-4 max-w-3xl text-slate-700">
          Estimez votre recette nette après URSSAF à partir du tarif d&apos;une séance.
          Comparez les deux cas utiles en micro-entreprise : sans versement libératoire et avec
          versement libératoire.
        </p>
        <p class="mt-3 rounded-lg border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
          Paramètres du simulateur : <strong>23,4 %</strong> (cotisations + CFP 0,2 %) et
          <strong> 25,6 % </strong> (cotisations + CFP + versement libératoire 2,2 %). La CFP est
          intégrée car elle est obligatoire en micro-entreprise. Source taux de cotisations sociales :
          URSSAF.
        </p>
      </div>

      <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">Tarif d&apos;une séance (EUR)</span>
            <input
              id="session-price"
              type="number"
              min="1"
              step="1"
              value="60"
              class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-semibold text-slate-800">Mode de prélèvement</span>
            <select id="social-rate" class="rounded-lg border border-slate-300 px-3 py-2 text-slate-900">
              <option value={contributionRates.socialPlusCfp.toString()}>
                Sans versement libératoire (23,4 %)
              </option>
              <option value={contributionRates.socialCfpAndLiberatoryTax.toString()}>
                Avec versement libératoire IR (25,6 %)
              </option>
            </select>
          </label>
        </div>

        <div class="mt-6 rounded-lg border border-teal-200 bg-teal-50 px-4 py-4">
          <p class="text-sm text-teal-950 sm:text-base">
            Recette nette estimée par séance :
            <strong id="net-per-session" class="font-semibold">0 EUR</strong>
          </p>
          <p class="mt-1 text-xs text-teal-900 sm:text-sm">
            Hypothèse de calcul mensuel : 4 semaines par mois.
          </p>
          <p class="mt-1 text-xs text-teal-900 sm:text-sm">
            Contrôle du plafond micro-BNC : 77 000 EUR de CA annuel (hypothèse annuelle : 44 semaines
            travaillées, soit 8 semaines de congés).
          </p>
        </div>

        <p class="mt-6 flex items-center gap-1.5 text-xs text-slate-500 sm:hidden" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0-4-4m4 4-4 4M16 17H4m0 0 4 4m-4-4 4-4"/></svg>
          Glissez pour voir toutes les colonnes
        </p>
        <div class="mt-2 overflow-x-auto rounded-lg border border-slate-200 sm:mt-6" style="hyphens:none;-webkit-hyphens:none">
          <table class="min-w-full border-collapse whitespace-nowrap text-left text-sm">
            <thead>
              <tr class="border-b border-slate-200 bg-slate-50">
                <th class="px-3 py-2 font-semibold text-slate-900">Séances / semaine</th>
                <th class="px-3 py-2 font-semibold text-slate-900">Séances / mois (x4)</th>
                <th class="px-3 py-2 font-semibold text-slate-900">CA brut mensuel</th>
                <th class="px-3 py-2 font-semibold text-slate-900">Prélèvements mensuels</th>
                <th class="px-3 py-2 font-semibold text-slate-900">Recette nette mensuelle</th>
                <th class="px-3 py-2 font-semibold text-slate-900">CA annuel (44 sem.)</th>
                <th class="px-3 py-2 font-semibold text-slate-900">Plafond 77 000 EUR</th>
              </tr>
            </thead>
            <tbody id="results-table-body"></tbody>
          </table>
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-slate-200 bg-white px-5 py-4 text-sm text-slate-600">
        Estimation informative : le calcul ne remplace pas un conseil comptable ou fiscal personnalisé.
      </div>

      <aside class="mt-6 rounded-xl border border-teal-200 bg-teal-50 px-5 py-5 text-sm leading-relaxed text-teal-950">
        <h2 class="text-lg font-bold">Passer de l’estimation au projet de cabinet</h2>
        <p class="mt-2">
          Pour interpréter le résultat, consultez les fourchettes de{' '}
          <a href="/blog/salaire-psychologue-liberal/" class="font-semibold underline underline-offset-2"
            >salaire d’un psychologue libéral</a
          > et le comparatif entre{' '}
          <a href="/blog/statut-juridique-psychologue-liberal/" class="font-semibold underline underline-offset-2"
            >micro-BNC et régime réel</a
          >. Le{' '}
          <a href="/blog/installer-liberal-psychologue-par-ou-commencer/" class="font-semibold underline underline-offset-2"
            >guide pour ouvrir un cabinet de psychologue</a
          > replace ensuite le calcul dans l’ordre complet des démarches.
        </p>
      </aside>
    </div>
  </section>
</Layout>

<script is:inline>
  (() => {
    const priceInput = document.getElementById("session-price");
    const rateSelect = document.getElementById("social-rate");
    const tableBody = document.getElementById("results-table-body");
    const netPerSessionEl = document.getElementById("net-per-session");

    if (
      !(priceInput instanceof HTMLInputElement) ||
      !(rateSelect instanceof HTMLSelectElement) ||
      !(tableBody instanceof HTMLElement) ||
      !(netPerSessionEl instanceof HTMLElement)
    ) {
      return;
    }

    const weeklyScenarios = [5, 8, 10, 12, 15, 20, 25, 30];
    const annualWeeksWorked = 44;
    const microBncCeiling = 77000;
    const eur = new Intl.NumberFormat("fr-FR", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 2,
    });

    const toPositiveNumber = (raw, fallback) => {
      const parsed = Number(raw);
      if (!Number.isFinite(parsed) || parsed <= 0) {
        return fallback;
      }
      return parsed;
    };

    const render = () => {
      const sessionPrice = toPositiveNumber(priceInput.value, 60);
      const totalRate = toPositiveNumber(rateSelect.value, 0.234);
      const netPerSession = sessionPrice * (1 - totalRate);

      netPerSessionEl.textContent = eur.format(netPerSession);
      tableBody.innerHTML = weeklyScenarios
        .map((sessionsPerWeek) => {
          const sessionsPerMonth = sessionsPerWeek * 4;
          const gross = sessionPrice * sessionsPerMonth;
          const deductions = gross * totalRate;
          const net = gross - deductions;
          const annualGross = sessionPrice * sessionsPerWeek * annualWeeksWorked;
          const exceedsCeiling = annualGross > microBncCeiling;
          const ceilingBadge = exceedsCeiling
            ? '<span class="inline-flex rounded-full bg-rose-100 px-2 py-0.5 text-xs font-semibold text-rose-800">Depasse</span>'
            : '<span class="inline-flex rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-800">OK</span>';

          return `<tr class="border-b border-slate-100 last:border-b-0">
            <td class="px-3 py-2 font-medium text-slate-900">${sessionsPerWeek}</td>
            <td class="px-3 py-2 text-slate-700">${sessionsPerMonth}</td>
            <td class="px-3 py-2 text-slate-700">${eur.format(gross)}</td>
            <td class="px-3 py-2 text-slate-700">${eur.format(deductions)}</td>
            <td class="px-3 py-2 font-semibold text-slate-900">${eur.format(net)}</td>
            <td class="px-3 py-2 text-slate-700">${eur.format(annualGross)}</td>
            <td class="px-3 py-2">${ceilingBadge}</td>
          </tr>`;
        })
        .join("");
    };

    priceInput.addEventListener("input", render);
    rateSelect.addEventListener("change", render);
    render();
  })();
</script>
