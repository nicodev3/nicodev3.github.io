---
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import PortfolioHero from "../components/PortfolioHero.astro";
import CtaSection from "../components/CtaSection.astro";
import { Picture } from "astro:assets";
import severineReisserImage from "../assets/images/screenshots/psychologue-leslilas.webp";
import marieJoseeGrassoImage from "../assets/images/screenshots/psychologue-sorgues.webp";
import delphineCimaImage from "../assets/images/screenshots/psychologue-manosque.webp";
import marieClaireBruneauImage from "../assets/images/screenshots/mcbruneau-psychologue-blois.webp";
import emanuelleFalliganImage from "../assets/images/screenshots/psychologue-sarrebourg.webp";
import stephanieRequetImage from "../assets/images/screenshots/psychologue-andrezieux-boutheon.webp";
import audreyLarcebauImage from "../assets/images/screenshots/psy-emdr-cotebasque.webp";
import montpellierPsychologueImage from "../assets/images/screenshots/montpellier-psychologue.webp";
import psychologueUzesImage from "../assets/images/screenshots/psychologue-uzes.webp";
import emmanuelleRoucheImage from "../assets/images/screenshots/emmarouche-psycho34.webp";
import cecileCoachingImage from "../assets/images/screenshots/cecilecoaching.webp";
import { RefreshCw } from "@lucide/astro";

const baseUrl = Astro.site ?? Astro.url.origin;
type PortfolioProject = {
  title: string;
  image: ImageMetadata;
  url: string;
  location: string;
  year: number;
  /** Affiche « Refonte en 2026 » dans les métadonnées de la carte. */
  refonte2026?: boolean;
  /** Texte alternatif HTML si « Aperçu du site » est trop générique (SEO / a11y). */
  imageAlt?: string;
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Accueil",
      item: new URL("/", baseUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Portfolio",
      item: new URL("/portfolio/", baseUrl).toString(),
    },
  ],
};

/** Année de conception par site (valeurs ci-dessous à ajuster selon vos archives). */
const psychologueProjects: PortfolioProject[] = [
  {
    title: "Sabine Lacas",
    image: psychologueUzesImage,
    url: "https://psychologue-uzes.fr/",
    location: "Uzes",
    year: 2018,
    refonte2026: true,
  },
  {
    title: "Marie-Josée Grasso",
    image: marieJoseeGrassoImage,
    url: "https://psychologue-sorgues.com/",
    location: "Sorgues",
    year: 2016,
    refonte2026: true,
  },
  {
    title: "Emma Rouche",
    image: emmanuelleRoucheImage,
    url: "https://emmarouche-psycho34.com/",
    location: "Castelnau-le-Lez",
    year: 2016,
    refonte2026: true,
  },
  {
    title: "Laure Meslé Yaakoubi",
    image: montpellierPsychologueImage,
    url: "https://montpellier-psychologue.pro/",
    location: "Montpellier",
    year: 2016,
    refonte2026: true,
  },
  {
    title: "Séverine Reisser",
    image: severineReisserImage,
    url: "https://psychologue-leslilas.fr/",
    location: "Les Lilas",
    year: 2019,
  },
  {
    title: "Delphine Cima",
    image: delphineCimaImage,
    url: "https://psychologue-manosque.net/",
    location: "Manosque",
    year: 2016,
  },
  {
    title: "Marie-Claire Bruneau",
    image: marieClaireBruneauImage,
    url: "https://mcbruneau-psychologue-blois.fr/",
    location: "Blois",
    year: 2017,
  },
  {
    title: "Emanuelle FALLIGAN",
    image: emanuelleFalliganImage,
    url: "https://psychologue-sarrebourg.fr/",
    location: "Sarrebourg",
    year: 2016,
  },
  {
    title: "Stéphanie REQUET-CATINEAN",
    image: stephanieRequetImage,
    url: "https://psychologue-andrezieux-boutheon.fr/",
    location: "Andrézieux-Bouthéon",
    year: 2016,
  },
  {
    title: "Audrey Larcebau",
    image: audreyLarcebauImage,
    url: "https://psy-emdr-cotebasque.fr/",
    location: "Côtebasque",
    year: 2016,
  },
];

/** Archives : conception d’origine avant 2019 sans refonte récente — masquées par défaut. */
const archiveTier = (p: PortfolioProject) => !p.refonte2026 && p.year < 2019;

const projects = psychologueProjects.map((p) => ({
  ...p,
  archiveTier: archiveTier(p),
}));

const conceptionYears = psychologueProjects.map((p) => p.year);
const conceptionYearMin = Math.min(...conceptionYears);
const conceptionYearMax = Math.max(...conceptionYears);

const portfolioYears = psychologueProjects.flatMap((p) =>
  p.refonte2026 ? [p.year, 2026] : [p.year],
);
const portfolioYearMin = Math.min(...portfolioYears);
const portfolioYearMax = Math.max(...portfolioYears);
const portfolioEyebrow = `Références · ${portfolioYearMin}–${portfolioYearMax}`;
const portfolioHeroTitle = "Sites pour psychologues. Voici ce que j’optimise.";
const portfolioHeroSubtitle =
  "Clarté de l’offre, présence locale Google et première prise de contact — le même socle technique pour chaque mise en ligne.";
---

<Layout
  title="Réalisations sites internet psychologues | Nicolas Devaux"
  description="Réalisations de sites internet : portfolio historique. Positionnement actuel : création de sites exclusivement pour psychologues."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>
  <PortfolioHero
    eyebrow={portfolioEyebrow}
    title={portfolioHeroTitle}
    subtitle={portfolioHeroSubtitle}
    breadcrumb={[{ label: "Accueil", href: "/" }, { label: "Portfolio" }]}
  >
    <p slot="context" class="m-0">
      Les références ci-dessous sont en majorité des conceptions d’origine entre{" "}
      <span class="whitespace-nowrap font-medium text-foreground">
        {conceptionYearMin} et {conceptionYearMax}
      </span>
      : certains sites ne sont plus en ligne (arrêt d’activité, reconversion). Les livraisons les plus récentes sont souvent couvertes par une confidentialité —{" "}
      <a href="/contact/">écrivez-moi</a>
      {" "}pour en parler.
    </p>
  </PortfolioHero>

  <section id="sites-psychologues" class="bg-white py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="mb-4 text-2xl font-bold leading-tight text-foreground sm:mb-6 sm:text-3xl"
      >
        Références en ligne
      </h2>
      <p class="mb-8 max-w-3xl text-sm leading-relaxed text-muted sm:text-base">
        Affichage par défaut : sites encore suivis ou{" "}
        <span class="font-medium text-foreground">refondus en 2026</span>. Utilisez « Tout l’historique » pour voir également les archives ({conceptionYearMin}–{conceptionYearMax}).
      </p>

      <!-- Projects Grid -->
      <div
        class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8"
      >
        {
          projects.map((project) => (
            <article
              class="portfolio-ref-card group flex flex-col overflow-hidden bg-white"
              data-portfolio-item
              data-portfolio-archive={project.archiveTier ? "true" : "false"}
              hidden={project.archiveTier}
            >
              <div class="portfolio-ref-card__media relative flex aspect-4/3 w-full items-center justify-center overflow-hidden bg-surface px-2 py-2 sm:px-2.5 sm:py-2.5">
                <Picture
                  src={project.image}
                  alt={project.imageAlt ?? `Aperçu du site ${project.title}`}
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  widths={[340, 680, 1020]}
                  sizes="(max-width: 767px) 100vw, (max-width: 1023px) 50vw, 340px"
                  loading="lazy"
                  decoding="async"
                  width={1020}
                  height={765}
                  pictureAttributes={{
                    class: "contents",
                  }}
                  class="max-h-full max-w-full object-contain object-center"
                />
              </div>
              <div class="portfolio-ref-card__body flex grow flex-col border-t border-[rgba(15,42,42,0.07)] bg-white p-5 sm:p-6">
                <h3 class="relative mb-4 w-fit max-w-full pb-0.5 text-lg font-semibold text-foreground sm:text-xl">
                  {project.title}
                  <span
                    class="pointer-events-none absolute bottom-0 left-0 h-0.5 w-full origin-left scale-x-0 bg-primary transition-transform duration-200 ease-out group-hover:scale-x-100 group-focus-within:scale-x-100"
                    aria-hidden="true"
                  />
                </h3>
                <div class="mb-4 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted">
                  <div class="flex items-center">
                    <svg
                      class="mr-1 h-4 w-4 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M15 10.5a3 3 0 1 1-6 0a3 3 0 0 1 6 0"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0"
                      />
                    </svg>
                    {project.location}
                  </div>
                  <div class="flex items-center">
                    <svg
                      class="mr-1 h-4 w-4 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5a2.25 2.25 0 002.25-2.25m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5a2.25 2.25 0 012.25 2.25v7.5"
                      />
                    </svg>
                    <time datetime={String(project.year)}>
                      Conception {project.year}
                    </time>
                  </div>
                  {
                    project.refonte2026 && (
                      <div class="flex items-center font-medium text-foreground">
                        <RefreshCw
                          class="mr-1 h-4 w-4 shrink-0 text-primary"
                          stroke-width={1.5}
                          aria-hidden="true"
                        />
                        <time datetime="2026">Refonte en 2026</time>
                      </div>
                    )
                  }
                </div>
                <div class="mt-auto pt-1">
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="portfolio-ref-card__link inline-flex items-center gap-1.5 text-sm font-semibold text-foreground underline decoration-primary/35 underline-offset-[6px] transition-[color,text-decoration-color] hover:text-primary hover:decoration-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 rounded-sm"
                    aria-label={`Voir le site ${project.title} (nouvel onglet)`}
                  >
                    Voir le site
                    <span
                      class="translate-x-0 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-focus-within:translate-x-0.5"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mb-6 max-w-3xl">
        <p class="mb-4 text-sm leading-relaxed text-muted sm:text-base">
          <span class="font-medium text-foreground">Référence complémentaire.</span>{" "}
          Site vitrine pour{" "}
          <a
            href="https://cecilecoaching.fr/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-primary underline underline-offset-4 hover:no-underline"
          >
            Cécile Coaching — coaching professionnel à Paris
          </a>
          .
        </p>
        <figure class="overflow-hidden rounded-[10px] border border-[rgba(15,42,42,0.08)] bg-surface shadow-[0_1px_2px_rgba(0,0,0,0.04),0_8px_24px_-8px_rgba(15,42,42,0.08)] max-w-xl">
          <a
            href="https://cecilecoaching.fr/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex aspect-4/3 items-center justify-center overflow-hidden bg-surface px-2 py-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
            aria-label="Voir le site Cécile Coaching (nouvel onglet)"
          >
            <Picture
              src={cecileCoachingImage}
              alt="Capture d'écran de la page d'accueil de Cécile Coaching, coach professionnelle APA à Paris"
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[340, 680]}
              sizes="(max-width: 640px) 100vw, 480px"
              loading="lazy"
              decoding="async"
              width={680}
              height={510}
              pictureAttributes={{
                class: "contents",
              }}
              class="max-h-full max-w-full object-contain object-center"
            />
          </a>
        </figure>
      </div>

      <aside
        class="mb-8 max-w-3xl border-l border-border pl-3 text-xs leading-relaxed text-muted sm:text-[0.8125rem]"
        aria-label="Complément sur le parcours"
      >
        <p class="m-0">
          <span class="font-medium text-muted">Complément.</span> Pendant plusieurs années, l’activité freelance était secondaire (fonctions tech lead). Je refonds aujourd’hui nicodev.fr et une offre dédiée aux psychologues — le cadre ci-dessus rappelle déjà pourquoi ce portfolio mélange archives et projets suivis.
        </p>
      </aside>

      <div class="mb-10 rounded-lg border border-border bg-surface p-5 sm:p-6">
        <h3 class="mb-3 text-lg font-semibold text-foreground">
          Ce que montrent ces réalisations
        </h3>
        <ul class="space-y-2 text-sm text-muted sm:text-base">
          <li>
            Une présentation claire de l'approche et des spécialités du
            praticien
          </li>
          <li>
            Une navigation simple pour rassurer et faciliter la prise de contact
          </li>
          <li>
            Des bases SEO locales solides pour améliorer la visibilité sur
            Google
          </li>
        </ul>
        <p class="mt-4 text-sm text-muted sm:text-base">
          Pour le détail des performances techniques (rapidité mobile, critères Google), voir la
          section dédiée sur la page{" "}
          <a
            href="/tarifs/#performances-pagespeed"
            class="font-semibold text-primary underline underline-offset-4 hover:no-underline"
            >Tarifs</a
          >.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="rounded-lg border border-border bg-background p-6">
          <h3 class="mb-4 text-lg font-semibold text-foreground">
            Méthode de travail
          </h3>
          <ol class="space-y-2 text-muted">
            <li><strong>1.</strong> Diagnostic rapide pour cadrer le besoin</li>
            <li>
              <strong>2.</strong> Mise en place du site à partir d'un modèle pro personnalisé
            </li>
            <li>
              <strong>3.</strong> Aller-retour de validation puis mise en ligne
            </li>
          </ol>
        </div>
        <div class="rounded-lg border border-border bg-surface p-6">
          <h3 class="mb-4 text-lg font-semibold text-foreground">
            Ce que vous pouvez attendre
          </h3>
          <p class="mb-4 text-muted">
            Un site plus lisible pour vos futurs patients, une meilleure
            présence locale et des demandes de contact plus qualifiées.
          </p>
          <p class="text-muted">
            Ces projets reposent sur les mêmes fondations que mes offres :
            Pack Site Vitrine (29€/mois) et Pack Site +
            Blog (49€/mois).
          </p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a
              href="/diagnostic-gratuit/"
              class="btn-primary-solid inline-block rounded-lg px-5 py-3 text-center"
            >
              Demander un diagnostic gratuit
            </a>
            <a
              href="/tarifs/"
              class="btn-outline-accent inline-block rounded-lg border-2 border-primary px-5 py-3 text-center text-foreground hover:bg-background"
            >
              Voir les tarifs
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaSection
    title="Vous avez un projet similaire ?"
    description="Un diagnostic gratuit permet de faire le point ; les tarifs détaillent les formules."
    primaryButton={{ text: 'Demander un diagnostic gratuit', href: '/diagnostic-gratuit/' }}
    secondaryButton={{ text: 'Voir les tarifs', href: '/tarifs/' }}
  />
</Layout>

<style>
  .portfolio-ref-card {
    border-radius: 10px;
    border: 1px solid rgba(15, 42, 42, 0.08);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 8px 24px -8px rgba(15, 42, 42, 0.08);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .portfolio-ref-card:hover,
  .portfolio-ref-card:focus-within {
    transform: translateY(-1px);
    border-color: rgba(15, 42, 42, 0.14);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.05),
      0 14px 32px -10px rgba(15, 42, 42, 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-ref-card {
      transition-duration: 0.01ms;
    }

    .portfolio-ref-card:hover,
    .portfolio-ref-card:focus-within {
      transform: none;
    }
  }
</style>
