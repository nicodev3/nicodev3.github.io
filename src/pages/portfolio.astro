---
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import PortfolioHero from "../components/PortfolioHero.astro";
import CtaSection from "../components/CtaSection.astro";
import portfolioHeroImage from "../assets/images/portfolio-image.webp";
import { Picture } from "astro:assets";
import severineReisserImage from "../assets/images/screenshots/psychologue-leslilas.webp";
import marieJoseeGrassoImage from "../assets/images/screenshots/psychologue-sorgues.webp";
import delphineCimaImage from "../assets/images/screenshots/psychologue-manosque.webp";
import marieClaireBruneauImage from "../assets/images/screenshots/mcbruneau-psychologue-blois.webp";
import emanuelleFalliganImage from "../assets/images/screenshots/psychologue-sarrebourg.webp";
import stephanieRequetImage from "../assets/images/screenshots/psychologue-andrezieux-boutheon.webp";
import audreyLarcebauImage from "../assets/images/screenshots/psy-emdr-cotebasque.webp";
import montpellierPsychologueImage from "../assets/images/screenshots/montpellier-psychologue.webp";
import psychologueUzesImage from "../assets/images/screenshots/psychologue-uzes.webp";
import emmanuelleRoucheImage from "../assets/images/screenshots/emmarouche-psycho34.webp";
import florentSimonNancyImage from "../assets/images/screenshots/psychologue-nancy-florent-simon.webp";
import balintSmbFranceImage from "../assets/images/screenshots/balint-smb-france.webp";
import psychomotriciteMorgesImage from "../assets/images/screenshots/psychomotricite-morges.webp";
import joieCompassionImage from "../assets/images/screenshots/joiecompassion.webp";
import benedicteDonetImage from "../assets/images/screenshots/benedictedonet-psyenligne.webp";
import angelaBassompierreImage from "../assets/images/screenshots/angelabassompierre.webp";
import pierreDalarunImage from "../assets/images/screenshots/pierre-dalarun.webp";
import { RefreshCw } from "@lucide/astro";

const baseUrl = Astro.site ?? Astro.url.origin;

type PortfolioProfession =
  | "psychologue"
  | "psychotherapeute"
  | "psychomotricien"
  | "psychomotricienne"
  | "association";

const professionLabels: Record<PortfolioProfession, string> = {
  psychologue: "Psychologue",
  psychotherapeute: "Psychothérapeute",
  psychomotricien: "Psychomotricien·ne",
  psychomotricienne: "Psychomotricienne",
  association: "Association professionnelle",
};

type PortfolioProject = {
  title: string;
  image: ImageMetadata;
  url: string;
  location: string;
  year: number;
  profession: PortfolioProfession;
  /** Affiche « Refonte en 2026 » dans les métadonnées de la carte. */
  refonte2026?: boolean;
  /** Texte alternatif HTML si « Aperçu du site » est trop générique (SEO / a11y). */
  imageAlt?: string;
  /** Courte description du projet (ex. refonte WordPress). */
  description?: string;
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Accueil",
      item: new URL("/", baseUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Portfolio",
      item: new URL("/portfolio/", baseUrl).toString(),
    },
  ],
};

/** Année de conception par site (valeurs ci-dessous à ajuster selon vos archives). */
const portfolioProjects: PortfolioProject[] = [
  {
    title: "Pierre Dalarun",
    image: pierreDalarunImage,
    url: "https://pierredalarun.com/",
    location: "Soudan",
    year: 2026,
    profession: "psychotherapeute",
    description:
      "Création d'un site vitrine pour présenter une approche psychocorporelle, les pratiques proposées et les consultations au cabinet ou en visio.",
    imageAlt:
      "Site Pierre Dalarun — psychothérapeute à Soudan près de Châteaubriant, consultations au cabinet et en visio",
  },
  {
    title: "Angela Bassompierre",
    image: angelaBassompierreImage,
    url: "https://angelabassompierre.fr/",
    location: "France",
    year: 2026,
    profession: "psychologue",
    description:
      "Création d'un site vitrine pour consultations psychologiques en ligne (approche intégrative, EFT, traumatismes).",
    imageAlt:
      "Site Angela Bassompierre — psychologue en ligne, consultations en visio pour adolescents et adultes",
  },
  {
    title: "Bénédicte Donet",
    image: benedicteDonetImage,
    url: "https://www.benedictedonet-psyenligne.com/",
    location: "France",
    year: 2026,
    profession: "psychologue",
    refonte2026: true,
    description:
      "Refonte d'un site WordPress avec optimisation des performances et SEO (psychologue en ligne, EMDR, trauma).",
    imageAlt:
      "Site Bénédicte Donet — psychologue en ligne, refonte WordPress avec optimisation performances et SEO",
  },
  {
    title: "Isabelle Leboeuf",
    image: joieCompassionImage,
    url: "https://joiecompassion.com/",
    location: "Seclin",
    year: 2018,
    profession: "psychologue",
    refonte2026: true,
    description:
      "Refonte visuelle et optimisation SEO d'un site WordPress (Joie & Compassion, TFC et programme MOOD).",
    imageAlt:
      "Site Joie & Compassion — refonte visuelle et SEO WordPress, Isabelle Leboeuf, thérapie fondée sur la compassion",
  },
  {
    title: "Anne Dupuis-de Charrière",
    image: psychomotriciteMorgesImage,
    url: "https://psychomotricite-morges.ch/",
    location: "Morges",
    year: 2026,
    profession: "psychomotricienne",
    imageAlt:
      "Site vitrine psychomotricité Anne Dupuis-de Charrière à Morges — accueil et prise de contact",
  },
  {
    title: "Florent Simon",
    image: florentSimonNancyImage,
    url: "https://psychologue-nancy-florent-simon.fr/",
    location: "Nancy",
    year: 2015,
    profession: "psychologue",
    imageAlt:
      "Site vitrine psychologue Florent Simon à Nancy — accueil et prise de contact",
  },
  {
    title: "Société Médicale Balint France",
    image: balintSmbFranceImage,
    url: "https://www.balint-smb-france.org/",
    location: "France",
    year: 2018,
    profession: "association",
    imageAlt:
      "Site de la Société Médicale Balint France — groupes Balint, formations et actualités",
  },
  {
    title: "Sabine Lacas",
    image: psychologueUzesImage,
    url: "https://psychologue-uzes.fr/",
    location: "Uzès",
    year: 2018,
    profession: "psychologue",
    refonte2026: true,
    imageAlt:
      "Capture du site vitrine psychologue Sabine Lacas à Uzès — présentation et prise de contact",
  },
  {
    title: "Marie-Josée Grasso",
    image: marieJoseeGrassoImage,
    url: "https://psychologue-sorgues.com/",
    location: "Sorgues",
    year: 2016,
    profession: "psychologue",
    refonte2026: true,
    imageAlt:
      "Site internet psychologue Marie-Josée Grasso à Sorgues — page d’accueil et informations cabinet",
  },
  {
    title: "Emma Rouche",
    image: emmanuelleRoucheImage,
    url: "https://emmarouche-psycho34.com/",
    location: "Castelnau-le-Lez",
    year: 2016,
    profession: "psychologue",
    refonte2026: true,
    imageAlt:
      "Site vitrine psychologue Emma Rouche à Castelnau-le-Lez (agglomération montpelliéraine)",
  },
  {
    title: "Laure Meslé Yaakoubi",
    image: montpellierPsychologueImage,
    url: "https://montpellier-psychologue.pro/",
    location: "Montpellier",
    year: 2016,
    profession: "psychologue",
    refonte2026: true,
    imageAlt:
      "Site web psychologue à Montpellier — Laure Meslé Yaakoubi, capture page d’accueil",
  },
  {
    title: "Séverine Reisser",
    image: severineReisserImage,
    url: "https://psychologue-leslilas.fr/",
    location: "Les Lilas",
    year: 2019,
    profession: "psychologue",
    imageAlt:
      "Site internet psychologue aux Lilas (Île-de-France) — Séverine Reisser",
  },
  {
    title: "Delphine Cima",
    image: delphineCimaImage,
    url: "https://psychologue-manosque.net/",
    location: "Manosque",
    year: 2016,
    profession: "psychologue",
    imageAlt:
      "Site vitrine psychologue Delphine Cima à Manosque — contenus et contact",
  },
  {
    title: "Marie-Claire Bruneau",
    image: marieClaireBruneauImage,
    url: "https://mcbruneau-psychologue-blois.fr/",
    location: "Blois",
    year: 2017,
    profession: "psychologue",
    imageAlt:
      "Site web psychologue Marie-Claire Bruneau à Blois — présentation du cabinet",
  },
  {
    title: "Emanuelle FALLIGAN",
    image: emanuelleFalliganImage,
    url: "https://psychologue-sarrebourg.fr/",
    location: "Sarrebourg",
    year: 2016,
    profession: "psychologue",
    imageAlt:
      "Site internet psychologue Emanuelle Falligan à Sarrebourg — accueil",
  },
  {
    title: "Stéphanie REQUET-CATINEAN",
    image: stephanieRequetImage,
    url: "https://psychologue-andrezieux-boutheon.fr/",
    location: "Andrézieux-Bouthéon",
    year: 2016,
    profession: "psychologue",
    imageAlt:
      "Site vitrine psychologue à Andrézieux-Bouthéon (proximité bassin lyonnais) — Stéphanie Requet-Catinean",
  },
  {
    title: "Audrey Larcebau",
    image: audreyLarcebauImage,
    url: "https://psy-emdr-cotebasque.fr/",
    location: "Côte basque",
    year: 2016,
    profession: "psychologue",
    refonte2026: true,
    imageAlt:
      "Site psychologue EMDR Côte basque — Audrey Larcebau, refonte 2026, page d’accueil",
  },
];

/** Archives : conception d’origine avant 2019 sans refonte récente — masquées par défaut. */
const archiveTier = (p: PortfolioProject) => !p.refonte2026 && p.year < 2019;

const projects = portfolioProjects.map((p) => ({
  ...p,
  professionLabel: professionLabels[p.profession],
  archiveTier: archiveTier(p),
}));

const conceptionYears = portfolioProjects.map((p) => p.year);
const conceptionYearMin = Math.min(...conceptionYears);
const conceptionYearMax = Math.max(...conceptionYears);

const portfolioYears = portfolioProjects.flatMap((p) =>
  p.refonte2026 ? [p.year, 2026] : [p.year],
);
const portfolioYearMin = Math.min(...portfolioYears);
const portfolioYearMax = Math.max(...portfolioYears);
const portfolioEyebrow = `Références · ${portfolioYearMin}–${portfolioYearMax}`;
const portfolioHeroTitle =
  "Des sites réalisés principalement pour des psychologues";
const portfolioHeroSubtitle =
  "Présentation de la pratique, visibilité locale et prise de contact : des réalisations conçues avec chaque collègue, à partir de son cadre et de ses besoins.";
---

<Layout
  title="Réalisations de sites internet pour psychologues | Nicodev"
  description="Découvrez les sites internet réalisés par Nicodev pour des psychologues en libéral : création, refonte et visibilité locale."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>
  <PortfolioHero
    eyebrow={portfolioEyebrow}
    title={portfolioHeroTitle}
    subtitle={portfolioHeroSubtitle}
    breadcrumb={[{ label: "Accueil", href: "/" }, { label: "Portfolio" }]}
    coverImage={portfolioHeroImage}
    coverImageAlt="Espace de travail avec maquettes de sites web pour professionnels du soin"
  >
  </PortfolioHero>

  <section id="sites-psychologues" class="bg-white py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="mb-4 text-2xl font-bold leading-tight text-foreground sm:mb-6 sm:text-3xl"
      >
        Références de sites pour psychologues
      </h2>
      <p class="mb-8 max-w-3xl text-sm leading-relaxed text-muted sm:text-base">
        Affichage par défaut : sites encore suivis ou{" "}
        <span class="font-medium text-foreground">refondus en 2026</span>. Utilisez « Tout l’historique » pour voir également les archives ({conceptionYearMin}–{conceptionYearMax}).
      </p>

      <!-- Projects Grid -->
      <div
        class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:gap-8"
      >
        {
          projects.map((project) => (
            <article
              class="portfolio-ref-card group flex flex-col overflow-hidden bg-white"
              data-portfolio-item
              data-portfolio-archive={project.archiveTier ? "true" : "false"}
              hidden={project.archiveTier}
            >
              <div class="portfolio-ref-card__media relative aspect-16/10 w-full overflow-hidden bg-surface">
                <Picture
                  src={project.image}
                  alt={
                    project.imageAlt ??
                    `Site vitrine psychologue à ${project.location} — ${project.title}`
                  }
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  widths={[400, 680, 1056]}
                  sizes="(max-width: 767px) 100vw, 50vw"
                  loading="lazy"
                  decoding="async"
                  width={1280}
                  height={800}
                  pictureAttributes={{
                    class: "block h-full w-full",
                  }}
                  class="h-full w-full object-contain object-center"
                />
              </div>
              <div class="portfolio-ref-card__body flex grow flex-col border-t border-[rgba(15,42,42,0.07)] bg-white p-5 sm:p-6">
                <h3 class="relative mb-4 w-fit max-w-full pb-0.5 text-lg font-semibold text-foreground sm:text-xl">
                  {project.title}
                  <span
                    class="pointer-events-none absolute bottom-0 left-0 h-0.5 w-full origin-left scale-x-0 bg-primary transition-transform duration-200 ease-out group-hover:scale-x-100 group-focus-within:scale-x-100"
                    aria-hidden="true"
                  />
                </h3>
                {
                  project.description && (
                    <p class="mb-4 text-sm leading-relaxed text-muted">
                      {project.description}
                    </p>
                  )
                }
                <div class="mb-4 flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted">
                  <div class="flex items-center">
                    <svg
                      class="mr-1 h-4 w-4 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M15.75 6a3.75 3.75 0 1 1-7.5 0a3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                      />
                    </svg>
                    <span>{project.professionLabel}</span>
                  </div>
                  <div class="flex items-center">
                    <svg
                      class="mr-1 h-4 w-4 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M15 10.5a3 3 0 1 1-6 0a3 3 0 0 1 6 0"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0"
                      />
                    </svg>
                    {project.location}
                  </div>
                  <div class="flex items-center">
                    <svg
                      class="mr-1 h-4 w-4 shrink-0"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="1.5"
                        d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5a2.25 2.25 0 002.25-2.25m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5a2.25 2.25 0 012.25 2.25v7.5"
                      />
                    </svg>
                    <time datetime={String(project.year)}>
                      Conception {project.year}
                    </time>
                  </div>
                  {
                    project.refonte2026 && (
                      <div class="flex items-center font-medium text-foreground">
                        <RefreshCw
                          class="mr-1 h-4 w-4 shrink-0 text-primary"
                          stroke-width={1.5}
                          aria-hidden="true"
                        />
                        <time datetime="2026">Refonte en 2026</time>
                      </div>
                    )
                  }
                </div>
                <div class="mt-auto pt-1">
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="portfolio-ref-card__link inline-flex items-center gap-1.5 rounded-sm text-sm font-semibold text-foreground transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
                    aria-label={`Voir le site ${project.title}, ${project.professionLabel} (nouvel onglet)`}
                    data-umami-event="portfolio_site_link_click"
                    data-umami-event-site={new URL(project.url).hostname}
                    data-umami-event-title={project.title}
                    data-umami-event-emplacement="card"
                  >
                    <span class="portfolio-ref-card__link-text">Voir le site</span>
                    <span
                      class="translate-x-0 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-focus-within:translate-x-0.5"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mb-10 rounded-lg border border-border bg-surface p-5 sm:p-6">
        <h3 class="mb-3 text-lg font-semibold text-foreground">
          Ce que montrent ces réalisations
        </h3>
        <ul class="space-y-2 text-sm text-muted sm:text-base">
          <li>
            Une présentation claire de l'approche et des spécialités du
            praticien
          </li>
          <li>
            Une navigation simple pour rassurer et faciliter la prise de contact
          </li>
          <li>
            Des bases SEO locales solides pour améliorer la visibilité sur
            Google
          </li>
        </ul>
        <p class="mt-4 text-sm text-muted sm:text-base">
          Pour le détail des performances techniques (rapidité mobile, critères Google), voir la
          section dédiée sur la page{" "}
          <a
            href="/tarifs/#performances-pagespeed"
            class="font-semibold text-primary underline underline-offset-4 hover:no-underline"
            >Tarifs</a
          >.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div class="rounded-lg border border-border bg-background p-6">
          <h3 class="mb-4 text-lg font-semibold text-foreground">
            Méthode de travail
          </h3>
          <ol class="space-y-2 text-muted">
            <li><strong>1.</strong> Diagnostic rapide pour cadrer le besoin</li>
            <li>
              <strong>2.</strong> Mise en place du site à partir d'un modèle pro personnalisé
            </li>
            <li>
              <strong>3.</strong> Aller-retour de validation puis mise en ligne
            </li>
          </ol>
        </div>
        <div class="rounded-lg border border-border bg-surface p-6">
          <h3 class="mb-4 text-lg font-semibold text-foreground">
            Ce que vous pouvez attendre
          </h3>
          <p class="mb-4 text-muted">
            Un site plus lisible pour vos futurs patients, une meilleure
            présence locale et des demandes de contact plus qualifiées.
          </p>
          <p class="text-muted">
            Ces projets reposent sur les mêmes fondations que mes deux formules :
            <a
              href="/tarifs/#tarifs-offres"
              class="font-semibold text-primary underline underline-offset-4 hover:no-underline"
              >Sérénité (29 €/mois) et Visibilité &amp; Confiance (49 €/mois)</a
            >.
          </p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row">
            <a
              href="/diagnostic-gratuit/"
              data-analytics-event="lead_click_diagnostic"
              data-analytics-cta="diagnostic"
              data-analytics-location="portfolio_projects"
              class="btn-primary-solid inline-block rounded-lg px-5 py-3 text-center"
            >
              Demander un diagnostic gratuit
            </a>
            <a
              href="/tarifs/"
              class="btn-outline-accent inline-block rounded-lg border-2 border-primary px-5 py-3 text-center text-foreground hover:bg-background"
            >
              Voir les tarifs
            </a>
          </div>
        </div>
      </div>

      <div class="mt-12 max-w-3xl">
        <p class="mb-4 text-sm leading-relaxed text-muted sm:text-base">
          <span class="font-medium text-foreground">Autres réalisations :</span>
          <a
            href="https://cecilecoaching.fr/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-primary underline underline-offset-4 hover:no-underline"
            data-umami-event="portfolio_site_link_click"
            data-umami-event-site="cecilecoaching.fr"
            data-umami-event-title="Cécile Coaching (APA)"
            data-umami-event-emplacement="autres_realisations"
          >
            coach sportif Activités Physiques Adaptées (APA)
          </a>
          .
        </p>
      </div>
    </div>
  </section>

  <CtaSection
    title="Vous avez un projet similaire ?"
    description="Un diagnostic gratuit permet de faire le point ; les tarifs détaillent les formules."
    primaryButton={{ text: 'Demander un diagnostic gratuit', href: '/diagnostic-gratuit/' }}
    secondaryButton={{ text: 'Voir les tarifs', href: '/tarifs/' }}
  />
</Layout>

<style>
  .portfolio-ref-card {
    border-radius: 10px;
    border: 1px solid rgba(15, 42, 42, 0.08);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.04),
      0 8px 24px -8px rgba(15, 42, 42, 0.08);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .portfolio-ref-card:hover,
  .portfolio-ref-card:focus-within {
    transform: translateY(-1px);
    border-color: rgba(15, 42, 42, 0.14);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.05),
      0 14px 32px -10px rgba(15, 42, 42, 0.12);
  }

  .portfolio-ref-card__link-text {
    text-decoration-line: underline;
    text-decoration-color: color-mix(in srgb, var(--color-primary-500) 35%, transparent);
    text-underline-offset: 6px;
    transition: text-decoration-color 0.2s ease;
  }

  .portfolio-ref-card__link:hover .portfolio-ref-card__link-text,
  .portfolio-ref-card__link:focus-visible .portfolio-ref-card__link-text {
    text-decoration-color: var(--color-primary-500);
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-ref-card {
      transition-duration: 0.01ms;
    }

    .portfolio-ref-card:hover,
    .portfolio-ref-card:focus-within {
      transform: none;
    }
  }
</style>
