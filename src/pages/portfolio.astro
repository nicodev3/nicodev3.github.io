---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaSection from '../components/CtaSection.astro';

const psychologueProjects = [
	{
		title: "Cécile Coaching",
		description: "Site vitrine pour coach professionnelle",
		image: "/images/screenshots/cecilecoaching.fr.png",
		url: "https://cecilecoaching.fr/",
		location: "Paris"
	},
	{
		title: "Séverine Reisser",
		description: "Site vitrine professionnel pour psychologue",
		image: "/images/screenshots/psychologue-leslilas.png",
		url: "https://psychologue-leslilas.fr/",
		location: "Les Lilas"
	},
	{
		title: "Marie-Josée Grasso",
		description: "Site vitrine pour psychologue",
		image: "/images/screenshots/psychologue-sorgues.png",
		url: "https://psychologue-sorgues.com/",
		location: "Sorgues"
	},
	{
		title: "Delphine Cima",
		description: "Site vitrine professionnel pour psychologue",
		image: "/images/screenshots/psy-manosque.png",
		url: "https://psychologue-manosque.net/",
		location: "Manosque"
	},
	{
		title: "Emanuelle FALLIGAN",
		description: "Site vitrine professionnel pour psychologue",
		image: "/images/screenshots/psy-sarrebourg.png",
		url: "https://psychologue-sarrebourg.fr/",
		location: "Sarrebourg"
	},
	{
		title: "Stéphanie REQUET-CATINEAN",
		description: "Site vitrine moderne pour psychologue",
		image: "/images/screenshots/psy-andrezieux.jpg",
		url: "https://psychologue-andrezieux-boutheon.fr/",
		location: "Andrézieux-Bouthéon"
	},
	{
		title: "Thomas Mouries",
		description: "Site vitrine pour ostéopathe D.O avec spécialisations",
		image: "/images/screenshots/osteopathe-toulouse-mouries.png",
		url: "https://osteopathe-toulouse-mouries.fr/",
		location: "Toulouse"
	},
	{
		title: "Audrey Larcebau",
		description: "Site vitrine pour psychologue spécialisée en EMDR",
		image: "/images/screenshots/psy-emdr-cotebasque.png",
		url: "https://psy-emdr-cotebasque.fr/",
		location: "Côtebasque"
	},
	{
		title: "Géraldine Adam",
		description: "Site vitrine pour coach sportif spécialisée en Pilates",
		image: "/images/screenshots/cours-pilates-fullpage.png",
		url: "https://cours-pilates.fr/",
		location: "Sceaux"
	},
];
---

<Layout 
	title="Portfolio - Nicolas Devaux"
	description="Réalisations en création de sites pour psychologues, psychomotriciens, psychothérapeutes, psychopraticiens, coachs, thérapeutes et praticiens en psychothérapie."
>
	<Hero 
		title="Portfolio" 
		subtitle="Quelques réalisations pour psychologues, coachs et professionnels du soin"
	/>

	<section id="sites-psychologues" class="bg-white py-12 sm:py-16">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<h2 class="mb-4 text-2xl font-bold leading-tight text-gray-900 sm:mb-6 sm:text-3xl">
				Sites internet pour psychologues et professionnels du soin psychique
			</h2>
			<p class="mb-8 max-w-3xl text-base text-gray-600 sm:text-lg">
				Beaucoup de projets présentés ici sont anciens, certains datent de plus de 10 ans. Plusieurs sites ne sont plus en ligne car les professionnels ont cessé leur activité.
			</p>
			<p class="mb-8 max-w-3xl text-gray-700">
				Le style visuel varie selon l'année de création, mais la logique reste la même : un site clair, rassurant, optimisé pour le mobile et structuré pour le référencement local (psychologue + ville), avec intégration possible d'un widget de prise de rendez-vous.
			</p>

			<div class="mb-10 rounded-xl border border-teal-100 bg-teal-50 p-5 sm:p-6">
				<h3 class="mb-3 text-lg font-semibold text-gray-900">Ce que montrent ces réalisations</h3>
				<ul class="space-y-2 text-sm text-gray-700 sm:text-base">
					<li>Une présentation claire de l'approche et des spécialités du praticien</li>
					<li>Une navigation simple pour rassurer et faciliter la prise de contact</li>
					<li>Des bases SEO locales solides pour améliorer la visibilité sur Google</li>
				</ul>
			</div>

			<!-- Projects Grid -->
			<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
				{psychologueProjects.map((project) => (
					<article class="flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm transition-shadow hover:shadow-md sm:rounded-xl">
						<div class="relative">
							<img 
								src={project.image} 
								alt={`Aperçu du site ${project.title}`}
								class="h-44 w-full object-cover sm:h-48"
								loading="lazy"
								decoding="async"
							/>
						</div>
						<div class="flex flex-grow flex-col border-t border-gray-200 bg-stone-50 p-5 sm:p-6">
							<h3 class="mb-2 text-lg font-semibold text-gray-900 sm:text-xl">
								{project.title}
							</h3>
							<p class="mb-3 text-gray-600">
								{project.description}
							</p>
							<div class="mb-4 flex items-center text-sm text-gray-500">
								<svg class="mr-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10.5a3 3 0 1 1-6 0a3 3 0 0 1 6 0"/>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0"/>
								</svg>
								{project.location}
							</div>
							<div class="mt-auto">
								<a 
									href={project.url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-block rounded-lg bg-teal-800 px-4 py-2 font-semibold text-white transition-colors hover:bg-teal-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-700 focus-visible:ring-offset-2"
									aria-label={`Visiter le site ${project.title} (nouvel onglet)`}
								>
									Visiter le site
								</a>
							</div>
						</div>
					</article>
				))}
			</div>

			<div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
				<div class="rounded-xl border border-gray-200 bg-white p-6">
					<h3 class="mb-4 text-lg font-semibold text-gray-900">Méthode de travail</h3>
					<ol class="space-y-2 text-gray-700">
						<li><strong>1.</strong> Diagnostic rapide pour cadrer le besoin</li>
						<li><strong>2.</strong> Mise en place du site à partir d'un modèle pro personnalisé</li>
						<li><strong>3.</strong> Aller-retour de validation puis mise en ligne</li>
					</ol>
				</div>
				<div class="rounded-xl border border-gray-200 bg-stone-50 p-6">
					<h3 class="mb-4 text-lg font-semibold text-gray-900">Ce que vous pouvez attendre</h3>
					<p class="mb-4 text-gray-700">
						Un site plus lisible pour vos futurs patients, une meilleure présence locale et des demandes de contact plus qualifiées.
					</p>
					<p class="text-gray-700">
						Ces projets reposent sur les mêmes fondations que mes offres : Forfait Création (490€), Pack Site Vitrine (59€/mois) et Pack Site + Blog (89€/mois).
					</p>
					<div class="mt-5 flex flex-col gap-3 sm:flex-row">
						<a href="/tarifs" class="inline-block rounded-lg border-2 border-teal-700 px-4 py-2 text-center font-semibold text-teal-800 transition-colors hover:bg-teal-50">
							Voir les offres
						</a>
						<a href="/contact" class="inline-block rounded-lg bg-teal-800 px-4 py-2 text-center font-semibold text-white transition-colors hover:bg-teal-900">
							Recevoir une proposition en 48h
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<CtaSection 
		title="Vous avez un projet similaire ?"
		description="Contactez-moi pour discuter de votre projet et obtenir un devis personnalisé."
		primaryButton={{ text: "Me contacter", href: "/contact" }}
		secondaryButton={{ text: "Voir mes tarifs", href: "/tarifs" }}
	/>
</Layout>
