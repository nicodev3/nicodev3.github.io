					<p class="mt-2 text-lg text-muted text-pretty">Quatre questions, réponse sous 48 heures ouvrées, sans engagement.</p>
				</div>
				<a
					href="/diagnostic-gratuit/"
					class="btn-primary-solid inline-flex shrink-0 items-center justify-center rounded-xl px-6 py-3 font-semibold"
					data-analytics-event="lead_click_diagnostic"
					data-analytics-cta="diagnostic"
