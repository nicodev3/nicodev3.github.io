---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaSection from '../components/CtaSection.astro';
import FaqSection from '../components/FaqSection.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import { Image } from 'astro:assets';
import { Phone, MessageCircle } from '@lucide/astro';
import {
	SOCIAL_HANDLE_DISPLAY,
	WHATSAPP_HREF,
	WHATSAPP_DISPLAY,
	WHATSAPP_PHONE_E164
} from '../data/contact';
import { googleTestimonials } from '../data/testimonials';
import portraitImage from '../assets/images/nicodev.webp';
import refOgWebp from '../assets/images/blog/seo-google-my-business.webp';

const baseUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL('/referencement-site-psychologue/', baseUrl).href;

const proofTestimonials = ['Séverine Reisser', 'Stéphanie Requet-Catinean']
	.map((short) => googleTestimonials.find((t) => t.short === short))
	.filter((t): t is NonNullable<typeof t> => Boolean(t));

/** Source unique : accordéon visible et JSON-LD FAQ affichent exactement les mêmes questions. */
const faqItems: {
	question: string;
	answer: string;
	link?: { href: string; label: string };
}[] = [
	{
		question: "Comment améliorer le référencement d'un site de psychologue ?",
		answer:
			"Commencez par un site rapide et bien structuré (titres, pages clés, contenu local), une fiche Google Business Profile complète et des informations identiques partout (nom, adresse, téléphone). Ensuite, publiez des contenus utiles avec régularité et évitez les pages dupliquées par ville. La régularité compte plus que les astuces.",
	},
	{
		question: 'Faut-il un blog pour référencer un site psychologue ?',
		answer:
			"Ce n'est pas obligatoire pour démarrer, mais un blog aide à couvrir des recherches locales et des questions fréquentes (installation, visibilité, fiche Google). Les deux offres incluent un CMS pour publier. L'offre Visibilité & Confiance ajoute une aide à la rédaction et des idées d'articles, sans rédaction mensuelle à ma charge.",
	},
	{
		question: "Combien coûte le référencement d'un site psychologue, et est-il inclus ?",
		answer:
			"Les fondations SEO, la fiche Google, le CMS et une veille de visibilité (je détecte et je corrige) sont inclus dans la création de site, dès 29 €/mois. L'offre Visibilité & Confiance à 49 €/mois ajoute un support prioritaire, un SEO expert, du GEO (être cité dans les réponses des IA) et une aide à la rédaction, sans garantie de position ni de citation. Méfiez-vous des forfaits SEO opaques vendus en sus sans périmètre clair.",
		link: { href: '/tarifs/', label: 'Voir les tarifs' },
	},
	{
		question: 'Une fiche Google Business Profile suffit-elle ?',
		answer:
			"Elle capte une partie des recherches locales, mais sans site les patients qui veulent comprendre votre approche avant d'appeler n'ont nulle part où aller, et certains se tournent vers des confrères mieux présentés. Fiche et site se renforcent mutuellement.",
	},
	{
		question: 'Faut-il créer des pages par ville ou par spécialité ?',
		answer:
			"Une page par spécialité réelle peut être utile si elle apporte un vrai contenu. Multiplier des pages par ville quasi identiques est en revanche contre-productif : Google les considère comme du contenu dupliqué et les patients s'y perdent. Mieux vaut une page locale solide et cohérente avec votre fiche.",
	},
	{
		question: 'Les avis Google sont-ils importants pour un psychologue ?',
		answer:
			"Ils comptent pour la visibilité locale et la confiance, mais leur gestion doit respecter le secret professionnel : pas de sollicitation insistante, et jamais de réponse qui confirme qu'une personne est suivie.",
		link: {
			href: '/blog/avis-google-e-reputation-psychologue/',
			label: 'Avis Google et e-réputation du psychologue',
		},
	},
	{
		question: 'Combien de temps faut-il pour être visible sur Google ?',
		answer:
			"Des signaux positifs sur la fiche Google peuvent apparaître en quelques semaines si elle est complète. Le référencement organique du site demande souvent plusieurs mois de régularité, surtout dans les villes concurrentielles. Méfiez-vous des discours qui annoncent des résultats rapides garantis.",
	},
	{
		question: 'Peut-on faire du SEO en respectant la déontologie ?',
		answer:
			"Oui : le SEO consiste à rendre des informations exactes faciles à trouver, pas à faire de la publicité racoleuse. Contenus informatifs, présentation sobre de la pratique et absence d'affirmation de résultat sont parfaitement compatibles avec le cadre déontologique.",
	},
	{
		question: 'Puis-je faire mon SEO moi-même ?',
		answer:
			"Oui pour une partie (compléter la fiche, demander des avis dans le cadre déontologique). La technique avancée (données structurées, performance, structure) est souvent plus rapide à confier, surtout si vous préférez vous concentrer sur la clinique.",
	},
	{
		question: 'Comment mesurer les résultats du référencement ?',
		answer:
			"Appels, formulaires, clics d'itinéraire sur la fiche, pages du site qui génèrent des contacts, sans confondre positions et prises de rendez-vous.",
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: { '@type': 'Answer', text: item.answer },
	})),
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Référencement site psychologue, SEO local et visibilité Google',
	description:
		'Référencement d’un site de psychologue : site optimisé pour Google, fiche Google et veille dès 29 €/mois. L’offre à 49 €/mois ajoute le support prioritaire, le SEO expert, le GEO et l’aide à la rédaction, sans garantie de place.',
	provider: {
		'@type': 'Person',
		name: 'Nicolas Devaux',
		url: new URL('/about/', baseUrl).href,
	},
	serviceType: 'Référencement naturel (SEO)',
	areaServed: { '@type': 'Country', name: 'France' },
	audience: {
		'@type': 'Audience',
		audienceType: 'Psychologues et cabinets de psychologie en libéral',
	},
	offers: {
		'@type': 'AggregateOffer',
		priceCurrency: 'EUR',
		lowPrice: '29',
		highPrice: '49',
		offerCount: 2,
		url: new URL('/tarifs/', baseUrl).href,
	},
	url: pageUrl,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Référencement site psychologue',
			item: pageUrl
		}
	]
};

const channelRows = [
	{
		canal: 'Doctolib seul',
		capte: 'Patients qui veulent prendre rendez-vous tout de suite',
		limite: "Profil standardisé, peu de place pour expliquer votre approche ; l'espace ne vous appartient pas",
		reco: 'À garder pour la prise de rendez-vous, en le reliant à votre site',
	},
	{
		canal: 'Fiche Google seule',
		capte: 'Recherches locales « psychologue + ville », appels, itinéraire',
		limite: "Peu de place pour expliquer l'approche, le cadre, les spécialités",
		reco: 'Utile en démarrage, insuffisant seule à moyen terme',
	},
	{
		canal: 'Site seul',
		capte: 'Recherche sur votre nom, contenus, crédibilité avant contact',
		limite: 'Moins visible sur la carte Google sans fiche complète',
		reco: 'Utile pour expliquer le cadre, moins efficace pour la recherche sur carte',
	},
	{
		canal: 'Site + fiche Google',
		capte: 'Découverte locale et conviction avant rendez-vous',
		limite: 'Demande des informations cohérentes et de la régularité sur les contenus',
		reco: 'Combinaison la plus solide',
		strong: true,
	},
];

const startPoints = [
	['Un site rapide sur mobile', 'chargement stable, textes lisibles, boutons de contact accessibles.'],
	['Une page par intention réelle', 'accueil, approche, infos pratiques, contact ; une page par spécialité seulement si le contenu est distinct.'],
	['Titres et descriptions uniques', 'chaque page a son titre, sa description et un seul H1 clair.'],
	['Informations locales visibles', 'ville, secteur, modalités (cabinet, téléconsultation), sans bourrage de mots-clés.'],
	['Une fiche Google complète', 'catégorie, horaires, téléphone, zone, photos sobres, lien vers le site.'],
	['Les mêmes coordonnées partout', 'nom, adresse et téléphone identiques sur le site, la fiche Google, Doctolib et les annuaires.'],
	['Des liens entre vos pages', 'accueil, pages clés, articles de blog et contact se renvoient les uns aux autres.'],
	['Un balisage pour Google', 'données structurées (JSON-LD) qui décrivent votre service, votre fil d’Ariane et votre FAQ.'],
	['Des contenus utiles et réguliers', 'des articles qui répondent aux vraies questions des patients.'],
	['Un suivi des contacts', 'appels, formulaires, clics d’itinéraire : c’est ce qui compte pour votre cabinet, pas seulement les positions.'],
];

const tocItems = [
	{ id: 'commencer', label: 'Par où commencer' },
	{ id: 'site-et-fiche', label: 'Site, fiche Google et Doctolib' },
	{ id: 'cote-site', label: 'Ce que je fais côté site' },
	{ id: 'limites', label: 'Prudence et délais' },
	{ id: 'faq', label: 'Questions fréquentes' },
];

const inlineLink = 'font-medium text-foreground underline decoration-primary/40 underline-offset-4 hover:text-primary';
---

<Layout
	title="Référencement site psychologue : SEO local et fiche Google"
	description="Référencement naturel pour psychologue libéral : site, SEO local et fiche Google. Bases dès 29 €/mois, SEO expert et GEO à 49 €/mois, sans garantie de position."
	image={refOgWebp}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<Hero
		title="Référencement site psychologue"
		subtitle="Un site clair, une fiche Google cohérente et une veille de visibilité, par un psychologue qui est aussi développeur web. Sans garantie de position."
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Référencement site psychologue' }]}
	>
		<Fragment slot="after">
			<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
				<a
					href="/diagnostic-gratuit/"
					class="btn-primary-solid inline-flex items-center justify-center rounded-xl px-6 py-3 font-semibold"
					data-analytics-event="lead_click_diagnostic"
					data-analytics-cta="diagnostic"
					data-analytics-location="referencement_hero"
					data-lead-source="referencement-hero"
				>
					Demander un diagnostic gratuit
				</a>
				<a
					href="/tarifs/"
					class="btn-outline-accent inline-flex items-center justify-center rounded-xl border-2 border-primary px-6 py-3 font-semibold text-foreground hover:bg-background"
				>
					Voir les tarifs
				</a>
			</div>
		</Fragment>
	</Hero>

	<div class="border-b border-border bg-white">
		<div class="shell-layout flex flex-wrap items-center justify-center gap-x-8 gap-y-1 text-sm">
			<a
				href={`tel:+${WHATSAPP_PHONE_E164}`}
				class="inline-flex min-h-11 items-center gap-2 font-medium text-muted transition-colors hover:text-primary"
			>
				<Phone class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				{WHATSAPP_DISPLAY}
			</a>
			<a
				href={WHATSAPP_HREF}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex min-h-11 items-center gap-2 font-semibold text-primary-500 transition-colors hover:text-primary"
				data-analytics-event="lead_click_whatsapp"
				data-analytics-cta="whatsapp"
				data-analytics-location="referencement_page"
			>
				<MessageCircle class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				WhatsApp {SOCIAL_HANDLE_DISPLAY}
			</a>
		</div>
	</div>

	<section class="section-y border-b border-border bg-surface" aria-labelledby="referencement-offre-heading">
		<div class="shell-layout">
			<header class="mx-auto max-w-3xl text-center">
				<h2 id="referencement-offre-heading" class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">
					Inclus dès 29&nbsp;€, approfondi à 49&nbsp;€
				</h2>
				<p class="mt-4 text-lg leading-relaxed text-muted text-pretty">
					Le référencement d’un site de psychologue n’est pas un forfait opaque vendu en sus&nbsp;:
					les fondations sont dans la création de site, dès la formule Sérénité.
				</p>
			</header>
			<div class="mx-auto mt-10 grid max-w-4xl gap-4 md:grid-cols-2">
				<div class="rounded-xl border border-border bg-white p-6 shadow-sm sm:p-8">
					<h3 class="font-heading text-xl font-semibold text-foreground">Sérénité</h3>
					<p class="mt-1 font-heading text-4xl font-semibold text-foreground">
						29&nbsp;€<span class="text-base font-normal text-muted">&nbsp;/mois</span>
					</p>
					<ul class="mt-5 space-y-2 leading-relaxed text-muted">
						<li>Structure SEO du site (titres, performances, données structurées)</li>
						<li>Fiche Google Business Profile</li>
						<li>CMS pour publier</li>
						<li>Veille de visibilité&nbsp;: je détecte et je corrige</li>
					</ul>
				</div>
				<div class="rounded-xl border-2 border-primary/40 bg-white p-6 shadow-sm sm:p-8">
					<h3 class="font-heading text-xl font-semibold text-foreground">Visibilité &amp; Confiance</h3>
					<p class="mt-1 font-heading text-4xl font-semibold text-primary-foreground">
						49&nbsp;€<span class="text-base font-normal text-muted">&nbsp;/mois</span>
					</p>
					<ul class="mt-5 space-y-2 leading-relaxed text-muted">
						<li>Tout ce qui est inclus dès 29&nbsp;€</li>
						<li>Support prioritaire</li>
						<li>SEO expert, plus d’outils d’analyse</li>
						<li>GEO&nbsp;: être cité dans les réponses des IA</li>
						<li>Aide à la rédaction&nbsp;: relecture, reformulation, idées d’articles</li>
					</ul>
				</div>
			</div>
			<p class="mx-auto mt-6 max-w-3xl text-center text-muted text-pretty">
				Sans garantie de place dans Google. Non inclus&nbsp;: la rédaction mensuelle de vos articles, les pages par ville, la publicité.
			</p>
			<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
				<a
					href="/diagnostic-gratuit/"
					class="btn-primary-solid inline-flex items-center justify-center rounded-xl px-6 py-3 font-semibold"
					data-analytics-event="lead_click_diagnostic"
					data-analytics-cta="diagnostic"
					data-analytics-location="referencement_offer"
					data-lead-source="referencement-offer"
				>
					Demander un diagnostic gratuit
				</a>
				<a
					href="/tarifs/"
					class="btn-outline-accent inline-flex items-center justify-center rounded-xl border-2 border-primary px-6 py-3 font-semibold text-foreground hover:bg-background"
				>
					Voir les tarifs
				</a>
			</div>
			<p class="mt-4 text-center text-muted">
				Pas encore de site&nbsp;?
				<a href="/creation-site-internet-psychologue/" class={`inline-flex min-h-11 items-center ${inlineLink}`}>Voir la création de site pour psychologue</a>
			</p>
		</div>
	</section>

	<section class="section-y border-b border-border bg-white" aria-labelledby="preuve-heading">
		<div class="shell-layout">
			<div class="mx-auto grid max-w-5xl items-start gap-8 md:grid-cols-[minmax(0,16rem)_1fr] md:gap-12">
				<Image
					src={portraitImage}
					alt="Nicolas Devaux, psychologue et développeur web"
					class="mx-auto h-auto w-full max-w-[16rem] rounded-xl object-cover"
					width={512}
					height={512}
					widths={[256, 384, 512]}
					sizes="(max-width: 768px) 60vw, 256px"
				/>
				<div>
					<h2 id="preuve-heading" class="font-heading text-3xl font-semibold text-foreground text-balance sm:text-4xl">
						Un confrère qui connaît votre cadre, pas une agence
					</h2>
					<p class="mt-4 text-lg leading-relaxed text-muted text-pretty">
						Je suis <a href="/about/" class={inlineLink}>psychologue, psychomotricien et psychothérapeute</a>, et développeur web.
						Je sais ce qu’un cabinet peut dire, et ce qu’il ne doit pas dire. Je prends la technique en charge&nbsp;; vous gardez la clinique.
					</p>
					<ul class="mt-6 space-y-3 text-lg leading-relaxed text-foreground">
						<li><strong>Pas de promesse de classement.</strong> Personne ne peut garantir une place sur «&nbsp;psychologue + ville&nbsp;».</li>
						<li><strong>Pas de pages par ville dupliquées.</strong> Google les ignore, les patients s’y perdent.</li>
						<li><strong>Pas de forfait SEO opaque.</strong> Ce qui est inclus est écrit, ce qui ne l’est pas aussi.</li>
					</ul>
				</div>
			</div>

			<div class="mx-auto mt-12 grid max-w-5xl gap-4 md:grid-cols-2">
				{proofTestimonials.map((t) => (
					<TestimonialCard
						quote={t.quote}
						author={t.author}
						source="google"
						rating={t.rating}
						websiteUrl={t.websiteUrl}
						websiteLabel={t.websiteLabel}
					/>
				))}
			</div>
			<p class="mt-6 text-center">
				<a href="/portfolio/" class={`inline-flex min-h-11 items-center ${inlineLink}`}>Voir les sites livrés dans le portfolio</a>
			</p>
		</div>
	</section>

	<section class="section-y border-b border-border bg-surface" aria-labelledby="sommaire-heading">
		<div class="shell-layout">
			<div class="mx-auto max-w-3xl">
				<h2 id="sommaire-heading" class="font-heading text-3xl font-semibold text-foreground sm:text-4xl">
					Référencement d’un psychologue&nbsp;: l’essentiel
				</h2>
				<p class="mt-4 text-lg leading-relaxed text-foreground text-pretty">
					Le référencement d’un site de psychologue associe des pages utiles et rapides, une présence locale cohérente et une fiche Google Business Profile complète. Le diagnostic gratuit aide à choisir les priorités selon votre pratique, sans promesse de classement.
				</p>
				<nav class="mt-6" aria-label="Sommaire de la page">
					<ol class="grid gap-x-8 sm:grid-cols-2">
						{tocItems.map((item, index) => (
							<li class="border-t border-border">
								<a
									href={`#${item.id}`}
									class="flex min-h-12 items-center gap-3 font-medium text-foreground transition-colors hover:text-primary"
								>
									<span class="type-label-mono w-6 text-primary-foreground" aria-hidden="true">{index + 1}</span>
									{item.label}
								</a>
							</li>
						))}
					</ol>
				</nav>
			</div>
		</div>
	</section>

	<section id="commencer" class="section-y scroll-mt-28 border-b border-border bg-white" aria-labelledby="commencer-heading">
		<div class="shell-layout">
			<div class="mx-auto max-w-5xl">
				<h2 id="commencer-heading" class="font-heading text-3xl font-semibold text-foreground text-balance sm:text-4xl">
					Référencement site psychologue&nbsp;: par où commencer&nbsp;?
				</h2>
				<p class="mt-4 max-w-[68ch] text-lg leading-relaxed text-foreground text-pretty">
					Avant d’ajouter des pages ou de payer une prestation SEO opaque, vérifiez ces dix points. C’est souvent là que se jouent les premiers gains de visibilité.
				</p>
				<ol class="mt-8 grid gap-x-12 md:grid-cols-2">
					{startPoints.map(([lead, detail], index) => (
						<li class="flex gap-4 border-t border-border py-4">
							<span class="type-label-mono w-7 shrink-0 pt-1 text-primary-foreground" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<p class="leading-relaxed text-muted">
								<strong class="text-foreground">{lead}</strong>, {detail}
							</p>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<section id="site-et-fiche" class="section-y scroll-mt-28 border-b border-border bg-surface" aria-labelledby="site-et-fiche-heading">
		<div class="shell-layout">
			<div class="mx-auto max-w-5xl">
				<h2 id="site-et-fiche-heading" class="font-heading text-3xl font-semibold text-foreground text-balance sm:text-4xl">
					Site, fiche Google et Doctolib&nbsp;: qui fait quoi&nbsp;?
				</h2>
				<div class="mt-6 max-w-[68ch] space-y-4 text-lg leading-relaxed text-foreground">
					<p class="text-pretty">
						Les recherches «&nbsp;référencement psychologue&nbsp;» mélangent annuaires, service-public et offres commerciales. Ici, il s’agit du <strong>référencement d’un site de psychologue</strong>, avec deux volets&nbsp;: votre <strong>site</strong> (contenu, structure, performance) et votre présence dans les résultats locaux, notamment via <a href="/blog/google-business-profile-psychologue/" class={inlineLink}>Google Business Profile</a>.
					</p>
					<p class="text-pretty">
						La plupart des recherches sont <strong>locales et concrètes</strong>&nbsp;: «&nbsp;psychologue + ville&nbsp;», parfois une spécialité («&nbsp;EMDR&nbsp;», «&nbsp;TCC&nbsp;») ou directement votre nom après une recommandation. Google affiche d’abord le pack local (carte et fiches), puis les sites. Il faut donc travailler <strong>les deux étages</strong>&nbsp;: une fiche complète pour apparaître sur la carte, un site clair pour informer ceux qui cliquent.
					</p>
					<p class="text-pretty">
						La recherche sur votre nom compte autant&nbsp;: un patient recommandé vérifie presque toujours en ligne avant d’appeler. Si Google ne renvoie qu’un annuaire incomplet, vous perdez la main sur cette première impression. L’article <a href="/blog/comment-trouver-premiers-patients-psychologue/" class={inlineLink}>trouver ses premiers patients</a> détaille ces parcours.
					</p>
				</div>

				<div class="mt-10 hidden overflow-hidden rounded-xl border border-border bg-white md:block">
					<table class="w-full border-collapse text-left">
						<caption class="sr-only">
							Comparaison entre Doctolib seul, fiche Google seule, site seul et site avec fiche Google pour le référencement d'un cabinet de psychologue
						</caption>
						<thead class="border-b border-border bg-surface-alt">
							<tr>
								<th scope="col" class="type-label-mono p-4 text-foreground">Canal</th>
								<th scope="col" class="type-label-mono p-4 text-foreground">Ce qu'il capte</th>
