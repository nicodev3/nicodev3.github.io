										{row.strong ? <strong class="text-foreground">{row.reco}</strong> : row.reco}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>

				<ul class="mt-10 space-y-4 md:hidden">
					{channelRows.map((row) => (
						<li class:list={['rounded-xl border bg-white p-5', row.strong ? 'border-2 border-primary/40' : 'border-border']}>
							<h3 class="font-heading text-lg font-semibold text-foreground">{row.canal}</h3>
							<dl class="mt-3 space-y-3 leading-relaxed">
								<div>
									<dt class="type-label-mono text-foreground">Ce qu'il capte</dt>
									<dd class="mt-1 text-muted">{row.capte}</dd>
								</div>
								<div>
									<dt class="type-label-mono text-foreground">Limite</dt>
									<dd class="mt-1 text-muted">{row.limite}</dd>
								</div>
								<div>
									<dt class="type-label-mono text-foreground">Recommandation</dt>
									<dd class="mt-1 text-muted">{row.strong ? <strong class="text-foreground">{row.reco}</strong> : row.reco}</dd>
