---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaSection from '../components/CtaSection.astro';
import FaqSection from '../components/FaqSection.astro';
import { Code2, GraduationCap, MapPin, MessageCircle, Phone, Search } from '@lucide/astro';
import { WHATSAPP_HREF, WHATSAPP_DISPLAY, WHATSAPP_PHONE_E164 } from '../data/contact';
import psychomotricienneImage from '../assets/images/psychomotricienne-2.webp';

const baseUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL('/site-internet-psychomotricien/', baseUrl).href;

const legitimacyItems = [
	{
		Icon: GraduationCap,
		title: 'Expertise psychomotricité',
		description:
			'Formation initiale de psychomotricien à l’ISRP : bilan, suivi, publics accompagnés et vocabulaire du cabinet — sans modèle générique de « thérapeute ».',
	},
	{
		Icon: Code2,
		title: 'Expertise web',
		description:
			'Développeur web et ancien tech lead front-end : structure, performance mobile, SEO technique et mise en ligne — pas une agence déconnectée du soin.',
	},
	{
		Icon: MapPin,
		title: 'Visibilité locale',
		description:
			'Pages et parcours de contact simples, pensés pour votre ville et votre fiche Google, sans promesses de positionnement irréalistes.',
	},
] as const;

const localSearchExamples = [
	'psychomotricien Lyon',
	'psychomotricien enfant Toulouse',
	'bilan psychomoteur Nantes',
	'cabinet psychomotricité Bordeaux',
] as const;

const psychomotricienFaqItems = [
	{
		question: 'Pourquoi créer un site internet quand on est psychomotricien ?',
		answer:
			'Parce que les familles, les adultes et les professionnels qui orientent cherchent des repères avant de prendre contact : qui vous êtes, qui vous accompagnez, comment se déroule un bilan psychomoteur, où se trouve le cabinet. Un site clair répond à ces questions avec vos propres mots, là où un annuaire ne montre qu’une fiche standardisée.',
	},
	{
		question: 'Un site internet peut-il aider un cabinet de psychomotricité à être trouvé sur Google ?',
		answer:
			'Oui, à condition d’être bien construit : structure lisible, titres pertinents, performance mobile et cohérence avec votre ville. Combiné à une fiche Google Business Profile complète, il améliore la visibilité locale du cabinet sur des recherches comme « psychomotricien + ville » — sans qu’aucune position puisse être garantie.',
	},
	{
		question: 'Quelle différence entre un site internet et une fiche Google Business Profile ?',
		answer:
			'La fiche Google donne les informations essentielles (adresse, horaires, téléphone, avis) directement dans les résultats locaux. Le site, lui, vous laisse expliquer votre pratique en détail : bilan, séances, publics accompagnés, approche. Les deux se renforcent : la fiche attire la recherche locale, le site rassure et donne envie de prendre contact.',
	},
	{
		question: 'Quelles pages prévoir pour un site de psychomotricien ?',
		answer:
			'En général : une page d’accueil claire, une présentation de votre parcours et de votre approche, une page sur le bilan psychomoteur et les séances, les publics accompagnés, les informations pratiques (tarifs, accès, horaires) et une page de contact. Le détail dépend de votre pratique réelle.',
	},
	{
		question: 'Combien coûte un site internet pour psychomotricien ?',
		answer:
			'L’offre fonctionne par abonnement mensuel, hébergement, nom de domaine et mises à jour inclus. Le détail des formules et de leur périmètre est présenté sur la page Tarifs, sans frais cachés ni engagement opaque.',
	},
	{
		question: 'Pourquoi travailler avec quelqu’un qui connaît la psychomotricité et le web ?',
		answer:
			'Parce que le contenu et la technique ne se séparent pas : expliquer un bilan psychomoteur demande des mots justes ; le rendre visible en ligne demande une structure solide. Je m’appuie sur une formation initiale de psychomotricien à l’ISRP et sur un vrai parcours de développeur web, jusqu’à tech lead front-end, pour un site sobre, précis et techniquement fiable.',
	},
	{
		question: 'Le site est-il adapté à une activité de psychomotricien en libéral ?',
		answer:
			'Oui. La page est pensée pour expliquer clairement votre cadre d’exercice, les publics que vous accompagnez, les modalités pratiques et les possibilités de prise de contact, sans transformer votre pratique en discours commercial.',
	},
	{
		question: 'Faut-il rédiger tous les textes soi-même ?',
		answer:
			'Non. Vous répondez à un formulaire guidé : publics accompagnés, bilan, suivi, cadre de consultation, horaires, accès au cabinet. Je structure ensuite les contenus pour qu’ils soient lisibles, sobres et compréhensibles par vos futurs patients ou leurs proches.',
	},
	{
		question: 'Le référencement local est-il garanti ?',
		answer:
			'Non, aucun prestataire sérieux ne peut garantir une position Google. En revanche, le site est construit avec des bases solides : structure claire, performance mobile, titres pertinents, données structurées et cohérence avec votre ville ou secteur.',
	},
	{
		question: 'Peut-on parler des motifs de consultation sans surpromettre ?',
		answer:
			'Oui. Le site peut expliquer les demandes fréquentes avec prudence : bilan psychomoteur, graphomotricité, coordination, agitation, repérage dans l’espace ou le temps, selon votre pratique réelle. L’objectif est d’informer, pas de promettre un résultat.',
	},
	{
		question: 'Puis-je intégrer Doctolib, Maiia ou un autre outil de rendez-vous ?',
		answer:
			'Oui. Si vous utilisez une plateforme compatible, j’intègre le lien, le bouton ou le widget disponible. Le site reste votre espace de présentation, et l’outil de rendez-vous vient simplement faciliter la prise de contact.',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: psychomotricienFaqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Création de site internet pour psychomotricien',
	description:
		'Création de site internet pour psychomotriciens par un DE psychomotricien (ISRP) et ancien tech lead développeur web : contenu juste, site performant et bases de référencement local.',
	provider: {
		'@type': 'Person',
		name: 'Nicolas Devaux',
		url: new URL('/about/', baseUrl).href,
	},
	serviceType: 'Création de site internet',
	areaServed: { '@type': 'Country', name: 'France' },
	audience: {
		'@type': 'Audience',
		audienceType: 'Psychomotriciens en libéral',
	},
	url: pageUrl,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Site internet psychomotricien',
			item: pageUrl,
		},
	],
};
---

<Layout
	title="Site internet psychomotricien : création de site vitrine et SEO"
	description="Création de site internet pour psychomotricien : un site clair, rassurant et optimisé pour présenter votre cabinet, vos accompagnements et améliorer votre visibilité locale."
	image={psychomotricienneImage}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<Hero
		title="Site internet pour psychomotricien"
		subtitle="Un site professionnel pour présenter votre cabinet de psychomotricité : publics accompagnés, bilans, séances et informations pratiques — par un psychomotricien de formation devenu développeur web."
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Site psychomotricien' }]}
		coverImage={psychomotricienneImage}
		coverImageAlt="Espace de psychomotricité avec une professionnelle accompagnant un enfant"
	/>

	<div class="border-b border-border bg-white py-3">
		<div class="shell-layout flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
			<a
				href={`tel:+${WHATSAPP_PHONE_E164}`}
				class="inline-flex items-center gap-1.5 font-medium text-muted transition-colors hover:text-primary"
			>
				<Phone class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				{WHATSAPP_DISPLAY}
			</a>
			<a
				href={WHATSAPP_HREF}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 font-semibold text-primary-500 transition-colors hover:text-primary"
				data-umami-event="lead_click_whatsapp_from_psychomotricien_page"
			>
				<MessageCircle class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				WhatsApp — réponse rapide
			</a>
		</div>
	</div>

	<section class="border-b border-border bg-surface py-12 sm:py-16" aria-labelledby="psychomotricien-reperes-heading">
		<div class="shell-layout">
			<header class="mx-auto mb-8 max-w-3xl text-center">
				<p class="type-eyebrow mb-3 text-muted">Repères</p>
				<h2 id="psychomotricien-reperes-heading" class="font-heading text-2xl font-semibold text-foreground sm:text-3xl">
					Psychomotricité et web : la même personne derrière le contenu et la technique
				</h2>
				<p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">
					Vous n’avez pas affaire à une agence qui découvre le soin, ni à un clinicien qui délègue le code. Je connais
					les enjeux d’un cabinet de psychomotricité et je construis moi-même des sites performants, avec un double
					regard : formation initiale en psychomotricité et expérience confirmée du web.
				</p>
			</header>

			<div class="grid grid-cols-1 gap-5 md:grid-cols-3">
				{
					legitimacyItems.map(({ Icon, title, description }) => (
						<article class="rounded-lg border border-border bg-white p-6 shadow-sm">
							<div class="ui-icon-well mb-4" aria-hidden="true">
								<Icon class="h-5 w-5" stroke-width={1.5} />
							</div>
							<h3 class="font-heading text-xl font-semibold text-foreground">{title}</h3>
							<p class="mt-3 text-base leading-relaxed text-muted">{description}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="section-y border-b border-border bg-white">
		<div class="shell-layout">
			<div class="mx-auto max-w-[72ch] prose prose-lg prose-headings:text-foreground prose-p:text-muted prose-li:text-muted prose-strong:text-foreground">
				<h2>Un site pour expliquer votre pratique sans la simplifier à l’excès</h2>
				<p>
					Un futur patient, un parent ou un médecin qui cherche un psychomotricien a souvent besoin de comprendre
					rapidement votre cadre : bilan, suivi, publics accompagnés, âge des patients, accès au cabinet, tarifs,
					prise de rendez-vous. Votre site doit rendre ces informations accessibles, sans promettre plus que ce que
					votre pratique permet.
				</p>
				<p>
					Pour un cabinet de psychomotricité, le contenu doit aussi parler à plusieurs publics en même temps :
					parents qui cherchent un premier repère, adultes qui hésitent à consulter, professionnels qui orientent, et
					personnes qui veulent simplement savoir comment se déroule un premier rendez-vous.
				</p>
				<p>
					Je vous aide à construire un site sobre et lisible, adapté à une profession du soin où la confiance se
					construit dans les détails : mots justes, informations concrètes, navigation simple, ton professionnel.
					Le contenu est pensé avec une <strong>expertise psychomotricité</strong> ; la mise en ligne repose sur une
					<strong>expertise web</strong> de développeur, jusqu’à tech lead front-end.
				</p>

				<h2>Deux expertises réunies pour votre site</h2>

				<h3>Comprendre la psychomotricité, pas seulement la « thérapie »</h3>
				<p>
					Mon parcours a commencé par une <strong>formation de psychomotricien à l’ISRP</strong>, avant de se
					prolonger vers la psychologie puis le développement web. Cette formation me permet de comprendre les enjeux
					de présentation d’un cabinet : expliquer le psychocorporel avec clarté, distinguer bilan et suivi, rester
					accessible aux familles, et éviter les formulations trop commerciales ou trop vagues.
				</p>
				<p>
					Concrètement, je ne pars pas d’un modèle générique de « thérapeute ». Je vous aide à formuler ce qui
					appartient vraiment à votre pratique : place du corps, développement psychomoteur, graphomotricité,
					coordination, relation, temporalité du suivi et articulation avec les autres professionnels.
				</p>

				<h3>Un site construit par un développeur expérimenté</h3>
				<p>
					Mon expérience web s’est construite en freelance puis en équipe, jusqu’à des postes de{' '}
					<strong>tech lead front-end</strong> (notamment au Figaro et chez Naxos). Aujourd’hui, je mets cette
					expérience au service des professionnels du soin. Vous échangez directement avec la personne qui rédige,
					structure et développe votre site — pas avec une chaîne commerciale.
				</p>
				<p>
					Côté technique : pages rapides sur mobile, structure HTML claire, données structurées, sitemap, bonnes
					pratiques SEO et intégration de vos outils (Doctolib, Maiia, etc.).{' '}
					<a href="/about/#references-professionnelles">Voir mon parcours web et mes références</a>.
				</p>

				<h2>Ce que le site peut présenter</h2>
				<ul>
					<li>Votre parcours, votre cadre de consultation et votre manière de travailler</li>
					<li>Les publics accompagnés : enfants, adolescents, adultes, personnes âgées, selon votre pratique réelle</li>
					<li>La différence entre un bilan psychomoteur, un suivi et un accompagnement ponctuel</li>
					<li>Les motifs fréquents de consultation, formulés avec prudence et pédagogie, sans diagnostic simpliste</li>
					<li>Les informations pratiques : tarifs, accès, horaires, documents à apporter, téléconsultation si pertinente</li>
					<li>Un lien ou widget de prise de rendez-vous, lorsque vous utilisez un outil externe</li>
					<li>Les bases de visibilité locale : titres, descriptions, performance mobile, sitemap et données structurées</li>
				</ul>

				<h2>Référencement local : rester prudent et concret</h2>
				<p>
					Les recherches du type <strong>psychomotricien + ville</strong> sont importantes, mais elles ne justifient
					pas des promesses irréalistes. Le travail consiste à créer une page bien structurée, compréhensible par les
					visiteurs et par les moteurs de recherche, puis à garder une cohérence entre votre site, votre fiche Google
					Business Profile et les annuaires où votre cabinet apparaît.
				</p>
				<div class="not-prose my-8 rounded-lg border border-border bg-surface p-6">
					<h3 class="mb-4 font-heading text-xl font-semibold text-foreground">
						Exemples de recherches locales à clarifier
					</h3>
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
						{
							localSearchExamples.map((example) => (
								<div class="flex items-center gap-3 rounded-lg bg-white p-3">
									<Search
										class="h-[18px] w-[18px] shrink-0 text-primary-foreground"
										stroke-width={1.5}
										aria-hidden="true"
									/>
									<span class="type-label-mono text-foreground">{example}</span>
								</div>
							))
						}
					</div>
					<p class="mt-4 text-sm leading-relaxed text-muted">
						Ces exemples servent à structurer le contenu et les balises. Ils ne remplacent pas une stratégie locale
						globale, ni la qualité de votre fiche Google, ni les recommandations professionnelles.
					</p>
				</div>
				<p>
					Un bon site ne remplace pas votre réputation locale, votre réseau d’adressage ou la qualité de votre fiche
					Google. Il leur donne un point d’appui stable, lisible et maîtrisé.
				</p>
				<p>
					Pour approfondir ce deuxième pilier, vous pouvez aussi lire les guides dédiés au <a href="/blog/site-internet-psychomotricien/">site internet de psychomotricien</a>,
					au <a href="/blog/referencement-local-psychomotricien/">référencement local d’un psychomotricien</a> et à la
					<a href="/blog/google-business-profile-psychomotricien/">fiche Google Business Profile d’un psychomotricien</a>.
				</p>

				<h2>Site internet, annuaire ou Doctolib : des rôles différents</h2>
				<p>
					Une fiche sur un annuaire ou un profil Doctolib facilite la prise de rendez-vous, mais le format reste
					imposé : mêmes rubriques pour tous, peu de place pour expliquer un bilan psychomoteur ou votre approche.
					Le site internet est le seul espace où un psychomotricien libéral contrôle entièrement son message — et il
					renforce les autres canaux : la fiche Google Business Profile renvoie vers le site, le site rassure ceux
					qui ont trouvé votre nom ailleurs.
				</p>
				<p>
					Aucun de ces outils ne remplace les autres : l’annuaire référence, Doctolib réserve, le site explique et
					rassure. C’est leur cohérence (mêmes coordonnées, même ton, mêmes informations) qui construit la
					visibilité locale d’un cabinet de psychomotricité.
				</p>

				<h2>Déroulement et tarifs</h2>
				<p>
					Le processus reste simple : diagnostic gratuit, choix d’une base graphique sobre, formulaire guidé pour
					rassembler vos informations, prévisualisation, ajustements puis mise en ligne. Vous n’avez pas besoin de
					gérer l’hébergement, le nom de domaine, les mises à jour ou les aspects techniques.
				</p>
				<p>
					L’offre fonctionne par abonnement mensuel tout inclus — le détail est sur la page{' '}
					<a href="/tarifs/">Tarifs</a>. Pour une question précise avant de vous lancer, le plus direct reste la{' '}
					<a href="/contact/">page contact</a>.
				</p>

				<h2>Pour qui ?</h2>
				<p>
					Cette offre s’adresse aux psychomotriciens installés en libéral, en création de cabinet, en association ou
					en reprise d’un site existant. Elle peut aussi convenir si vous avez déjà une fiche Google ou une page sur
					un annuaire, mais pas encore d’espace clair pour présenter votre pratique avec vos propres mots.
				</p>
			</div>
		</div>
	</section>

	<FaqSection
		items={psychomotricienFaqItems}
		title="Questions fréquentes"
		sectionId="faq-psychomotricien"
		headingId="faq-psychomotricien-heading"
		background="surface"
		headingAlign="center"
	/>

	<CtaSection
		title="Faire le point sur votre projet de site"
		description="Le diagnostic gratuit permet de vérifier vos besoins, votre contexte et la formule la plus adaptée, sans engagement."
		primaryButton={{ text: 'Demander un diagnostic gratuit', href: '/diagnostic-gratuit/' }}
		secondaryButton={{ text: 'Voir les tarifs', href: '/tarifs/' }}
		background="white"
	/>
</Layout>
