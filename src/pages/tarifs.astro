---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BulletList from '../components/BulletList.astro';
import CtaSection from '../components/CtaSection.astro';
import OffersSection from '../components/OffersSection.astro';
import PageSpeedScores from '../components/PageSpeedScores.astro';
import FaqSection from '../components/FaqSection.astro';
import tarifsHeroImage from '../assets/images/tarifs-image.webp';
import { TARIFS_TRUST_SIGNALS } from '../data/tarifs-trust-signals';
import { CalendarClock, LockOpen, PackageCheck } from '@lucide/astro';

const tarifsHeroHighlightIcons = [PackageCheck, CalendarClock, LockOpen] as const;
const tarifsHeroHighlights = TARIFS_TRUST_SIGNALS.map((label, index) => ({
	Icon: tarifsHeroHighlightIcons[index],
	label,
}));

const baseUrl = Astro.site ?? Astro.url.origin;
const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{ '@type': 'ListItem', position: 2, name: 'Tarifs', item: new URL('/tarifs/', baseUrl).toString() }
	]
};

const platformCons = [
	'15-40€/mois d’abonnement, souvent avec la création et les réglages à votre charge',
	'Vous devez tout faire vous-même',
	'Mises en page génériques, peu personnalisées',
	"Pas d'optimisation pour Google",
	'Support limité, modifications à votre charge',
	"Pas d'intégration du widget de prise de RDV"
];

const servicePros = [
	'29-49€/mois tout inclus',
	"Je m'occupe de tout pour vous",
	'Échange direct avec le développeur qui réalise vraiment votre site',
	'Base professionnelle + adaptation attentive à votre pratique',
	'Bases SEO, fiche Google et CMS inclus dès 29 €/mois',
	'Modifications de contenu selon la formule (1 ou 3 par mois)',
	'Intégration du widget de prise de RDV incluse'
];

const tarifsFaqItems = [
	{
		question: "Quels sont les tarifs Nicodev pour un site de psychologue ?",
		answer:
			"Chez Nicodev, le prix est présenté sous forme d'abonnement tout inclus : 29 €/mois pour l'offre Sérénité ou 49 €/mois pour l'offre Visibilité & Confiance. La création, l'hébergement, le nom de domaine et la maintenance sont intégrés au périmètre. Pour les fourchettes du marché (DIY, freelance, agence), voir le guide « combien coûte un site pour psychologue »."
	},
	{
		question: "Que couvre l'abonnement site psychologue ?",
		answer:
			"L'abonnement couvre le socle du site : mise en ligne, hébergement, nom de domaine, CMS, bases SEO, fiche Google, maintenance, support et bouton de rendez-vous (Doctolib, Perfactive ou autre) lorsque vous en utilisez un. La formule à 49 €/mois ajoute une veille SEO d'expert (suivi, relecture et optimisation des contenus), 3 modifications simples par mois et une modernisation annuelle."
	},
	{
		question: "Y a-t-il des frais d'installation pour l'abonnement ?",
		answer:
			"Non, aucun frais caché. La création de votre site est incluse dans l'abonnement. Vous commencez à payer seulement après la livraison de votre site."
	},
	{
		id: 'faq-modifications',
		question: "Que signifient les modifications de contenu incluses ?",
		answer:
			"L'offre Sérénité inclut 1 modification simple par mois (texte, photo, tarif, horaires ou lien RDV). L'offre Visibilité & Confiance inclut 3 modifications simples par mois, traitées en priorité, plus une modernisation annuelle du site. Les changements de structure importants (nouvelles pages majeures, refonte du design) restent hors périmètre. Au-delà du quota, vous pouvez publier via le CMS ou demander un devis."
	},
	{
		question: 'Le bouton de prise de rendez-vous est-il inclus dans Sérénité ?',
		answer:
			"Oui. Si vous utilisez déjà Doctolib, Perfactive, Qare, Maiia, Calendly ou un autre outil compatible, j'intègre le bouton, le lien ou le widget disponible sur votre site. Je n'installe pas un agenda à votre place : l'abonnement à la plateforme de rendez-vous reste séparé.",
	},
	{
		question: "Combien de temps pour créer mon site ?",
		answer:
			"En général deux à trois semaines selon vos disponibilités et les contenus à fournir ; parfois un peu moins si tout arrive vite. Je travaille en étroite collaboration avec vous pour respecter votre calendrier."
	},
	{
		question: "Puis-je résilier l'abonnement à tout moment ?",
		answer:
			"Oui, vous pouvez résilier à tout moment. Aucun engagement de durée ni pénalité liée à la seule résiliation : les prestations continuent jusqu'à la fin de la période mensuelle déjà facturée."
	},
	{
		id: 'faq-sortie',
		question: "Si j'arrête, est-ce que je perds tout ?",
		answer:
			"Non. Le site et les services associés (hébergement, mises à jour, support) s'arrêtent à la fin de la période déjà payée, mais le nom de domaine vous est transféré sur simple demande, vers votre compte ou le prestataire de votre choix, et vous récupérez un export de vos contenus (textes et images fournies). Votre adresse et vos textes restent les vôtres, même si nous arrêtons de travailler ensemble."
	},
	{
		question: "La visibilité sur Google est-elle incluse ?",
		answer:
			"Les bases SEO et la fiche Google sont prévues dans les deux offres : site rapide, structure claire, titres, descriptions, indexation et cohérence locale. L'offre Visibilité & Confiance ajoute le travail d'un expert SEO dans la durée : veille avec des outils professionnels (notamment Ahrefs), relecture et optimisation de vos contenus, corrections si un problème apparaît. Ce n'est pas une garantie de place dans Google : le référencement local dépend aussi de votre ville, de la concurrence et de la régularité des contenus. Hors périmètre : rédaction mensuelle à ma charge, rapport SEO, pages par ville, publicité."
	}
];
---

<Layout
	title="Tarifs Nicodev : abonnement site psychologue dès 29 €/mois"
	description="Abonnement site psychologue Nicodev : 29 ou 49 €/mois tout inclus (création, hébergement, domaine, maintenance). Formules et périmètre détaillés."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>
	<Hero
		title="Tarifs Nicodev : abonnement site psychologue"
		subtitle="Deux formules claires dès 29 €/mois : création, hébergement, nom de domaine et maintenance inclus pour votre site de psychologue."
		variant="light"
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Tarifs' }]}
		coverImage={tarifsHeroImage}
		coverImageAlt="Bureau professionnel avec ordinateur, symbole de transparence tarifaire pour site de psychologue"
	>
		<Fragment slot="after">
			<ul
				class="mx-auto mt-6 flex max-w-3xl list-none flex-wrap justify-center gap-2 p-0 sm:gap-2.5"
				aria-label="Garanties tarifaires"
			>
				{tarifsHeroHighlights.map(({ Icon, label }) => (
					<li>
						<span class="inline-flex items-center gap-1.5 rounded-full border border-border/90 bg-background/70 px-3 py-1.5 text-sm text-muted shadow-sm backdrop-blur-sm">
							<Icon class="size-3.5 shrink-0 text-primary-700" aria-hidden="true" stroke-width={2.25} />
							<span>{label}</span>
						</span>
					</li>
				))}
			</ul>
		</Fragment>
	</Hero>

	<OffersSection background="white" />

	<section class="section-y border-t border-border bg-white">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<p class="mb-8 rounded-lg border border-border bg-surface px-5 py-4 text-sm text-muted sm:text-base">
				Vous cherchez d&apos;abord un ordre de grandeur (DIY, freelance, agence)&nbsp;?
				Lisez le guide{' '}
				<a
					href="/blog/combien-coute-site-internet-2026/"
					class="font-semibold text-primary underline underline-offset-4 hover:no-underline"
				>combien coûte un site pour psychologue</a>
				{' '}— cette page Tarifs détaille uniquement les <strong class="text-foreground">formules Nicodev</strong>.
				Vous vous installez&nbsp;?
				Voir aussi{' '}
				<a
					href="/blog/installer-liberal-psychologue-par-ou-commencer/"
					class="font-semibold text-primary underline underline-offset-4 hover:no-underline"
				>ouvrir un cabinet de psychologue</a>
				{' '}ou demander un{' '}
				<a
					href="/diagnostic-gratuit/"
					data-analytics-event="lead_click_diagnostic"
					data-analytics-cta="diagnostic"
					data-analytics-location="pricing_intro"
					class="font-semibold text-primary underline underline-offset-4 hover:no-underline"
				>diagnostic gratuit</a>
				{' '}avant de choisir une formule.
			</p>
			<div class="rounded-lg border border-border bg-muted/10 p-6 sm:p-8">
				<h2 class="mb-4 text-lg font-semibold text-foreground sm:text-xl">
					Pourquoi un abonnement site psychologue mensuel ?
				</h2>
				<p class="mb-4 text-sm text-muted sm:text-base">
					Un site n'est pas seulement un fichier mis en ligne une fois. Il faut une adresse, un hébergement, des mises à jour, un minimum de surveillance et quelqu'un qui sache intervenir quand votre cabinet évolue. L'abonnement regroupe ces postes pour un tarif prévisible, sans petites factures séparées ni charge mentale technique.
				</p>
				<ul class="space-y-2 text-sm text-muted sm:text-base">
					<li class="flex items-baseline gap-2">
						<span class="inline-block size-1.5 shrink-0 rounded-full bg-primary"></span>
						<span><strong class="text-foreground">Hébergement</strong> — souvent 8 à 40 €/mois pour un hébergement fiable selon le niveau de service et de maintenance</span>
					</li>
					<li class="flex items-baseline gap-2">
						<span class="inline-block size-1.5 shrink-0 rounded-full bg-primary"></span>
						<span><strong class="text-foreground">Nom de domaine</strong> — souvent 10 à 30 €/an pour votre adresse internet, par exemple votre-nom.fr</span>
					</li>
					<li class="flex items-baseline gap-2">
						<span class="inline-block size-1.5 shrink-0 rounded-full bg-primary"></span>
						<span><strong class="text-foreground">Maintenance et suivi</strong> — corrections, sécurité, performance, petits changements de contenu et suivi SEO peuvent vite dépasser le prix d'un simple hébergement</span>
					</li>
				</ul>
				<p class="mt-4 text-sm text-muted sm:text-base">
					La formule Sérénité pose les bases : CMS, SEO technique, fiche Google et 1 modification simple par mois. La formule Visibilité & Confiance ajoute une <strong class="text-foreground">veille SEO d'expert</strong> (suivi, relecture et optimisation des contenus). Pour comprendre le périmètre de création, voir la page <a href="/creation-site-internet-psychologue/" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">création de site internet pour psychologue</a>. Pour le volet Google, voir <a href="/referencement-site-psychologue/" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">référencement psychologue</a>. Pour les psychomotriciens&nbsp;: <a href="/site-internet-psychomotricien/" class="font-semibold text-primary underline underline-offset-4 hover:no-underline">site internet psychomotricien</a>.
				</p>
			</div>
		</div>
	</section>

	<!-- Philosophie Section -->
	<section class="section-y bg-surface">
		<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
			<h2 class="text-3xl font-bold text-foreground mb-8 text-center">
				La qualité web au service de votre activité
			</h2>

			<div class="prose prose-lg mx-auto text-muted space-y-6">
				<p>
					Contrairement à la plupart des prestataires qui cachent leurs tarifs, je prône la <strong>transparence totale</strong>. Votre budget doit être investi dans la qualité, pas dans des fonctionnalités inutiles ou des prestations opaques.
				</p>
				<p>
					Je travaille sur peu de projets à la fois, avec une attention réelle portée au contenu, à la
					lisibilité et aux besoins concrets des psychologues que j’accompagne.
				</p>
			</div>

			<div class="mt-10 rounded-lg border border-border bg-white p-6 sm:p-8">
				<h3 class="text-xl font-semibold text-foreground mb-4">Mes engagements qualité</h3>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
					<BulletList
						items={[
							"<strong>Visibilité :</strong> Bases SEO et fiche Google dès la création, pour les recherches psychologue ou psychomotricien",
							"<strong>Perception :</strong> Design rassurant, navigation intuitive, accessibilité",
							"<strong>Technique :</strong> Sécurité RGPD, performance, CMS, conformité aux standards"
						]}
					/>
					<BulletList
						items={[
							"<strong>Contenu :</strong> Présentation de vos spécialités ; vous pouvez publier des articles via le CMS",
							"<strong>Services :</strong> Intégration du widget ou lien de prise de RDV (Doctolib, Qare, Maiia, Calendly...)",
							"<strong>Accompagnement :</strong> Modifications de contenu selon la formule (1 ou 3 par mois)"
						]}
					/>
				</div>
			</div>

			<div
				id="performances-pagespeed"
				class="mt-10 scroll-mt-24 rounded-lg border border-border bg-white p-6 sm:p-8"
			>
				<h3 class="mb-3 text-xl font-semibold text-foreground">
					Performances techniques (Google PageSpeed)
				</h3>
				<p class="mb-3 text-sm text-muted sm:text-base">
					En complément du design et du contenu, les sites sont pensés pour charger vite sur
					mobile et respecter les critères techniques que Google utilise aussi pour le
					référencement. Les scores ci-dessous illustrent ce qu&apos;un site bien optimisé peut
					obtenir sur PageSpeed Insights (exemple type).
				</p>
				<p class="mb-4 text-sm text-muted sm:text-base">
					Pour votre site actuel, vous pouvez lancer un test gratuit en quelques secondes.
				</p>
				<div class="mb-4">
					<PageSpeedScores title="Exemple de scores pour un site de psychologue ou psychomotricien" />
				</div>
				<a
					href="https://pagespeed.web.dev/"
					target="_blank"
					rel="noopener noreferrer"
					data-umami-event="pagespeed_test_link_click"
					class="inline-flex items-center text-sm font-semibold text-primary underline underline-offset-4 hover:no-underline"
				>
					Testez les performances de votre site sur Google PageSpeed
				</a>
			</div>

			<div class="prose prose-lg mx-auto text-muted mt-10">
				<p>
					Les sites s’appuient sur une base professionnelle sobre, puis sont ajustés avec soin selon votre identité, votre pratique et vos besoins. Ils sont optimisés pour tous les appareils et respectent les règles de communication des professions réglementées. La qualité demande du temps, et mes tarifs en sont le reflet exact.
				</p>
			</div>
		</div>
	</section>

	<!-- Complément : comparaison avec les plateformes (les formules détaillées sont dans OffersSection ci-dessus) -->
	<section id="comparaison-plateformes" class="section-y scroll-mt-28 bg-white">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="bg-surface p-8 rounded-lg border border-border">
				<h3 class="text-2xl font-bold text-center text-foreground mb-8">
					Pourquoi choisir mes services plutôt qu'une plateforme ?
				</h3>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
					<div>
						<h4 class="text-lg font-semibold text-foreground mb-4">Avec Wix, Squarespace, etc. :</h4>
						<ul class="space-y-3">
							{platformCons.map((item) => (
								<li class="flex items-start gap-3">
									<span
										aria-hidden="true"
										class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-700"
									>
										<svg
											class="size-3"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="3"
											stroke-linecap="round"
										>
											<path d="M6 6l12 12M18 6L6 18" />
										</svg>
									</span>
									<span class="sr-only">Non&nbsp;:</span>
									<span class="text-muted">{item}</span>
								</li>
							))}
						</ul>
					</div>

					<div>
						<h4 class="text-lg font-semibold text-foreground mb-4">Avec mes services :</h4>
						<ul class="space-y-3">
							{servicePros.map((item) => (
								<li class="flex items-start gap-3">
									<span
										aria-hidden="true"
										class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700"
									>
										<svg
											class="size-3"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="3"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M5 12l4 4L19 7" />
										</svg>
									</span>
									<span class="sr-only">Oui&nbsp;:</span>
									<span class="text-muted">{item}</span>
								</li>
							))}
						</ul>
					</div>
				</div>

				<div class="bg-background p-6 rounded-lg border border-border">
					<h4 class="font-semibold text-foreground mb-3">Ce que coûte vraiment un site qu'on gère soi-même :</h4>
					<p class="text-muted">
						Générer un site ne prend plus des heures&nbsp;: avec une plateforme ou un assistant, une
						première version sort en une soirée. Ce qui prend du temps, c'est l'après — décider quoi
						écrire de sa pratique, tenir la fiche Google à jour, corriger ce qui casse, réindexer après
						un changement d'adresse ou d'honoraires, et savoir si ce qui est en ligne est encore juste.
					</p>
					<p class="text-muted mt-3">
						C'est ce poste-là que l'abonnement fait disparaître de votre charge mentale. Au-delà du prix,
						il y a aussi la qualité de suivi&nbsp;: entre une logique industrielle et une approche
						artisanale, la différence se joue souvent dans l’attention portée au détail, à votre ton et à
						la cohérence du site.
					</p>
				</div>
			</div>
		</div>
	</section>

	<FaqSection
		items={tarifsFaqItems}
		title="Questions fréquentes"
		sectionId="faq-tarifs"
		headingId="faq-tarifs-heading"
		background="surface"
		headingAlign="center"
	/>

	<CtaSection
		title="Prêt à créer votre site internet ?"
		description="Discutons de votre projet et choisissons ensemble la formule qui correspond à vos besoins."
		primaryButton={{ text: 'Demander un diagnostic gratuit', href: '/diagnostic-gratuit/' }}
		secondaryButton={{ text: 'Voir les tarifs', href: '/tarifs/#tarifs-offres' }}
		background="white"
	/>
</Layout>
