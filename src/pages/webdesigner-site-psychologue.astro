---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CtaSection from '../components/CtaSection.astro';
import { Phone, MessageCircle } from '@lucide/astro';
import { WHATSAPP_HREF, WHATSAPP_DISPLAY, WHATSAPP_PHONE_E164 } from '../data/contact';
import webdesignerOgWebp from '../assets/images/blog/site-psychologue.webp';

const baseUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL('/webdesigner-site-psychologue/', baseUrl).href;

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Puis-je choisir les couleurs et la police ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Oui, dans un cadre sobre et accessible — nous validons ensemble les contrastes et la lisibilité.',
			},
		},
		{
			'@type': 'Question',
			name: 'Proposez-vous uniquement le design ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: "Non : l'accompagnement couvre conception, développement, hébergement et suivi. Je ne livre pas de maquettes Figma sans mise en ligne.",
			},
		},
		{
			'@type': 'Question',
			name: 'Le design influence-t-il le référencement ?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Indirectement : un site clair, rapide et bien structuré aide Google et surtout les patients à agir (appel, formulaire, RDV).',
			},
		},
	],
};

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Design et conception de site vitrine pour psychologue',
	description:
		'Webdesign spécialisé pour psychologues : interface sobre, lisible sur mobile, parcours clair vers les informations utiles et la prise de contact.',
	provider: {
		'@type': 'Person',
		name: 'Nicolas Devaux',
		url: new URL('/about/', baseUrl).href,
	},
	serviceType: 'Conception et design de site internet',
	areaServed: { '@type': 'Country', name: 'France' },
	url: pageUrl,
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Accueil', item: new URL('/', baseUrl).toString() },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Webdesigner psychologues',
			item: pageUrl
		}
	]
};
---

<Layout
	title="Webdesigner psychologues : site vitrine | Nicolas Devaux"
	description="Webdesigner spécialisé sites pour psychologues : interface sobre, lisible sur mobile, parcours clair vers les informations utiles et la prise de contact. Psychologue et développeur web."
	image={webdesignerOgWebp}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

	<Hero
		title="Webdesigner pour psychologues"
		subtitle="Un design sobre et professionnel — pas tape-à-l’œil — pour rassurer et guider vers la prise de contact ou le widget de RDV."
		breadcrumb={[{ label: 'Accueil', href: '/' }, { label: 'Webdesigner psychologues' }]}
	/>

	<div class="border-b border-border bg-white py-3">
		<div class="shell-layout flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
			<a
				href={`tel:+${WHATSAPP_PHONE_E164}`}
				class="inline-flex items-center gap-1.5 font-medium text-muted transition-colors hover:text-primary"
			>
				<Phone class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				{WHATSAPP_DISPLAY}
			</a>
			<a
				href={WHATSAPP_HREF}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 font-semibold text-primary-500 transition-colors hover:text-primary"
				data-umami-event="lead_click_whatsapp_from_webdesigner_page"
			>
				<MessageCircle class="h-4 w-4 shrink-0" stroke-width={1.75} aria-hidden="true" />
				WhatsApp — réponse rapide
			</a>
		</div>
	</div>

	<section class="section-y border-b border-border bg-white">
		<div class="shell-layout">
			<div class="mx-auto max-w-[72ch] prose prose-lg prose-headings:text-foreground prose-p:text-muted prose-li:text-muted prose-strong:text-foreground">
				<h2>Pourquoi chercher un «&nbsp;webdesigner psychologue&nbsp;»&nbsp;?</h2>
				<p>
					La recherche <strong>webdesigner psychologue</strong> reflète souvent la même attente qu’un décorateur pour cabinet&nbsp;: on veut quelqu’un qui comprend le ton du métier — confidentialité, calme, lisibilité — sans discours publicitaire ni effets gadget qui fatiguent sur téléphone.
				</p>
				<p>
					Je suis <strong>psychologue et développeur web</strong>. Je ne sous-traite pas la conception à une équipe généraliste&nbsp;: vous parlez à la personne qui code et qui sait ce que vos patients peuvent craindre quand ils arrivent sur un site (surinformation, affirmations trop appuyées, surcharge visuelle).
				</p>

				<h2>Ce que « design » veut dire ici</h2>
				<ul>
					<li>Hiérarchie visuelle claire (titres, espacements, contrastes accessibles)</li>
					<li>Parcours court vers l’action utile (contact, téléphone, rendez-vous en ligne)</li>
					<li>Mise en page adaptée à votre contenu, à votre ville et à votre pratique</li>
					<li>Typographie lisible sur écran et en impression (cartes de visite, signatures mail)</li>
					<li>Photos et visuels sobres — pas de banques d’images «&nbsp;stock sourire&nbsp;» qui brouillent le message clinique</li>
				</ul>

				<h2>Design et déontologie&nbsp;: même combat</h2>
				<p>
					Un site de psychologue n’a pas à reprendre les codes d’un site de vente. Le design sert la <strong>lisibilité</strong> et la <strong>confiance</strong>&nbsp;: présenter le titre, le parcours, les modalités, les limites du cadre — sans témoignages patients utilisés comme argument, sans affirmation de guérison, sans pop-ups agressifs. Ces principes sont développés dans le <a href="/blog/site-internet-psychologues/">guide site internet pour psychologue</a> et dans l’article sur les <a href="/blog/site-internet-psychologue-promesses-trop-belles/">discours trop assurés des offres web</a>.
				</p>
				<p>
					Beaucoup de sites «&nbsp;faits maison&nbsp;» ou issus de modèles génériques souffrent d’une hiérarchie confuse, de textes trop petits sur mobile ou de formulaires mal sécurisés. Le travail de design ici inclut aussi la <strong>structure HTML</strong> (titres H1–H3 cohérents) — utile pour vos patients comme pour Google.
				</p>

				<h2>Mobile d’abord</h2>
				<p>
					Une large part des recherches «&nbsp;psychologue + ville&nbsp;» se fait sur téléphone. Si le bouton d’appel est caché, si le texte défile sur dix écrans sans repère ou si le widget Doctolib charge lentement, la personne part avant d’avoir lu votre approche. Chaque interface suit une logique <strong>mobile first</strong>&nbsp;: une colonne, des blocs aérés, des actions visibles sans zoom.
				</p>

				<h2>Du design à la mise en ligne</h2>
				<p>
					Le design n’est pas une étape décorative ajoutée après coup&nbsp;: il accompagne la collecte de vos contenus (formulaire guidé), le choix des sections (accueil, approche, informations pratiques, contact) et l’intégration de votre outil de rendez-vous. La page <a href="/creation-site-internet-psychologue/">création de site internet pour psychologue</a> décrit l’offre complète&nbsp;; la page <a href="/referencement-site-psychologue/">référencement site psychologue</a> précise comment le rendu s’inscrit dans une visibilité locale durable.
				</p>
				<p>
					Pour cadrer votre projet avant engagement, le <a href="/diagnostic-gratuit/">diagnostic gratuit</a> permet de comparer votre site actuel (ou l’absence de site) aux exemples et de lister les priorités design + visibilité.
				</p>

				<h2>Questions fréquentes</h2>
				<p><strong>Puis-je choisir les couleurs et la police&nbsp;?</strong> Oui, dans un cadre sobre et accessible — nous validons ensemble les contrastes et la lisibilité.</p>
				<p><strong>Proposez-vous uniquement le design&nbsp;?</strong> Non&nbsp;: l’accompagnement couvre conception, développement, hébergement et suivi. Je ne livre pas de maquettes Figma sans mise en ligne.</p>
				<p><strong>Le design influence-t-il le référencement&nbsp;?</strong> Indirectement&nbsp;: un site clair, rapide et bien structuré aide Google et surtout les patients à agir (appel, formulaire, RDV).</p>

				<h2>Liens utiles</h2>
				<ul>
					<li><a href="/creation-site-internet-psychologue/">Création de site internet pour psychologue</a></li>
					<li><a href="/referencement-site-psychologue/">Référencement site psychologue</a></li>
					<li><a href="/portfolio/">Portfolio</a></li>
					<li><a href="/blog/guide-complet-visibilite-en-ligne-psychologues/">Guide visibilité en ligne (blog)</a></li>
					<li><a href="/tarifs/">Tarifs</a></li>
				</ul>
			</div>
		</div>
	</section>

	<CtaSection
		title="Voir si le rendu vous convient"
		description="Le portfolio et le diagnostic gratuit permettent de valider le ton avant de vous engager."
		primaryButton={{ text: 'Demander un diagnostic gratuit', href: '/diagnostic-gratuit/' }}
		secondaryButton={{ text: 'Voir le portfolio', href: '/portfolio/' }}
		background="surface"
	/>
</Layout>
